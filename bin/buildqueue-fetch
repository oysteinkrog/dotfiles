#!/usr/bin/env -S python3 -I -S
"""Print the heavy-build queue, its order, how fast it moves and its gate state, as JSON.

    buildqueue-fetch                   print it once
    buildqueue-fetch --serve FILE [S]  rewrite FILE every S seconds (default 5) until the
                                       parent process exits

Feeds the build queue Plasma widget (~/.local/share/plasma/plasmoids/org.oysteinkrog.buildqueue).
buildqueue-window starts it with --serve, and the widget reads the file. One long-lived
process costs a few ms a round; a new Python process every 5 s cost about 1% of a core.
Read only: it never touches a build or the queue.

Sources:
  /run/user/<uid>/heavy-build.queue/<job>      one file per waiting job
  builds.slice/heavy-build-*.scope (cgroupfs)  running builds and their memory
  ~/.local/state/heavy-build/live.log          every queue decision (read from a saved offset)
  ~/.local/state/heavy-build/history.tsv       one row per finished build (read from a saved offset)
  ~/.local/state/pressure/level                the pressure coordinator's level
  ~/.config/heavy-build.lanes                  per-lane priority rules (optional)

Machine resources (memory, swap, CPU) are left out on purpose: Tasklens shows them beside
this panel.

A job id is <submit ns>-<pid>-<hash>. The hash is history.tsv column 3, and the pid is in the
scope name heavy-build-<pid>-<n>, so live.log lines tie waits, starts and finished builds to a
project. The offsets and the last two hours of starts and finishes are kept in
~/.cache/buildqueue/state.json, so each run reads only what was appended since the last one.
"""

import json
import os
import pathlib
import re
import sys
import time

# configparser and subprocess are imported where they are used: most runs need neither,
# and their imports cost more than the rest of a run.

HOME = pathlib.Path.home()
UID = os.getuid()
RUNTIME = pathlib.Path(f"/run/user/{UID}")
QUEUE = RUNTIME / "heavy-build.queue"
SLICE = pathlib.Path(
    f"/sys/fs/cgroup/user.slice/user-{UID}.slice/user@{UID}.service/builds.slice"
)
HB_STATE = HOME / ".local/state/heavy-build"
LIVE = HB_STATE / "live.log"
HISTORY = HB_STATE / "history.tsv"
LEVEL = HOME / ".local/state/pressure/level"
CONF = HOME / ".config/heavy-build.conf"
LANES = HOME / ".config/heavy-build.lanes"
CACHE = HOME / ".cache/buildqueue"
STATE = CACHE / "state.json"
OWNERS = CACHE / "owners.json"
SESSIONS = HOME / ".claude/sessions"
TRANSCRIPTS = HOME / ".claude/projects"

# How far back the first run reads, before there is an offset.
FIRST_LIVE_BYTES = 6 << 20
FIRST_HISTORY_BYTES = 256 << 10
KEEP_S = 2 * 3600
HOUR = 3600
DAY = 24 * HOUR
SAMPLE_EVERY_S = 30
LANE_SAMPLE_S = 60
NEXT_SHOWN = 6
LANE_JOBS = 24
TREND_S = 15 * 60
THEME_EVERY_S = 600
SESSIONS_EVERY_S = 60
OWNER_READ_BYTES = 24 << 20
OWNER_FIRST_BYTES = 64 << 20
QUEUE_SHOWN = 120

LINE_RE = re.compile(
    r'^(\S+) mode=\S+ job=(\d+)-(\d+)-([0-9a-f]+) decision=(\S+) reason="([^"]*)"'
)
KEYS_RE = re.compile(r" keys=(\S+)")
PRIO_RE = re.compile(r" prio=(\S+)")
RANK_RE = re.compile(r" rank=(\d+)")
FIELD_RE = re.compile(r"(session|agent|owner|lane)=(\S+)")
TS_RE = re.compile(r"(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)([+-])(\d\d)(\d\d)")
# A worktree named in a transcript: .scratch/<tag>, work/desktop/<tag>, work/<tag>, src/<tag> or
# /var/tmp/claude[/<task>]/<tag>.
MENTION_RE = re.compile(rb"(?:\.scratch|work/desktop|work|/var/tmp/claude(?:/[\w.-]+)?)/([A-Za-z0-9][\w.-]{1,60})")
# A file name (README.md, test_break.py) is never a worktree; 26.2 is.
FILE_RE = re.compile(r"\.[A-Za-z][A-Za-z0-9]{0,5}$")
IDLE_RE = re.compile(r"\s*\(idle, not counted[^)]*\)")


def project_of_keys(keys):
    """The worktree or cargo tree a job's keys name, as its folder name. '' for none."""
    for k in keys.split(","):
        kind, _, path = k.partition(":")
        if kind in ("tree", "cargo") and path:
            return os.path.basename(path.rstrip("/"))
    return ""


def project_of_dir(path):
    """The folder name of the git tree that holds path, or of path itself."""
    p = pathlib.Path(path)
    if p == HOME:
        return "~"
    for d in (p, *p.parents):
        if d == HOME or d == d.parent:
            break
        if (d / ".git").exists():
            return d.name
    return p.name


def project_of_pid(pid):
    """The project a running heavy-build process works in, from its working directory."""
    try:
        return project_of_dir(os.readlink(f"/proc/{pid}/cwd"))
    except OSError:
        return ""


def reason_kind(reason):
    """The cause word a wait reason starts with: memory, cores, behind, starve, pressure, ..."""
    m = re.match(r"[A-Za-z][\w-]*", reason)
    return m.group(0) if m else "other"


def read_new(path, offset, first_bytes):
    """Lines appended to path since offset, and the new offset. Starts over when the file shrank."""
    try:
        size = path.stat().st_size
    except OSError:
        return [], 0
    if offset is None or offset > size:
        offset = max(0, size - first_bytes)
        skip_partial = offset > 0
    else:
        skip_partial = False
    if offset == size:
        return [], offset
    with path.open("rb") as f:
        f.seek(offset)
        data = f.read(size - offset)
    end = data.rfind(b"\n") + 1
    lines = data[:end].decode("utf-8", "replace").splitlines()
    if skip_partial and lines:
        lines = lines[1:]
    return lines, offset + end


def parse_ts(text):
    """Epoch seconds of a live.log time such as 2026-10-26T11:10:03+0100."""
    m = TS_RE.match(text)
    if not m:
        return None
    y, mo, d, h, mi, s, sign, oh, om = (m.group(i) for i in range(1, 10))
    t = time.mktime((int(y), int(mo), int(d), int(h), int(mi), int(s), 0, 0, 0))
    # mktime reads the fields as local time with no DST set; move them to UTC from
    # the line's own offset.
    local_off = -time.timezone
    off = (int(oh) * 3600 + int(om) * 60) * (1 if sign == "+" else -1)
    return t + local_off - off


def load_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(st):
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, separators=(",", ":")))
    tmp.replace(STATE)


def update_live(st, now):
    lines, st["liveOffset"] = read_new(LIVE, st.get("liveOffset"), FIRST_LIVE_BYTES)
    reasons = st.setdefault("waitReason", {})  # job id -> [kind, text]
    projects = st.setdefault("projectOf", {})  # hash -> [project, seen]
    starts = st.setdefault("starts", [])  # [ts, job id, wait_s, project, prio]
    for line in lines:
        m = LINE_RE.match(line)
        if not m:
            continue
        ts, sub_ns, pid, h, decision, reason = m.groups()
        job = f"{sub_ns}-{pid}-{h}"
        km = KEYS_RE.search(line)
        project = project_of_keys(km.group(1)) if km else ""
        if not project and decision == "start":
            project = projects.get(h, [""])[0] or project_of_pid(pid)
        if project:
            projects[h] = [project, now]
        if decision == "wait":
            rm = RANK_RE.search(line)
            reasons[job] = [reason_kind(reason), IDLE_RE.sub("", reason), int(rm.group(1)) if rm else 0]
        elif decision == "start":
            t = parse_ts(ts)
            if t is None:
                continue
            pm = PRIO_RE.search(line)
            starts.append(
                [
                    t,
                    job,
                    max(0.0, t - int(sub_ns) / 1e9),
                    project,
                    pm.group(1) if pm else "",
                ]
            )
            reasons.pop(job, None)
    st["starts"] = [s for s in starts if s[0] > now - KEEP_S]
    for h in [h for h, (_, seen) in projects.items() if seen < now - 24 * 3600]:
        del projects[h]


def update_history(st, now):
    lines, st["historyOffset"] = read_new(
        HISTORY, st.get("historyOffset"), FIRST_HISTORY_BYTES
    )
    done = st.setdefault("finished", [])  # [end, class, hash, wall_s, reason]
    for line in lines:
        c = line.split("\t")
        if len(c) < 7:
            continue
        try:
            end = int(c[0])
        except ValueError:
            continue
        reason = c[7] if len(c) > 7 else ("ok" if c[6] == "0" else "fail")
        done.append([end, c[1], c[2], float(c[3] or 0), reason])
    st["finished"] = [d for d in done if d[0] > now - KEEP_S]


def waiting_jobs(st, now):
    """[(job id, submit epoch, prio, est_mem_gib, class, project, est_wall_s, session, agent,
    owner)] for every waiting job. Line 3 of a ticket (session= agent= lane= owner= dirs=) is
    written by heavy-build since 2026-10-26; older tickets have none."""
    projects = st["projectOf"]
    jobs = []
    names = os.listdir(QUEUE)  # missing folder: an error, so the saved state is kept
    for name in names:
        parts = name.split("-")
        if len(parts) != 3 or not parts[0].isdigit():
            continue
        try:
            with open(QUEUE / name) as f:
                f.readline()
                fields = f.readline().split()
                extra = dict(FIELD_RE.findall(f.readline()))
        except OSError:
            continue  # started or cancelled since the listing
        prio, mem, cls, keys, wall = "", 0.0, "", "-", 0
        if len(fields) >= 6:
            prio, keys, cls = fields[0], fields[4], fields[5]
            try:
                mem = float(fields[1])
                wall = int(float(fields[3]))
            except ValueError:
                pass
        project = project_of_keys(keys)
        if not project:
            project = projects.get(parts[2], [""])[0] or project_of_pid(parts[1])
        if project:
            projects[parts[2]] = [project, now]
        jobs.append((
            name, int(parts[0]) / 1e9, prio, mem, cls, project, wall,
            "" if extra.get("session", "-") == "-" else extra["session"],
            "" if extra.get("agent", "-") == "-" else extra["agent"],
            recorded_owner(extra),
        ))
    return jobs


def recorded_owner(fields):
    """The session heavy-build recorded for a job: the calling Claude session, else the
    grove lane's owner. '' when it recorded neither."""
    for k in ("session", "owner"):
        v = fields.get(k, "-")
        if v not in ("-", "?", ""):
            return v
    return ""


def read_int(path):
    try:
        return int(path.read_text().split()[0])
    except (OSError, ValueError, IndexError):
        return 0


def running_builds(st, now):
    units = st.setdefault("units", {})  # unit -> {cls, prio, why, since, project}
    found = []
    try:
        names = [n for n in os.listdir(SLICE) if n.startswith("heavy-build-") and n.endswith(".scope")]
    except OSError:
        names = []
    new = [n for n in names if n not in units]
    if new:
        import subprocess

        try:
            out = subprocess.run(
                ["systemctl", "--user", "show", *new, "-p", "Id,Description,ActiveEnterTimestamp", "--timestamp=unix"],
                capture_output=True, text=True, timeout=5,
            ).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        for block in out.strip().split("\n\n"):
            props = dict(l.split("=", 1) for l in block.splitlines() if "=" in l)
            unit = props.get("Id")
            if unit not in new:
                continue
            desc = props.get("Description", "")
            words = desc.split()
            cls = words[1] if len(words) > 1 else ""
            pm = re.search(r"prio=(\S+)", desc)
            why = desc.split("reason:", 1)[1].strip() if "reason:" in desc else ""
            since = props.get("ActiveEnterTimestamp", "").lstrip("@")
            project = project_of_pid(unit.split("-")[2])
            extra = dict(FIELD_RE.findall(desc))
            units[unit] = {
                "session": "" if extra.get("session", "-") == "-" else extra["session"],
                "agent": "" if extra.get("agent", "-") == "-" else extra["agent"],
                "owner": recorded_owner(extra),
                "cls": cls,
                "prio": pm.group(1) if pm else "",
                "why": why,
                "since": int(since) if since.isdigit() else now,
                "project": project,
            }
    for unit in [u for u in units if u not in names]:
        del units[unit]
    for n in names:
        u = units.get(n)
        if not u:
            continue
        found.append(
            {
                "cls": u["cls"],
                "prio": u["prio"],
                "why": u["why"],
                "project": u["project"],
                "session": u.get("session", ""),
                "agent": u.get("agent", ""),
                "owner": u.get("owner", ""),
                "runtime": max(0, int(now - u["since"])),
                "mem": read_int(SLICE / n / "memory.current"),
            }
        )
    found.sort(key=lambda b: -b["runtime"])
    return found


def median(values):
    v = sorted(values)
    n = len(v)
    return (v[n // 2] + v[(n - 1) // 2]) / 2


def pct(values, q):
    if not values:
        return None
    v = sorted(values)
    return v[min(len(v) - 1, int(q * len(v)))]


def machine_level():
    """The pressure coordinator's level file: level=normal|slow|pause since= reason=..."""
    level = {}
    try:
        text = LEVEL.read_text()
        for m in re.finditer(r'(\w+)=("([^"]*)"|\S+)', text):
            level[m.group(1)] = m.group(3) if m.group(3) is not None else m.group(2)
    except OSError:
        pass
    return level


def read_conf():
    conf = {}
    try:
        for line in CONF.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip()
    except OSError:
        pass
    return conf


def limits(conf):
    parts = []
    if "HEAVY_BUILD_MAX_JOBS" in conf:
        parts.append(f"{conf['HEAVY_BUILD_MAX_JOBS']} jobs")
    if "HEAVY_BUILD_MAX_APP_RUNS" in conf:
        parts.append(f"{conf['HEAVY_BUILD_MAX_APP_RUNS']} app runs")
    if conf.get("HEAVY_BUILD_MEM_CONTROLLER") == "1":
        parts.append(
            "memory controller: target {} GiB, brake under {} GiB, none under {} GiB".format(
                conf.get("HEAVY_BUILD_MC_TARGET_GIB", "?"),
                conf.get("HEAVY_BUILD_MC_BRAKE_GIB", "?"),
                conf.get("HEAVY_BUILD_MC_HARD_GIB", "?"),
            )
        )
    elif "HEAVY_BUILD_MEM_RESERVE_GIB" in conf:
        parts.append(f"reserve {conf['HEAVY_BUILD_MEM_RESERVE_GIB']} GiB")
    return ", ".join(parts)


def theme(st, now):
    """Colours of the current Plasma style (the panels), cached for THEME_EVERY_S."""
    cached = st.get("theme")
    if cached and now - cached.get("at", 0) < THEME_EVERY_S:
        return cached["colours"]
    import configparser
    import subprocess

    colours = {}
    try:
        path = subprocess.run(
            [str(HOME / "bin/plasma-style-colours")],
            capture_output=True, text=True, timeout=10, check=True,
        ).stdout.strip()
        cp = configparser.ConfigParser(interpolation=None, strict=False)
        cp.optionxform = str
        cp.read(path)

        def hex_of(group, key):
            r, g, b = (int(x) for x in cp[group][key].split(",")[:3])
            return f"#{r:02x}{g:02x}{b:02x}"

        colours = {
            "background": hex_of("Colors:Window", "BackgroundNormal"),
            "alternate": hex_of("Colors:View", "BackgroundNormal"),
            "text": hex_of("Colors:Window", "ForegroundNormal"),
            "inactive": hex_of("Colors:Window", "ForegroundInactive"),
            "negative": hex_of("Colors:Window", "ForegroundNegative"),
            "neutral": hex_of("Colors:Window", "ForegroundNeutral"),
            "positive": hex_of("Colors:Window", "ForegroundPositive"),
            "accent": hex_of("Colors:Selection", "BackgroundNormal"),
            "accentText": hex_of("Colors:Selection", "ForegroundNormal"),
        }
    except (OSError, subprocess.SubprocessError, KeyError, ValueError):
        pass
    st["theme"] = {"at": now, "colours": colours}
    return colours


def lane_rules():
    """[(match, prio, by)] from ~/.config/heavy-build.lanes, in file order. The file is
    optional: heavy-build-prio writes it, and the first matching line wins."""
    rules = []
    try:
        text = LANES.read_text()
    except OSError:
        return rules
    for line in text.splitlines():
        w = line.split("#", 1)[0].split()
        if len(w) >= 2:
            by = next((x[3:] for x in w[2:] if x.startswith("by=")), "")
            rules.append((w[0], w[1], by))
    return rules


def lane_prio(rules, *names):
    """The first rule that matches any of names (a worktree tag, a session name), as heavy-build
    picks it. Directory rules (/ or ~/) are not matched here."""
    import fnmatch

    names = [n for n in names if n]
    for match, prio, by in rules:
        if any(match == n or fnmatch.fnmatchcase(n, match) for n in names):
            return {"prio": prio, "by": by, "rule": match}
    return None


# Owners. A job belongs to the Claude session that owns its worktree. heavy-build does not
# record the session yet and detached jobs have lost their parent chain, so the owner is
# found from the sessions themselves: a live session whose folder is the worktree, or else
# the session whose transcripts name the worktree far more often than any other.


def load_owners():
    try:
        return json.loads(OWNERS.read_text())
    except (OSError, ValueError):
        return {}


def save_owners(ow):
    if not ow.pop("dirty", False):
        return
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = OWNERS.with_suffix(".tmp")
    tmp.write_text(json.dumps(ow, separators=(",", ":")))
    tmp.replace(OWNERS)


def update_sessions(ow, now):
    """Refresh the session list (id -> name, folder, live) and each live session's transcript
    files, once a minute."""
    if now - ow.get("sessionsAt", 0) < SESSIONS_EVERY_S and "sessions" in ow:
        return
    ow["sessionsAt"] = now
    sessions = ow.setdefault("sessions", {})
    dirs = ow.setdefault("dirs", {})  # session id -> its transcript folder
    for s in sessions.values():
        s["live"] = False
    try:
        files = list(SESSIONS.glob("*.json"))
    except OSError:
        files = []
    for f in files:
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        sid = d.get("sessionId")
        if not sid:
            continue
        sessions[sid] = {
            "name": d.get("name") or os.path.basename(d.get("cwd", "")) or sid[:8],
            "cwd": d.get("cwd", ""),
            "live": os.path.exists(f"/proc/{d.get('pid', 0)}"),
        }
    missing = [sid for sid, s in sessions.items() if s["live"] and sid not in dirs]
    if missing:
        try:
            for d in TRANSCRIPTS.iterdir():
                for sid in missing:
                    if (d / f"{sid}.jsonl").exists():
                        dirs[sid] = str(d)
        except OSError:
            pass
    # Subagent transcripts number in the thousands, so only those written in the last hour,
    # or written in the last two days and not read yet, are checked for new bytes. Offsets
    # are kept for the last two days' files only: older ones do not grow again.
    offsets = ow.get("offsets", {})
    paths, keep = [], []
    for sid, s in sessions.items():
        if s["live"] and sid in dirs:
            d = pathlib.Path(dirs[sid])
            main = str(d / f"{sid}.jsonl")
            paths.append([sid, main])
            keep.append(main)
            for f in (d / sid / "subagents").glob("*.jsonl"):
                path = str(f)
                try:
                    age = now - f.stat().st_mtime
                except OSError:
                    continue
                if age < HOUR or (path not in offsets and age < 2 * DAY):
                    paths.append([sid, path])
                if age < 2 * DAY:
                    keep.append(path)
    ow["files"] = paths
    ow["keep"] = keep


def update_mentions(ow):
    """Count worktree names in the new part of each live transcript, OWNER_READ_BYTES per
    run at most. A transcript seen for the first time is read from its last
    OWNER_FIRST_BYTES only."""
    offsets = ow.setdefault("offsets", {})
    counts = ow.setdefault("counts", {})  # tag -> {session id: mentions}
    budget = OWNER_READ_BYTES
    for sid, path in ow.get("files", []):
        if budget <= 0:
            break
        try:
            size = os.stat(path).st_size
        except OSError:
            continue
        start = offsets.get(path)
        if start is None:
            start = max(0, size - OWNER_FIRST_BYTES)
        if size <= start:
            offsets[path] = min(start, size)
            continue
        with open(path, "rb") as f:
            f.seek(start)
            data = f.read(min(size - start, budget))
        end = data.rfind(b"\n") + 1
        if end == 0:
            if len(data) < budget:
                continue
            end = len(data)
        budget -= end
        offsets[path] = start + end
        for m in MENTION_RE.finditer(data, 0, end):
            tag = m.group(1).decode(errors="replace")
            if FILE_RE.search(tag):
                continue
            c = counts.setdefault(tag, {})
            c[sid] = c.get(sid, 0) + 1
        ow["dirty"] = True
    # Forget transcripts of sessions that have ended.
    keep = set(ow.pop("keep", None) or offsets)
    for path in [p for p in offsets if p not in keep]:
        del offsets[path]
        ow["dirty"] = True


def owner_of(ow, tag, recorded=""):
    """(session name, how, live) for a worktree name. how is recorded (heavy-build wrote it on
    the ticket), folder, mentions, guess or ''."""
    sessions = ow.get("sessions", {})
    if recorded:
        live = any(s["live"] and s["name"] == recorded for s in sessions.values())
        return recorded, "recorded", live
    by_folder = [s for s in sessions.values() if s["live"] and os.path.basename(s["cwd"]) == tag]
    if len(by_folder) == 1:
        return by_folder[0]["name"], "folder", True
    counts = sorted(ow.get("counts", {}).get(tag, {}).items(), key=lambda x: -x[1])
    counts = [c for c in counts if c[0] in sessions]
    if not counts:
        return "", "", False
    top = counts[0]
    second = counts[1][1] if len(counts) > 1 else 0
    s = sessions[top[0]]
    how = "mentions" if top[1] >= 3 and top[1] >= 2 * second else "guess"
    return s["name"], how, s["live"]


def group_by_owner(projects, rules):
    """One entry per owning session, holding its worktrees under "lanes". Worktrees with no
    owner go under one entry with an empty owner."""
    groups = {}
    for r in projects:
        name, live = r["owner"], r["ownerLive"]
        g = groups.get(name)
        if not g:
            g = groups[name] = {"name": name, "owner": name, "ownerLive": live, "lanes": [], "jobs": [], "spark": []}
        g["lanes"].append(r)
    out = []
    for g in groups.values():
        kids = g["lanes"]
        for k in ("waiting", "running", "started", "finished", "failed"):
            g[k] = sum(x[k] for x in kids)
        g["spark"] = [sum(v) for v in zip(*(x["spark"] for x in kids))]
        g["guess"] = any(x["ownerHow"] == "guess" for x in kids)
        g["prio"] = lane_prio(rules, g["name"])
        out.append(g)
    return sorted(out, key=lambda r: (r["name"] == "", -r["waiting"], -r["running"], -r["started"] - r["finished"], r["name"]))


def on_path(cmd):
    return any(os.access(os.path.join(d, cmd), os.X_OK) for d in os.environ.get("PATH", "").split(":") if d) or os.access(HOME / "bin" / cmd, os.X_OK)


def build(st, now, ow):
    update_live(st, now)
    update_history(st, now)
    update_sessions(ow, now)
    update_mentions(ow)

    waiting = waiting_jobs(st, now)
    ids = {j[0] for j in waiting}
    reasons = st["waitReason"]
    for job in [j for j in reasons if j not in ids]:
        del reasons[job]

    # Wait causes: the last wait line of each waiting job.
    kinds, example = {}, {}
    for job, *_ in waiting:
        kind, text = reasons.get(job, ["not seen yet", ""])[:2]
        kinds[kind] = kinds.get(kind, 0) + 1
        example.setdefault(kind, text)
    causes = sorted(
        ({"kind": k, "count": n, "example": example.get(k, "")[:160]} for k, n in kinds.items()),
        key=lambda c: -c["count"],
    )

    # Queue length samples, for the trend.
    level = machine_level()
    samples = st.setdefault("samples", [])
    if not samples or now - samples[-1][0] >= SAMPLE_EVERY_S:
        samples.append([now, len(waiting), level.get("level", "")])
    st["samples"] = [s for s in samples if s[0] > now - KEEP_S]
    past = [s for s in st["samples"] if s[0] <= now - TREND_S]
    trend = len(waiting) - past[-1][1] if past else None

    hour_starts = [s for s in st["starts"] if s[0] > now - HOUR]
    hour_done = [d for d in st["finished"] if d[0] > now - HOUR]
    waits = [s[2] for s in hour_starts]
    finished = {}
    for d in hour_done:
        finished[d[4]] = finished.get(d[4], 0) + 1
    arrived = {s[1] for s in st["starts"] if int(s[1].split("-")[0]) / 1e9 > now - HOUR}
    arrived |= {j[0] for j in waiting if j[1] > now - HOUR}

    running = running_builds(st, now)
    conf = read_conf()

    # Queue order: the rank of each job's last wait line, then priority and age as heavy-build
    # orders them, for jobs it has not ranked yet.
    prank = {"high": 0, "critical": 1, "normal": 2, "low": 3}

    def order(j):
        r = reasons.get(j[0], [None, None, 0])
        rank = r[2] if len(r) > 2 and r[2] else 10**6
        return (rank, prank.get(j[2], 2), j[1])

    queue = sorted(waiting, key=order)
    pos = {j[0]: i + 1 for i, j in enumerate(queue)}

    def cause(job):
        return reasons.get(job, ["not seen yet"])[0]

    # Per project: waiting now, started and finished in the last hour, and its jobs for the tree.
    proj = {}

    def row(name):
        name = name or "(none)"
        return proj.setdefault(name, {"name": name, "waiting": 0, "running": 0, "started": 0, "finished": 0, "failed": 0, "jobs": []})

    for b in running:
        r = row(b["project"])
        r["running"] += 1
        r["jobs"].append({"state": "running", "cls": b["cls"], "prio": b["prio"], "age": b["runtime"], "session": b["session"], "agent": b["agent"]})
    for j in queue:
        r = row(j[5])
        r["waiting"] += 1
        if len(r["jobs"]) < LANE_JOBS:
            r["jobs"].append({"state": "waiting", "cls": j[4], "prio": j[2], "age": int(now - j[1]), "pos": pos[j[0]], "cause": cause(j[0]), "session": j[7], "agent": j[8]})
    for s in hour_starts:
        row(s[3])["started"] += 1
    for d in sorted(hour_done, key=lambda d: -d[0]):
        r = row(st["projectOf"].get(d[2], [""])[0])
        r["finished"] += 1
        if d[4] == "fail":
            r["failed"] += 1
        if len(r["jobs"]) < LANE_JOBS:
            r["jobs"].append({"state": "ok" if d[4] == "ok" else "failed", "cls": d[1], "end": d[0], "session": "", "agent": ""})

    # One sample a minute of each lane's waiting count, for its sparkline.
    lanes = st.setdefault("laneSamples", [])
    if not lanes or now - lanes[-1][0] >= LANE_SAMPLE_S:
        lanes.append([now, {n: r["waiting"] for n, r in proj.items() if r["waiting"]}])
    st["laneSamples"] = lanes = [x for x in lanes if x[0] > now - HOUR]
    # The owner heavy-build recorded for a worktree's jobs, where it recorded one.
    recorded = {}
    for b in running:
        if b["owner"]:
            recorded.setdefault(b["project"], b["owner"])
    for j in queue:
        if j[9]:
            recorded.setdefault(j[5], j[9])
    rules = lane_rules()
    for n, r in proj.items():
        r["spark"] = [x[1].get(n, 0) for x in lanes]
        r["owner"], r["ownerHow"], r["ownerLive"] = owner_of(ow, n, recorded.get(n, ""))
    # A worktree with no clear owner takes the owner of its siblings (ffnew-x for ffnew-*),
    # when all the siblings with a clear owner agree on one.
    sure = ("recorded", "folder", "mentions")
    for n, r in proj.items():
        if r["ownerHow"] in sure or "-" not in n:
            continue
        prefix = n.split("-", 1)[0] + "-"
        found = {(x["owner"], x["ownerLive"]) for m, x in proj.items() if m != n and m.startswith(prefix) and x["ownerHow"] in sure}
        if len(found) == 1:
            (r["owner"], r["ownerLive"]), = found
            r["ownerHow"] = "siblings"
    for n, r in proj.items():
        r["prio"] = lane_prio(rules, n, r["owner"])
    projects = sorted(proj.values(), key=lambda r: (-r["waiting"], -r["running"], -r["started"] - r["finished"], r["name"]))

    def owner(project, rec=""):
        r = proj.get(project or "(none)")
        if r and not rec:
            return {"owner": r["owner"], "ownerHow": r["ownerHow"], "ownerLive": r["ownerLive"]}
        name, how, live = owner_of(ow, project, rec)
        return {"owner": name, "ownerHow": how, "ownerLive": live}

    nxt = [
        {"project": j[5] or "(none)", "cls": j[4], "prio": j[2], "waited": int(now - j[1]), "est": j[6], "cause": cause(j[0]), **owner(j[5], j[9])}
        for j in queue[:NEXT_SHOWN]
    ]
    # Every job in the order heavy-build runs it: the running ones, then the queue.
    queue_rows = [
        {"state": "running", "project": b["project"] or "(none)", "cls": b["cls"], "prio": b["prio"], "age": b["runtime"], **owner(b["project"], b["owner"])}
        for b in running
    ] + [
        {"state": "waiting", "pos": pos[j[0]], "project": j[5] or "(none)", "cls": j[4], "prio": j[2], "age": int(now - j[1]), "cause": cause(j[0]), **owner(j[5], j[9])}
        for j in queue[:QUEUE_SHOWN]
    ]
    gate = {
        "state": {"pause": "paused", "slow": "slowed", "normal": "open"}.get(level.get("level", ""), "unknown"),
        "since": int(level["since"]) if level.get("since", "").isdigit() else 0,
        "reason": level.get("reason", ""),
    }

    def as_int(key):
        try:
            return int(conf.get(key, ""))
        except ValueError:
            return 0

    prios = {}
    for j in waiting:
        prios[j[2]] = prios.get(j[2], 0) + 1

    return {
        "updated": int(now * 1000),
        "error": "",
        "running": running,
        "gate": gate,
        "slots": {
            "jobs": as_int("HEAVY_BUILD_MAX_JOBS"),
            "appRuns": as_int("HEAVY_BUILD_MAX_APP_RUNS"),
            "appRunsUsed": sum(1 for b in running if b["cls"] == "app-run"),
        },
        "next": nxt,
        "history": [[int(s[0]), s[1], s[2] if len(s) > 2 else ""] for s in st["samples"] if s[0] > now - HOUR],
        "prioTool": on_path("heavy-build-prio"),
        "waiting": {
            "count": len(waiting),
            "oldest": int(now - min((j[1] for j in waiting), default=now)),
            "memGib": round(sum(j[3] for j in waiting), 1),
            "prios": prios,
            "causes": causes,
        },
        "velocity": {
            "finished": finished,
            "started": len(hour_starts),
            "arrived": len(arrived),
            "waitMedian": median(waits) if waits else None,
            "waitP90": pct(waits, 0.9),
            "trend": trend,
            "trendMinutes": TREND_S // 60,
        },
        "projects": group_by_owner(projects, rules),
        "queue": queue_rows,
        "limits": limits(conf),
        "theme": theme(st, now),
    }


def run_once(st, ow):
    now = time.time()
    try:
        return build(st, now, ow), True
    except Exception as exc:  # the widget shows the error and keeps its last data
        return {"updated": int(now * 1000), "error": f"{type(exc).__name__}: {exc}"}, False


def serve(path, every):
    """Rewrite path every `every` seconds. Saves the cursors once a minute and on exit."""
    import signal

    out = pathlib.Path(path)
    tmp = out.with_name(out.name + ".tmp")
    parent = os.getppid()
    st = load_state()
    ow = load_owners()
    saved = 0.0
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        while os.getppid() == parent:
            start = time.time()
            result, ok = run_once(st, ow)
            tmp.write_text(json.dumps(result, separators=(",", ":")))
            tmp.replace(out)
            if ok and start - saved >= 60:
                save_state(st)
                save_owners(ow)
                saved = start
            time.sleep(max(0.5, every - (time.time() - start)))
    finally:
        save_state(st)
        save_owners(ow)


def main():
    if len(sys.argv) >= 3 and sys.argv[1] == "--serve":
        serve(sys.argv[2], float(sys.argv[3]) if len(sys.argv) > 3 else 5.0)
        return
    st = load_state()
    ow = load_owners()
    result, ok = run_once(st, ow)
    if ok:
        save_state(st)
        save_owners(ow)
    json.dump(result, sys.stdout, separators=(",", ":"))


if __name__ == "__main__":
    main()
