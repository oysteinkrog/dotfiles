#!/bin/bash
# Keep the themed Star Nest wallpaper shader in step with the Plasma colour scheme.
#
# The live shader is ~/.local/share/shader-wallpaper/Star_Nest_Themed.frag. On the
# first run it is copied from the template in ~/.dotfiles/misc/shader-wallpaper.
# After that only the lines tagged @theme(Group.Key) change: each gets the RGB
# value of [Colors:Group] Key from the Plasma style's colours (plasma-style-colours:
# the style's own colors file, or kdeglobals for styles without one, such as
# Breeze). Every other line, including values
# saved from the plugin's Shader Tweaks panel, is left alone. Setting
# followTheme = false in the shader turns the sync off.
#
# The login screen (Plasma Login Manager) runs as the plasmalogin user and cannot
# read the home folder, so the shader is also copied to $GREETER_COPY when that
# directory exists and is writable (see setup/steps/60-desktop.sh).
#
# Run by shader-wallpaper-theme-sync.path whenever kdeglobals, plasmarc or the
# shader changes. The wallpaper plugin reloads the file itself when watchSourceFile is on.

set -euo pipefail

TEMPLATE="$HOME/.dotfiles/misc/shader-wallpaper/Star_Nest_Themed.frag"
SHADER="$HOME/.local/share/shader-wallpaper/Star_Nest_Themed.frag"
GREETER_COPY=/var/lib/shader-wallpaper/Star_Nest_Themed.frag

copy_for_greeter() {
    local dir; dir=$(dirname "$GREETER_COPY")
    [ -d "$dir" ] && [ -w "$dir" ] || return 0
    cmp -s "$SHADER" "$GREETER_COPY" && return 0
    local t; t=$(mktemp "$GREETER_COPY.XXXXXX")
    cp "$SHADER" "$t" && chmod 644 "$t" && mv "$t" "$GREETER_COPY"
}

if [ ! -f "$SHADER" ]; then
    mkdir -p "$(dirname "$SHADER")"
    cp "$TEMPLATE" "$SHADER"
fi

if grep -qE '^\s*const\s+bool\s+followTheme\s*=\s*false\s*;' "$SHADER"; then
    copy_for_greeter
    exit 0
fi

COLOURS=$("$HOME/bin/plasma-style-colours")

tmp=$(mktemp "$SHADER.XXXXXX")
trap 'rm -f "$tmp"' EXIT

while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line =~ @theme\(([A-Za-z]+)\.([A-Za-z]+)\) ]]; then
        rgb=$(kreadconfig6 --file "$COLOURS" --group "Colors:${BASH_REMATCH[1]}" --key "${BASH_REMATCH[2]}")
        if [[ $rgb =~ ^([0-9]+),([0-9]+),([0-9]+) ]]; then
            vec=$(awk -v r="${BASH_REMATCH[1]}" -v g="${BASH_REMATCH[2]}" -v b="${BASH_REMATCH[3]}" \
                'BEGIN { printf "vec3(%.3f, %.3f, %.3f)", r/255, g/255, b/255 }')
            line=$(sed -E "s/vec3\([^)]*\)/$vec/" <<<"$line")
        fi
    fi
    printf '%s\n' "$line"
done <"$SHADER" >"$tmp"

# Leave the file untouched when nothing changed, so the plugin does not reload.
if ! cmp -s "$tmp" "$SHADER"; then
    mv "$tmp" "$SHADER"
    trap - EXIT
fi
copy_for_greeter
