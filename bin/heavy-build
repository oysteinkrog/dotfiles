#!/usr/bin/env bash
# heavy-build: run a heavy build or test in one of 3 build slots, in a
# memory-capped systemd scope, after memory and free-space checks.
#
# Usage: heavy-build <cmd> [args...]
#   heavy-build cargo test -p mux --lib
#   heavy-build dotnet build Foo.sln
#   heavy-build localbuild build frankenterm
#   heavy-build bash -c 'cd sub && cargo build && cargo test'
#
# What it does:
# - Waits for one of 3 build slots. Slot 0 is $XDG_RUNTIME_DIR/heavy-build.lock,
#   the lock of the older `flock ... systemd-run` rule, so a build started with
#   that rule counts as one slot. Slots 1 and 2 are heavy-build.lock.1 and .2.
# - Also waits until MemAvailable is at least HEAVY_BUILD_MIN_MEM_GIB
#   (default 20), checked again every HEAVY_BUILD_POLL seconds (default 5).
# - Counts a build scope left over from a killed heavy-build as a used slot.
# - Gives up after HEAVY_BUILD_WAIT seconds in total (default 7200) with exit
#   code 75. A wait can be long: run it in the background when your tool call
#   has a timeout.
# - Refuses when the filesystem of the current directory has less than
#   HEAVY_BUILD_REFUSE_GIB free (default 60). Exit code 75.
#   HEAVY_BUILD_FORCE=1 skips that check; it is for Oystein, not for agents.
# - Runs the command in a transient scope in builds.slice with the rule's
#   memory caps, so an OOM kills only the build, not frankenterm-mux.service.
#   The command never inherits the lock, so a daemon it leaves behind cannot
#   hold a slot. heavy-build holds the slot until the build exits.
# - Exits with the command's status. A signal death gives 128 + signal
#   (137 after an OOM kill). TERM, INT or HUP to heavy-build stop the build.
#
# Nesting: inside a build scope (heavy-build, or the old flock rule) it runs
# the command directly. Under a plain `flock heavy-build.lock` it takes no
# second slot but still makes a scope.
#
# It sets no target dir or build dir. ~/.cargo/config.toml sets
# build.build-dir; see ~/.claude/CLAUDE.md "Builds".
set -uo pipefail

if [[ $# -lt 1 || $1 == -h || $1 == --help ]]; then
  sed -n '2,/^set -uo/{/^set -uo/d;s/^# \{0,1\}//;p}' "${BASH_SOURCE[0]}" >&2
  [[ $# -ge 1 ]] && exit 0
  exit 2
fi

RUNDIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
LOCK=${HEAVY_BUILD_LOCK:-$RUNDIR/heavy-build.lock}
WAIT=${HEAVY_BUILD_WAIT:-7200}
REFUSE_GIB=${HEAVY_BUILD_REFUSE_GIB:-60}
MIN_MEM_GIB=${HEAVY_BUILD_MIN_MEM_GIB:-20}
POLL=${HEAVY_BUILD_POLL:-5}

build_env=(
  HEAVY_BUILD_ACTIVE=1
  CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-8}"
  CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-8}"
  MSBUILDDISABLENODEREUSE=1
  DOTNET_CLI_USE_MSBUILD_SERVER=0
)

say() { echo "heavy-build: $*" >&2; }

# Already inside a build scope: heavy-build in heavy-build, or the old rule.
if grep -qE '/builds\.slice/[^/]+\.scope$' /proc/self/cgroup 2>/dev/null; then
  exec env "${build_env[@]}" "$@"
fi

SLOTS=("$LOCK" "$LOCK.1" "$LOCK.2")

# True when a process above us holds one of the slot locks, for example
# `flock heavy-build.lock heavy-build ...`. Matches on inode only: on btrfs,
# stat's device number is the subvolume's, not the one /proc/locks prints.
ancestor_holds_lock() {
  local inos="" f ino holders pid p
  for f in "${SLOTS[@]}"; do
    ino=$(stat -c %i -- "$f" 2>/dev/null) && inos+=" $ino"
  done
  [[ -n $inos ]] || return 1
  holders=$(awk -v is="$inos" 'BEGIN {n = split(is, a, " "); for (k = 1; k <= n; k++) want[a[k]] = 1}
    $2 == "FLOCK" && $3 != "->" {split($6, d, ":"); if (d[3] in want) print $5}' /proc/locks 2>/dev/null)
  [[ -n $holders ]] || return 1
  pid=$PPID
  while [[ -n $pid && $pid -gt 1 ]]; do
    for p in $holders; do [[ $p == "$pid" ]] && return 0; done
    pid=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)
  done
  return 1
}

mem_avail_gib() { awk '/^MemAvailable:/ {print int($2 / 1048576); exit}' /proc/meminfo 2>/dev/null; }

# Build scopes whose heavy-build was killed (SIGKILL) run on without a slot.
# The unit name carries the heavy-build pid, so a dead pid marks an orphan.
orphan_scopes() {
  local u pid
  systemctl --user list-units --type=scope --state=active --plain --no-legend 'heavy-build-*.scope' 2>/dev/null \
    | awk '{print $1}' | while read -r u; do
        pid=${u#heavy-build-}; pid=${pid%%-*}
        [[ $pid =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null && echo "$u"
      done
}

# Number of slot locks nobody holds, not counting the one on fd 9.
other_free_slots() {
  local f n=0
  for f in "${SLOTS[@]}"; do
    [[ $f == "$held" ]] && continue
    if { exec 7>>"$f" && flock -n 7; } 2>/dev/null; then n=$(( n + 1 )); fi
    exec 7>&- 2>/dev/null
  done
  echo "$n"
}

# Take a free slot, new slots first, so builds still waiting with the old
# `flock heavy-build.lock` rule get slot 0 when it frees up.
try_slot() {
  local f
  for f in "$LOCK.2" "$LOCK.1" "$LOCK"; do
    exec 9>>"$f" || continue
    if flock -n 9; then held=$f; return 0; fi
    exec 9>&-
  done
  return 1
}

deadline=$(( SECONDS + WAIT ))
held=
if ancestor_holds_lock; then
  say "a parent process holds a build slot; not taking another"
else
  said=
  while :; do
    mem=$(mem_avail_gib)
    if [[ ! $mem =~ ^[0-9]+$ ]] || (( mem >= MIN_MEM_GIB )); then
      if try_slot; then
        orphans=$(orphan_scopes | wc -l)
        if (( orphans == 0 || orphans <= $(other_free_slots) )); then
          break
        fi
        exec 9>&-; held=
        why="a build whose heavy-build was killed is still running ($(orphan_scopes | tr '\n' ' '))"
      else
        why="all 3 build slots are in use"
      fi
    else
      why="only ${mem} GiB of memory is available; a build starts at ${MIN_MEM_GIB} GiB"
    fi
    if (( SECONDS >= deadline )); then
      say "gave up after ${WAIT}s: $why. Tell the manager session."
      exit 75
    fi
    if [[ ${why%% *} != "${said%% *}" ]]; then say "waiting: $why"; said=$why; fi
    sleep "$POLL"
  done
fi

avail=$(LC_ALL=C df -B1G --output=avail -- . 2>/dev/null | tail -1 | tr -d ' ')
if [[ $avail =~ ^[0-9]+$ ]] && (( avail < REFUSE_GIB )) && [[ ${HEAVY_BUILD_FORCE:-0} != 1 ]]; then
  say "refused. $(df --output=target -- . | tail -1) has ${avail} GiB free; the limit is ${REFUSE_GIB} GiB."
  say "stop and tell the manager session. Do not delete other build output to make room."
  exit 75
fi

unit="heavy-build-$$-$RANDOM"
systemd-run --user --scope --quiet --collect --expand-environment=no \
  --unit="$unit" --slice=builds.slice \
  -p MemoryHigh=16G -p MemoryMax=18G -p MemorySwapMax=2G -p OOMPolicy=kill \
  env "${build_env[@]}" "$@" 0<&0 9>&- &
child=$!

stop_build() {
  kill "-$1" "$child" 2>/dev/null
  systemctl --user kill --signal="$1" "$unit.scope" 2>/dev/null
}
trap 'stop_build TERM' TERM HUP
trap 'stop_build INT' INT
while :; do
  wait "$child"
  rc=$?
  kill -0 "$child" 2>/dev/null || break
done
# Nothing from this build may run on once we drop the lock.
systemctl --user stop "$unit.scope" 2>/dev/null
exit "$rc"
