#!/usr/bin/env bash
# heavy-build: run a heavy build or test in a memory-capped systemd scope in
# builds.slice, once the build queue lets it start.
#
# Usage: heavy-build [--class app-run] [--ready-file PATH] [--wait-timeout S] [--] <cmd> [args...]
#   heavy-build cargo test -p mux --lib
#   heavy-build dotnet build Foo.sln
#   heavy-build localbuild build frankenterm
#   heavy-build bash -c 'cd sub && cargo test'
#   (one heavy command per call: cargo test builds what it needs, so do not
#   chain `cargo build && cargo test` in one heavy-build call)
#
# There are two admission rules. ~/.config/heavy-build.conf picks one with the
# line HEAVY_BUILD_MODE=shadow (the default) or HEAVY_BUILD_MODE=live. Only that
# file sets the mode. Waiters read it again on every poll.
#
# shadow mode: the old slot rule decides.
# - Up to 3 builds run at once, one per build slot. Slot 0 is
#   $XDG_RUNTIME_DIR/heavy-build.lock, the lock of the older `flock ...
#   systemd-run` rule, so a build started with that rule counts as one slot.
#   Slots 1 and 2 are heavy-build.lock.1 and .2.
# - Waiters form a first-come, first-served line. Only the first may start.
# - A build starts when MemAvailable is at least HEAVY_BUILD_MIN_MEM_GIB
#   (default 12), or HEAVY_BUILD_SOLO_MEM_GIB (default 8) when no build runs.
# - A build scope left over from a killed heavy-build counts as a used slot.
# - The budget rule below runs beside it and only logs what it would decide,
#   to ~/.local/state/heavy-build/shadow.log. One line each time its decision
#   changes, and one when the old rule starts the build. Fields: time, job,
#   decision (start or wait), reason, actual (what the old rule did), and
#   would_start_for (seconds the budget rule had already said start).
#
# live mode: the budget rule decides. A waiting build may start when:
# - fewer than HEAVY_BUILD_MAX_JOBS builds run (default 6);
# - the cores in use plus its own estimate are at most HEAVY_BUILD_CPU_BUDGET
#   (default 28). With HEAVY_BUILD_REAL_USE=1 (the default since 2026-10-22),
#   cores in use is what builds.slice used over the last 30 to 120 s
#   (HEAVY_BUILD_SLICE_CPU_SECS, default 30, sampled by every waiter into
#   $XDG_RUNTIME_DIR/heavy-build.cpu/builds.slice.samples) plus, for each
#   build in its first 2 min, its estimate minus the cores it already used
#   inside that window (its 60 s average times the share of the window it
#   has run, floored at 0), so its CPU is not counted twice. A build with no
#   60 s figure yet adds its full estimate. Until 2026-10-23 every young
#   build added its full estimate. Until enough samples exist,
#   and with HEAVY_BUILD_REAL_USE=0, it is the old charge: a running build is
#   charged its estimate for 2 min, then what it used over the last 60 s;
# - CPU pressure (some avg10) is at most HEAVY_BUILD_MAX_CPU_PSI percent
#   (default 75), and has stayed at or under it for HEAVY_BUILD_CPU_PSI_SECS
#   seconds (default 30), as sampled by waiters and running builds. Only
#   checked for builds estimated at 2 cores or more. The default was 40, and
#   60 in heavy-build.conf from 2026-10-08; on 2026-10-20 it went to 75,
#   because one 12-core Wine test pushes CPU pressure over 60% while cores
#   are still free;
# - MemAvailable, minus the memory running builds are still expected to take,
#   minus its own estimate, leaves HEAVY_BUILD_MEM_RESERVE_GIB (default 8).
#   A running build is expected to take HEAVY_BUILD_TC_PCT percent (default
#   50) of its estimate, minus what it holds now. A scope in builds.slice with
#   no heavy-build state file is expected to take 2 GiB more than it holds now,
#   and its unit name is logged as untracked=unit:GiB. When such a scope used
#   under 0.05 cores over the last 2 min, it is logged as unit:GiB:idle and
#   is not counted as a running build, for the job limit or for cores.
#   Swap headroom: while system memory pressure (/proc/pressure/memory, some
#   avg10 and avg60) is under 1.0%, HEAVY_BUILD_SWAP_HEADROOM_PCT percent
#   (default 25) of SwapFree, at most HEAVY_BUILD_SWAP_HEADROOM_GIB (default
#   8), counts as available here and in the critical-first check, and the
#   reason says "+<GiB> swap headroom". It is never added when the pressure is
#   higher or cannot be read, and not for the first build (the solo rule).
#   The swap room and pressure gates below still apply. On the night to
#   2026-10-20 builds waited 3004 times for memory with memory pressure near
#   0 and about 64 GiB of zram swap free. Either setting at 0 turns it off;
# - the memory builds hold plus its estimate fits under the builds.slice cap.
#   With HEAVY_BUILD_REAL_USE=1, builds hold what builds.slice uses now
#   (memory.current) plus, for each young build, HEAVY_BUILD_YOUNG_GROW_PCT
#   percent (default 50; 100 before 2026-10-23) of its estimate minus what it
#   holds now. A replay of 2026-10-23 10:16 to 14:28 with that, the
#   young-CPU rule above, HEAVY_BUILD_TC_PCT=25 and a 40G builds.slice
#   MemoryHigh gave a mean wait of 6.4 min against 13.7 for the same starts
#   (/var/tmp/claude/hb-tune/sim.py). A build is young until it has run HEAVY_BUILD_YOUNG_MIN_SECS
#   (default 120) or HEAVY_BUILD_YOUNG_PCT percent (default 70) of its
#   expected wall time, whichever is longer, so a build that peaks late (a
#   link step) stays charged its estimate for most of its run. With
#   HEAVY_BUILD_REAL_USE=0, or when memory.current cannot be read, builds hold
#   the larger of their estimate and their current memory, as before
#   2026-10-22, when this rule kept builds waiting with 28.2 GiB charged and
#   19.3 GiB really in use. A replay of 2026-10-22 09:06 to 16:00, with the
#   reserve cut from 6 to 5 GiB, gave 450 starts against 409 and a mean wait
#   of 23 min against 29; the lowest projected MemAvailable was 6.4 GiB
#   against 6.3 (late-peak memory model, /var/tmp/claude/hb-replay/replay.py).
#   With HEAVY_BUILD_SLICE_EXCLUDE_INACTIVE_FILE=1 (the default) the
#   inactive_file line of builds.slice memory.stat is taken off memory.current
#   (never below 0), since the kernel can drop that page cache at once; the
#   wait reason says how much was left out. Set it to 0 to count
#   memory.current as it is.
#   The cap is the lower of builds.slice memory.max (MemoryMax) and
#   memory.high (MemoryHigh); "max" means no limit. Both files are read again
#   on every decision, so a `systemctl --user set-property builds.slice
#   MemoryHigh=...` applies at once. Each live.log decision line has
#   cap=<GiB>G(max|high), or cap=none when neither is set;
# - claude.slice and session.slice memory pressure (full avg10) are each
#   under HEAVY_BUILD_MAX_MEM_PSI percent (default 5). app.slice is not read:
#   on 2026-10-21 one Chrome unit at its own MemoryHigh made app.slice
#   look stressed and blocked every build for hours. Until 2026-10-22 this
#   gate read some avg10 of claude.slice and app.slice;
# - the pressure level allows it (see "Pressure level" below);
# - no running build holds one of its lock keys.
# When no build runs, a build starts once MemAvailable is at least
# HEAVY_BUILD_SOLO_MEM_GIB, whatever its estimate (the builds.slice cap does
# not apply), so one big build is never blocked forever. At pressure level
# slow or pause that shortcut is off: the first build needs every test above
# too. Order is priority, then
# arrival. A build whose lock key is busy is skipped and keeps its place.
# Writer preference: no build with a tree:<top>#<suffix> key that is behind
# the first waiter with the plain key tree:<top> in order starts until the
# plain one has started (reason writer:). Suffixed builds ahead of it in
# order, and suffixed builds already running, go on as usual; the plain build
# waits only for the running ones. Builds in other trees are not affected.
# Aged critical builds: a critical build that has waited
# HEAVY_BUILD_CRIT_AGE_SECS (default 1800, 0 turns it off) ranks ahead of high
# builds, the oldest first. Once it has also waited HEAVY_BUILD_STARVE seconds
# and is first in order without fitting, the starve rule holds every build
# behind it, high builds too, so the cores and job slots it needs come free.
# One exception: while that aged critical head waits for memory (memory or
# slice-cap), other critical builds that fit may pass it. On 2026-10-23 a
# steady stream of high builds (95 starts in 2.5 h) kept 11 critical builds
# waiting for over 2.5 h.
# Aging slot: a normal or low build that has waited HEAVY_BUILD_AGE_SECS
# (default 3600) goes ahead of other normal and low builds, the oldest first,
# while fewer than HEAVY_BUILD_AGE_SLOTS (default 1) builds let in this way
# still run. It ranks after high and critical builds and before normal ones.
# When it is first in order and does not fit, the starve rule does not apply
# to it and builds that fit may pass it, so it takes only the first slot it
# fits into. Normal and low builds still follow the backfill rule. Every
# memory, swap, CPU pressure, disk and lock key check still applies. Its start
# is logged with aged=1. HEAVY_BUILD_AGE_SLOTS=0 turns it off.
# When the first build in order does not fit, a later one may start if it fits
# now and should end before the first one could start. That stops once the
# first one has waited HEAVY_BUILD_STARVE seconds (default 1800).
# Starve fix (HEAVY_BUILD_STARVE_FIX, default 1; 0 restores the old rule):
# - An aged head keeps the starve rule. Before, a normal build that reached
#   HEAVY_BUILD_AGE_SECS lost it, and builds behind it backfilled again. On
#   2026-10-25 a 22 GiB cargo test lost it at 60 min, one minute before the
#   last running build ended, and backfills kept it out for 35 more minutes.
# - A starving head counts no untracked scope (a builds.slice scope without a
#   heavy-build) when it asks whether any build runs, so the
#   HEAVY_BUILD_SOLO_MEM_GIB shortcut still lets it in. Untracked scopes
#   still count for every other check.
# - The queue never holds an empty machine: when no tracked build runs and
#   the head still does not fit (pressure level slow or pause, or less than
#   HEAVY_BUILD_SOLO_MEM_GIB free), builds behind it that fit may start.
# - A head that fits only when no other build runs says so in its waiting
#   line, with a hint to lower its memory use.
# Starve bound (HEAVY_BUILD_STARVE_BOUND, default 1; 0 turns it off): a
# starving head that waits for memory holds back only builds whose end can
# let it in. Untracked scopes count as staying. If by the current numbers it
# would not fit even if every build ended (memory outside builds.slice too
# low, pressure level slow or pause, or the builds.slice cap), it holds back
# nothing. If it would fit only once the running app runs have ended too, it
# holds back new app runs and nothing else.
# Its waiting line says which, and asks the submitter to shrink it. The
# give-up clock still runs, so such a build ends with exit 75 after
# HEAVY_BUILD_WAIT seconds unless memory frees up first.
# Memory controller (HEAVY_BUILD_MEM_CONTROLLER, default 0; 1 turns it on):
# replaces the reserve rule for memory with a rule that keeps RAM nearly full
# and holds builds only on signs of harmful swapping. Design and replay:
# /var/tmp/claude/hb-fullmem/PROPOSAL.md (2026-10-26). While it is on:
# - A build may start when MemAvailable, minus what young builds are still
#   expected to take, minus HEAVY_BUILD_MC_STEP_PCT percent (default 50) of
#   its own estimate, leaves HEAVY_BUILD_MC_TARGET_GIB (default 6), and
#   MemAvailable is at least HEAVY_BUILD_MC_HARD_GIB (default 3). A young
#   build (as for the real-use rule: under max(YOUNG_MIN_SECS, YOUNG_PCT % of
#   its expected wall time) old) is expected to take its full estimate minus
#   what it holds in its first HEAVY_BUILD_MC_NEW_FULL_SECS (default 60), then
#   HEAVY_BUILD_TC_PCT percent of it minus what it holds. Older builds are
#   expected to take nothing more. Untracked scopes keep their 2 GiB. The
#   critical-first reserve uses the same "still to come".
# - Brake: a normal or low build waits ("pressure: memory controller brake")
#   while, in a sample of the last HEAVY_BUILD_MC_CALM_SECS (default 60),
#   MemAvailable was under HEAVY_BUILD_MC_BRAKE_GIB (default 10) and disk
#   swap-in was at least HEAVY_BUILD_MC_BRAKE_SWAPIN pages/s (default 2000)
#   or memory full avg10 at least HEAVY_BUILD_MC_BRAKE_FULL_PCT (default 10).
#   Above 10 GiB free the swap-in comes from sessions paging back in, which
#   holding builds does not fix (2026-10-26 08:40 to 09:40).
# - No normal or low build starts while MemAvailable fell more than
#   HEAVY_BUILD_MC_FALL_GIB (default 2) in the last 15 s.
# - Pace: one normal or low start per 15 s above 16 GiB free, per 30 s from
#   10 to 16 GiB, per 60 s under 10 GiB. This takes the place of the slow
#   level's gap; the pause level still holds normal and low builds.
# - Samples ("epoch pswpin MemAvailable_kB harm") live in
#   $XDG_RUNTIME_DIR/heavy-build.cpu/mem.samples, shared by every waiter.
# Pressure level: pressure-coordinator.service writes
# ~/.local/state/pressure/level ("level=normal|slow|pause ... updated=<epoch>
# reason=...") every 5 s, and at pause also
# $XDG_RUNTIME_DIR/heavy-build.hold.pressure ("expires=<epoch> <reason>").
# - pause (the pressure hold is in force, or the level file says pause): only
#   high and critical builds may start, and only through the full memory test
#   (estimate plus reserve, and the builds.slice cap, even for the first
#   build) with no swap headroom. Normal and low builds wait with reason
#   "pressure: ...", and take no writer preference.
# - slow: a normal or low build may start only when no normal or low build
#   started in the last HEAVY_BUILD_SLOW_FAST_GAP_SECS (30 s) while
#   MemAvailable is above HEAVY_BUILD_SLOW_FAST_MIN_GIB (16 GiB), or in the
#   last HEAVY_BUILD_SLOW_GAP_SECS (120 s) at or below it. Until 2026-10-22 the
#   gap was always 120 s, and with the level flicking between normal, slow
#   and pause it held 39 builds back with 23 GiB free. The time of the last such
#   start is kept in $XDG_RUNTIME_DIR/heavy-build.last-normal-start, so a
#   build that ended quickly still counts. No swap headroom for anyone, and
#   the first build gets the full memory test too. High and critical builds
#   are not held.
# - normal: no change.
# - A level file whose updated= is more than HEAVY_BUILD_PRESSURE_STALE_SECS
#   old (default 30) counts as slow until it is
#   HEAVY_BUILD_PRESSURE_STALE_SLOW_SECS old (default 600). Older than that,
#   with updated= in the future, or missing, it is ignored (level stale or
#   none). A pressure hold counts only with an expires= that has not come and
#   is at most 600 s away; an empty or malformed one is ignored. The
#   manager's heavy-build.hold is a different file.
# Running builds are never stopped. While the level holds a build back, its
# give-up clock does not run, even when another gate (swap, interactive) is
# the reason shown. Each decision line in live.log has pressure=<level>.
# HEAVY_BUILD_PRESSURE=0 turns the level off.
# Decisions are logged to ~/.local/state/heavy-build/live.log.
# The live settings above can also be set in ~/.config/heavy-build.conf as
# KEY=VALUE lines. The environment wins over the file.
#
# Both modes:
# - Stops first while $XDG_RUNTIME_DIR/heavy-build.hold exists (the manager
#   session's pause switch; its text is the reason). An optional line
#   expires=<unix epoch seconds> (a line of its own, or the start of the first
#   line, like "expires=1791990000 cargo cache rebuild") ends the hold at that
#   time even when the file stays: builds then go on as if it were gone, and
#   each waiting heavy-build logs event=hold-expired ("hold expired") once.
#   Example for 18 min: echo "expires=$(( $(date +%s) + 1080 )) <reason>" >
#   $XDG_RUNTIME_DIR/heavy-build.hold. A hold without such a line lasts until
#   the file is removed.
# - Critical-first switch (the manager session's kpp priority switch; only the
#   live rule uses it): while $XDG_RUNTIME_DIR/heavy-build.critical-first
#   exists, a normal or low build (aged ones too) may start only when
#   (a) fewer than noncrit_slots normal or low builds run (default 1; a scope
#   in builds.slice without a live heavy-build counts as one unless idle), and
#   (b) MemAvailable, minus the memory running builds are still expected to
#   take, minus its own estimate, leaves reserve_gib GiB (default 12, so a
#   headless MotionCatalyst lane can launch). Every normal check still
#   applies. High and critical builds are not affected, and running builds
#   are never stopped. Such a wait is logged as decision=wait
#   reason="critical-first: ..." and, like the hold, does not run the give-up
#   clock. While the switch is on, a normal or low build's wait for memory
#   (reason "memory: ...") does not run the clock either. Optional lines, each on its own line: noncrit_slots=<N>,
#   reserve_gib=<G>, and expires=<unix epoch seconds> as for the hold (logged
#   once as event=critical-first-expired). It lives in /run, so a reboot
#   clears it. Example for 4 h:
#   printf 'kpp sprint\nexpires=%s\nnoncrit_slots=1\nreserve_gib=12\n' \
#   "$(( $(date +%s) + 14400 ))" > $XDG_RUNTIME_DIR/heavy-build.critical-first
# - Waits while swap room (90% of SwapTotal minus swap used) is under HEAVY_BUILD_MIN_SWAP_ROOM_GIB (default 10).
# - Estimates each build's memory, cores and wall time. Memory is the largest
#   of: the highest peak in the last 10 runs of the same command in the same
#   directory, the p90 peak of the last 50 runs of its class (cargo test,
#   dotnet build, Wine run-tests and so on), and the class floor, at most
#   22 GiB. A dotnet build, test or msbuild of a whole .sln or .slnx (named,
#   or picked by MSBuild from the directory) has class dotnet-build-sln and
#   gets 16 GiB until that class has 5 runs. An OOM-killed run counts with a peak of at least its MemoryMax
#   (column 9), else 1.25 times its peak. A run whose peak reached 98% of its
#   scope's MemoryHigh (column 10, else column 9 minus 2 GiB) was held at the
#   cap, so its real need is unknown: it counts with a peak of at least 1.25
#   times that MemoryHigh, and is logged as event=capped when it ends. On
#   2026-10-20 a dotnet build estimated at 6.6 GiB sat at its 16 GiB cap and
#   left the machine 1 GiB. A Wine test run with --filter or --filter-for
#   is estimated from the runs of the same tests instead (same projects,
#   flags and filters, from any tree or lane; history column 12) in the last
#   14 days: their p90 peak once there are 5, else the class percentile
#   HEAVY_BUILD_WINE_FALLBACK_PCT (default 75 since 2026-10-22; it was 90
#   from 2026-10-21, and 75 before). The class
#   floor holds, except that 10 or more runs may go down to 4 GiB. A run
#   without a filter keeps the rule above. Own history (since 2026-10-23,
#   HEAVY_BUILD_OWN_EST=1): when the command has 2 or more runs with a peak
#   and the class p90, class percentile or class floor decided, its estimate
#   is 1.2 times its own highest peak of the last 10 runs (at least 1 GiB),
#   if that is lower; live.log shows mem=key-own. Set it to 0 to turn this
#   off. See estimate(). Cores and wall
#   time come from the
#   last 5 runs of the same command, then from the class, then 8 cores and
#   600 s. History: ~/.local/state/heavy-build/history.tsv,
#   one line per finished build, tab separated, with no header line. Columns:
#   1 end time (epoch s), 2 class, 3 key (hash of directory and command),
#   4 wall time in seconds (not the exit code), 5 CPU seconds, 6 peak memory
#   bytes, 7 exit code, 8 reason: ok, fail, cancelled (heavy-build got TERM,
#   INT or HUP), timeout (exit 124), oom (the scope's memory.events shows an
#   oom_kill) or stopped (an app run whose command died from a signal, or
#   that heavy-build stopped on TERM, INT or HUP), 9 the scope's MemoryMax in bytes, 10 the scope's MemoryHigh in
#   bytes, 11 the tree state when the build started (see the rerun guard),
#   12 the Wine test sig (see wine_sig; - for other classes), 13 the
#   non-file peak in bytes (see sample_scope; NA when memory.stat could not
#   be read). Lines before the non-file change (2026-10-25) have no column 13.
#   14 who submitted it, as <session>/<agent> ("-" for either one not known;
#   see "Who submitted a job"). Older lines have no column 14.
#   Lines written before 2026-10-09 have no column 8, lines before
#   2026-10-16 no column 9, lines before 2026-10-20 no column 10 or 11, and
#   lines before the sig change (2026-10-20 afternoon) no column 12.
# - Sweeps stale scopes when a build asks to start: a heavy-build scope whose
#   heavy-build is gone is stopped only when it holds nothing but Wine
#   leftovers (winedevice.exe, wineserver, services.exe and the like). Each
#   sweep is logged as event=sweep with the unit and its processes. A scope
#   with any other process is never stopped, however idle it looks (until
#   2026-10-22 one under 0.05 cores for 2 min was stopped): it is logged once
#   as event=sweep-skip. A scope whose heavy-build still runs is never swept.
# - Lock keys: cargo:<workspace root> for cargo commands, tree:<git toplevel>
#   for dotnet and Wine commands, and wine:<prefix> for Wine runs that would
#   share one prefix and so one wineserver (the DESKTOP-14957 guard). The guard
#   never sets WINEPREFIX. HEAVY_BUILD_KEY=none turns lock keys off.
#   For tools/wine/run-tests.sh the wine: key follows the prefix the script
#   will use, read from that tree's own run-tests.sh. A script with its own
#   prefix per worktree (motioncatalyst-tests-<tree><AgentOutputSuffix>) gets
#   no wine: key when it will use that prefix: WINEPREFIX is unset, or names
#   the shared prefix and the script ignores it (MC_TESTS_SHARED_PREFIX guard,
#   PR #13900) and MC_TESTS_SHARED_PREFIX is not 1. The tree: key stays. An
#   older script without the per-worktree prefix keeps the old keys.
#   A dotnet or Wine build with AgentOutputSuffix=<s> (in its environment, or
#   in its args as AgentOutputSuffix=, -p: or /p:) gets tree:<top>#<s>, and
#   build.sh and build.cmd also get tree:<top>#buildcli (BuildCli's output has
#   no suffix). Two different suffixes run side by side. The same suffix twice,
#   or the plain tree:<top> next to any suffix, still waits. The split happens
#   only when the tree has the suffix blocks (apps/online/src/web/client/
#   Directory.Build.props names AgentOutputSuffix). Without them the key stays
#   plain and live.log gets locksplit=off reason=no-blocks.
# - HEAVY_BUILD_PRIORITY=high|normal|low (default normal). Agents may set high
#   ONLY for a P0 bug or for the last local check before a PR, and must give
#   the reason in HEAVY_BUILD_REASON. At most 2 high builds run at once. A
#   high build that waits only for this cap keeps its place but is never the
#   head of the line, so it cannot hold up other builds through the starve or
#   backfill rule (on 2026-10-23 it did: one high waiter blocked 37 builds for
#   40 min while the machine sat idle). A low
#   build counts as normal after 30 min of waiting. Only live mode uses it.
#   When HEAVY_BUILD_PRIORITY is unset, the default comes from the sessions in
#   ~/.config/machine/sessions.toml:
#   - critical when the calling Claude session is critical (asked with
#     `machine-session class --pid`), or when the current directory or a lock
#     key's directory is in a grove lane that belongs to a critical session:
#     the lane is critical in [lanes], its grove registry owner is a critical
#     session, or a live critical session works in it. Order is high, then
#     critical, then normal, then low, with two age rules: a critical build
#     that has waited HEAVY_BUILD_CRIT_AGE_SECS (default 1800) goes ahead of
#     high builds, and an aged normal or low build (the aging slot) goes ahead
#     of other normal builds but stays behind critical ones. A critical build
#     passes no safety gate:
#     memory, swap, interactive pressure, disk and lock keys all still apply.
#     While a critical build waits for job slots, cores or CPU pressure, no
#     normal or low build may start ahead of it (no backfill past it);
#   - low when the calling session is pausable.
#   HEAVY_BUILD_PRIORITY=critical cannot be set by hand.
# - Lane priority (HEAVY_BUILD_LANE_PRIO=1 in heavy-build.conf, default 0):
#   the manager sets priority per lane in ~/.config/heavy-build.lanes, one
#   rule per line, `<match> <high|normal|low> [by=<who>] [# note]`, first
#   match wins.
#   A match that starts with / or ~/ is a glob on the build's directories (the
#   current directory, its git top and the lock-key directories), for example
#   /var/tmp/claude/cass*. Any other match is a glob on the grove lane tag,
#   the lane's grove owner and the calling Claude session's name, for example
#   theme, release-* or hotfix-a. A rule lasts until it is removed
#   (heavy-build-prio set and clear write the file). Each waiter reads the
#   file on every poll and rewrites line 2 of its ticket when its priority
#   changes, so its place among the others changes too; live.log gets one
#   event=prio-change line. Order: critical from sessions.toml beats
#   everything, then the first matching rule, then HEAVY_BUILD_PRIORITY,
#   then the session default (low when pausable). A caller's own high with no
#   rule for it counts as normal: the manager owns priority. A bad line is
#   skipped with a warning. With the switch off, or with no lanes file or an
#   empty one, priority works as described above. A rule may carry
#   by=<who> after the priority (who set it: oystein, manager or an agent's
#   name); heavy-build ignores it and heavy-build-prio list shows it.
# - Who submitted a job: worked out once at submit, always. The Claude session
#   is, in this order: the session HEAVY_BUILD_SESSION_PID names, when live;
#   HEAVY_BUILD_SESSION when no pid is given and a live session has that
#   name; the first ancestor with a live
#   ~/.claude/sessions/PID.json; the session CLAUDE_PID names; the session in
#   the same claude scope. Ticket line 3 says which one as via=env-name,
#   env-pid, parent, claude-pid or scope (- for none). The SessionStart hook
#   heavy-build-session-env.py sets both HEAVY_BUILD_SESSION variables and
#   passes them through systemd-run, which otherwise starts a unit with none
#   of the caller's environment. The
#   agent is CLAUDE_AGENT_NAME or HEAVY_BUILD_AGENT, else "subagent" in a
#   Claude subagent's shell, else "-". It goes into ticket line 3, the end of
#   every live.log line (session= agent=) and history column 14.
# - Re-exec (HEAVY_BUILD_REEXEC=1, default 0): bash keeps the code a
#   heavy-build started with, so an install used to reach only new jobs (on
#   2026-10-26, 41 of 82 waiters ran rules from before that day's installs).
#   With this on, a waiter that has not started its build checks its own
#   script's inode and mtime on every poll. When they changed, it re-execs the
#   new script with the same arguments, environment and directory, as the same
#   process. The new code takes back the same ticket file (handed over in
#   HB_ADOPT_TICKET), so the build keeps its place in line, and its give-up
#   clock. live.log gets event=reexec. It re-execs at most once per script
#   version, and not at all when the new file fails `bash -n` or cannot adopt
#   a ticket (event=reexec-skip).
# - Estimate refresh (HEAVY_BUILD_EST_REFRESH=1, default 0): a waiter works
#   out its estimate again when a setting in heavy-build.conf changes, and
#   otherwise every HEAVY_BUILD_EST_REFRESH_SECS (default 600) seconds. When
#   it changes, ticket line 2 is rewritten and live.log gets one
#   event=est-change est_from= est_to= line.
# - Checks again every HEAVY_BUILD_POLL seconds (default 5).
# - Gives up after HEAVY_BUILD_WAIT seconds without progress (default 7200)
#   with exit code 75. The clock starts again each time the waiter moves up
#   in line. In live mode it does not run while the build waits only because
#   a higher-priority build is ahead of it (a critical build that goes first,
#   or a first build in order with a higher priority). In both modes it stays
#   at 0 while the hold is on, and starts from 0 when the hold lifts.
#   Nor does it run while the critical-first switch is on and a normal or
#   low build waits for memory or for the switch itself.
#   Otherwise it does run while the build is first in order, or waits for a
#   lock key, swap or interactive memory pressure. A wait can be long. Do not
#   run a build that can wait or take over 10 minutes in a Claude background
#   shell (run_in_background): Claude Code kills those when memory runs low,
#   and the build and its place in line are lost. Start it as a systemd user
#   unit instead and follow its journal:
#     systemd-run --user --unit=<name> --collect --same-dir heavy-build <cmd>
#     journalctl --user -u <name> -f
# - Every exit 75 (gave up, or low disk) is logged as decision=refuse.
# - Rerun guard: refuses at once, with exit code 76, when the same command in
#   the same directory (the history key) failed (reason fail) in each of its
#   last HEAVY_BUILD_RERUN_FAILS runs (default 2), all of them ended in the
#   last HEAVY_BUILD_RERUN_SECS seconds (default 1800), and its git tree has
#   not changed since the last failure. The tree state is the git HEAD of the
#   toplevel plus a hash of `git status --porcelain` and the size and mtime of
#   each path it lists, taken when the build starts (history column 11).
#   Outside git it is "-", and then time alone decides. When git status takes
#   over 5 s only HEAD counts. History lines without column 11 never cause a
#   refusal. A success, a cancel, a timeout or an OOM run in between ends the
#   run of failures. Logged as decision=rerun-refuse. HEAVY_BUILD_ALLOW_RERUN=1
#   skips the guard (logged as event=rerun-allowed);
#   HEAVY_BUILD_RERUN_FAILS=0 turns it off.
#   Over 37.7 h to 2026-10-20, 40% of
#   build CPU went to failed runs; one lane ran the same failing test filter
#   29 times in a row.
#   HEAVY_BUILD_HISTORY_LINES (default 20000, minimum 100) is how many lines of
#   history.tsv are kept; it is trimmed when 10% over.
# - Refuses when the filesystem of the current directory has less than
#   HEAVY_BUILD_REFUSE_GIB free (default 60). Exit code 75.
#   HEAVY_BUILD_FORCE=1 skips that check; it is for Oystein, not for agents.
# - Runs the command in a transient scope in builds.slice, so an OOM kills only
#   the build. MemoryHigh is 1.25 times the memory estimate, from 16G to 22G;
#   MemoryMax is twice MemoryHigh, but no more than builds.slice memory.max
#   (and never under MemoryHigh); MemorySwapMax is 8G. Until 2026-10-22
#   MemoryMax was MemoryHigh + 2G and MemorySwapMax 2G, so a build could be
#   OOM-killed with the machine far from full. The command never inherits a
#   slot lock.
# - HEAVY_BUILD_TIMEOUT=<seconds> stops the build after that long (exit 124).
# - Warns on stderr when the build used under 0.05 cores for 10 min (it may be
#   hung), or when its Wine processes have lost their wineserver. Such a build
#   stops counting against the budget, the job limit and the 2-high cap until
#   it uses CPU again (no build is stopped for it). The admission reason then
#   ends with "(idle, not counted as a job or a high build: <unit>,...)". On
#   2026-10-23 a hung Wine suite held a high slot and a job for 50 min while
#   33 builds waited. A high build that has used under 0.05 cores for 15 min
#   (HB_HUNG_HIGH_SECS, default 900) also gets one live.log line,
#   event=hung-high unit=<unit> cwd=<dir> idle_s=<s> notice=<where>, and one
#   note on stderr, once per build. When stderr is a file (the build's own
#   log), notice= names it; otherwise it says live.log. Nothing is stopped
#   (since 2026-10-23). A Wine process's prefix is the
#   WINEPREFIX in its own environment, else heavy-build's own WINEPREFIX. When
#   neither has one (WINEPREFIX set only inside the wrapped command, for a
#   child Wine started without it), that process is skipped, never guessed to
#   use ~/.wine; live.log gets event=wine-orphan-skip once. Only the run's own
#   prefixes count: its WINEPREFIX (for run-tests.sh, the prefix the script will
#   really use, see the lock keys) and the prefix of its wine: lock key. A
#   prefix whose remaining processes are all Wine service processes
#   (winedevice.exe, services.exe and the like) is shutting down and does not
#   count either. Another prefix the build started and stopped itself
#   (headless-mc.sh, test-fallback.sh) gets only event=wine-orphan-other in
#   live.log, once per prefix, and never a warning or a stop. Nothing is killed by default;
#   HEAVY_BUILD_WINE_ORPHAN=stop stops a Wine run after 2 min in that state.
# - Logs a Wine test run (class wine-run-tests or wine-run-tests-prebuilt) that
#   has used under 0.05 cores for 15 min (HB_WINE_IDLE_SECS): one stderr line
#   and one event=wine-idle line in live.log with the prefix and idle_s, once
#   per idle spell. It stops nothing.
# - CPU pinning is undone. Every 3 s (HB_CPU_GUARD_SECS) any thread in the
#   build's own scope whose CPU list is narrower than all CPUs the scope may
#   use (taskset, numactl --physcpubind, sched_setaffinity) is set back to all
#   of them when that pinning crowds CPUs: more runnable threads share one
#   narrow CPU set than it has CPUs, in two checks in a row, or the busy-loop
#   warning below is active and the thread spins. One thread per CPU (.NET
#   Server GC does that on purpose) is left alone. live.log gets event=unpin
#   once per pid. On 2026-10-13 40 busy
#   loops pinned to CPUs 30 and 31 starved the NVIDIA modeset thread and
#   KWin's output thread there, and the desktop froze for seconds at a time.
#   A cgroup cannot forbid sched_setaffinity, so it is undone after the fact.
# - Warns (event=busy-loops, nothing is killed) when the scope has more than
#   2 times its estimated cores (at least 2) in threads that stayed runnable
#   without ever sleeping between two checks, for 60 s (HB_BUSY_SECS).
# - Exit codes: the command's own status; 128 + signal on a signal death (137
#   after an OOM kill); 75 when refused or when the wait gave up; 76 when the
#   rerun guard refused a command that keeps failing; 77 when
#   --wait-timeout ran out before the command was let in; 124 when
#   HEAVY_BUILD_TIMEOUT or HEAVY_BUILD_WINE_ORPHAN=stop ended it; 2 for a usage
#   error; 70 when it came back to the queue after its build started (the
#   script was changed in place under an older heavy-build). TERM, INT or
#   HUP to heavy-build stop the build. heavy-build stops its scope on every
#   exit it can catch. When the command ends and only Wine
#   leftovers remain in the scope, they get SIGKILL before the scope stops
#   (logged as event=stop-kill).
#
# App runs: class app-run is a long-lived app, such as headless MotionCatalyst
# under Wine. A command is app-run when it names headless-mc.sh or run-mc.sh,
# or runs MotionCatalyst.exe or UiMcpHost.exe through wine, or when
# --class app-run (HEAVY_BUILD_CLASS=app-run) is given; no other class can be
# named. Leading options, each with an env form:
#   --class app-run         HEAVY_BUILD_CLASS=app-run
#   --ready-file PATH       HEAVY_BUILD_READY_FILE=PATH: removed at the start,
#                           written (atomically) once the command is let in and
#                           started, with lines admitted=, unit=,
#                           heavy_build_pid= and child_pid=; removed again when
#                           heavy-build exits. Works for every class.
#   --wait-timeout SECONDS  HEAVY_BUILD_WAIT_TIMEOUT: gives up with exit 77
#                           when not let in that many seconds after queueing,
#                           holds included. HEAVY_BUILD_WAIT still applies.
#   --                      ends the options.
# An app run differs from a build in these ways:
# - MemoryHigh is HEAVY_BUILD_APP_MEM_HIGH_GIB (default 10), MemoryMax twice
#   that (capped by builds.slice as for a build). Its memory estimate comes from app-run history as for any class
#   (default 8 GiB until 5 runs, floor 6 GiB), never above that MemoryHigh.
# - CPUQuota is HEAVY_BUILD_APP_CPU_QUOTA percent (default 800, so 8 threads;
#   0 or an empty value means no quota). A headless MC doing CPU MoCap used 18
#   of 32 threads for 40 min on 2026-10-23. The live.log decision lines of an
#   app run say cpu_quota=<n>% or cpu_quota=none.
# - At most HEAVY_BUILD_MAX_APP_RUNS (default 2; 0 turns the cap off) app runs
#   run at once. Each one counts as a job against HEAVY_BUILD_MAX_JOBS, and is
#   charged memory and cores like a build (after 2 min, the cores it used over
#   the last 60 s). An app run that waits for the cap (reason app-cap:) keeps
#   its place in line but never heads it, so builds behind it are not held up.
# - No HEAVY_BUILD_TIMEOUT unless the caller sets one. Its wall-time guess is
#   4 h until it has history.
# - No "it may be hung" warning when it idles; it still stops being charged
#   cores and expected memory after 10 min idle.
# - A run whose command dies from a signal, or that ends because heavy-build
#   itself got TERM, INT or HUP (headless-mc.sh stop), is logged with reason
#   stopped, not cancelled, and its peak still counts for the estimate.
# - No shared-prefix wine: key. It keys on its own prefix
#   motioncatalyst-ui-<name> when WINEPREFIX names one, or when the command
#   says headless-mc.sh start <name>; otherwise it gets no wine: key (the
#   tree: key, if any, stays).
# Priority, the hold file, the critical-first switch, lock keys and every
# memory gate apply as for builds. When the command ends, heavy-build stops the
# whole scope: every process left in it (wineserver, winedevice.exe, a mock
# server) ends too, whoever else uses it.
#
# Nesting: inside a build scope (heavy-build, or the old flock rule) it runs
# the command directly, in the outer scope, and writes a --ready-file at once. Under a plain `flock heavy-build.lock` it skips the
# line, but still makes a scope.
#
# It sets no target dir or build dir. ~/.cargo/config.toml sets
# build.build-dir; see ~/.claude/CLAUDE.md "Builds".
set -uo pipefail
# The whole script is one { } block, so bash parses all of it before running
# any of it. bash reads a script as it goes: if the file is rewritten in place
# while a heavy-build runs, a plain script goes on at its old byte offset in
# the new text. On 2026-10-10 two running heavy-builds jumped back into the
# wait loop that way and their stale charge held the queue for 76 min.
{

# The script this process loaded: bash keeps it open on fd 255, so this is the
# inode it read even when an install replaced the path since. Taken first, so
# an install during setup still counts as a change (see "Re-exec").
script_id=$(stat -L -c '%i %Y' -- "/proc/$$/fd/255" 2>/dev/null || stat -L -c '%i %Y' -- "${BASH_SOURCE[0]}" 2>/dev/null)
# The arguments as given, and what a re-exec while waiting hands over (see
# "Re-exec"). The HB_ADOPT_* and HB_REEXEC_IDS variables leave the environment
# here, so the build never sees them.
orig_args=("$@")
adopt_t=${HB_ADOPT_TICKET:-} adopt_st=${HB_ADOPT_STATE:-} reexec_ids=${HB_REEXEC_IDS:-}
unset HB_ADOPT_TICKET HB_ADOPT_STATE HB_REEXEC_IDS

if [[ $# -lt 1 || $1 == -h || $1 == --help ]]; then
  sed -n '2,/^set -uo/{/^set -uo/d;s/^# \{0,1\}//;p}' "${BASH_SOURCE[0]}" >&2
  [[ $# -ge 1 ]] && exit 0
  exit 2
fi

# Leading options (see "App runs" in the help text). Each has an env form.
CLASS_ARG=${HEAVY_BUILD_CLASS:-}
READY_FILE=${HEAVY_BUILD_READY_FILE:-}
WAIT_TIMEOUT=${HEAVY_BUILD_WAIT_TIMEOUT:-}
while (( $# )); do
  case $1 in
    --class) (( $# >= 2 )) || { echo "heavy-build: --class needs a value" >&2; exit 2; }; CLASS_ARG=$2; shift 2 ;;
    --class=*) CLASS_ARG=${1#--class=}; shift ;;
    --ready-file) (( $# >= 2 )) || { echo "heavy-build: --ready-file needs a path" >&2; exit 2; }; READY_FILE=$2; shift 2 ;;
    --ready-file=*) READY_FILE=${1#--ready-file=}; shift ;;
    --wait-timeout) (( $# >= 2 )) || { echo "heavy-build: --wait-timeout needs seconds" >&2; exit 2; }; WAIT_TIMEOUT=$2; shift 2 ;;
    --wait-timeout=*) WAIT_TIMEOUT=${1#--wait-timeout=}; shift ;;
    --) shift; break ;;
    -*) echo "heavy-build: unknown option '$1'. Put -- before a command that starts with '-'. To see the queue, read ~/.local/state/heavy-build/live.log" >&2; exit 2 ;;
    *) break ;;
  esac
done
if (( $# < 1 )); then echo "heavy-build: no command given" >&2; exit 2; fi
if [[ -n $CLASS_ARG && $CLASS_ARG != app-run ]]; then
  echo "heavy-build: --class (HEAVY_BUILD_CLASS) takes only app-run, not '$CLASS_ARG'" >&2
  exit 2
fi
if [[ -n $WAIT_TIMEOUT && ! $WAIT_TIMEOUT =~ ^[1-9][0-9]*$ ]]; then
  echo "heavy-build: --wait-timeout (HEAVY_BUILD_WAIT_TIMEOUT) must be a whole number of seconds, not '$WAIT_TIMEOUT'" >&2
  exit 2
fi
# A ready file from an earlier run must not read as admission for this one.
[[ -n $READY_FILE ]] && rm -f -- "$READY_FILE"
# write_ready UNIT CHILD: tells the caller that the command has been let in.
write_ready() {
  [[ -n $READY_FILE ]] || return 0
  printf 'admitted=%s\nunit=%s\nheavy_build_pid=%s\nchild_pid=%s\n' "$EPOCHSECONDS" "$1" "$$" "$2" \
    > "$READY_FILE.tmp.$$" && mv -f -- "$READY_FILE.tmp.$$" "$READY_FILE"
}

RUNDIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
LOCK=${HEAVY_BUILD_LOCK:-$RUNDIR/heavy-build.lock}
WAIT=${HEAVY_BUILD_WAIT:-7200}
REFUSE_GIB=${HEAVY_BUILD_REFUSE_GIB:-60}
MIN_MEM_GIB=${HEAVY_BUILD_MIN_MEM_GIB:-12}
SOLO_MEM_GIB=${HEAVY_BUILD_SOLO_MEM_GIB:-8}
MIN_SWAP_ROOM_GIB=${HEAVY_BUILD_MIN_SWAP_ROOM_GIB:-10}
POLL=${HEAVY_BUILD_POLL:-5}
HOLD=$RUNDIR/heavy-build.hold
hold_expired_logged=
CRITF=$RUNDIR/heavy-build.critical-first
PHOLD=$RUNDIR/heavy-build.hold.pressure
PHOLD_MAX_SECS=600
NCSTART=$RUNDIR/heavy-build.last-normal-start
PLEVEL_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/pressure/level
plevel=none preason=
critf_expired_logged=
QDIR=$RUNDIR/heavy-build.queue
JDIR=$RUNDIR/heavy-build.jobs
ADMIT=$RUNDIR/heavy-build.admit
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/heavy-build.conf
LANES=${XDG_CONFIG_HOME:-$HOME/.config}/heavy-build.lanes
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/heavy-build
HIST=$STATE/history.tsv
PRIO=${HEAVY_BUILD_PRIORITY:-normal}
TIMEOUT=${HEAVY_BUILD_TIMEOUT:-}
# Test hooks: where /proc files, the cgroup tree and Wine's socket dirs are
# read from, and the sampler's timings. Not for normal use.
PROC=${HB_PROC:-/proc}
CG=${HB_CGROUP:-/sys/fs/cgroup}
WINE_TMP=${HB_WINE_TMP:-/tmp/.wine-$UID}
SAMPLE=${HB_SAMPLE_SECS:-15}
STALL_SECS=${HB_STALL_SECS:-600}
WINE_IDLE_SECS=${HB_WINE_IDLE_SECS:-900}
HUNG_HIGH_SECS=${HB_HUNG_HIGH_SECS:-900}
WARMUP=${HB_WARMUP_SECS:-120}
ORPHAN_STOP_SECS=${HB_ORPHAN_STOP_SECS:-120}
IDLE_SECS=${HB_IDLE_SECS:-120}
NO_SCOPE_SECS=${HB_NO_SCOPE_SECS:-60}
SCOPE_GONE_SECS=${HB_SCOPE_GONE_SECS:-120}
PSI_GAP=${HB_PSI_GAP_SECS:-20}
CPUDIR=$RUNDIR/heavy-build.cpu
PSIF=$RUNDIR/heavy-build.cpupsi
GUARD_SECS=${HB_CPU_GUARD_SECS:-3}
BUSY_SECS=${HB_BUSY_SECS:-60}
SYSCPU=${HB_SYSCPU:-/sys/devices/system/cpu}
# comm names (as /proc shows them, 15 characters at most) of the Wine
# processes that stay behind when a Wine run ends. From the user journal,
# 2026-10-07 to 10-09: winedevice.exe in almost every stop, and now and then
# wineserver, services.exe, plugplay.exe, explorer.exe, rpcss.exe,
# svchost.exe, lsass.exe and conhost.exe.
WINE_LEFTOVERS=" winedevice.exe wineserver services.exe plugplay.exe explorer.exe rpcss.exe svchost.exe lsass.exe conhost.exe winemenubuilder wineboot.exe "
USVC=$CG/user.slice/user-$UID.slice/user@$UID.service
BSLICE=$USVC/builds.slice
MEMINFO=$PROC/meminfo
WINE_DEFAULT_LINE='${WINEPREFIX:-$HOME/.local/share/wineprefixes/motioncatalyst}'

build_env=(
  HEAVY_BUILD_ACTIVE=1
  CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-8}"
  CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-8}"
  MSBUILDDISABLENODEREUSE=1
  DOTNET_CLI_USE_MSBUILD_SERVER=0
)

say() { echo "heavy-build: $*" >&2; }

# Already inside a build scope: heavy-build in heavy-build, or the old rule.
if grep -qE '/builds\.slice/[^/]+\.scope$' /proc/self/cgroup 2>/dev/null; then
  # The command runs in the outer build's scope, so it is let in at once.
  write_ready "$(grep -oE '[^/]+\.scope$' /proc/self/cgroup 2>/dev/null | head -1)" "$$"
  exec env -u HEAVY_BUILD_CLASS -u HEAVY_BUILD_READY_FILE -u HEAVY_BUILD_WAIT_TIMEOUT "${build_env[@]}" "$@"
fi

case $PRIO in
  high|normal|low) ;;
  *) say "HEAVY_BUILD_PRIORITY must be high, normal or low, not '$PRIO'"; exit 2 ;;
esac
if [[ $PRIO == high && -z ${HEAVY_BUILD_REASON:-} ]]; then
  say "HEAVY_BUILD_PRIORITY=high needs HEAVY_BUILD_REASON. High is only for a P0 bug or the last local check before a PR."
  exit 2
fi
if [[ -n $TIMEOUT && ! $TIMEOUT =~ ^[1-9][0-9]*$ ]]; then
  say "HEAVY_BUILD_TIMEOUT must be a whole number of seconds, not '$TIMEOUT'"
  exit 2
fi

SLOTS=("$LOCK" "$LOCK.1" "$LOCK.2")

# ---------------------------------------------------------------- settings

# Reads ~/.config/heavy-build.conf. Sets MODE and the live-rule settings.
# For each setting the environment wins, then the file, then the default.
read_conf() {
  local k v
  declare -gA CONFV=()
  CONF_SIG=
  if [[ -r $CONF ]]; then
    while IFS='=' read -r k v || [[ -n $k ]]; do
      k=${k//[[:space:]]/}
      [[ $k == HEAVY_BUILD_* ]] || continue
      v=${v%%#*}
      v=${v//[[:space:]\"\']/}
      CONFV[$k]=$v
      CONF_SIG+="$k=$v;"
    done < "$CONF"
  fi
  MODE=shadow
  [[ ${CONFV[HEAVY_BUILD_MODE]:-} == live ]] && MODE=live
  setting HEAVY_BUILD_MAX_JOBS 6
  setting HEAVY_BUILD_CPU_BUDGET 28
  setting HEAVY_BUILD_MEM_RESERVE_GIB 8
  setting HEAVY_BUILD_MAX_CPU_PSI 75
  setting HEAVY_BUILD_CPU_PSI_SECS 30
  setting HEAVY_BUILD_MAX_MEM_PSI 5
  setting HEAVY_BUILD_PRESSURE 1
  setting HEAVY_BUILD_PRESSURE_STALE_SECS 30
  setting HEAVY_BUILD_PRESSURE_STALE_SLOW_SECS 600
  setting HEAVY_BUILD_SLOW_GAP_SECS 120
  setting HEAVY_BUILD_SLOW_FAST_GAP_SECS 30
  setting HEAVY_BUILD_SLOW_FAST_MIN_GIB 16
  setting HEAVY_BUILD_TC_PCT 50
  setting HEAVY_BUILD_REAL_USE 1
  setting HEAVY_BUILD_SLICE_EXCLUDE_INACTIVE_FILE 1
  setting HEAVY_BUILD_YOUNG_PCT 70
  setting HEAVY_BUILD_YOUNG_MIN_SECS 120
  setting HEAVY_BUILD_YOUNG_GROW_PCT 50
  (( YOUNG_GROW_PCT >= 0 && YOUNG_GROW_PCT <= 100 )) || YOUNG_GROW_PCT=50
  setting HEAVY_BUILD_SLICE_CPU_SECS 30
  (( SLICE_CPU_SECS >= 5 )) || SLICE_CPU_SECS=30
  setting HEAVY_BUILD_STARVE 1800
  setting HEAVY_BUILD_STARVE_FIX 1
  setting HEAVY_BUILD_STARVE_BOUND 1
  setting HEAVY_BUILD_MEM_CONTROLLER 0
  setting HEAVY_BUILD_LANE_PRIO 0
  setting HEAVY_BUILD_EST_REFRESH 0
  setting HEAVY_BUILD_REEXEC 0
  setting HEAVY_BUILD_EST_REFRESH_SECS 600
  (( EST_REFRESH_SECS >= 1 )) || EST_REFRESH_SECS=600
  setting HEAVY_BUILD_MC_TARGET_GIB 6
  setting HEAVY_BUILD_MC_HARD_GIB 3
  setting HEAVY_BUILD_MC_STEP_PCT 50
  setting HEAVY_BUILD_MC_NEW_FULL_SECS 60
  setting HEAVY_BUILD_MC_BRAKE_GIB 10
  setting HEAVY_BUILD_MC_BRAKE_SWAPIN 2000
  setting HEAVY_BUILD_MC_BRAKE_FULL_PCT 10
  setting HEAVY_BUILD_MC_CALM_SECS 60
  setting HEAVY_BUILD_MC_FALL_GIB 2
  setting HEAVY_BUILD_AGE_SECS 3600
  setting HEAVY_BUILD_AGE_SLOTS 1
  setting HEAVY_BUILD_CRIT_AGE_SECS 1800
  setting HEAVY_BUILD_SWAP_HEADROOM_PCT 25
  setting HEAVY_BUILD_SWAP_HEADROOM_GIB 8
  setting HEAVY_BUILD_WINE_FALLBACK_PCT 75
  setting HEAVY_BUILD_OWN_EST 1
  setting HEAVY_BUILD_EST_NONFILE 1
  setting HEAVY_BUILD_NONFILE_PAD_PCT 125
  (( NONFILE_PAD_PCT >= 100 && NONFILE_PAD_PCT <= 400 )) || NONFILE_PAD_PCT=125
  (( WINE_FALLBACK_PCT >= 1 && WINE_FALLBACK_PCT <= 100 )) || WINE_FALLBACK_PCT=75
  setting HEAVY_BUILD_RERUN_FAILS 2
  setting HEAVY_BUILD_RERUN_SECS 1800
  setting HEAVY_BUILD_HISTORY_LINES 20000
  setting HEAVY_BUILD_APP_MEM_HIGH_GIB 10
  setting HEAVY_BUILD_MAX_APP_RUNS 2
  (( APP_MEM_HIGH_GIB >= 1 )) || APP_MEM_HIGH_GIB=10
  setting HEAVY_BUILD_APP_CPU_QUOTA 800
  # An empty value, in the environment or the conf file, means no quota, as 0 does.
  if [[ ${HEAVY_BUILD_APP_CPU_QUOTA+x} ]]; then
    [[ -z $HEAVY_BUILD_APP_CPU_QUOTA ]] && APP_CPU_QUOTA=0
  elif [[ ${CONFV[HEAVY_BUILD_APP_CPU_QUOTA]+x} && -z ${CONFV[HEAVY_BUILD_APP_CPU_QUOTA]} ]]; then
    APP_CPU_QUOTA=0
  fi
  APP_CPU_QUOTA=$(( 10#$APP_CPU_QUOTA ))
}

setting() {
  local v=${!1:-}
  [[ -n $v ]] || v=${CONFV[$1]:-}
  [[ $v =~ ^[0-9]+$ ]] || v=$2
  printf -v "${1#HEAVY_BUILD_}" %s "$v"
}

# ---------------------------------------------------------------- estimates

# wine_tests_prebuilt WORD... -> true when run-tests.sh is given only test
# projects ending in .dll. run-tests.sh tests such an assembly as it is and
# builds nothing, which needs about half the memory of a run that builds
# (2.2 GB against 4.1 GB, measured 2026-10-16). One project name without .dll
# means a build, and so does no project at all (every default project).
wine_tests_prebuilt() {
  local w seen= n=0 skip=
  for w in "$@"; do
    if [[ -z $seen ]]; then
      [[ $w == *run-tests.sh ]] && seen=1
      continue
    fi
    if [[ -n $skip ]]; then skip=; continue; fi
    case $w in
      ';'|'&&'|'||'|'|'|'&') break ;;
      --filter) skip=1 ;;
      -*) ;;
      *.dll) n=$(( n + 1 )) ;;
      *) return 1 ;;
    esac
  done
  (( n > 0 ))
}

# wine_sig CLASS WORD... -> "<filtered> <sig>" for a run-tests.sh command:
# filtered is 1 when it has a --filter or --filter-for, else 0 (the full suite
# of its projects). sig is an 8-character hash of the class, the test project
# names (directory and .dll cut off), the other flags and the filter values,
# each sorted, so the same tests run from another tree, lane or WINEPREFIX
# get the same sig. Quotes are dropped. Prints nothing without run-tests.sh.
wine_sig() {
  local c=$1 w seen= skip= f=0 p
  local -a parts=()
  shift
  for w in "$@"; do
    w=${w//[\'\"]/}
    if [[ -z $seen ]]; then
      [[ $w == *run-tests.sh ]] && seen=1
      continue
    fi
    if [[ -n $skip ]]; then parts+=("f:$skip=$w"); skip=; continue; fi
    case $w in
      ';'|'&&'|'||'|'|'|'&') break ;;
      --filter|--filter-for) skip=$w f=1 ;;
      --filter=*|--filter-for=*) parts+=("f:$w"); f=1 ;;
      -*) parts+=("o:$w") ;;
      '') ;;
      *) p=${w##*/}; parts+=("p:${p%.dll}") ;;
    esac
  done
  [[ -n $seen ]] || return 0
  echo "$f $(printf '%s\n' "$c" "${parts[@]}" | LC_ALL=C sort | md5sum | cut -c1-8)"
}

# dotnet_sln WORD...: true when a `dotnet build|test|msbuild` or a
# plain `msbuild` builds a whole solution: its project argument ends in .sln
# or .slnx, or it has none (or names a directory) and that directory holds a
# .sln or .slnx and no project file, so MSBuild picks the solution. Words are
# split on blanks, so `bash -c 'cd x && dotnet build'` looks in the current
# directory, not in x.
dotnet_sln() {
  local w seen= skip= proj= f end=
  for w in "$@"; do
    [[ -n $end ]] && break
    case $w in ';'|'&&'|'||'|'|'|'&') [[ -n $seen ]] && break; seen=; continue ;; esac
    if [[ $w == ?*[\;\&\|\)] ]]; then end=1; w=${w%%[\;\&\|\)]*}; fi
    w=${w##*[\;\&\|\(]}
    [[ -n $w ]] || continue
    if [[ -z $seen ]]; then
      if [[ ${w##*/} == msbuild || ${w##*/} == msbuild.exe ]]; then seen=1
      elif [[ ${w##*/} == dotnet ]]; then seen=d
      fi
      continue
    fi
    if [[ $seen == d ]]; then
      case $w in build|test|msbuild) seen=1 ;; *) seen= ;; esac
      continue
    fi
    if [[ -n $skip ]]; then skip=; continue; fi
    case $w in
      -c|-f|-o|-r|-v|-a|-s|-l|--configuration|--framework|--output|--runtime|--verbosity|--arch|--os|--source|--logger|--filter|--settings|--results-directory|--collect|--blame-hang-timeout|--property) skip=1 ;;
      -*|/*:*) ;;
      /*) [[ ${w:1} == */* ]] && { proj=$w; break; } ;;
      *) proj=$w; break ;;
    esac
  done
  [[ -n $seen && $seen != d ]] || return 1
  [[ $proj == *.sln || $proj == *.slnx ]] && return 0
  [[ -z $proj ]] && proj=.
  [[ -d $proj ]] || return 1
  for f in "$proj"/*.*proj; do [[ -e $f ]] && return 1; done
  for f in "$proj"/*.sln "$proj"/*.slnx; do [[ -e $f ]] && return 0; done
  return 1
}

classify() {
  local c=" $* " words
  local rc='(^|[^[:alnum:]_-])cargo[[:space:]]+(\+[^[:space:]]+[[:space:]]+)?'
  if [[ -n ${CLASS_ARG:-} ]]; then echo "$CLASS_ARG"
  elif [[ $c == *run-tests.sh* ]]; then
    read -ra words <<< "$*"
    if wine_tests_prebuilt "${words[@]}"; then echo wine-run-tests-prebuilt
    else echo wine-run-tests
    fi
  elif [[ $c =~ (^|[/[:space:]])(headless-mc|run-mc)\.sh[[:space:]] ]] ||
       [[ ${c,,} == *wine* && ${c,,} =~ (^|[/\\[:space:]])(motioncatalyst|uimcphost)\.exe[[:space:]] ]]; then echo app-run
  elif [[ ${c,,} =~ (^|[^[:alnum:]_-])inspectcode(\.sh|\.exe)?[[:space:]] ]]; then echo jb-inspectcode
  elif [[ $c =~ ${rc}build[[:space:]].*--release || $c == *localbuild* ]]; then echo cargo-release
  elif [[ $c =~ ${rc}clippy ]]; then echo cargo-clippy
  elif [[ $c =~ ${rc}check ]]; then echo cargo-check
  elif [[ $c =~ ${rc}(test|nextest) ]]; then echo cargo-test
  elif [[ $c =~ ${rc}build ]]; then echo cargo-build
  elif [[ ${c,,} =~ (dotnet[[:space:]]+(build|test|msbuild)|msbuild(\.exe)?)[[:space:]] ]] && read -ra words <<< "$*" && dotnet_sln "${words[@]}"; then
    echo dotnet-build-sln
  elif [[ $c =~ dotnet[[:space:]]+test ]]; then echo dotnet-test
  elif [[ $c =~ dotnet[[:space:]]+(build|publish|run) ]]; then echo dotnet-build
  elif [[ ${c,,} == *wine* ]]; then echo wine-script
  else echo other
  fi
}

# "mem_gib cores wall_s floor_gib" per class. The first three were measured on
# 2026-10-07 (85 jobs): p90 peak, average cores, median wall. floor_gib is the
# lowest memory estimate the class can get, set on 2026-10-16 after a
# wine-run-tests run peaked at 17.4 GB on a 9.9 GB estimate and was OOM-killed.
# mem_gib was raised to the floor where it was lower. Classes without a row
# use the default. That 17.4 GB run was a test leak, fixed on 2026-10-16
# (a normal run peaks at 4.6 GB at p90 over 443 runs), so the wine-run-tests
# floor went from 10 to 6 GiB. A key that really used more still gets its own
# peak. jb-inspectcode (JetBrains inspectcode, also run as `jb inspectcode`)
# peaked at 17.4 GB twice on 2026-10-17 on MotionCatalyst.sln, once oom-killed,
# while it was estimated at 3.6 GB as "other". Its floor is 18 GiB; the scope
# gets MemoryHigh 22G and MemoryMax 44G (twice 22G, capped by builds.slice MemoryMax, 50G since 2026-10-23). Cores and wall time are guesses until
# it has history. wine-run-tests-prebuilt is a run of already built .dll files (2.2 GB,
# 33 s); its wall time is a guess until it has history. dotnet-build-sln is a
# dotnet build, test or msbuild of a whole .sln or .slnx (see dotnet_sln). On
# 2026-10-20 one of MotionCatalyst.sln was estimated at 6.6 GiB from the
# dotnet-build p90 and sat at its 16 GiB cap. It gets 16 GiB (no floor) until
# the class has 5 runs of its own; from then on its p90 decides, and capped
# runs count as 1.25 x their cap. Its wall time is a guess.
class_table() {
  case $1 in
    cargo-release)  echo "16.3 3.4 4500 0" ;;
    wine-script)    echo "7.4 5.6 537 0" ;;
    wine-run-tests) echo "6 5.9 114 6" ;;
    wine-run-tests-prebuilt) echo "3 5.9 33 3" ;;
    cargo-test)     echo "13.3 3.4 96 6" ;;
    cargo-clippy)   echo "7.6 2.6 42 6" ;;
    dotnet-build)   echo "5 8.0 17 5" ;;
    dotnet-test)    echo "5.2 6.9 45 0" ;;
    dotnet-build-sln) echo "16 9.2 120 0" ;;
    cargo-check)    echo "3.9 1.7 26 0" ;;
    jb-inspectcode) echo "18 2.0 600 18" ;;
    app-run)        echo "8 1.5 14400 6" ;;
    *)              echo "8 8 600 0" ;;
  esac
}

# The highest memory estimate, in GiB. A scope's MemoryHigh is 1.25 x the
# estimate, clamped to 16G..22G (see "Memory caps scale" below), so no build
# gets more than 22G before it is throttled. A larger estimate would only
# hold back other builds for memory this build cannot be given.
EST_MEM_MAX_GIB=22
# How many days of history a Wine test sig's runs count for (see estimate).
SIG_DAYS=14

# estimate KEY CLASS [SIG FILTERED] -> "mem_gib cores wall_s source".
# history.tsv columns: end_epoch class key wall_s cpu_s peak_bytes exit_code
# reason cap_bytes high_bytes tree_state sig. Older lines have no column 12
# (some no 11, 10, 9 or 8).
# Memory is the largest of: the key's highest peak in its last 10 runs, the
# class p90 peak over its last 50 runs (the class_table value when the class
# has under 5 runs), and the class floor. It is capped at EST_MEM_MAX_GIB.
# Own history (HEAVY_BUILD_OWN_EST=1, the default since 2026-10-23): when the
# key has 2 or more runs with a peak and the class estimate or floor decided,
# the estimate is 1.2 x the key's highest peak of its last 10 runs (at least
# 1 GiB, mem=key-own) if that is lower. This also applies below the class
# floor and to filtered Wine runs that fell back to the class percentile. On
# 2026-10-23 it would have lowered the estimate of 37 of 504 builds below their
# class p90 or floor. HEAVY_BUILD_OWN_EST=0 turns it off.
# A Wine test run with a filter (SIG from wine_sig, FILTERED 1) is estimated
# from its sig instead (history column 12, runs in the last SIG_DAYS days):
# with 5 or more such runs, their p90 peak (mem=sig-p90); with fewer, the
# class WINE_FALLBACK_PCT percentile (default 75, logged as mem=class-p75),
# or the highest peak of those few runs when that
# is more (mem=sig-max). The key's own peak does not apply. The class floor
# still applies, except that a sig with 10 or more runs may go down to 4 GiB.
# On 2026-10-20 wine-run-tests was planned at 8.5 to 9.8 GB from the class
# p90 while 1,383 runs peaked at 5.6 GB on average, and memory was the main
# reason Wine runs waited (median 12 min). A run without a filter (the full
# suite of its projects) keeps the rule above.
# An OOM-killed run (exit 137 or reason oom, but not cancelled or timeout)
# counts with a peak of at least its scope's MemoryMax (column 9), or its
# peak times 1.25 when column 9 is missing. A run that is not OOM-killed but
# whose peak reached 98% of its MemoryHigh (column 10; for older lines column
# 9 minus 2 GiB, as MemoryMax has always been MemoryHigh + 2G) counts with a
# peak of at least 1.25 x that MemoryHigh: it was throttled at the cap, so
# its peak is a lower bound, not a measurement. Exit 75, 124 and other signals
# (exit 128 and above) are left out. Wall time and cores come from the key's
# last 5 runs, else from the class, and never from OOM-killed runs.
# Non-file peak (HEAVY_BUILD_EST_NONFILE, default 1; 0 restores the old
# rule): a run with history column 13 counts with HEAVY_BUILD_NONFILE_PAD_PCT
# (default 125) percent of that non-file peak, never more than its
# memory.peak. memory.peak also counts the page cache of files the build
# writes, which the kernel can drop: on 2026-10-25 the tl-ui cargo test had a
# 4.8 GiB anon peak and up to 9.0 GiB of file cache, and was estimated at
# 22 GiB. The pad covers spikes between samples (15 s apart; a 2 s trace of
# that build lost up to 16% at 15 s). Such a run counts as held at its
# MemoryHigh only when its non-file peak reached 90% of it, since cache alone
# fills a scope to its MemoryHigh. When a key has a run with column 13, its
# runs without one are left out; the same for a class with 5 such runs.
# OOM-killed runs always count. A build needs 3 good samples (30 s or
# more) for column 13.
# source: history, class-history, class or default (where wall and cores
# came from), then ",mem=" and what set memory: key, class-p90, class-pNN,
# sig-p90, sig-max, class, default, floor, key-own or cap.
estimate() {
  local h=$HIST
  [[ -r $h ]] || h=/dev/null
  LC_ALL=C awk -F'\t' -v k="$1" -v c="$2" -v t="$(class_table "$2")" -v maxm="$EST_MEM_MAX_GIB" \
    -v s="${3:-}" -v sf="${4:-0}" -v now="$EPOCHSECONDS" -v swin="$(( ${SIG_DAYS:-14} * 86400 ))" -v fpct="${WINE_FALLBACK_PCT:-75}" \
    -v ownest="${OWN_EST:-1}" -v nfon="${EST_NONFILE:-1}" -v nfpad="${NONFILE_PAD_PCT:-125}" '
    function max2(a, b) { return a > b ? a : b }
    function srt(a, n,   g, i, j, x) { for (g = 1; g * 3 < n; g = g * 3 + 1); for (; g >= 1; g = int(g / 3)) for (i = g + 1; i <= n; i++) { x = a[i]; for (j = i; j > g && a[j - g] + 0 > x + 0; j -= g) a[j] = a[j - g]; a[j] = x } }
    $4 > 0 && $7 != 75 && $7 != 124 {
      oom = ($8 == "oom" || ($7 == 137 && $8 != "cancelled" && $8 != "timeout"))
      if ($7 >= 128 && !oom && $2 != "app-run") next
      pk = $6
      nf = (nfon == 1 && $13 ~ /^[0-9]+$/ && $6 ~ /^[0-9]+$/)
      if (oom && pk != "NA") {
        if ($9 ~ /^[0-9]+$/) { if ($9 + 0 > pk + 0) pk = $9 + 0 }
        else pk = pk * 1.25
      } else if (nf) {
        # Never above memory.peak, unless swap made the non-file peak larger.
        pk = $13 * nfpad / 100; if (pk > max2($6 + 0, $13 + 0)) pk = max2($6 + 0, $13 + 0)
        hi = ($10 ~ /^[0-9]+$/) ? $10 + 0 : ($9 ~ /^[0-9]+$/) ? $9 - 2147483648 : 0
        if (hi > 0 && $13 + 0 >= 0.9 * hi && hi * 1.25 > pk + 0) pk = hi * 1.25
      } else if (pk != "NA") {
        hi = ($10 ~ /^[0-9]+$/) ? $10 + 0 : ($9 ~ /^[0-9]+$/) ? $9 - 2147483648 : 0
        if (hi > 0 && pk + 0 >= 0.98 * hi && hi * 1.25 > pk + 0) pk = hi * 1.25
      }
      # kmf/cmf: kept when non-file rows replace the others. OOM-killed runs
      # are always kept.
      if ($3 == k) { kmn++; kmp[kmn] = pk; kmf[kmn] = (nf || oom); knf += nf }
      if ($2 == c) { cmn++; cmp[cmn] = pk; cmf[cmn] = (nf || oom); cnf += nf }
      if (s != "" && $12 == s && $1 + 0 >= now - swin && pk != "NA") { smn++; smp[smn] = pk }
      if (oom) next
      if ($3 == k) { kn++; kw[kn] = $4; kc[kn] = $5 }
      if ($2 == c) { cn++; cw[cn] = $4; cc[cn] = $5 }
    }
    END {
      # Runs with a non-file peak replace runs without one (OOM-killed runs
      # stay): for the key from its first such run, for the class from its
      # fifth.
      if (knf >= 1) { n = 0; for (i = 1; i <= kmn; i++) if (kmf[i]) kmp[++n] = kmp[i]; kmn = n }
      if (cnf >= 5) { n = 0; for (i = 1; i <= cmn; i++) if (cmf[i]) cmp[++n] = cmp[i]; cmn = n }
      split(t, d, " "); mem = d[1]; cores = d[2]; wall = d[3]; floor = d[4] + 0
      src = (c == "other" || c == "cargo-build") ? "default" : "class"
      msrc = src
      if (cn >= 5) {
        n = 0; sc = 0; sw = 0
        for (i = (cn > 50 ? cn - 49 : 1); i <= cn; i++) {
          w[++n] = cw[i]
          if (cc[i] != "NA") { sc += cc[i]; sw += cw[i] }
        }
        srt(w, n); wall = w[int((n + 1) / 2)]
        if (sw > 0) cores = sc / sw
        src = "class-history"
      }
      filt = (s != "" && sf == 1)
      cmem = mem
      if (cmn >= 5) {
        m = 0
        for (i = (cmn > 50 ? cmn - 49 : 1); i <= cmn; i++) if (cmp[i] != "NA") p[++m] = cmp[i]
        if (m > 0) {
          srt(p, m)
          i = int(0.9 * m) + 1; if (i > m) i = m; mem = p[i] / 1073741824; msrc = "class-p90"
          i = int(fpct / 100 * m) + 1; if (i > m) i = m; cmem = p[i] / 1073741824
        }
      }
      if (filt) {
        if (smn >= 5) {
          srt(smp, smn); i = int(0.9 * smn) + 1; if (i > smn) i = smn
          mem = smp[i] / 1073741824; msrc = "sig-p90"
          if (smn >= 10 && floor > 4) floor = 4
        } else {
          mem = cmem; if (msrc == "class-p90") msrc = "class-p" fpct
          mx = -1
          for (i = 1; i <= smn; i++) if (smp[i] + 0 > mx) mx = smp[i] + 0
          if (mx >= 0 && mx / 1073741824 > mem) { mem = mx / 1073741824; msrc = "sig-max" }
        }
      }
      if (kn >= 1) {
        n = 0; s = 0; nc = 0
        for (i = (kn > 5 ? kn - 4 : 1); i <= kn; i++) {
          w2[++n] = kw[i]
          if (kc[i] != "NA") { s += kc[i] / kw[i]; nc++ }
        }
        srt(w2, n); wall = w2[int((n + 1) / 2)]
        if (nc > 0) cores = s / nc
        src = "history"
      }
      if (kmn >= 1 && !filt) {
        mx = -1
        for (i = (kmn > 10 ? kmn - 9 : 1); i <= kmn; i++) if (kmp[i] != "NA" && kmp[i] + 0 > mx) mx = kmp[i] + 0
        if (mx >= 0 && mx / 1073741824 > mem) { mem = mx / 1073741824; msrc = "key" }
      }
      if (floor > mem) { mem = floor; msrc = "floor" }
      # Own history: a key with 2 or more runs with a peak is estimated at
      # 1.2 x its highest peak of its last 10 runs (at least 1 GiB) when that
      # is below the class estimate or floor.
      if (ownest == 1 && kmn >= 2 && msrc ~ /^(class|class-p[0-9]+|floor)$/) {
        no = 0; mx = -1
        for (i = (kmn > 10 ? kmn - 9 : 1); i <= kmn; i++) if (kmp[i] != "NA") { no++; if (kmp[i] + 0 > mx) mx = kmp[i] + 0 }
        if (no >= 2) {
          own = 1.2 * mx / 1073741824; if (own < 1) own = 1
          if (own < mem) { mem = own; msrc = "key-own" }
        }
      }
      if (maxm > 0 && mem > maxm) { mem = maxm; msrc = "cap" }
      if (mem < 0.1) mem = 0.1
      if (cores < 0.1) cores = 0.1
      if (wall < 1) wall = 1
      printf "%.1f %.1f %d %s,mem=%s\n", mem, cores, wall, src, msrc
    }' "$h" 2>/dev/null || echo "8.0 8.0 600 default,mem=default"
}

# ---------------------------------------------------------------- lock keys

# Directory of the Wine server socket for prefix $1, as wineserver names it.
wine_server_dir() {
  local dev ino
  dev=$(stat -c %D -- "$1" 2>/dev/null) && ino=$(stat -c %i -- "$1" 2>/dev/null) || return 1
  printf '%s/server-%s-%x\n' "$WINE_TMP" "$dev" "$ino"
}

# Prints "pid inside" or "pid outside" (of builds.slice) for each wineserver
# that serves prefix $1.
wineservers_for() {
  local dir d comm cwd cg
  dir=$(wine_server_dir "$1") || return 0
  for d in "$PROC"/[0-9]*; do
    read -r comm 2>/dev/null < "$d/comm" || continue
    [[ $comm == wineserver ]] || continue
    cwd=$(readlink "$d/cwd" 2>/dev/null) || continue
    [[ $cwd == "$dir" ]] || continue
    cg=$(<"$d/cgroup") 2>/dev/null || cg=
    if [[ $cg == */builds.slice/* ]]; then echo "${d##*/} inside"; else echo "${d##*/} outside"; fi
  done
}

# True when the command runs Wine: some word, split on blanks and shell
# separators so sh -c '...' counts, is a Wine program (wine, wine64,
# wineserver, wineboot, winetricks), a known Wine wrapper script, or a script
# under tools/wine/. "wine" inside another path or argument does not count,
# so /var/tmp/claude/x-linux-wine/run.sh gets no Wine key.
wine_cmd() {
  local a w b ws
  for a in "$@"; do
    read -r -d '' -a ws <<< "${a//[;&|()\`]/ }"
    for w in "${ws[@]}"; do
      b=${w##*/}
      case ${b,,} in
        wine|wine64|wineserver|wineboot|winetricks) return 0 ;;
        run-tests.sh|run-mc.sh|headless-mc.sh) return 0 ;;
      esac
      [[ $w == tools/wine/* || $w == */tools/wine/* ]] && return 0
    done
  done
  return 1
}

SHARED_WINEPREFIX=$HOME/.local/share/wineprefixes/motioncatalyst

# run_tests_prefix TOP WORD...: the prefix a tools/wine/run-tests.sh command
# will run in, when its script makes its own prefix per worktree (master, and
# stable/26.1 and 26.2 since PRs #13885/#13886). Prints "own <prefix>" when the
# script will use its own copy, ~/.local/share/wineprefixes/motioncatalyst-
# tests-<tree folder><AgentOutputSuffix> (or <that>-run<pid> when another run
# holds it), or "set <prefix>" when it will use WINEPREFIX. A script with the
# shared-prefix guard (PR #13900, MC_TESTS_SHARED_PREFIX) ignores a WINEPREFIX
# that names the shared prefix. The script read is the command's own
# run-tests.sh when that path exists, else TOP/tools/wine/run-tests.sh.
# Returns 1 with no output for any other command, and for an older script
# without the per-worktree prefix (a lane not rebased yet).
run_tests_prefix() {
  local top=$1 a w ws f= tree wp
  shift
  for a in "$@"; do
    read -r -d '' -a ws <<< "${a//[;&|()\`]/ }"
    for w in "${ws[@]}"; do
      [[ ${w##*/} == run-tests.sh ]] || continue
      if [[ -f $w ]]; then f=$w
      elif [[ -n $top && -f $top/tools/wine/run-tests.sh ]]; then f=$top/tools/wine/run-tests.sh
      fi
      break 2
    done
  done
  [[ -n $f ]] && grep -qF 'motioncatalyst-tests-' "$f" 2>/dev/null || return 1
  tree=$(cd "$(dirname "$f")/../.." 2>/dev/null && pwd) || return 1
  wp=${WINEPREFIX:-}
  if [[ -n $wp && ${wp%/} == "$SHARED_WINEPREFIX" && ${MC_TESTS_SHARED_PREFIX:-} != 1 ]] \
      && grep -qF MC_TESTS_SHARED_PREFIX "$f" 2>/dev/null; then
    wp=
  fi
  if [[ -n $wp ]]; then echo "set $wp"
  else echo "own $HOME/.local/share/wineprefixes/motioncatalyst-tests-${tree##*/}${AgentOutputSuffix:-}"
  fi
}

# The DESKTOP-14957 stopgap. Runs that share one Wine prefix share one
# wineserver, which lives in the scope of whichever run started it; when that
# scope ends, the other runs hang. So such runs get the key wine:<prefix>.
# For run-tests.sh the prefix is the one the script will use (run_tests_prefix);
# a script that uses its own prefix per worktree needs no key, since it never
# shares that prefix with another run. The key also turns itself off in a
# worktree whose wine-env.sh no longer has the shared default, and when a
# wineserver for the prefix already runs outside builds.slice. It never sets
# WINEPREFIX.
wine_key() {
  local top=$1 p rt
  shift
  if [[ ${cls:-} == app-run ]]; then
    p=$(app_prefix "$@") && echo "wine:$p"
    return 0
  fi
  wine_cmd "$@" || return 0
  if rt=$(run_tests_prefix "$top" "$@"); then
    [[ $rt == own\ * ]] && return 0
    p=${rt#set }
  elif [[ -n ${WINEPREFIX:-} ]]; then
    p=$WINEPREFIX
  else
    [[ -n $top ]] || return 0
    grep -qF -- "$WINE_DEFAULT_LINE" "$top/tools/wine/wine-env.sh" 2>/dev/null || return 0
    p=$SHARED_WINEPREFIX
  fi
  [[ $(wineservers_for "$p") == *outside* ]] && return 0
  echo "wine:$p"
}

# The own prefix of an app run, or nothing (exit 1): WINEPREFIX when it names
# a motioncatalyst-ui-<name> prefix, else the <name> after
# headless-mc.sh start in the command (also inside bash -c). Never the shared
# prefix, since each instance has its own.
app_prefix() {
  local w n= i
  if [[ ${WINEPREFIX:-} =~ /motioncatalyst-ui-[^/]+/?$ ]]; then echo "${WINEPREFIX%/}"; return 0; fi
  read -ra w <<< "$*"
  for (( i = 0; i + 2 < ${#w[@]}; i++ )); do
    if [[ ${w[i]} =~ (^|/)headless-mc\.sh$ && ${w[i+1]} == start && ${w[i+2]} =~ ^[[:alnum:]_.-]+$ ]]; then n=${w[i+2]}; break; fi
  done
  [[ -n $n ]] || return 1
  echo "$HOME/.local/share/wineprefixes/motioncatalyst-ui-$n"
}

# Lock keys for this build, one per line. Spaces in a key become %20.
# A line starting with ! is a note for live.log, not a key.
lock_keys() {
  [[ ${HEAVY_BUILD_KEY:-} == none ]] && return 0
  local s=" $* " ws top= tree= suf
  if [[ $s =~ [^[:alnum:]_-]cargo[[:space:]] ]]; then
    ws=$(cargo locate-project --workspace --message-format plain 2>/dev/null) && [[ -n $ws ]] && echo "cargo:${ws%/Cargo.toml}"
  fi
  if [[ ${s,,} =~ dotnet|msbuild|wine|run-tests\.sh|build\.cmd ]]; then
    top=$(git rev-parse --show-toplevel 2>/dev/null) && tree=1
  elif [[ $s =~ [[:space:]/]build\.sh[[:space:]] ]]; then
    top=$(git rev-parse --show-toplevel 2>/dev/null) && [[ -d $top/tools/BuildCli ]] && tree=1
  fi
  if [[ -n $tree ]]; then
    suf=$(agent_suffix "$@")
    if [[ -z $suf || $top == *#* ]]; then
      echo "tree:$top"
    elif ! grep -qsF AgentOutputSuffix "$top/$SPLIT_MARK"; then
      echo "tree:$top"
      echo "!locksplit=off reason=no-blocks suffix=$suf"
    else
      echo "tree:$top#$suf"
      [[ $s =~ [[:space:]/]build\.(sh|cmd)[[:space:]] && -d $top/tools/BuildCli ]] && echo "tree:$top#buildcli"
    fi
  fi
  wine_key "$top" "$@"
}

# The suffix blocks kpp added last (df22e584067d). A tree without this one may
# still write shared outputs, so a suffixed build there keeps the plain key.
SPLIT_MARK=apps/online/src/web/client/Directory.Build.props

# The build's AgentOutputSuffix, trimmed, or nothing. A value in the args
# (AgentOutputSuffix=, -p:, /p:, also inside sh -c) wins over the environment,
# as an MSBuild global property does. Two different values in the args, or a
# value with characters other than letters, digits, _ . and -, give nothing,
# so the build keeps the plain tree key.
agent_suffix() {
  local a v= n=0 re='(^|[^[:alnum:]_])AgentOutputSuffix=([^;[:space:]"'\'']*)'
  for a; do
    while [[ $a =~ $re ]]; do
      if (( n == 0 )); then v=${BASH_REMATCH[2]}; n=1
      elif [[ ${BASH_REMATCH[2]} != "$v" ]]; then return 0; fi
      a=${a#*"${BASH_REMATCH[0]}"}
    done
  done
  (( n )) || v=${AgentOutputSuffix-}
  v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
  [[ $v =~ ^[A-Za-z0-9_.-]+$ ]] && echo "$v"
}

# Directories of the cargo: and tree: lock keys, one per line. A tree key's
# #suffix is not part of the directory.
key_dirs() {
  local k d
  [[ $keys_csv == - ]] && return 0
  tr ',' '\n' <<< "$keys_csv" | while read -r k; do
    d=${k#*:}
    [[ $k == tree:*#* ]] && d=${d%#*}
    [[ $k == cargo:* || $k == tree:* ]] && echo "$d"
  done | sed 's/%20/ /g'
}

# critical_lane DIR...: prints why a build in one of these directories belongs
# to a critical session, or nothing. A directory counts when the grove lane
# that holds it is critical in [lanes] of sessions.toml, when the lane's grove
# registry owner is a critical session (a swarm lane such as .scratch/vac2,
# owner kpp), or when a live critical session works in that lane (~/work/
# desktop/kpp for kpp). Reads the same files as machine-session, with the
# same MACHINE_SESSION_* overrides.
critical_lane() {
  timeout 5 python3 -I - "$@" 2> /dev/null <<'PY'
import json, os, sys, tomllib
from pathlib import Path

home = Path.home()
env = os.environ.get
try:
    with open(env("MACHINE_SESSION_REGISTRY", home / ".config/machine/sessions.toml"), "rb") as f:
        reg = tomllib.load(f)
except (OSError, ValueError):
    sys.exit()
crit = {k for k, v in reg.get("sessions", {}).items() if v == "critical"}
crit_lanes = {k for k, v in reg.get("lanes", {}).items() if v == "critical"}
if not crit and not crit_lanes:
    sys.exit()
lanes = []
try:
    repos = json.loads(Path(env("MACHINE_SESSION_GROVE_REPOS", home / ".config/grove/repos.json")).read_text())
    repos = repos.get("repos", {})
except (OSError, ValueError):
    repos = {}
for repo in repos.values():
    try:
        projects = json.loads((Path(repo["work_dir"]) / ".grove/registry.json").read_text())["projects"]
    except (OSError, ValueError, KeyError, TypeError):
        continue
    for tag, p in projects.items():
        if p.get("path"):
            lanes.append((p["path"].rstrip("/"), tag, (p.get("owner") or {}).get("session_name")))
lanes.sort(key=lambda l: len(l[0]), reverse=True)

def lane_of(d):
    for path, tag, owner in lanes:
        if d == path or d.startswith(path + "/"):
            return tag, owner
    return None, None

# Lanes where a live critical session works.
proc = Path(env("MACHINE_SESSION_PROC", "/proc"))
worked = {}
for f in Path(env("MACHINE_SESSION_SESSIONS_DIR", home / ".claude/sessions")).glob("*.json"):
    try:
        s = json.loads(f.read_text())
        pid = int(s["pid"])
    except (OSError, ValueError, KeyError, TypeError):
        continue
    if s.get("name") not in crit:
        continue
    try:
        stat = (proc / str(pid) / "stat").read_text()
    except OSError:
        continue
    rest = stat[stat.rfind(")") + 2 :].split()
    if s.get("procStart") and len(rest) > 19 and rest[19] != str(s["procStart"]):
        continue
    tag, _ = lane_of(s.get("cwd") or "")
    if tag:
        worked.setdefault(tag, s["name"])

for d in sys.argv[1:]:
    for d in dict.fromkeys([d.rstrip("/"), os.path.realpath(d)]):
        tag, owner = lane_of(d)
        if not tag:
            continue
        if tag in crit_lanes:
            print(f"grove lane {tag} is critical in ~/.config/machine/sessions.toml")
        elif owner in crit:
            print(f"grove lane {tag} belongs to critical session {owner}")
        elif tag in worked:
            print(f"grove lane {tag} is where critical session {worked[tag]} works")
        else:
            continue
        sys.exit()
PY
}

# ---------------------------------------------------------------- lane priority

# lane_ident_py PID DIR...: prints "lane owner session dirs via" for the lanes
# file: the grove lane tag that holds the first of DIR that is in a lane, that
# lane's grove owner, the Claude session that owns PID (an ancestor that is a
# session, else a session in the same claude scope, as machine-session does),
# and DIR as a comma list. "-" for each one not found; spaces become %20.
# When no ancestor is a session, CLAUDE_PID (set by Claude Code in its shells)
# names the session if its session file is live; then the claude scope.
lane_ident_py() {
  timeout 5 python3 -I - "$@" 2> /dev/null <<'PY'
import json, os, sys
from pathlib import Path

home = Path.home()
env = os.environ.get
pid, dirs = int(sys.argv[1]), [d.rstrip("/") or "/" for d in sys.argv[2:]]
dirs = list(dict.fromkeys(dirs + [os.path.realpath(d) for d in dirs]))
lanes = []
try:
    repos = json.loads(Path(env("MACHINE_SESSION_GROVE_REPOS", home / ".config/grove/repos.json")).read_text())
    repos = repos.get("repos", {})
except (OSError, ValueError, AttributeError):
    repos = {}
for repo in repos.values():
    try:
        projects = json.loads((Path(repo["work_dir"]) / ".grove/registry.json").read_text())["projects"]
    except (OSError, ValueError, KeyError, TypeError):
        continue
    for tag, p in projects.items():
        if p.get("path"):
            lanes.append((p["path"].rstrip("/"), tag, (p.get("owner") or {}).get("session_name")))
lanes.sort(key=lambda l: len(l[0]), reverse=True)
lane = owner = None
for d in dirs:
    for path, tag, own in lanes:
        if d == path or d.startswith(path + "/"):
            lane, owner = tag, own
            break
    if lane:
        break

proc = Path(env("MACHINE_SESSION_PROC", "/proc"))

def stat_rest(p):
    try:
        s = (proc / str(p) / "stat").read_text()
    except OSError:
        return []
    return s[s.rfind(")") + 2 :].split()

def cgroup(p):
    try:
        return (proc / str(p) / "cgroup").read_text().strip().split(":")[-1]
    except OSError:
        return None

sessions = {}
for f in Path(env("MACHINE_SESSION_SESSIONS_DIR", home / ".claude/sessions")).glob("*.json"):
    try:
        s = json.loads(f.read_text())
        sp = int(s["pid"])
    except (OSError, ValueError, KeyError, TypeError):
        continue
    rest = stat_rest(sp)
    if not rest or (s.get("procStart") and len(rest) > 19 and rest[19] != str(s["procStart"])):
        continue
    sessions[sp] = s.get("name") or f"pid-{sp}"
# The session, and how it was found ("via"). HEAVY_BUILD_SESSION_PID wins
# when it is a live session, and gives its current name, so a rename since
# the SessionStart hook ran does not matter. HEAVY_BUILD_SESSION, a name,
# counts only when no pid was given and a live session has that name: with
# a pid that is gone, the name may belong to a newer session by now.
session, via = None, "-"
want, wpid = env("HEAVY_BUILD_SESSION", ""), env("HEAVY_BUILD_SESSION_PID", "")
if wpid.isdigit() and int(wpid) in sessions:
    session, via = sessions[int(wpid)], "env-pid"
elif not wpid and want and want in sessions.values():
    session, via = want, "env-name"
p, seen = pid, set()
while session is None and p > 1 and p not in seen:
    if p in sessions:
        session, via = sessions[p], "parent"
        break
    seen.add(p)
    rest = stat_rest(p)
    p = int(rest[1]) if len(rest) > 1 else 0
if session is None and env("CLAUDE_PID", "").isdigit() and int(env("CLAUDE_PID")) in sessions:
    session, via = sessions[int(env("CLAUDE_PID"))], "claude-pid"
if session is None:
    cg = cgroup(pid) or ""
    if "/claude-" in cg and cg.endswith(".scope"):
        for sp, name in sessions.items():
            if cgroup(sp) == cg:
                session, via = name, "scope"
                break

def enc(v):
    return (v or "-").replace(" ", "%20").replace(",", "%2C") if v else "-"

print(enc(lane), enc(owner), enc(session), ",".join(enc(d) for d in dirs) or "-", via)
PY
}

# lanes_load: reads the lanes file without a fork. When its text changed, parses
# it into LR_M (match), LR_P (priority) and LR_L (the whole line), and says each
# bad line once. A missing file reads as empty.
lanes_text=$'\x01' LR_M=() LR_P=() LR_L=()
lanes_load() {
  local -a raw=()
  local txt l body m p by extra n=0 IFS=$' \t\n'
  [[ -r $LANES ]] && mapfile -t raw < "$LANES" 2>/dev/null
  IFS=$'\n'; txt="${raw[*]}"; IFS=$' \t\n'
  [[ $txt == "$lanes_text" ]] && return 0
  lanes_text=$txt LR_M=() LR_P=() LR_L=()
  for l in "${raw[@]}"; do
    n=$(( n + 1 ))
    body=${l%%#*}
    m= p= by= extra=
    read -r m p by extra <<< "$body"
    [[ -z $m ]] && continue
    if [[ -n $extra || ! $p =~ ^(high|normal|low)$ || ( -n $by && ! $by =~ ^by=[A-Za-z0-9_.@:-]+$ ) ]]; then
      say "warning: $LANES line $n skipped: want '<match> high|normal|low [by=<who>] [# note]', got '$l'"
      continue
    fi
    LR_M+=("$m") LR_P+=("$p") LR_L+=("$(read -r x <<< "$l"; printf '%s' "$x")")
  done
}

# lane_rule_match: true when a lanes rule matches this build; sets lane_rule
# (the line) and lane_rule_prio. First match wins.
lane_rule_match() {
  local i m n d lane owner sess dirs
  local -a ds
  read -r lane owner sess dirs _ <<< "$lane_ident"
  IFS=, read -ra ds <<< "${dirs:--}"
  for i in "${!LR_M[@]}"; do
    m=${LR_M[i]}
    if [[ $m == /* || $m == "~/"* ]]; then
      [[ $m == "~/"* ]] && m=$HOME/${m#"~/"}
      m=${m%/}
      for d in "${ds[@]}"; do
        [[ $d == - ]] && continue
        d=${d//%20/ }; d=${d//%2C/,}
        # shellcheck disable=SC2053
        if [[ $d == $m || $d == $m/* ]]; then lane_rule=${LR_L[i]} lane_rule_prio=${LR_P[i]}; return 0; fi
      done
    else
      for n in "$lane" "$owner" "$sess"; do
        [[ -z $n || $n == - ]] && continue
        n=${n//%20/ }; n=${n//%2C/,}
        # shellcheck disable=SC2053
        if [[ $n == $m ]]; then lane_rule=${LR_L[i]} lane_rule_prio=${LR_P[i]}; return 0; fi
      done
    fi
  done
  return 1
}

# job_ident: once, at submit. Sets lane_ident ("lane owner session dirs",
# from lane_ident_py), own_session, own_agent and ticket_l3, the ticket's
# line 3. The agent name comes from CLAUDE_AGENT_NAME or HEAVY_BUILD_AGENT
# when set; a Claude subagent without one (CLAUDE_CODE_CHILD_SESSION=1) is
# "subagent"; otherwise "-". HB_LANE_IDENT is a test hook.
job_ident() {
  local top lane owner dirs via
  local -a kd
  mapfile -t kd < <(key_dirs)
  if [[ -n ${HB_LANE_IDENT:-} ]]; then
    lane_ident=$HB_LANE_IDENT
  else
    top=$(git rev-parse --show-toplevel 2>/dev/null)
    lane_ident=$(lane_ident_py $$ "$PWD" ${top:+"$top"} "${kd[@]}")
  fi
  [[ -n $lane_ident ]] || lane_ident="- - - -"
  read -r lane owner own_session dirs via <<< "$lane_ident"
  own_agent=${CLAUDE_AGENT_NAME:-${HEAVY_BUILD_AGENT:-}}
  [[ -z $own_agent && ${CLAUDE_CODE_CHILD_SESSION:-} == 1 ]] && own_agent=subagent
  own_agent=${own_agent//[^A-Za-z0-9_.@:-]/_}
  own_agent=${own_agent:--} own_session=${own_session:--}
  ticket_l3="session=$own_session agent=$own_agent lane=${lane:--} owner=${owner:--} dirs=${dirs:--} via=${via:--}"
}

# lane_setup: once per run, works out the session class when the caller set
# HEAVY_BUILD_PRIORITY, which the old default leaves out.
lane_setup() {
  local -a kd
  if [[ -z ${lane_class_done:-} ]]; then
    lane_class_done=1
    if [[ -n ${HEAVY_BUILD_PRIORITY:-} ]]; then
      SESSION_CLASS=$(timeout 5 "${HB_MACHINE_SESSION:-machine-session}" class --pid $$ 2> /dev/null)
      if [[ $SESSION_CLASS == critical ]]; then
        crit_why="this session is critical in ~/.config/machine/sessions.toml"
      else
        mapfile -t kd < <(key_dirs)
        crit_why=$(critical_lane "$PWD" "${kd[@]}")
      fi
    fi
  fi
}

# lane_prio_apply: sets PRIO for this poll (see "Lane priority" in the help).
# When it changes, logs it once and rewrites line 2 of the ticket, so the
# other waiters rank this build by the new priority.
lane_prio_apply() {
  local new=$BASE_PRIO rule="none: lane priority is off or the lanes file has no rules" q
  if (( LANE_PRIO )); then
    lanes_load
    if (( ${#LR_M[@]} )); then
      lane_setup
      if [[ -n ${crit_why:-} ]]; then
        new=critical rule="critical: $crit_why"
      elif lane_rule_match; then
        new=$lane_rule_prio rule=$lane_rule
      elif [[ -n ${HEAVY_BUILD_PRIORITY:-} ]]; then
        new=$HEAVY_BUILD_PRIORITY
        if [[ $new == high ]]; then
          new=normal rule="none: a caller's own high needs a lanes rule"
          if [[ -z ${lane_demote_said:-} ]]; then
            lane_demote_said=1
            say "priority normal, not high: the manager session owns build priority (~/.config/heavy-build.lanes has no rule for this build). Ask the manager session if this build must go first."
            log_line "event=prio-demoted asked=high reason=\"$HEAVY_BUILD_REASON\" ident=\"$lane_ident\" cmd=\"$cmdline\""
          fi
        fi
      elif [[ ${SESSION_CLASS:-} == pausable ]]; then
        new=low
      else
        new=normal
      fi
    fi
  fi
  [[ $new == "$PRIO" ]] && return 0
  q=${rule//\"/\'}
  log_line "event=prio-change prio_from=$PRIO prio_to=$new rule=\"$q\" ident=\"${lane_ident:--}\" cmd=\"$cmdline\""
  say "priority $new (was $PRIO): $rule"
  PRIO=$new state_prio=$new
  [[ -n $ticket && -e $ticket ]] && write_ticket
  return 0
}

# ---------------------------------------------------------------- estimate refresh

# An app run is never planned above its own MemoryHigh.
app_est_cap() {
  if [[ $cls == app-run ]] && awk -v m="$est_mem" -v h="$APP_MEM_HIGH_GIB" 'BEGIN { exit !(m > h) }'; then
    est_mem=$APP_MEM_HIGH_GIB.0 est_src="${est_src%%,mem=*},mem=app-high"
  fi
}

# est_refresh: with HEAVY_BUILD_EST_REFRESH=1, a waiter works out its estimate
# again when a setting in heavy-build.conf changed, and otherwise every
# HEAVY_BUILD_EST_REFRESH_SECS (default 600). When it changes, line 2 of the
# ticket is rewritten and live.log gets one event=est-change line. On
# 2026-10-26 a tl-ui cargo test queued at 07:45 kept its 19.2 GiB estimate
# after HEAVY_BUILD_EST_NONFILE=1 went live at 08:42 (a new submit got about
# 7 GiB), and as the starve head it held about 80 jobs for 5 hours.
est_refresh() {
  local old new
  if (( ! EST_REFRESH )) || { [[ $CONF_SIG == "$est_sig" ]] && (( EPOCHSECONDS - est_ts < EST_REFRESH_SECS )); }; then
    est_sig=$CONF_SIG
    return 0
  fi
  est_sig=$CONF_SIG est_ts=$EPOCHSECONDS
  old="$est_mem $est_cores $est_wall"
  read -r est_mem est_cores est_wall est_src <<< "$(estimate "$hash" "$cls" "${sig#-}" "$sig_f")"
  app_est_cap
  new="$est_mem $est_cores $est_wall"
  [[ $new == "$old" ]] && return 0
  local om oc ow
  read -r om oc ow <<< "$old"
  log_line "event=est-change est_from=${om}G/${oc}c/${ow}s est_to=${est_mem}G/${est_cores}c/${est_wall}s($est_src) cmd=\"$cmdline\""
  say "estimate now ${est_mem} GiB, ${est_cores} cores, ${est_wall} s (was ${om} GiB, ${oc} cores, ${ow} s)"
  [[ -n $ticket && -e $ticket ]] && write_ticket
  return 0
}

# ---------------------------------------------------------------- re-exec

# adopt_ticket: after a re-exec, restores the give-up clock of the ticket the
# start of main took back (adopted, which is also ticket).
adopt_ticket() {
  local q s b
  read -r q s b _ <<< "$adopt_st"
  [[ $q =~ ^[0-9]+$ ]] && queued_ts=$q
  [[ $s =~ ^[0-9]+$ ]] && stuck=$s
  [[ $b =~ ^[0-9]+$ ]] && adopt_best=$b
  log_line "event=reexec-adopted ticket=${ticket##*/} queued_s=$(( EPOCHSECONDS - queued_ts )) script=\"$script_id\" cmd=\"$cmdline\""
  return 0
}

# reexec_check: with HEAVY_BUILD_REEXEC=1, re-execs a waiting heavy-build
# whose script file changed. See "Re-exec" in the help text.
reexec_check() {
  local now_id tag abs why=
  (( REEXEC )) || return 0
  [[ -z ${build_started:-} && -n $ticket && -e $ticket ]] || return 0
  now_id=$(stat -L -c '%i %Y' -- "${BASH_SOURCE[0]}" 2>/dev/null) || return 0
  [[ -n $now_id && $now_id != "$script_id" ]] || return 0
  tag=${now_id// /:}
  [[ " $reexec_ids " == *" $tag "* ]] && return 0
  reexec_ids+=" $tag"
  # Everything that can fail is checked before the exec, which replaces this
  # process: a failure after it would end the waiter.
  abs=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null)
  if [[ -z $abs || ! -f $abs || ! -r $abs ]]; then
    why="the script ${BASH_SOURCE[0]} cannot be read"
  elif ! "$BASH" -n -- "$abs" 2>/dev/null; then
    why="the new script fails bash -n"
  elif ! grep -q 'HB_ADOPT_TICKET' -- "$abs" 2>/dev/null; then
    why="the new script cannot take back a ticket (no HB_ADOPT_TICKET)"
  elif [[ ! -x $BASH ]]; then
    why="bash ($BASH) is gone"
  fi
  if [[ -n $why ]]; then
    log_line "event=reexec-skip from=\"$script_id\" to=\"$now_id\" reason=\"$why\" cmd=\"$cmdline\""
    say "heavy-build was updated, but this waiter stays on its old code: $why"
    return 0
  fi
  log_line "event=reexec from=\"$script_id\" to=\"$now_id\" ticket=${ticket##*/} waited_s=$(( EPOCHSECONDS - queued_ts )) cmd=\"$cmdline\""
  say "heavy-build was updated; going on with the new code, same place in line"
  export HB_ADOPT_TICKET=$ticket HB_ADOPT_STATE="$queued_ts $stuck ${best:--} ${tstate:--}" HB_REEXEC_IDS="${reexec_ids# }"
  shopt -s execfail
  exec "$BASH" -- "$abs" "${orig_args[@]}"
  shopt -u execfail
  unset HB_ADOPT_TICKET HB_ADOPT_STATE HB_REEXEC_IDS
  log_line "event=reexec-skip from=\"$script_id\" to=\"$now_id\" reason=\"exec failed\" cmd=\"$cmdline\""
  return 0
}

# ---------------------------------------------------------------- old rule

# True when a process above us holds one of the slot locks, for example
# `flock heavy-build.lock heavy-build ...`. Matches on inode only: on btrfs,
# stat's device number is the subvolume's, not the one /proc/locks prints.
ancestor_holds_lock() {
  local inos="" f ino holders pid p
  for f in "${SLOTS[@]}"; do
    ino=$(stat -c %i -- "$f" 2>/dev/null) && inos+=" $ino"
  done
  [[ -n $inos ]] || return 1
  holders=$(awk -v is="$inos" 'BEGIN {n = split(is, a, " "); for (k = 1; k <= n; k++) want[a[k]] = 1}
    $2 == "FLOCK" && $3 != "->" {split($6, d, ":"); if (d[3] in want) print $5}' /proc/locks 2>/dev/null)
  [[ -n $holders ]] || return 1
  pid=$PPID
  while [[ -n $pid && $pid -gt 1 ]]; do
    for p in $holders; do [[ $p == "$pid" ]] && return 0; done
    pid=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)
  done
  return 1
}

mem_avail_gib() { awk '/^MemAvailable:/ {print int($2 / 1048576); exit}' "$MEMINFO" 2>/dev/null; }

# GiB of swap left before 90% of swap is used. Empty when there is no swap.
swap_room_gib() {
  awk '/^SwapTotal:/ {t = $2} /^SwapFree:/ {f = $2}
    END {if (t > 0) print int((0.9 * t - (t - f)) / 1048576)}' "$MEMINFO" 2>/dev/null
}

# Number of scopes with processes in builds.slice (heavy-build or the old rule).
active_build_scopes() {
  local e n=0
  for e in "$BSLICE"/*.scope/cgroup.events; do
    [[ -e $e ]] && grep -qx 'populated 1' "$e" 2>/dev/null && n=$(( n + 1 ))
  done
  echo "$n"
}

# Start time of a process (field 22 of /proc/PID/stat), to tell a live waiter
# from a new process that got the same pid.
proc_start() {
  local s
  { s=$(<"/proc/$1/stat"); } 2>/dev/null || return 1
  s=${s##*) }
  # shellcheck disable=SC2086
  set -- $s
  echo "${20}"
}

# A ticket's first line is "pid starttime"; it is live while that process
# runs. The second line is "prio mem cores wall keys" for the budget rule.
# The third line, "session= agent= lane= owner= dirs=", says who submitted the
# build and which lanes-file rules can match (heavy-build-prio list reads it).
# Values have spaces as %20 and commas as %2C; dirs is a comma list.
# Waiters running an older heavy-build read only the first line.
ticket_alive() {
  local pid st
  read -r pid st < "$1" 2>/dev/null || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ $(proc_start "$pid") == "$st" ]]
}

write_ticket() {
  rm -f -- "$JDIR/$unit"
  mkdir -p "$QDIR" 2>/dev/null
  printf '%s %s\n%s %s %s %s %s %s\n%s' "$$" "$mystart" "$PRIO" "$est_mem" "$est_cores" "$est_wall" "$keys_csv" "$cls" \
    "${ticket_l3:+$ticket_l3$'\n'}" > "$ticket.tmp" && mv -f "$ticket.tmp" "$ticket"
}

# Sets pos (our place in line, 1 = next), total, and dup (an earlier ticket has
# our hash). Removes tickets whose waiter is gone.
queue_scan() {
  local LC_ALL=C t
  pos=0 total=0 dup=
  for t in "$QDIR"/[0-9]*; do
    [[ -e $t && $t != *.tmp ]] || continue
    if [[ $t != "$ticket" ]] && ! ticket_alive "$t"; then rm -f -- "$t"; continue; fi
    total=$(( total + 1 ))
    if [[ $t == "$ticket" ]]; then
      pos=$total
    elif (( pos == 0 )) && [[ ${t##*-} == "$hash" ]]; then
      dup=1
    fi
  done
}

# Build scopes whose heavy-build was killed (SIGKILL) run on without a slot.
# The unit name carries the heavy-build pid, so a dead pid marks an orphan.
orphan_scopes() {
  local u pid
  systemctl --user list-units --type=scope --state=active --plain --no-legend 'heavy-build-*.scope' 2>/dev/null \
    | awk '{print $1}' | while read -r u; do
        pid=${u#heavy-build-}; pid=${pid%%-*}
        [[ $pid =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null && echo "$u"
      done
}

# Number of slot locks nobody holds, not counting the one on fd 9.
other_free_slots() {
  local f n=0
  for f in "${SLOTS[@]}"; do
    [[ $f == "$held" ]] && continue
    if { exec 7>>"$f" && flock -n 7; } 2>/dev/null; then n=$(( n + 1 )); fi
    exec 7>&- 2>/dev/null
  done
  echo "$n"
}

# Take a free slot, new slots first, so builds still waiting with the old
# `flock heavy-build.lock` rule get slot 0 when it frees up.
try_slot() {
  local f
  for f in "$LOCK.2" "$LOCK.1" "$LOCK"; do
    exec 9>>"$f" || continue
    if flock -n 9; then held=$f; return 0; fi
    exec 9>&-
  done
  return 1
}

# ---------------------------------------------------------------- stale scopes

# "pid:comm" for each process in the scope cgroup $1 whose comm can be read.
scope_procs() {
  local pid comm
  while read -r pid; do
    read -r comm 2>/dev/null < "$PROC/$pid/comm" || continue
    printf '%s:%s\n' "$pid" "$comm"
  done 2>/dev/null < "$1/cgroup.procs"
}

# True when $1 (scope_procs output) is not empty and lists only Wine leftovers.
only_wine_leftovers() {
  local l
  [[ -n $1 ]] || return 1
  while read -r l; do [[ $WINE_LEFTOVERS == *" ${l#*:} "* ]] || return 1; done <<< "$1"
}

# cpu_rate UNIT USAGE_USEC: the scope's CPU use in millicores over the last
# full window of HB_IDLE_SECS (default 120), or "-" until the first window
# ends. Samples ("start_epoch usage_usec rate") live in $CPUDIR/<unit>, shared
# by every heavy-build, so the window spans waiters that come and go.
cpu_rate() {
  local f=$CPUDIR/$1 t0= u0= r=- now=$EPOCHSECONDS
  read -r t0 u0 r 2>/dev/null < "$f"
  if [[ ! $t0 =~ ^[0-9]+$ || ! $u0 =~ ^[0-9]+$ ]] || (( $2 < u0 )); then
    mkdir -p "$CPUDIR" 2>/dev/null
    printf '%s %s -\n' "$now" "$2" > "$f.$$" && mv -f "$f.$$" "$f"
    echo -
    return
  fi
  if (( now > t0 && now - t0 >= IDLE_SECS )); then
    r=$(( ($2 - u0) / (now - t0) / 1000 ))
    printf '%s %s %s\n' "$now" "$2" "$r" > "$f.$$" && mv -f "$f.$$" "$f"
  fi
  echo "${r:--}"
}

# True while the heavy-build (pid $2) that made scope $1 still runs: its
# state file names the pid and start time, or, with no state file, the pid
# still runs heavy-build.
hb_alive() {
  local u p st rest
  if read -r u p st rest 2>/dev/null < "$JDIR/$1"; then
    [[ $(proc_start "$2") == "$st" ]]
    return
  fi
  tr '\0' ' ' < "/proc/$2/cmdline" 2>/dev/null | grep -q heavy-build
}

# Stops heavy-build scopes whose heavy-build is gone, for example killed with
# SIGKILL so its own cleanup never ran, and that hold nothing but Wine
# leftovers. A scope whose heavy-build still runs is never touched. A scope
# with any process that is not a Wine leftover is left alone, however idle,
# and logged once as event=sweep-skip: killed work is never fine.
sweep_stale() {
  local d u pid procs list f n
  for d in "$BSLICE"/heavy-build-*.scope; do
    [[ -d $d ]] || continue
    grep -qx 'populated 1' "$d/cgroup.events" 2>/dev/null || continue
    u=${d##*/}; u=${u%.scope}
    pid=${u#heavy-build-}; pid=${pid%%-*}
    [[ $pid =~ ^[0-9]+$ ]] || continue
    hb_alive "$u" "$pid" && continue
    procs=$(scope_procs "$d")
    [[ -n $procs ]] || continue
    list=$(paste -sd, - <<< "$procs")
    if ! only_wine_leftovers "$procs"; then
      if [[ ! -e $CPUDIR/$u.noted ]]; then
        mkdir -p "$CPUDIR" 2>/dev/null
        : > "$CPUDIR/$u.noted" 2>/dev/null
        log_line "event=sweep-skip unit=$u heavy_build_pid=$pid procs=$list reason=\"its heavy-build is gone but it holds processes that are not Wine leftovers, so it stays\""
      fi
      continue
    fi
    log_line "event=sweep unit=$u reason=wine-leftovers heavy_build_pid=$pid procs=$list"
    systemctl --user kill --signal=KILL "$u.scope" 2>/dev/null
    systemctl --user stop "$u.scope" 2>/dev/null
    rm -f -- "$JDIR/$u" "$CPUDIR/$u" "$CPUDIR/$u.noted"
  done
  # Forget the samples of scopes that are gone.
  for f in "$CPUDIR"/*; do
    [[ -e $f ]] || continue
    n=${f##*/}; n=${n%.noted}
    [[ $n == *.* ]] && continue
    [[ -d $BSLICE/$n.scope ]] || rm -f -- "$f"
  done
}

# Keeps $PSIF ("under_since last_sample"): since when CPU pressure (some
# avg10) has stayed at or under HEAVY_BUILD_MAX_CPU_PSI, as seen by waiters
# and running builds. A gap over HB_PSI_GAP_SECS between samples starts the
# count again. Sets cpu_quiet to the seconds it has stayed under (0 while
# over). Without a pressure file the rule is off.
psi_watch() {
  local v= l ip fp since= last= now=$EPOCHSECONDS
  cpu_quiet=999999
  while read -r l; do [[ $l == some\ * ]] && { v=${l#*avg10=}; v=${v%% *}; break; }; done 2>/dev/null < "$PROC/pressure/cpu"
  [[ $v =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
  cpu_quiet=0
  ip=${v%%.*}; fp=00
  [[ $v == *.* ]] && fp=${v#*.}00
  fp=${fp:0:2}
  {
    flock 5
    read -r since last 2>/dev/null < "$PSIF"
    if (( 10#$ip * 100 + 10#$fp > MAX_CPU_PSI * 100 )); then
      since=-
    elif [[ ! $since =~ ^[0-9]+$ || ! $last =~ ^[0-9]+$ ]] || (( now - last > PSI_GAP )); then
      since=$now
    fi
    printf '%s %s\n' "$since" "$now" > "$PSIF.tmp" && mv -f "$PSIF.tmp" "$PSIF"
  } 5>>"$PSIF.lock" 2>/dev/null
  [[ $since =~ ^[0-9]+$ ]] && cpu_quiet=$(( now - since ))
}

# ---------------------------------------------------------------- budget rule

# mem_watch: for the memory controller. Sets mc_swapin (disk swap-in pages/s
# over the oldest kept sample at least 10 s old, or -1), mc_fall (MiB that
# MemAvailable fell from its highest point in the last 15 s) and mc_harm_ago
# (seconds since a sample met the brake test, or 999999). Samples are kept
# for max(120, 2 x MC_CALM_SECS) seconds and written at most every 5 s, with
# a temp file and mv, like slice_cpu.
mem_watch() {
  local f=$CPUDIR/mem.samples k v p= a= full= t0 p0 a0 h0 keep=() base= last=0 hi=0 harm=0 win now=$EPOCHSECONDS
  mc_swapin=-1 mc_fall=0 mc_harm_ago=999999
  while read -r k v; do [[ $k == pswpin ]] && { p=$v; break; }; done 2>/dev/null < "$PROC/vmstat"
  while read -r k v _; do [[ $k == MemAvailable: ]] && { a=$v; break; }; done 2>/dev/null < "$MEMINFO"
  while read -r k v; do [[ $k == full ]] && { full=${v#*avg10=}; full=${full%% *}; break; }; done 2>/dev/null < "$PROC/pressure/memory"
  [[ $p =~ ^[0-9]+$ && $a =~ ^[0-9]+$ ]] || return 0
  [[ $full =~ ^[0-9]+(\.[0-9]+)?$ ]] || full=0
  win=$(( MC_CALM_SECS * 2 > 120 ? MC_CALM_SECS * 2 : 120 ))
  while read -r t0 p0 a0 h0; do
    [[ $t0 =~ ^[0-9]+$ && $p0 =~ ^[0-9]+$ && $a0 =~ ^[0-9]+$ ]] || continue
    (( t0 <= now && now - t0 <= win && p0 <= p )) || continue
    keep+=("$t0 $p0 $a0 ${h0:-0}"); last=$t0
    if [[ -z $base ]] && (( now - t0 >= 10 )); then base="$t0 $p0"; fi
    (( now - t0 <= 15 && a0 > hi )) && hi=$a0
    [[ ${h0:-0} == 1 ]] && mc_harm_ago=$(( now - t0 ))
  done 2>/dev/null < "$f"
  if [[ -n $base ]]; then
    read -r t0 p0 <<< "$base"
    mc_swapin=$(( (p - p0) / (now - t0) ))
  fi
  (( hi > a )) && mc_fall=$(( (hi - a) / 1024 ))
  if (( a < MC_BRAKE_GIB * 1048576 )) && { (( mc_swapin >= MC_BRAKE_SWAPIN )) || (( ${full%%.*} >= MC_BRAKE_FULL_PCT )); }; then
    harm=1 mc_harm_ago=0
  fi
  if (( now - last >= 5 || harm )); then
    keep+=("$now $p $a $harm")
    mkdir -p "$CPUDIR" 2>/dev/null
    printf '%s\n' "${keep[@]}" > "$f.$$" 2>/dev/null && mv -f "$f.$$" "$f" 2>/dev/null
  fi
  return 0
}

# slice_cpu: sets slice_cores (builds.slice CPU use in cores, two decimals,
# or empty) and slice_win (the seconds it was measured over). Samples
# ("epoch_us usage_usec", one per line, at least 5 s apart) live in
# $CPUDIR/builds.slice.samples, shared by every heavy-build, and are kept for
# 4x HEAVY_BUILD_SLICE_CPU_SECS. The rate is taken from the oldest kept sample
# that is at least SLICE_CPU_SECS old, so the window runs from SLICE_CPU_SECS
# to 4x that. Written with a temp file and mv, so a reader never sees half a file.
slice_cpu() {
  local f=$CPUDIR/builds.slice.samples k v u= now t0 u0 keep=() base= last=0
  slice_cores= slice_win=0
  while read -r k v; do [[ $k == usage_usec ]] && { u=$v; break; }; done 2>/dev/null < "$BSLICE/cpu.stat"
  [[ $u =~ ^[0-9]+$ ]] || return 0
  now=$(now_us)
  while read -r t0 u0; do
    [[ $t0 =~ ^[0-9]+$ && $u0 =~ ^[0-9]+$ ]] || continue
    (( t0 <= now && now - t0 <= SLICE_CPU_SECS * 4000000 && u0 <= u )) || continue
    keep+=("$t0 $u0"); last=$t0
    if [[ -z $base ]] && (( now - t0 >= SLICE_CPU_SECS * 1000000 )); then base="$t0 $u0"; fi
  done 2>/dev/null < "$f"
  if [[ -n $base ]]; then
    read -r t0 u0 <<< "$base"
    slice_win=$(( (now - t0) / 1000000 ))
    v=$(( (u - u0) * 100 / (now - t0) ))
    printf -v slice_cores '%d.%02d' $(( v / 100 )) $(( v % 100 ))
  fi
  if (( now - last >= 5000000 )); then
    keep+=("$now $u")
    mkdir -p "$CPUDIR" 2>/dev/null
    printf '%s\n' "${keep[@]}" > "$f.$$" 2>/dev/null && mv -f "$f.$$" "$f" 2>/dev/null
  fi
  return 0
}

# One line per running build. Own builds come from their state files
# ($JDIR/<unit>: "unit pid pidstart start mem cores wall cur_bytes
# cores60_milli stalled prio keys class"); a state file whose heavy-build is gone is
# removed once its scope is empty. Scopes in builds.slice without a live
# heavy-build (orphans, the old flock rule) come as "F unit cur_bytes cpu_usec
# age_s idle keys", where idle is 1 when the scope used under 0.05 cores over
# the last HB_IDLE_SECS, and keys come from a state file its heavy-build left
# behind (a SIGKILL skips the cleanup), so its lock keys stay held.
# A state file is removed (event=sweep) and charges nothing when its
# heavy-build is in the queue as a waiter, or when its scope has not run for
# HB_NO_SCOPE_SECS (60) since the build was let in: such a heavy-build runs no
# build, and its charge could hold the queue for good.
running_lines() {
  local f u pid st start em ec ew cur c60 stl pr ks cl seen=" " d age usec k v r idle t waiting=" "
  local -A left=()
  for t in "$QDIR"/[0-9]*; do
    [[ -e $t && $t != *.tmp ]] || continue
    t=${t##*/}; t=${t#*-}; waiting+="${t%%-*} "
  done
  for f in "$JDIR"/heavy-build-*; do
    [[ -e $f && $f != *.tmp ]] || continue
    cl=
    read -r u pid st start em ec ew cur c60 stl pr ks cl < "$f" || continue
    if [[ $(proc_start "$pid") != "$st" ]]; then
      if grep -qx 'populated 1' "$BSLICE/$u.scope/cgroup.events" 2>/dev/null; then left[$u]=${ks:--}
      else rm -f -- "$f"; fi
      continue
    fi
    if ! grep -qx 'populated 1' "$BSLICE/$u.scope/cgroup.events" 2>/dev/null; then
      if [[ $waiting == *" $pid "* ]]; then
        rm -f -- "$f"
        log_line "event=sweep unit=$u reason=waiting heavy_build_pid=$pid cores=$ec"
        continue
      fi
      if [[ $start =~ ^[0-9]+$ ]] && (( EPOCHSECONDS - start > NO_SCOPE_SECS )); then
        rm -f -- "$f"
        log_line "event=sweep unit=$u reason=no-scope heavy_build_pid=$pid cores=$ec age_s=$(( EPOCHSECONDS - start ))"
        continue
      fi
    fi
    seen+="$u "
    echo "R $u $start $em $ec $(( start + ${ew%.*} )) $cur $c60 $stl $pr ${ks:--} ${cl:--}"
  done
  for d in "$BSLICE"/*.scope; do
    [[ -d $d ]] || continue
    grep -qx 'populated 1' "$d/cgroup.events" 2>/dev/null || continue
    u=${d##*/}; u=${u%.scope}
    [[ $seen == *" $u "* ]] && continue
    read -r cur 2>/dev/null < "$d/memory.current" || cur=0
    usec=0
    while read -r k v; do [[ $k == usage_usec ]] && { usec=$v; break; }; done 2>/dev/null < "$d/cpu.stat"
    age=$(( EPOCHSECONDS - $(stat -c %Z -- "$d" 2>/dev/null || echo "$EPOCHSECONDS") ))
    [[ $usec =~ ^[0-9]+$ ]] || usec=0
    r=$(cpu_rate "$u" "$usec")
    idle=0
    [[ $r =~ ^[0-9]+$ ]] && (( r < 50 )) && idle=1
    echo "F $u $cur $usec $age $idle ${left[$u]:--}"
  done
}

# One line per live ticket: "W name arrival_s prio mem cores wall keys class".
# Tickets from an older heavy-build have no second line and get the defaults.
waiter_lines() {
  local t name l1 p m c w k cl
  for t in "$QDIR"/[0-9]*; do
    [[ -e $t && $t != *.tmp ]] || continue
    name=${t##*/}
    p= m= c= w= k= cl=
    { read -r l1; read -r p m c w k cl; } < "$t" 2>/dev/null
    echo "W $name $(( ${name%%-*} / 1000000000 )) ${p:-normal} ${m:-8} ${c:-8} ${w:-600} ${k:--} ${cl:--}"
  done
}

# The admission walk. Input: R, F and W lines. Prints
# "start|wait<TAB>rank<TAB>reason<TAB>untracked<TAB>prioheld<TAB>cap" for the
# waiter named by `me`. cap is the builds.slice cap used, as <GiB>G(max|high)
# or none.
# Each reason starts with a short kind and a colon. untracked lists the F scopes
# as unit:GiB, comma separated, or "-".
# shellcheck disable=SC2016
ADMIT_AWK='
function max(a, b) { return a > b ? a : b }
function min(a, b) { return a < b ? a : b }
# "avg10 avg60" of the some line of pressure file f, or "-1 -1".
function psi1060(f,   l, a, b, c, v) {
  v = "-1 -1"
  while ((getline l < f) > 0) if (l ~ /^some /) { split(l, a, " "); split(a[2], b, "="); split(a[3], c, "="); v = (b[2] + 0) " " (c[2] + 0) }
  close(f); return v
}
function psi10(f,   l, a, b, v) {
  v = -1
  while ((getline l < f) > 0) if (l ~ /^some /) { split(l, a, " "); split(a[2], b, "="); v = b[2] + 0 }
  close(f); return v
}
# full avg10 of pressure file f, or -1.
function psifull10(f,   l, a, b, v) {
  v = -1
  while ((getline l < f) > 0) if (l ~ /^full /) { split(l, a, " "); split(a[2], b, "="); v = b[2] + 0 }
  close(f); return v
}
# The pressure level (plevel from the coordinator) holds back waiter i: at
# pause every normal or low build, at slow a normal or low build while the
# last normal or low build started less than the slow gap ago (lastnc, from
# the last-normal-start file, or a pick in this walk). The gap is slowfastgap
# seconds while MemAvailable is above slowfastgib GiB, else slowgap seconds.
# "" when it may go on.
function pressure_why(i,   gap) {
  if (w_pr[i] == "high" || w_pr[i] == "critical") return ""
  if (plevel == "pause") return "pressure: level pause, only high and critical builds start (" preason ")"
  # The memory controller (memctl=1) takes the place of the slow level gap.
  if (memctl) {
    if (mcharmago < mccalm)
      return sprintf("pressure: memory controller brake, %d s ago under %d GiB free with disk swap-in at least %d pages/s or memory full at least %d%%; it waits until %d s calm", mcharmago, mcbrakegib, mcbrakeswapin, mcbrakefull, mccalm)
    if (mcfall > mcfallgib * 1024)
      return sprintf("pressure: memory controller, MemAvailable fell %.1f GiB in the last 15 s, the limit is %d", mcfall / 1024, mcfallgib)
    gap = (avail > 16) ? 15 : (avail >= 10) ? 30 : 60
    if (lastnc > 0 && lastnc <= now && now - lastnc < gap)
      return sprintf("pressure: memory controller, %.1f GiB free, one new build per %d s; the last one started %d s ago", avail, gap, now - lastnc)
    return ""
  }
  if (plevel != "slow") return ""
  gap = (avail > slowfastgib) ? slowfastgap : slowgap
  if (lastnc > 0 && lastnc <= now && now - lastnc < gap)
    return sprintf("pressure: level slow, %.1f GiB free, one new build per %d s; the last one started %d s ago (%s)", avail, gap, now - lastnc, preason)
  return ""
}
# Lock keys a build holds. A tree key tree:<top>#<suffix> also marks <top>
# as held by a suffixed build, so a plain tree:<top> waits for it.
function hold(keys, id,   n, k, i, b) {
  if (keys == "" || keys == "-") return
  n = split(keys, k, ",")
  for (i = 1; i <= n; i++) { busy[k[i]] = id; if ((b = index(k[i], "#")) > 0) subheld[substr(k[i], 1, b - 1)] = k[i] }
}
# The held key that blocks these keys, or "". The same key blocks. A plain
# tree:<top> and any tree:<top>#<suffix> block each other. Two different
# suffixes do not.
function clash(keys,   n, k, i, b) {
  if (keys == "" || keys == "-") return ""
  n = split(keys, k, ",")
  for (i = 1; i <= n; i++) {
    if (k[i] in busy) return k[i]
    if ((b = index(k[i], "#")) > 0) { if (substr(k[i], 1, b - 1) in busy) return substr(k[i], 1, b - 1) }
    else if (k[i] in subheld) return subheld[k[i]]
  }
  return ""
}
# The plain tree key that a waiter ahead (before place o in order) holds
# against these suffixed keys by the writer preference, or "".
function writer(keys, o,   n, k, i, b, t) {
  if (keys == "" || keys == "-") return ""
  n = split(keys, k, ",")
  for (i = 1; i <= n; i++) if ((b = index(k[i], "#")) > 0 && ((t = substr(k[i], 1, b - 1)) in wpos) && wpos[t] < o) return t
  return ""
}
# The real-use rule (realuse=1) also sums, per build, the memory still to
# come while it is young (grow: its estimate minus what it holds now, until it
# has run youngmin seconds or youngpct percent of its expected wall time,
# whichever is longer) and the cores of builds in their first warm seconds
# (cy: the estimate minus what the build already used inside the CPU window,
# which sliceavg counts). Only growpct percent of grow is charged. Y_held and
# Y_cpu go on top of what builds.slice really uses. fgrow is memory still to
# come for a scope with no heavy-build.
function addrun(id, start, mem, cores, end, cur, c60, stalled, prio, keys, pct, cls, fgrow,   n, k, i, held, tc, cc, grow, cy) {
  nr++
  grow = 0; cy = 0
  # An idle build (no CPU for HB_STALL_SECS) is charged only the memory it
  # holds. It is not counted as a job or a high build until it runs again.
  if (stalled == 1) { held = cur; tc = 0; cc = 0; T_idle++; idlerun = idlerun (idlerun == "" ? "" : ",") id }
  else {
    held = max(cur, mem); tc = max(0, mem * pct / 100 - cur)
    # The memory controller: only young builds still take more, a new one its
    # full estimate. Untracked scopes (start 0) keep their charge.
    if (memctl && start > 0) {
      tc = 0
      if (now - start < max(youngmin, (end - start) * youngpct / 100)) tc = max(0, mem * (now - start < mcnewfull ? 100 : pct) / 100 - cur)
    }
    cc = (c60 == "-" || now - start < warm) ? cores : max(0.25, c60 / 1000)
    if (start > 0 && now - start < max(youngmin, (end - start) * youngpct / 100)) grow = max(0, mem - cur) * growpct / 100
    # sliceavg already holds the CPU this build used inside its window, so a
    # young build adds only its estimate minus that share (floored at 0).
    if (start > 0 && (c60 == "-" || now - start < warm)) {
      cy = cores
      if (c60 != "-" && sliceavgwin > 0) cy = max(0, cores - c60 / 1000 * min(1, (now - start) / sliceavgwin))
    }
  }
  grow += fgrow
  Y_held += grow; Y_cpu += cy
  if (realuse && slicecur >= 0) held = cur + grow
  r_end[nr] = max(end, now + poll); r_tc[nr] = tc; r_cc[nr] = cc; r_held[nr] = held
  r_app[nr] = (cls == "app-run")
  r_cur[nr] = cur; r_high[nr] = (prio == "high" && stalled != 1); r_job[nr] = (stalled != 1)
  T_n += r_job[nr]; T_cpu += cc; T_tc += tc; T_held += held; T_high += r_high[nr]; T_aged += (prio ~ /:aged$/)
  T_nc += (prio !~ /^(high|critical)(:aged)?$/)
  T_app += (cls == "app-run")
  hold(keys, id)
}
function why_not(i, nrun, cpu, tc, held, av, nhigh) {
  # With no build running, MemAvailable >= solo is enough, except at pressure
  # level slow or pause: then the first build also needs the full tests below.
  # Idle builds are not counted in nrun, but while one runs the full tests
  # still apply, since it may use CPU again. For a starving head (untsolo set
  # by the walk) running untracked scopes do not count here.
  if (nrun - untsolo <= 0 && T_idle == 0 && av < solo) return sprintf("memory: %.1f GiB available, the first build needs %d", av, solo)
  if (nrun - untsolo <= 0 && T_idle == 0 && plevel != "slow" && plevel != "pause") return ""
  if (nrun >= maxjobs) return sprintf("jobs: %d builds run, the limit is %d", nrun, maxjobs)
  if (w_pr[i] == "high" && nhigh >= 2) return "high-cap: 2 high-priority builds already run"
  if (cpu + w_cores[i] > cpubudget) {
    if (cpureal) return sprintf("cores: needs %.1f, %.1f of %d in use (builds.slice used %.1f over the last %d s, plus %.1f for builds that started recently)", w_cores[i], cpu, cpubudget, sliceavg, sliceavgwin, cpu - sliceavg)
    return sprintf("cores: needs %.1f, %.1f of %d are charged", w_cores[i], cpu, cpubudget)
  }
  if (w_cores[i] >= 2 && cpupsi > maxcpupsi) return sprintf("cpu-pressure: %.1f%%, the limit is %d%%", cpupsi, maxcpupsi)
  if (w_cores[i] >= 2 && cpuquiet < cpuhold) return sprintf("cpu-pressure: %.1f%%, under the %d%% limit for %d s, it must stay under for %d s", cpupsi, maxcpupsi, cpuquiet, cpuhold)
  if (memctl) {
    if (av < mchard) return sprintf("memory: %.1f GiB available, the memory controller starts nothing under %d", av, mchard)
    if (av + swx - tc - w_mem[i] * mcstep / 100 < mctarget) return sprintf("memory: needs %.1f GiB, charged %d%%; %.1f available%s, %.1f still to come for young builds, target %d", w_mem[i], mcstep, av, swxnote, tc, mctarget)
  }
  else if (av + swx - tc - w_mem[i] < reserve) return sprintf("memory: needs %.1f GiB; %.1f available%s, %.1f still to come for running builds, reserve %d", w_mem[i], av, swxnote, tc, reserve)
  if (held + w_mem[i] > slicecap) {
    if (memreal) return sprintf("slice-cap: needs %.1f GiB; builds.slice uses %.1f GiB%s and running builds may take %.1f more, of the %.1f GiB cap (%s)", w_mem[i], slicecur, slicecache > 0 ? sprintf(" (%.1f GiB inactive cache not counted)", slicecache) : "", held - slicecur, slicecap, capsrc == "high" ? "MemoryHigh" : "MemoryMax")
    return sprintf("slice-cap: needs %.1f GiB; builds hold %.1f of the %.1f GiB builds.slice cap (%s)", w_mem[i], held, slicecap, capsrc == "high" ? "MemoryHigh" : "MemoryMax")
  }
  return ""
}
# The critical-first switch (cf=1): a normal or low waiter also needs a free
# non-critical slot and cfreserve GiB left after its estimate. "" when it may go on.
function cf_why(i, nnc, tc, av) {
  if (!cf || w_pr[i] == "high" || w_pr[i] == "critical") return ""
  if (nnc >= cfslots) return sprintf("critical-first: %d normal or low builds run, the limit is %d while critical builds go first", nnc, cfslots)
  if (av + swx - tc - w_mem[i] < cfreserve) return sprintf("critical-first: needs %.1f GiB; %.1f available%s, %.1f still to come for running builds, normal and low builds must leave %d", w_mem[i], av, swxnote, tc, cfreserve)
  return ""
}
function pick(i) {
  addrun(w_id[i], now, w_mem[i], w_cores[i], now + w_wall[i], 0, "-", 0, w_pr[i] (w_aged[i] ? ":aged" : ""), w_keys[i], tcpct, w_cls[i], 0); picked[i] = 1
  if (w_pr[i] != "high" && w_pr[i] != "critical") lastnc = now
}
# When enough running builds should have ended for waiter i to fit.
function shadow_time(i,   j, k, x, idx, nrun, cpu, tc, held, av, nh, u0) {
  for (j = 1; j <= nr; j++) idx[j] = j
  for (j = 2; j <= nr; j++) { x = idx[j]; for (k = j - 1; k >= 1 && r_end[idx[k]] > r_end[x]; k--) idx[k + 1] = idx[k]; idx[k + 1] = x }
  nrun = T_n; cpu = T_cpu; tc = T_tc; held = T_held; av = avail; nh = T_high
  # shadowlast: the head fits only once every build has ended. untsolo drops
  # as untracked scopes end, so none is taken off twice.
  shadowlast = 0; u0 = untsolo
  for (j = 1; j <= nr; j++) {
    k = idx[j]
    nrun -= r_job[k]; cpu -= r_cc[k]; tc -= r_tc[k]; held -= r_held[k]; av += r_cur[k]; nh -= r_high[k]
    if (r_unt[k] && untsolo > 0) untsolo--
    if (why_not(i, nrun, cpu, tc, held, av, nh) == "") { shadowlast = (j == nr); untsolo = u0; return r_end[k] }
  }
  untsolo = u0
  return nr > 0 ? r_end[idx[nr]] : now
}
# Why waiter i would still wait once every running build has ended except
# untracked scopes and, with keepapp, app runs (both can run for hours).
# "" when it would fit then.
function why_left(i, keepapp,   k, nrun, cpu, tc, held, av, nh) {
  nrun = T_n; cpu = T_cpu; tc = T_tc; held = T_held; av = avail; nh = T_high
  for (k = 1; k <= nr; k++) if (!r_unt[k] && !(keepapp && r_app[k])) { nrun -= r_job[k]; cpu -= r_cc[k]; tc -= r_tc[k]; held -= r_held[k]; av += r_cur[k]; nh -= r_high[k] }
  return why_not(i, nrun, cpu, tc, held, av, nh)
}
BEGIN {
  while ((getline l < meminfo) > 0) {
    split(l, f, " ")
    if (f[1] == "MemAvailable:") avail = f[2] / 1048576
    else if (f[1] == "SwapTotal:") swt = f[2]
    else if (f[1] == "SwapFree:") swf = f[2]
  }
  close(meminfo)
  # The cap is the lower of memory.max and memory.high; "max" or a missing
  # file means no limit. On a tie memory.max is named.
  slicecap = 1e9; capsrc = "none"
  if ((getline l < slicemax) > 0 && l ~ /^[0-9]+$/) { slicecap = l / 1073741824; capsrc = "max" }
  close(slicemax)
  if ((getline l < slicehigh) > 0 && l ~ /^[0-9]+$/ && l / 1073741824 < slicecap) { slicecap = l / 1073741824; capsrc = "high" }
  close(slicehigh)
  capinfo = (capsrc == "none") ? "none" : sprintf("%.1fG(%s)", slicecap, capsrc)
  # What builds.slice really holds now (memory.current), or -1.
  slicecur = -1
  if (slicecurfile != "" && (getline l < slicecurfile) > 0 && l ~ /^[0-9]+$/) slicecur = l / 1073741824
  if (slicecurfile != "") close(slicecurfile)
  # Page cache the kernel can drop at once (memory.stat inactive_file) does
  # not count against the cap when slicestatfile is set.
  slicecache = 0
  if (slicecur >= 0 && slicestatfile != "") {
    while ((getline l < slicestatfile) > 0) {
      split(l, f, " ")
      if (f[1] == "inactive_file" && f[2] ~ /^[0-9]+$/) { slicecache = f[2] / 1073741824; break }
    }
    close(slicestatfile)
    if (slicecache > slicecur) slicecache = slicecur
    slicecur -= slicecache
  }
  if (sliceavg == "") sliceavg = -1
  memctl += 0
  if (memctl) {
    if (mctarget == "") mctarget = 6
    if (mchard == "") mchard = 3
    if (mcstep == "") mcstep = 50
    if (mcnewfull == "") mcnewfull = 60
    if (mcbrakegib == "") mcbrakegib = 10
    if (mcbrakeswapin == "") mcbrakeswapin = 2000
    if (mcbrakefull == "") mcbrakefull = 10
    if (mccalm == "") mccalm = 60
    if (mcfallgib == "") mcfallgib = 2
    if (mcharmago == "") mcharmago = 999999
    mcharmago += 0; mcfall += 0
  }
  if (growpct == "") growpct = 100
  sliceavg += 0
  # Swap headroom: while system memory pressure (some avg10 and avg60) is
  # under 1.0%, swpct percent of SwapFree, at most swcap GiB, counts as
  # available for the memory and critical-first checks. Never when the
  # pressure is higher or cannot be read.
  swx = 0; swxnote = ""
  split(mempsifile == "" ? "-1 -1" : psi1060(mempsifile), mp, " ")
  if (plevel != "slow" && plevel != "pause" && swpct > 0 && swcap > 0 && swf > 0 && mp[1] >= 0 && mp[1] < 1.0 && mp[2] >= 0 && mp[2] < 1.0) {
    swx = swf / 1048576 * swpct / 100; if (swx > swcap) swx = swcap
    swxnote = sprintf(" (+%.1f swap headroom)", swx)
  }
  cpupsi = psi10(cpupsifile); if (cpupsi < 0) cpupsi = 0
  claudepsi = psifull10(claudepsifile); sessionpsi = psifull10(sessionpsifile)
}
$1 == "R" { addrun($2, $3, $4, $5, $6, $7 / 1073741824, $8, $9, $10, $11, tcpct, $12, 0) }
# A scope without a live heavy-build: charged its current memory plus 2 GiB still to come.
# An idle one only holds its current memory (and its lock keys); it is not a running build.
$1 == "F" && $6 == 1 {
  T_held += $3 / 1073741824
  hold($7, $2)
  untracked = untracked (untracked == "" ? "" : ",") sprintf("%s:%.1fG:idle", $2, $3 / 1073741824)
  next
}
$1 == "F" {
  c = ($5 >= 10) ? $4 / 1e6 / $5 * 1000 : "-"
  addrun($2, 0, $3 / 1073741824 + 2, 8, now + 600, $3 / 1073741824, c, 0, "normal", ($7 == "" ? "-" : $7), 100, "-", 2)
  r_unt[nr] = 1; T_unt++
  untracked = untracked (untracked == "" ? "" : ",") sprintf("%s:%.1fG", $2, $3 / 1073741824)
}
$1 == "W" {
  nw++; w_id[nw] = $2; w_arr[nw] = $3; p = $4
  if (p == "low" && now - $3 >= lowage) p = "normal"
  w_pr[nw] = p; w_rank[nw] = (p == "high") ? 0 : (p == "critical") ? 1 : (p == "low") ? 3 : 2
  # An aged critical build (waited critage seconds) goes ahead of high ones.
  w_caged[nw] = (p == "critical" && critage > 0 && now - $3 >= critage)
  if (w_caged[nw]) w_rank[nw] = -1
  w_mem[nw] = $5 + 0; w_cores[nw] = $6 + 0; w_wall[nw] = $7 + 0; w_keys[nw] = $8; w_cls[nw] = $9
}
END {
  # The real-use rule: the slice-cap and cores checks start from what
  # builds.slice uses now (memory.current, and its CPU use over the last
  # sliceavgwin seconds) plus what young builds are still expected to take,
  # instead of the sum of charged estimates. Without a reading, the old sums.
  memreal = (realuse && slicecur >= 0); cpureal = (realuse && sliceavg >= 0)
  if (memreal) T_held = slicecur + Y_held
  if (cpureal) T_cpu = sliceavg + Y_cpu
  # The aging slot: the oldest normal or low waiter that has waited agesecs
  # goes ahead of other normal and low ones but behind critical ones (rank
  # 1.5), while fewer than ageslots builds let in this way run. A running one
  # has prio <prio>:aged.
  for (n = ageslots - T_aged; n > 0; n--) {
    a = 0
    for (i = 1; i <= nw; i++) if (w_rank[i] >= 2 && now - w_arr[i] >= agesecs && (!a || w_id[i] < w_id[a])) a = i
    if (!a) break
    w_rank[a] = 1.5; w_aged[a] = 1
  }
  for (i = 1; i <= nw; i++) ord[i] = i
  for (i = 2; i <= nw; i++) {
    x = ord[i]
    for (j = i - 1; j >= 1 && (w_rank[ord[j]] > w_rank[x] || (w_rank[ord[j]] == w_rank[x] && w_id[ord[j]] > w_id[x])); j--) ord[j + 1] = ord[j]
    ord[j + 1] = x
  }
  # Writer preference: the first waiter in order with a plain tree:<top> key
  # holds that tree. No waiter behind it with a tree:<top>#<suffix> key may
  # start first. Suffixed waiters ahead of it keep their place. A waiter the
  # pressure level holds back takes no writer preference, so it cannot block
  # a high or critical build behind it.
  for (o = 1; o <= nw; o++) {
    i = ord[o]
    if (w_keys[i] == "" || w_keys[i] == "-") continue
    if (pressure_why(i) != "") continue
    n = split(w_keys[i], k, ",")
    for (j = 1; j <= n; j++) if (k[j] ~ /^tree:/ && index(k[j], "#") == 0 && !(k[j] in wpref)) { wpref[k[j]] = i; wpos[k[j]] = o }
  }
  gate = ""
  if (swt > 0 && (0.9 * swt - (swt - swf)) / 1048576 < minswap)
    gate = sprintf("swap: %.1f GiB left before 90%% of swap is used, need %d", (0.9 * swt - (swt - swf)) / 1048576, minswap)
  else if (claudepsi >= maxmempsi) gate = sprintf("interactive: claude.slice memory pressure (full) %.1f%%, the limit is %d%%", claudepsi, maxmempsi)
  else if (sessionpsi >= maxmempsi) gate = sprintf("interactive: session.slice memory pressure (full) %.1f%%, the limit is %d%%", sessionpsi, maxmempsi)
  # critw: the first critical waiter that waits for job slots, cores or CPU
  # pressure. Normal and low builds may not start ahead of it.
  headi = 0; starving = 0; shadow = 0; critw = 0; critmempass = 0; bound = ""
  for (o = 1; o <= nw; o++) {
    i = ord[o]
    if (gate != "") { why[i] = gate; continue }
    bk = clash(w_keys[i])
    if (bk != "") { why[i] = "key: lock key " bk " is busy (" busy[bk] ")"; continue }
    # App runs (headless MotionCatalyst) last for hours. At most maxapp of them
    # hold job slots. One that waits for this keeps its place but is never the
    # head of the line, so it cannot starve builds behind it.
    if (w_cls[i] == "app-run" && maxapp > 0 && T_app >= maxapp) { why[i] = sprintf("app-cap: %d app runs hold job slots, the limit is %d", T_app, maxapp); continue }
    # The pressure level: a held normal or low build keeps its place but is
    # never the head of the line, so high and critical builds behind it go on.
    pw = pressure_why(i)
    if (pw != "") { why[i] = pw; continue }
    # The high-cap is a share rule, not a resource limit. A high build that
    # waits for it keeps its place but is never the head of the line.
    if (w_pr[i] == "high" && T_high >= 2) { why[i] = "high-cap: 2 high-priority builds already run"; continue }
    wk = writer(w_keys[i], o)
    if (wk != "") { why[i] = "writer: " w_id[wpref[wk]] " waits for " wk ", so no new build with a suffixed key in that tree starts first"; continue }
    if (critw && w_rank[i] > 1) { why[i] = sprintf("critical: %s from a critical session waits for %s, so it goes first", w_id[critw], critwhat); continue }
    if (!headi) {
      # An aged head never starves the queue: high and critical builds that
      # fit pass it, so it holds only the slot it gets next. With the starve
      # fix (starvefix=1) it does, as any other head that waited that long.
      st = (now - w_arr[i] >= starve && (starvefix || !w_aged[i]))
      untsolo = (starvefix && st) ? T_unt : 0
      r = why_not(i, T_n, T_cpu, T_tc, T_held, avail, T_high)
      if (r == "") r = cf_why(i, T_nc, T_tc, avail)
      if (r == "") { pick(i); why[i] = (untsolo > 0 && T_n - T_unt <= 0) ? "fits: no tracked build runs, and untracked scopes do not hold back a build that has waited this long" : "fits: next in order"; untsolo = 0; continue }
      headi = i; why[i] = r; shadow = shadow_time(i); starving = st; untsolo = 0
      # The queue never holds an empty machine: when no tracked build runs
      # and the head still does not fit (pressure level slow or pause, or
      # less than solo GiB free), builds behind it that fit may start. No
      # build is due to end, so the shadow time gives no bound.
      if (starvefix && T_n - T_unt <= 0 && T_idle == 0) { starving = 0; shadow = now + 86400 }
      # Starve bound (starvebound=1): a starving head that waits for memory
      # holds back only builds whose end lets it in. nofit: it does not fit
      # even with no build running, so it holds back nothing. app: it fits
      # only once the app runs have ended, so it holds back new app runs and
      # nothing else. Both log the reason in its waiting line. On 2026-10-26
      # two such heads held 20 to 44 builds for 2 to 3 h behind app runs and
      # memory outside builds.slice.
      if (starvebound && starving && r ~ /^(memory|slice-cap):/) {
        untsolo = T_unt
        rk = why_left(i, 1)
        if (rk ~ /^(memory|slice-cap):/) bound = (why_left(i, 0) == "") ? "app" : "nofit"
        untsolo = 0
        if (bound != "") { starving = 0; shadow = now + 86400 }
      }
      if (bound == "nofit") why[i] = r "; by the current numbers it would not fit even if every build ended, so builds behind it may start. Lower its memory use (for example CARGO_BUILD_JOBS or --test-threads); it can start when memory outside builds frees up"
      else if (bound == "app") why[i] = r sprintf("; it fits only once the running app %s (%d) %s ended, so no new app run starts and other builds may pass it", T_app == 1 ? "run" : "runs", T_app, T_app == 1 ? "has" : "have")
      else if (starvefix && shadowlast && T_n - T_unt > 0 && r ~ /^(memory|slice-cap):/) why[i] = r "; it fits only when no other build runs, so it may wait long (lower its memory use, for example CARGO_BUILD_JOBS or --test-threads)"
      # An aged critical head that waits for memory lets critical builds that fit pass it.
      critmempass = (starving && w_caged[i] && r ~ /^(memory|slice-cap):/)
      if (w_pr[i] == "critical" && r ~ /^(jobs|cores|cpu-pressure):/) { critw = i; critwhat = substr(r, 1, index(r, ":") - 1) }
      continue
    }
    if (critmempass && w_pr[i] == "critical") {
      r = why_not(i, T_n, T_cpu, T_tc, T_held, avail, T_high)
      if (r == "") { pick(i); why[i] = "fits: the aged critical build " w_id[headi] " waits for memory, and critical builds that fit may pass it"; continue }
    }
    if (starving) { why[i] = sprintf("starve: %s has waited %d min, so nothing may pass it", w_id[headi], (now - w_arr[headi]) / 60); continue }
    if (bound == "app" && w_cls[i] == "app-run") { why[i] = sprintf("starve: %s waits for the running app runs to end, so no new app run starts", w_id[headi]); continue }
    r = why_not(i, T_n, T_cpu, T_tc, T_held, avail, T_high)
    if (r == "") r = cf_why(i, T_nc, T_tc, avail)
    if (r != "" && !critw && w_pr[i] == "critical" && r ~ /^(jobs|cores|cpu-pressure):/) { critw = i; critwhat = substr(r, 1, index(r, ":") - 1) }
    if (r != "") { why[i] = r; continue }
    if (w_aged[headi] && w_rank[i] <= 1) { pick(i); why[i] = "fits: the aged build " w_id[headi] " does not fit yet, and " w_pr[i] " builds may pass it"; continue }
    if (now + 1.5 * w_wall[i] > shadow) { why[i] = sprintf("behind: it would not end before %s can start, in about %d min", w_id[headi], (shadow - now) / 60); continue }
    pick(i); why[i] = "backfill: it fits and should end before " w_id[headi] " can start"
  }
  if (untracked == "") untracked = "-"
  for (o = 1; o <= nw; o++) {
    i = ord[o]
    if (w_id[i] != me) continue
    if (picked[i] && w_aged[i]) why[i] = sprintf("aged: it waited %d min, so it goes ahead of other normal builds (%s)", (now - w_arr[i]) / 60, why[i])
    # prioheld: this build waits only because a higher-priority build is
    # ahead of it, or for the critical-first switch, so its give-up clock
    # does not run. While the switch is on, a normal or low build that waits
    # for memory counts as held too: the critical builds it lets in take that
    # memory. On 2026-10-20 a 26.1 beta test gave up after 7201 s of such waits.
    kind = substr(why[i], 1, index(why[i], ":") - 1); ph = 0
    if (!picked[i] && kind !~ /^(swap|interactive|key|writer|app-cap)$/ && (kind == "critical" || kind == "critical-first" || kind == "pressure" || (cf && kind == "memory" && w_pr[i] != "high" && w_pr[i] != "critical") || (headi && headi != i && w_rank[headi] < w_rank[i]))) ph = 1
    # The pressure level holds this build whatever reason is shown (a swap or
    # interactive gate may come first), so the clock does not run.
    if (!picked[i] && pressure_why(i) != "") ph = 1
    if (picked[i] && swx > 0) why[i] = why[i] swxnote
    if (idlerun != "") why[i] = why[i] " (idle, not counted as a job or a high build: " idlerun ")"
    printf "%s\t%d\t%s\t%s\t%d\t%s\n", (picked[i] ? "start" : "wait"), o, why[i], untracked, ph, capinfo
    exit
  }
  printf "wait\t0\tqueue: no ticket for this build\t%s\t0\t%s\n", untracked, capinfo
}'

# Runs the budget rule for this waiter. Sets dec (start or wait), rank, why,
# capinfo (the builds.slice cap used) and
# prioheld (1 when only higher-priority builds ahead hold it back).
decide() {
  local out lastnc=0
  sweep_stale
  plevel=-
  if hold_on; then
    dec=wait rank=0 why="hold: new builds are on hold: $(head -c 200 "$HOLD" 2>/dev/null)" untracked=- prioheld=0 capinfo=-
    return
  fi
  critical_first_on
  pressure_level
  { read -r lastnc || [[ -n $lastnc ]]; } 2>/dev/null < "$NCSTART"
  [[ $lastnc =~ ^[0-9]{1,15}$ ]] || lastnc=0
  psi_watch
  slice_cores= slice_win=0
  (( REAL_USE )) && slice_cpu
  mc_swapin=-1 mc_fall=0 mc_harm_ago=999999
  (( MEM_CONTROLLER )) && mem_watch
  out=$( { running_lines; waiter_lines; } | awk -v now="$EPOCHSECONDS" -v me="${ticket##*/}" \
    -v cpuquiet="$cpu_quiet" -v cpuhold="$CPU_PSI_SECS" \
    -v meminfo="$MEMINFO" -v slicemax="$BSLICE/memory.max" -v slicehigh="$BSLICE/memory.high" -v cpupsifile="$PROC/pressure/cpu" \
    -v claudepsifile="$USVC/claude.slice/memory.pressure" -v sessionpsifile="$USVC/session.slice/memory.pressure" \
    -v plevel="$plevel" -v preason="$preason" -v lastnc="$lastnc" \
    -v slowgap="$SLOW_GAP_SECS" -v slowfastgap="$SLOW_FAST_GAP_SECS" -v slowfastgib="$SLOW_FAST_MIN_GIB" \
    -v maxjobs="$MAX_JOBS" -v cpubudget="$CPU_BUDGET" -v reserve="$MEM_RESERVE_GIB" \
    -v maxcpupsi="$MAX_CPU_PSI" -v maxmempsi="$MAX_MEM_PSI" -v starve="$STARVE" -v starvefix="$STARVE_FIX" -v starvebound="$STARVE_BOUND" -v solo="$SOLO_MEM_GIB" \
    -v minswap="$MIN_SWAP_ROOM_GIB" -v warm="$WARMUP" -v poll="$POLL" -v lowage=1800 -v tcpct="$TC_PCT" \
    -v agesecs="$AGE_SECS" -v ageslots="$AGE_SLOTS" -v critage="$CRIT_AGE_SECS" -v maxapp="$MAX_APP_RUNS" \
    -v cf="$cf_on" -v cfslots="$cf_slots" -v cfreserve="$cf_reserve" \
    -v mempsifile="$PROC/pressure/memory" -v swpct="$SWAP_HEADROOM_PCT" -v swcap="$SWAP_HEADROOM_GIB" \
    -v realuse="$REAL_USE" -v slicecurfile="$( (( REAL_USE )) && echo "$BSLICE/memory.current")" \
    -v slicestatfile="$( (( REAL_USE && SLICE_EXCLUDE_INACTIVE_FILE )) && echo "$BSLICE/memory.stat")" \
    -v sliceavg="$slice_cores" -v sliceavgwin="$slice_win" -v youngpct="$YOUNG_PCT" -v youngmin="$YOUNG_MIN_SECS" -v growpct="$YOUNG_GROW_PCT" \
    -v memctl="$MEM_CONTROLLER" -v mctarget="$MC_TARGET_GIB" -v mchard="$MC_HARD_GIB" -v mcstep="$MC_STEP_PCT" -v mcnewfull="$MC_NEW_FULL_SECS" \
    -v mcbrakegib="$MC_BRAKE_GIB" -v mcbrakeswapin="$MC_BRAKE_SWAPIN" -v mcbrakefull="$MC_BRAKE_FULL_PCT" -v mccalm="$MC_CALM_SECS" -v mcfallgib="$MC_FALL_GIB" \
    -v mcharmago="$mc_harm_ago" -v mcfall="$mc_fall" "$ADMIT_AWK")
  IFS=$'\t' read -r dec rank why untracked prioheld capinfo <<< "$out"
  if [[ -z ${dec:-} ]]; then dec=wait rank=0 why="error: the budget check printed nothing"; fi
  [[ ${prioheld:-} == 1 ]] || prioheld=0
  untracked=${untracked:--} capinfo=${capinfo:--}
}

# ---------------------------------------------------------------- logging

# Appends one line to the decision log of the current mode.
log_line() {
  local f=$STATE/$MODE.log sz
  mkdir -p "$STATE" 2>/dev/null || return 0
  {
    flock 6
    printf '%(%Y-%m-%dT%H:%M:%S%z)T mode=%s job=%s %s session=%s agent=%s\n' -1 "$MODE" "$jobid" "$*" "${own_session:--}" "${own_agent:--}" >&6
    sz=$(stat -c %s -- "$f" 2>/dev/null || echo 0)
    if (( sz > 20000000 )); then tail -n 50000 -- "$f" > "$f.tmp" && mv -f -- "$f.tmp" "$f"; fi
  } 6>>"$f"
}

# True while the manager's hold file is in force: it exists, and it has no
# expires=<epoch> line or that time has not come. On 2026-10-14 a hold meant
# for 18 min stayed 36 min because the manager missed its check; about 28
# builds waited. Logs "hold expired" once per expiry time.
hold_on() {
  local line exp=
  [[ -e $HOLD ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^expires=([0-9]{1,15})([^0-9]|$) ]]; then exp=$(( 10#${BASH_REMATCH[1]} )); break; fi
  done 2>/dev/null < "$HOLD"
  [[ -n $exp ]] || return 0
  (( EPOCHSECONDS < exp )) && return 0
  if [[ $hold_expired_logged != "$exp" ]]; then
    hold_expired_logged=$exp
    say "hold expired at $(printf '%(%H:%M:%S)T' "$exp"); going on although $HOLD is still there"
    log_line "event=hold-expired expires=$exp reason=\"hold expired; the hold file is still there\""
  fi
  return 1
}

# The coordinator's pressure level (see "Pressure level" in the header). Sets
# plevel to normal, slow, pause, stale or none, and preason to the reason.
# - A pressure hold counts (pause) only with a valid expires= that has not
#   come and is at most PHOLD_MAX_SECS (600) away. An empty or malformed hold,
#   or one that vanishes while it is read, counts as no hold.
# - A level file updated within PRESSURE_STALE_SECS (30) gives its level. One
#   older than that but updated within PRESSURE_STALE_SLOW_SECS (600) is slow:
#   the coordinator may be stuck. Older than that, or updated= in the future,
#   it is stale and has no effect. No level file, or HEAVY_BUILD_PRESSURE=0,
#   is none.
# Neither file ever stops a running build.
pressure_level() {
  local line= exp= l= u= age
  plevel=none preason=
  (( PRESSURE )) || return 0
  if [[ -e $PHOLD ]] && { IFS= read -r line || [[ -n $line ]]; } 2>/dev/null < "$PHOLD"; then
    if [[ $line =~ ^expires=([0-9]{1,15})([^0-9]|$) ]]; then
      exp=$(( 10#${BASH_REMATCH[1]} ))
      line=${line:$(( 8 + ${#BASH_REMATCH[1]} ))}; line=${line# }
      if (( EPOCHSECONDS < exp && exp - EPOCHSECONDS <= PHOLD_MAX_SECS )); then
        plevel=pause preason=${line:0:160}
        preason=${preason//\"/\'}
        return 0
      fi
    fi
  fi
  line=
  [[ -e $PLEVEL_FILE ]] || return 0
  { IFS= read -r line || [[ -n $line ]]; } 2>/dev/null < "$PLEVEL_FILE" || return 0
  [[ $line =~ (^|[[:space:]])level=(normal|slow|pause)([[:space:]]|$) ]] && l=${BASH_REMATCH[2]}
  [[ $line =~ (^|[[:space:]])updated=([0-9]{1,15})([[:space:]]|$) ]] && u=$(( 10#${BASH_REMATCH[2]} ))
  [[ -n $l && -n $u ]] || return 0
  age=$(( EPOCHSECONDS - u ))
  if (( age < -5 || age > PRESSURE_STALE_SLOW_SECS )); then plevel=stale; return 0; fi
  if (( age > PRESSURE_STALE_SECS )); then
    plevel=slow preason="the level file was not updated for ${age} s, so slow until ${PRESSURE_STALE_SLOW_SECS} s"
    return 0
  fi
  plevel=$l
  [[ $line =~ reason=\"([^\"]*)\" ]] && preason=${BASH_REMATCH[1]:0:160}
  return 0
}

# The critical-first switch ($CRITF, see the header). Sets cf_on (1 while the
# file exists and its expires= time, if any, has not come), cf_slots
# (noncrit_slots=, default 1) and cf_reserve (reserve_gib=, default 12).
# Logs "critical-first expired" once per expiry time. Returns 0 when on.
critical_first_on() {
  local line exp=
  cf_on=0 cf_slots=1 cf_reserve=12
  [[ -e $CRITF ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    if [[ -z $exp && $line =~ ^expires=([0-9]{1,15})([^0-9]|$) ]]; then exp=$(( 10#${BASH_REMATCH[1]} ))
    elif [[ $line =~ ^noncrit_slots=([0-9]{1,3})[[:space:]]*$ ]]; then cf_slots=$(( 10#${BASH_REMATCH[1]} ))
    elif [[ $line =~ ^reserve_gib=([0-9]{1,4})[[:space:]]*$ ]]; then cf_reserve=$(( 10#${BASH_REMATCH[1]} ))
    fi
  done 2>/dev/null < "$CRITF"
  if [[ -n $exp ]] && (( EPOCHSECONDS >= exp )); then
    if [[ $critf_expired_logged != "$exp" ]]; then
      critf_expired_logged=$exp
      log_line "event=critical-first-expired expires=$exp reason=\"critical-first expired; the switch file is still there\""
    fi
    return 1
  fi
  cf_on=1
}

# Logs the budget decision when it, its reason kind or the actual outcome
# changes. $1 is what actually happened: wait or start.
log_decision() {
  local k="$dec|${why%%:*}|$1|$MODE|${capinfo:--}|$plevel" since= appcpu=
  if [[ ${cls:-} == app-run ]]; then
    if (( APP_CPU_QUOTA > 0 )); then appcpu=" cpu_quota=${APP_CPU_QUOTA}%"; else appcpu=" cpu_quota=none"; fi
  fi
  if [[ $dec == start ]]; then
    [[ -n $would_since ]] || would_since=$EPOCHSECONDS
  else
    would_since=
  fi
  [[ $k == "$last_log" ]] && return
  last_log=$k
  [[ -n $would_since ]] && since=" would_start_for=$(( EPOCHSECONDS - would_since ))s"
  [[ $dec == start && $why == aged:* ]] && since+=" aged=1"
  log_line "decision=$dec reason=\"$why\" cap=${capinfo:--} pressure=$plevel actual=$1${since} rank=$rank est=${est_mem}G/${est_cores}c/${est_wall}s($est_src) prio=$PRIO${appcpu} keys=$keys_csv untracked=${untracked:--} cmd=\"$cmdline\""
}

# Logs a refusal as decision=refuse, then exits. $1 is the reason, $2 the
# exit code (default 75; 77 for the --wait-timeout).
refuse() {
  log_line "decision=refuse reason=\"$1\" pressure=$plevel waited_s=$(( EPOCHSECONDS - queued_ts )) stuck_s=${stuck:-0} rank=${pos:-0} prio=$PRIO keys=$keys_csv cmd=\"$cmdline\""
  exit "${2:-75}"
}

# ---------------------------------------------------------------- job state

write_state() {
  mkdir -p "$JDIR" 2>/dev/null
  printf '%s %s %s %s %s %s %s %s %s %s %s %s %s\n' "$unit" "$$" "$mystart" "$start_ts" "$est_mem" "$est_cores" \
    "$est_wall" "$1" "$2" "$3" "$state_prio" "$keys_csv" "$cls" > "$JDIR/$unit.tmp" && mv -f "$JDIR/$unit.tmp" "$JDIR/$unit"
}

now_us() { local t=${EPOCHREALTIME//[!0-9]/}; echo "${t#0}"; }

# Wine prefixes in our scope that have lost their wineserver, one per line.
# A process's prefix is the WINEPREFIX in its own /proc environ, else
# $wine_fb, the prefix heavy-build gave the job (its WINEPREFIX, unless
# run-tests.sh ignores that one). A process with neither is not guessed to
# use ~/.wine: Wine's own children (services.exe, winedevice.exe, test hosts
# started with their own environment) often lack WINEPREFIX and reach their
# wineserver through the inherited WINESERVERSOCKET instead. On 2026-10-14
# that guess warned "the wineserver for ~/.wine is gone" for a run whose own
# prefix was fine. Such processes are counted on a last line "?<count>"
# instead, so the caller can log that it skipped them.
# Only the run's own prefixes ($wine_own, one per line, and <$wine_runs>-run<n>
# when run-tests.sh may have moved there) are printed plainly, and only when
# some process in them is more than a Wine service process (WINE_LEFTOVERS):
# a prefix with only those left is shutting down, not hung. Any other prefix
# without a wineserver is printed as "~<prefix>", for the log only. On
# 2026-10-20 a test-fallback.sh run stopped a UI prefix of its own, and its
# winedevice.exe, still in the scope for a few seconds, set off the warning.
wine_orphans() {
  local d=$1 pid comm p l f fb own o mine nopfx=0
  local -A comm_of=() pfx_of=() busy=() seen=()
  fb=${wine_fb-${WINEPREFIX:-}}
  own=${wine_own-$fb}
  while read -r pid; do
    read -r comm 2>/dev/null < "$PROC/$pid/comm" || continue
    [[ $comm == *.exe || $comm == wine || $comm == wine64 || $comm == wine*-preloader ]] || continue
    comm_of[$pid]=$comm
  done 2>/dev/null < "$d/cgroup.procs"
  (( ${#comm_of[@]} )) || return 0
  local files=()
  for pid in "${!comm_of[@]}"; do files+=("$PROC/$pid/environ"); done
  while IFS= read -r -d '' l; do
    f=${l%%:WINEPREFIX=*}
    pid=${f%/environ}; pid=${pid##*/}
    [[ -n ${pfx_of[$pid]+x} ]] || pfx_of[$pid]=${l#"$f":WINEPREFIX=}
  done < <(grep -a -z -H '^WINEPREFIX=' "${files[@]}" 2>/dev/null)
  for pid in "${!comm_of[@]}"; do
    if [[ -n ${pfx_of[$pid]+x} ]]; then p=${pfx_of[$pid]}
    elif [[ -n $fb ]]; then p=$fb
    else nopfx=$(( nopfx + 1 )); continue
    fi
    p=${p%/}
    [[ -n $p ]] || continue
    seen[$p]=1
    [[ $WINE_LEFTOVERS == *" ${comm_of[$pid]} "* ]] || busy[$p]=1
  done
  for p in "${!seen[@]}"; do
    [[ -d $p ]] || continue
    [[ -n $(wineservers_for "$p") ]] && continue
    mine=
    while IFS= read -r o; do
      [[ -n $o && $p == "${o%/}" ]] && { mine=1; break; }
    done <<< "$own"
    [[ -n ${wine_runs:-} && $p == "${wine_runs%/}"-run[0-9]* ]] && mine=1
    if [[ -z $mine ]]; then echo "~$p"
    elif [[ -n ${busy[$p]:-} ]]; then echo "$p"
    fi
  done | LC_ALL=C sort
  (( nopfx > 0 )) && echo "?$nopfx"
  return 0
}

# Reads our scope's cgroup: memory, CPU time, the 60 s core average, the stall
# test and the Wine orphan test. Rewrites the state file.
sample_scope() {
  local d=$BSLICE/$unit.scope cur=0 pk u= now k v c60=- n rate orph unknown others p idle_s wp fl= sh= dt= wb= sw=
  [[ -d $d ]] || return 0
  read -r cur 2>/dev/null < "$d/memory.current" || cur=
  [[ $cur =~ ^[0-9]+$ ]] || { cur=0; fl=bad; }
  if read -r pk 2>/dev/null < "$d/memory.peak" && [[ $pk =~ ^[0-9]+$ ]] && (( pk > peak )); then peak=$pk; fi
  (( cur > peak )) && peak=$cur
  # Non-file memory: memory.current minus file pages, plus shmem, dirty and
  # writeback pages (counted in file, but not quick to drop) and swap. The
  # page cache of files the build writes is left out (history column 13).
  [[ $fl == bad ]] || while read -r k v; do
    case $k in file) fl=$v ;; shmem) sh=$v ;; file_dirty) dt=$v ;; file_writeback) wb=$v ;; esac
  done 2>/dev/null < "$d/memory.stat"
  read -r sw 2>/dev/null < "$d/memory.swap.current" || sw=0
  [[ $sw =~ ^[0-9]+$ ]] || sw=0
  if [[ $fl =~ ^[0-9]+$ && $sh =~ ^[0-9]+$ && $dt =~ ^[0-9]+$ && $wb =~ ^[0-9]+$ ]]; then
    v=$(( cur - fl + sh + dt + wb + sw )); (( v < 0 )) && v=0
    (( v > ${peak_nf:-0} )) && peak_nf=$v
    nf_n=$(( ${nf_n:-0} + 1 ))
  fi
  while read -r k v; do [[ $k == usage_usec ]] && { u=$v; break; }; done 2>/dev/null < "$d/cpu.stat"
  [[ $u =~ ^[0-9]+$ ]] || return 0
  now=$(now_us)
  usec_last=$u
  S_t+=("$now"); S_u+=("$u")
  n=${#S_t[@]}
  while (( n - s_lo > 2 )) && (( now - S_t[s_lo + 1] >= 60000000 )); do s_lo=$(( s_lo + 1 )); done
  if (( now - S_t[s_lo] >= 1000000 )); then
    c60=$(( (u - S_u[s_lo]) * 1000 / (now - S_t[s_lo]) ))
  fi
  if (( n >= 2 )) && (( now > S_t[n - 2] )); then
    rate=$(( (u - S_u[n - 2]) * 1000 / (now - S_t[n - 2]) ))
    if (( rate >= 50 )); then
      last_active=$now
      stalled_cpu=0
    elif (( now - last_active >= STALL_SECS * 1000000 )) && (( ! stalled_cpu )); then
      stalled_cpu=1
      if [[ -z $stall_warned ]]; then
        stall_warned=1
        # An idle app (MC waiting for its next test) is normal, so no warning.
        [[ $cls == app-run ]] || say "warning: this build used under 0.05 cores for $(( STALL_SECS / 60 )) min ($STALL_SECS s); it may be hung. It no longer counts against the build budget."
        log_line "event=stall unit=$unit cmd=\"$cmdline\""
      fi
    fi
    # A high build idle for HUNG_HIGH_SECS (default 900): one live.log line and
    # one notice, once per build. Nothing is stopped. The notice goes to
    # stderr; when stderr is a file, that is the build's own log and the line
    # names it, else the owner finds it in live.log (notice=live.log).
    if [[ ${PRIO:-} == high && -z ${hung_high_logged:-} && ${cls:-} != app-run ]] && (( rate < 50 )) \
      && (( now - last_active >= ${HUNG_HIGH_SECS:-900} * 1000000 )); then
      hung_high_logged=1
      idle_s=$(( (now - last_active) / 1000000 ))
      wp=live.log
      [[ -f /dev/stderr ]] && wp=$(readlink -f /dev/stderr) && [[ -n $wp ]] || wp=live.log
      say "note: this high-priority build has used under 0.05 cores for $(( idle_s / 60 )) min ($idle_s s); it may be hung. Nothing was stopped.$( (( stalled_cpu )) && echo " It no longer counts as a job or a high build.") Unit $unit, directory $PWD."
      log_line "event=hung-high unit=$unit cwd=${PWD// /%20} idle_s=$idle_s notice=${wp// /%20} cmd=\"$cmdline\""
    fi
    # Idle Wine test runs, logged only for now, to learn how often tests hang.
    # On 2026-10-19 one run sat idle for 57 min after vstest's blame-hang
    # collector fired. One line per idle spell.
    if [[ $cls == wine-run-tests || $cls == wine-run-tests-prebuilt ]]; then
      if (( rate >= 50 )); then
        wine_idle_logged=
      elif [[ -z $wine_idle_logged ]] && (( now - last_active >= WINE_IDLE_SECS * 1000000 )); then
        wine_idle_logged=1
        idle_s=$(( (now - last_active) / 1000000 ))
        say "note: this Wine test run has used under 0.05 cores for $(( idle_s / 60 )) min ($idle_s s); it may be hung. Logged only, nothing was stopped."
        wp=${wine_main:--}
        log_line "event=wine-idle prefix=${wp// /%20} idle_s=$idle_s unit=$unit cmd=\"$cmdline\""
      fi
    fi
  fi
  orph=$(wine_orphans "$d")
  unknown=$(grep -m1 '^?' <<< "$orph")
  others=$(sed -n 's/^~//p' <<< "$orph")
  orph=$(grep -m1 -v '^[?~]' <<< "$orph")
  while IFS= read -r p; do
    [[ -n $p && $orph_other_logged != *"|$p|"* ]] || continue
    orph_other_logged+="|$p|"
    log_line "event=wine-orphan-other unit=$unit prefix=${p// /%20} reason=\"not this run's own prefix, so no warning and no stop\" cmd=\"$cmdline\""
  done <<< "$others"
  if [[ -n $unknown && -z $orph_unknown_logged ]]; then
    orph_unknown_logged=1
    log_line "event=wine-orphan-skip unit=$unit procs=${unknown#?} reason=\"prefix unknown: WINEPREFIX is not in the process environment or in heavy-build's, so the wineserver check skips these processes instead of guessing ~/.wine\" cmd=\"$cmdline\""
  fi
  if [[ -n $orph ]]; then
    orphan_seen=$(( orphan_seen + 1 ))
    [[ -n $orphan_since ]] || orphan_since=$EPOCHSECONDS
    if (( orphan_seen >= 2 )); then
      stalled_wine=1
      if [[ -z $orphan_warned ]]; then
        orphan_warned=1
        say "warning: the wineserver for $orph is gone (DESKTOP-14957). This run will hang. Stop it and run it again."
        log_line "event=wine-orphan unit=$unit prefix=$orph cmd=\"$cmdline\""
      fi
      if [[ ${HEAVY_BUILD_WINE_ORPHAN:-} == stop && -z $orphan_stopped ]] && (( EPOCHSECONDS - orphan_since >= ORPHAN_STOP_SECS )); then
        orphan_stopped=1
        say "stopping this Wine run: its wineserver has been gone for ${ORPHAN_STOP_SECS} s (HEAVY_BUILD_WINE_ORPHAN=stop)"
        systemctl --user stop "$unit.scope" 2>/dev/null
      fi
    fi
  else
    orphan_seen=0 orphan_since= stalled_wine=0
  fi
  grep -qx 'populated 1' "$d/cgroup.events" 2>/dev/null && write_state "$cur" "$c60" "$(( stalled_cpu || stalled_wine ))"
  psi_watch
}

# ---------------------------------------------------------------- CPU guard
# See "CPU pinning is undone" in the help text for why.

# All CPUs the scope cgroup $1 may use: its cpuset.cpus.effective when the
# cpuset controller is on, else all online CPUs.
all_cpus() {
  local c=
  read -r c 2>/dev/null < "$1/cpuset.cpus.effective"
  [[ -n $c ]] || read -r c 2>/dev/null < "$SYSCPU/online"
  echo "$c"
}

# Thread IDs in the scope cgroup $1 and any cgroups below it. Uses
# cgroup.threads; where it is missing, the threads of each pid in cgroup.procs.
scope_tids() {
  local c pid ts
  while IFS= read -r c; do
    if [[ -r $c/cgroup.threads ]]; then cat -- "$c/cgroup.threads" 2>/dev/null; continue; fi
    while read -r pid; do
      [[ $pid =~ ^[0-9]+$ ]] || continue
      ts=("$PROC/$pid"/task/[0-9]*)
      if [[ -e ${ts[0]} ]]; then printf '%s\n' "${ts[@]##*/}"; else echo "$pid"; fi
    done 2>/dev/null < "$c/cgroup.procs"
  done < <(find "$1" -type d 2>/dev/null)
}

# Reads thread IDs on stdin. Prints "tid tgid state voluntary_switches cpus"
# for each one whose status can be read.
thread_info() {
  grep -x '[0-9]\+' | sed "s|.*|$PROC/&/status|" \
    | xargs -r grep -sH -e '^Tgid:' -e '^State:' -e '^voluntary_ctxt_switches:' -e '^Cpus_allowed_list:' 2>/dev/null \
    | awk '{
        i = index($0, ":"); p = substr($0, 1, i - 1); r = substr($0, i + 1)
        j = index(r, ":"); k = substr(r, 1, j - 1); v = substr(r, j + 1); gsub(/^[ \t]+|[ \t]+$/, "", v)
        n = split(p, a, "/"); t = a[n - 1]
        if (!(t in seen)) { seen[t] = 1; order[++m] = t }
        if (k == "Tgid") g[t] = v
        else if (k == "State") s[t] = substr(v, 1, 1)
        else if (k == "voluntary_ctxt_switches") w[t] = v
        else c[t] = v
      }
      END { for (i = 1; i <= m; i++) { t = order[i]; if (c[t] != "") printf "%s %s %s %s %s\n", t, (g[t] == "" ? t : g[t]), (s[t] == "" ? "?" : s[t]), (w[t] == "" ? "-" : w[t]), c[t] } }'
}

# Number of CPUs in a list such as 0-3,8,30-31.
cpu_count() {
  local n=0 r a b IFS=,
  for r in $1; do
    if [[ $r == *-* ]]; then a=${r%-*} b=${r#*-}; n=$(( n + b - a + 1 )); else n=$(( n + 1 )); fi
  done
  echo "$n"
}

# Sets harmful CPU pinning in our own scope back to all CPUs and watches for
# busy loops. Touches nothing outside $BSLICE/$unit.scope.
# Pinning alone is not harmful: .NET Server GC pins one thread to each CPU on
# purpose (GCHeapAffinitize), and several .NET processes in one scope each put
# a GC thread on CPU 0. So a pinned thread is set back only when
# - its narrow CPU set is crowded: more runnable threads share that exact set
#   than it has CPUs, in two checks in a row (a GC pause lasts milliseconds,
#   the 2026-10-13 loops stayed runnable), or
# - the busy-loop warning is active and the thread itself is spinning.
cpu_guard() {
  local d=$BSLICE/$unit.scope all tid tgid st vcs cpus busy=0 cmd lim10 k i why spin
  local -a T_tid=() T_tgid=() T_cpus=() T_spin=()
  local -A now_st=() runq=() crowded=()
  [[ -d $d ]] || return 0
  all=$(all_cpus "$d")
  [[ -n $all ]] || return 0
  while read -r tid tgid st vcs cpus; do
    spin=0
    [[ $st == R && $vcs != - && ${prev_st[$tid]:-} == "R:$vcs" ]] && { busy=$(( busy + 1 )); spin=1; }
    now_st[$tid]="$st:$vcs"
    [[ $cpus == "$all" ]] && continue
    [[ $st == R ]] && runq[$cpus]=$(( ${runq[$cpus]:-0} + 1 ))
    T_tid+=("$tid") T_tgid+=("$tgid") T_cpus+=("$cpus") T_spin+=("$spin")
  done < <(scope_tids "$d" | thread_info)
  prev_st=()
  for k in "${!now_st[@]}"; do prev_st[$k]=${now_st[$k]}; done
  # Crowded now and at the last check.
  for k in "${!runq[@]}"; do
    (( runq[$k] > $(cpu_count "$k") )) && crowded[$k]=${runq[$k]}
  done
  local -A was=()
  for k in "${!crowd_prev[@]}"; do was[$k]=1; done
  crowd_prev=()
  for k in "${!crowded[@]}"; do crowd_prev[$k]=1; done

  lim10=${est_cores/./}
  lim10=$(( 2 * 10#${lim10:-80} ))
  (( lim10 < 20 )) && lim10=20
  if (( busy * 10 > lim10 )); then
    [[ -n $busy_since ]] || busy_since=$EPOCHSECONDS
    if [[ -z $busy_warned ]] && (( EPOCHSECONDS - busy_since >= BUSY_SECS )); then
      busy_warned=1
      say "warning: $busy threads in this build have spun without sleeping for ${BUSY_SECS} s (estimate: ${est_cores} cores). Busy loops starved the desktop on 2026-10-13. Nothing is killed."
      log_line "event=busy-loops unit=$unit threads=$busy est_cores=$est_cores secs=$(( EPOCHSECONDS - busy_since )) cmd=\"$cmdline\""
    fi
  else
    busy_since=
  fi

  for i in "${!T_tid[@]}"; do
    tid=${T_tid[i]} tgid=${T_tgid[i]} cpus=${T_cpus[i]} why=
    if [[ -n ${crowded[$cpus]:-} && -n ${was[$cpus]:-} ]]; then
      why="crowded runnable=${crowded[$cpus]}"
    elif [[ -n $busy_warned && -n $busy_since ]] && (( T_spin[i] )); then
      why=busy-loop
    else
      continue
    fi
    taskset -p -c "$all" "$tid" >/dev/null 2>&1 || continue
    [[ -n ${unpinned[$tgid]:-} ]] && continue
    unpinned[$tgid]=1
    cmd=$(tr '\0' ' ' < "$PROC/$tgid/cmdline" 2>/dev/null | cut -c1-200)
    cmd=${cmd% }; cmd=${cmd//\"/\'}
    log_line "event=unpin unit=$unit pid=$tgid tid=$tid cpus=$cpus set_to=$all reason=\"$why\" cmd=\"$cmd\""
    say "warning: pid $tgid ($cmd) had threads crowded on CPUs $cpus ($why); set back to $all. Pinned busy loops froze the desktop on 2026-10-13."
  done
}

# ---------------------------------------------------------------- rerun guard

# The state of the git tree the build runs in: "<HEAD 12>-<hash 8>", where
# the hash covers `git status --porcelain` and the size and mtime of each
# path it lists, so an edit to a file that was already modified counts as a
# change. "<HEAD 12>" alone when git status fails or takes over 5 s, "-"
# outside git. --no-optional-locks keeps it off the index lock that builds
# and agents in the same tree use. About 0.5 s in the monorepo.
tree_state() {
  local top head list meta
  top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo -; return; }
  head=$(git -C "$top" rev-parse -q --verify HEAD 2>/dev/null) || head=none
  if ! list=$(cd "$top" && timeout 5 git --no-optional-locks status --porcelain -z --untracked-files=normal 2>/dev/null | tr '\0' '\n'); then
    echo "${head:0:12}"
    return
  fi
  meta=$(cd "$top" && cut -c4- <<< "$list" | xargs -r -d '\n' stat -c '%n %s %Y' -- 2>/dev/null)
  echo "${head:0:12}-$(printf '%s\n%s\n' "$list" "$meta" | md5sum | cut -c1-8)"
}

# rerun_check KEY STATE: prints "<fails> <seconds since the last one>" when
# the last RERUN_FAILS runs of KEY in history all failed within RERUN_SECS
# and the tree state is the same as at the last failure (or either state is
# "-", so time alone decides). Prints nothing when the build may run.
rerun_check() {
  (( RERUN_FAILS > 0 )) || return 0
  [[ -r $HIST ]] || return 0
  awk -F'\t' -v k="$1" -v st="$2" -v n="$RERUN_FAILS" -v win="$RERUN_SECS" -v now="$EPOCHSECONDS" '
    $3 == k { m++; t[m] = $1; e[m] = $7; r[m] = $8; s[m] = $11; has[m] = (NF >= 11) }
    END {
      if (m < n) exit
      for (i = m - n + 1; i <= m; i++) if (r[i] != "fail" || e[i] == 0 || now - t[i] > win) exit
      if (!has[m]) exit
      if (s[m] != "-" && st != "-" && s[m] != st) exit
      print n, now - t[m]
    }' "$HIST" 2>/dev/null
}

# append_history EXIT_CODE REASON. Columns: see the help text at the top.
append_history() {
  local cpu=NA pk=NA wall=$(( EPOCHSECONDS - start_ts ))
  (( wall < 1 )) && wall=1
  [[ -n $usec_last ]] && cpu=$(printf '%d.%03d' $(( usec_last / 1000000 )) $(( usec_last % 1000000 / 1000 )))
  local capb=NA highb=NA nfb=NA
  (( peak > 0 )) && pk=$peak
  # Column 13 needs 3 good samples (30 s or more), so a short build, whose
  # peak may fall between samples, keeps NA.
  local nf_ok=
  (( ${nf_n:-0} >= 3 )) && nf_ok=1 nfb=${peak_nf:-0}
  if [[ -n ${cap_high:-} ]]; then
    capb=$(( ${cap_max:-$(( cap_high + 2 ))} * 1073741824 )) highb=$(( cap_high * 1073741824 ))
    # A scope full of page cache also reaches its MemoryHigh. That only
    # counts when the non-file peak reached 90% of it (or is unknown).
    if (( peak * 100 >= highb * 98 )) && { [[ -z $nf_ok ]] || (( ! ${EST_NONFILE:-1} )) || (( ${peak_nf:-0} * 100 >= highb * 90 )); }; then
      if [[ $cls == app-run ]]; then
        say "warning: this app run's memory reached its ${cap_high}G MemoryHigh and was held there; HEAVY_BUILD_APP_MEM_HIGH_GIB sets that cap"
      else
        say "warning: this build's memory reached its ${cap_high}G MemoryHigh and was held there; its next estimate is at least $(( cap_high * 5 / 4 )) GiB"
      fi
      log_line "event=capped unit=$unit peak=$peak nonfile=$nfb high=$highb est=${est_mem}G cmd=\"$cmdline\""
    fi
  fi
  mkdir -p "$STATE" 2>/dev/null || return 0
  {
    flock 6
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$EPOCHSECONDS" "$cls" "$hash" "$wall" "$cpu" "$pk" "$1" "$2" "$capb" "$highb" "${tstate:--}" "${sig:--}" "$nfb" "${own_session:--}/${own_agent:--}" >&6
    local hl=${HISTORY_LINES:-20000}; (( hl >= 100 )) || hl=20000
    # Keep HISTORY_LINES lines (about 2 weeks at 1,300 builds a day); trim at 10% over.
    if (( $(wc -l < "$HIST") > hl + hl / 10 )); then tail -n "$hl" -- "$HIST" > "$HIST.tmp" && mv -f -- "$HIST.tmp" "$HIST"; fi
  } 6>>"$HIST"
}

# ---------------------------------------------------------------- main

# After a re-exec, take back the ticket before any slow setup, and remove it
# on any exit from here on, so a signal in setup cannot leave it behind. The
# full on_exit trap replaces this one below.
adopted=
if [[ -n $adopt_t && $adopt_t == "$QDIR"/[0-9]* && $adopt_t != *.tmp && -e $adopt_t ]] \
  && { read -r a_pid a_st < "$adopt_t"; } 2>/dev/null && [[ $a_pid == "$$" && $a_st == "$(proc_start $$)" ]]; then
  adopted=$adopt_t
  trap 'rm -f -- "$adopted" "$adopted.tmp"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
fi

hash=$(printf '%s\0' "$PWD" "$@" | md5sum | cut -c1-8)
cmdline="$*"
cmdline=${cmdline//\"/\'}
(( ${#cmdline} > 160 )) && cmdline="${cmdline:0:157}..."
cls=$(classify "$@")
sig=- sig_f=0
if [[ $cls == wine-run-tests || $cls == wine-run-tests-prebuilt ]]; then
  read -ra sig_words <<< "$*"
  read -r sig_f sig <<< "$(wine_sig "$cls" "${sig_words[@]}")"
  [[ -n $sig ]] || sig=- sig_f=0
fi
# Settings first, so HEAVY_BUILD_WINE_FALLBACK_PCT reaches estimate().
read_conf
# Time limit for Wine test runs: HEAVY_BUILD_WINE_TIMEOUT seconds (conf or
# environment). A caller's own HEAVY_BUILD_TIMEOUT wins. 0 or unset: no limit.
if [[ -z $TIMEOUT && $cls == wine-run-tests* ]]; then
  setting HEAVY_BUILD_WINE_TIMEOUT 0
  (( WINE_TIMEOUT > 0 )) && TIMEOUT=$WINE_TIMEOUT
fi
read -r est_mem est_cores est_wall est_src <<< "$(estimate "$hash" "$cls" "${sig#-}" "$sig_f")"
keys_out=$(lock_keys "$@")
keys_note=$(grep '^!' <<< "$keys_out" | sed 's/^!//' | paste -sd' ' -)
keys_csv=$(grep -v '^!' <<< "$keys_out" | sed 's/ /%20/g' | paste -sd, -)
[[ -n $keys_csv ]] || keys_csv=-
# The run's own Wine prefixes, for wine_orphans: wine_main is the prefix the
# command will run in (for run-tests.sh, what run_tests_prefix says, else
# WINEPREFIX), wine_fb the prefix for a Wine process with no WINEPREFIX of its
# own, wine_runs the base of run-tests.sh's <prefix>-run<pid> fallback, and
# wine_own the list: wine_main and the wine: key's prefix.
wine_main=${WINEPREFIX:-} wine_fb=${WINEPREFIX:-} wine_runs=
if wine_cmd "$@" && rt=$(run_tests_prefix "$(git rev-parse --show-toplevel 2>/dev/null)" "$@"); then
  wine_main=${rt#* }
  if [[ $rt == own\ * ]]; then wine_runs=$wine_main wine_fb=; else wine_fb=$wine_main; fi
fi
wine_own=$(tr ',' '\n' <<< "$keys_csv" | sed -n 's/^wine://p' | sed 's/%20/ /g')
[[ -n $wine_main ]] && wine_own+=$'\n'$wine_main
# The default priority comes from the calling session's class, or from the
# grove lane the build runs in. HB_MACHINE_SESSION is a test hook.
if [[ -z ${HEAVY_BUILD_PRIORITY:-} ]]; then
  SESSION_CLASS=$(timeout 5 "${HB_MACHINE_SESSION:-machine-session}" class --pid $$ 2> /dev/null)
  crit_why=
  if [[ $SESSION_CLASS == critical ]]; then
    crit_why="this session is critical in ~/.config/machine/sessions.toml"
  else
    mapfile -t kdirs < <(key_dirs)
    crit_why=$(critical_lane "$PWD" "${kdirs[@]}")
  fi
  if [[ -n $crit_why ]]; then
    PRIO=critical
    say "priority critical: $crit_why"
  elif [[ $SESSION_CLASS == pausable ]]; then
    PRIO=low
    say "priority low: this session is pausable in ~/.config/machine/sessions.toml"
  fi
fi
unit="heavy-build-$$-$RANDOM"
# Each build gets its own Roslyn compiler server. Without an id, every C#
# compile uses one server per SDK, and the first one started (often outside
# heavy-build) runs on outside builds.slice with all the compile work. On
# 2026-10-11 one such server held 12.7 GB and 4.3 cores. This one starts in the
# scope and stops with it.
build_env+=(SharedCompilationId="${SharedCompilationId:-hb-$unit}")
# PRIO in the state file; <prio>:aged for a build let in by the aging slot.
state_prio=$PRIO
# The priority without lanes rules; lane_prio_apply goes back to it.
BASE_PRIO=$PRIO lane_ident= own_session=- own_agent=- ticket_l3=
# Ends this heavy-build if it comes back to the wait section after its build
# started. Only a script rewritten in place under an older heavy-build (one
# without the { } block) can do that; on 2026-10-10 it ran a build twice.
reentry_guard() {
  [[ -n ${build_started:-} ]] || return 0
  say "stopping: this heavy-build came back to the queue after its build started (script was ${script_id:-?}, now $(stat -L -c '%i %Y' -- "${BASH_SOURCE[0]}" 2>/dev/null)). The file was changed in place under it."
  log_line "event=reentry unit=$unit script_was=\"${script_id:-?}\" cmd=\"$cmdline\""
  exit 70
}
jobid=$unit
mystart=$(proc_start $$)
start_ts=$EPOCHSECONDS
ticket=$adopted
[[ -n $adopted ]] && jobid=${adopted##*/}
scope_up= child= cancel_sig=
# Runs on every exit bash can catch, signals included: removes the ticket and
# state file and, once the scope exists, stops it, so nothing from this build
# runs on without a heavy-build to account for it.
on_exit() {
  rm -f -- ${ticket:+"$ticket" "$ticket.tmp"} "$JDIR/$unit" "$JDIR/$unit.tmp" ${READY_FILE:+"$READY_FILE"}
  [[ -n $scope_up ]] && systemctl --user stop "$unit.scope" 2>/dev/null
}
trap on_exit EXIT
# While waiting no scope exists yet, so a signal just ends heavy-build.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
job_ident
read_conf
lane_prio_apply
app_est_cap
est_sig=$CONF_SIG est_ts=$EPOCHSECONDS

# The rerun guard (see the help text). tstate goes into history column 11.
tstate=-
if [[ -n $adopted ]]; then
  # A re-exec'd waiter passed the guard when it was queued; it keeps that
  # tree state and is not refused now.
  read -r _ _ _ tstate <<< "$adopt_st"
  [[ $tstate =~ ^[A-Za-z0-9-]+$ ]] || tstate=-
  rr=
else
  (( RERUN_FAILS > 0 )) && tstate=$(tree_state)
  rr=$(rerun_check "$hash" "$tstate")
fi
if [[ -n $rr ]]; then
  rtree=$(git rev-parse --show-toplevel 2>/dev/null) || rtree=$PWD
  read -r rr_n rr_ago <<< "$rr"
  if [[ ${HEAVY_BUILD_ALLOW_RERUN:-} == 1 ]]; then
    log_line "event=rerun-allowed fails=$rr_n last_fail_s=$rr_ago tree=$rtree state=$tstate cmd=\"$cmdline\""
  else
    say "exit 76, not run: this exact command failed $rr_n times in a row in the last $(( RERUN_SECS / 60 )) min with no change in $rtree; read the last log or change something before running it again. While you fix it, rerun only the failing test with a filter. Set HEAVY_BUILD_ALLOW_RERUN=1 to override."
    log_line "decision=rerun-refuse reason=\"rerun: failed $rr_n times in a row in the last $(( RERUN_SECS / 60 )) min, the last ${rr_ago}s ago, with no change in the tree\" tree=$rtree state=$tstate prio=$PRIO keys=$keys_csv cmd=\"$cmdline\""
    exit 76
  fi
fi

reentry_guard
# The give-up clock: seconds of waiting without moving up in line, not counted
# while only higher-priority builds ahead hold this build back.
stuck=0 tick=$SECONDS queued_ts=$EPOCHSECONDS pos=0
held=
if ancestor_holds_lock; then
  say "a parent process holds a build slot; not taking another"
else
  # Lexical order of ticket names is arrival order: time in ns (fixed width),
  # then pid, then a short hash of the directory and command.
  adopt_best=
  if [[ -n $adopted ]]; then adopt_ticket; else ticket=$QDIR/$(date +%s%N)-$$-$hash; fi
  jobid=${ticket##*/}
  write_ticket
  if [[ -n $keys_note ]]; then
    log_line "$keys_note keys=$keys_csv cmd=\"$cmdline\""
    say "lock key not split by AgentOutputSuffix: this tree has no suffix blocks ($SPLIT_MARK)"
  fi
  said= best=$adopt_best last_log= would_since=
  while :; do
    reentry_guard
    [[ -e $ticket ]] || write_ticket
    read_conf
    lane_prio_apply
    est_refresh
    reexec_check
    queue_scan
    started=
    if [[ $MODE == live ]]; then
      exec 8>>"$ADMIT"
      flock 8
      decide
      if [[ $dec == start ]]; then
        start_ts=$EPOCHSECONDS
        [[ $why == aged:* ]] && state_prio=$PRIO:aged
        write_state 0 - 0   # our reservation, written while we hold the mutex
        # The start of a normal or low build, for the one-per-120-s rule at
        # pressure level slow. Written under the mutex.
        if [[ $PRIO != high && $PRIO != critical ]]; then
          printf '%s\n' "$EPOCHSECONDS" > "$NCSTART.$$" && mv -f -- "$NCSTART.$$" "$NCSTART"
        fi
        rm -f -- "$ticket"
        started=1
      fi
      exec 8>&-
      log_decision "$dec"
      (( rank > 0 )) && pos=$rank
      [[ -n $started ]] && break
    else
      if hold_on; then
        why="new builds are on hold: $(head -c 200 "$HOLD" 2>/dev/null)"
      elif (( pos > 1 )); then
        why="earlier builds go first"
      else
        mem=$(mem_avail_gib)
        room=$(swap_room_gib)
        need=$MIN_MEM_GIB
        (( $(active_build_scopes) == 0 )) && need=$SOLO_MEM_GIB
        if [[ $mem =~ ^[0-9]+$ ]] && (( mem < need )); then
          why="only ${mem} GiB of memory is available; a build starts at ${need} GiB"
        elif [[ $room =~ ^-?[0-9]+$ ]] && (( room < MIN_SWAP_ROOM_GIB )); then
          why="swap is nearly full (${room} GiB left before 90% of swap is used, need ${MIN_SWAP_ROOM_GIB})"
        elif try_slot; then
          orphans=$(orphan_scopes | wc -l)
          if (( orphans == 0 || orphans <= $(other_free_slots) )); then
            started=1
          else
            exec 9>&-; held=
            why="a build whose heavy-build was killed is still running ($(orphan_scopes | tr '\n' ' '))"
          fi
        else
          why="all 3 build slots are in use"
        fi
      fi
      # The budget rule only watches in shadow mode.
      oldwhy=${why:-}
      decide
      if [[ -n $started ]]; then
        log_decision start
        break
      fi
      log_decision wait
      why=$oldwhy
      prioheld=0   # the old rule is first come, first served
    fi
    # While the manager's hold file exists the clock stays at 0, so a hold of
    # any length never ends in exit 75. On 2026-10-14 a build was refused
    # after 7201 s that it spent waiting only on the hold. The clock starts
    # from 0 again when the hold lifts.
    if hold_on; then
      stuck=0
    elif (( ! prioheld )); then
      stuck=$(( stuck + SECONDS - tick ))
    fi
    tick=$SECONDS
    if [[ -n $best ]] && (( pos > 0 && pos < best )); then stuck=0; fi
    (( pos > 0 )) && { [[ -z $best ]] || (( pos < best )); } && best=$pos
    line="in line: position $pos of $total${dup:+ (an identical build is ahead)}"
    if [[ -n $WAIT_TIMEOUT ]] && (( EPOCHSECONDS - queued_ts >= WAIT_TIMEOUT )); then
      say "exit 77, not run: --wait-timeout ${WAIT_TIMEOUT}s ran out before the queue let it in: $why; $line. Nothing ran. Try again later, or give a longer --wait-timeout."
      refuse "wait-timeout: not let in within ${WAIT_TIMEOUT}s: $why" 77
    fi
    if (( stuck >= WAIT )); then
      say "exit 75, not run: gave up after ${stuck}s without moving up: $why; $line. Nothing ran. Do not resubmit at once; try again later or tell the manager session."
      refuse "wait: gave up after ${stuck}s without moving up: $why"
    fi
    key="${why%% *} $pos"
    if [[ $key != "$said" ]]; then say "waiting: $why; $line"; said=$key; fi
    sleep "$POLL"
  done
  rm -f -- "$ticket"
fi

avail=$(LC_ALL=C df -B1G --output=avail -- . 2>/dev/null | tail -1 | tr -d ' ')
if [[ $avail =~ ^[0-9]+$ ]] && (( avail < REFUSE_GIB )) && [[ ${HEAVY_BUILD_FORCE:-0} != 1 ]]; then
  say "exit 75, not run: $(df --output=target -- . | tail -1) has ${avail} GiB free; the limit is ${REFUSE_GIB} GiB."
  say "stop and tell the manager session. Do not delete other build output to make room."
  refuse "disk: $(df --output=target -- . | tail -1) has ${avail} GiB free, the limit is ${REFUSE_GIB} GiB"
fi

# Memory caps scale with the estimate: MemoryHigh = 1.25 x estimate, 16G to 22G.
# estimate() never returns more than EST_MEM_MAX_GIB (22), the top of this range.
mem10=${est_mem/./}
cap_high=$(( (10#$mem10 * 125 + 999) / 1000 ))
(( cap_high < 16 )) && cap_high=16
(( cap_high > 22 )) && cap_high=22
# An app run gets a fixed MemoryHigh (HEAVY_BUILD_APP_MEM_HIGH_GIB, default 10).
[[ $cls == app-run ]] && cap_high=$APP_MEM_HIGH_GIB
# MemoryMax is twice MemoryHigh, at most what builds.slice allows (its
# memory.max, whole GiB), and never under MemoryHigh. MemorySwapMax 8G.
cap_max=$(( cap_high * 2 ))
slice_max=
read -r slice_max 2>/dev/null < "$BSLICE/memory.max"
if [[ $slice_max =~ ^[0-9]+$ ]] && (( cap_max > slice_max / 1073741824 )); then cap_max=$(( slice_max / 1073741824 )); fi
(( cap_max < cap_high )) && cap_max=$cap_high
props=(-p MemoryHigh="${cap_high}G" -p MemoryMax="${cap_max}G" -p MemorySwapMax=8G -p OOMPolicy=kill -p TimeoutStopSec=3s)
[[ -n $TIMEOUT ]] && props+=(-p RuntimeMaxSec="$TIMEOUT")
# An app run gets a CPU cap (HEAVY_BUILD_APP_CPU_QUOTA percent, default 800);
# 0 or empty means none. Builds get no CPUQuota.
[[ $cls == app-run ]] && (( APP_CPU_QUOTA > 0 )) && props+=(-p CPUQuota="${APP_CPU_QUOTA}%")
desc="heavy-build $cls prio=$PRIO${HEAVY_BUILD_REASON:+ reason: $HEAVY_BUILD_REASON}"

# The signal traps go in before the scope exists, so no signal can end
# heavy-build between making the scope and watching it.
stop_build() {
  cancel_sig=$1
  [[ -n $child ]] && kill "-$1" "$child" 2>/dev/null
  systemctl --user kill --signal="$1" "$unit.scope" 2>/dev/null
}
trap 'stop_build TERM' TERM HUP
trap 'stop_build INT' INT

start_ts=$EPOCHSECONDS
write_state 0 - 0
build_started=1
scope_up=1
systemd-run --user --scope --quiet --collect --expand-environment=no \
  --unit="$unit" --slice=builds.slice --description="$desc" "${props[@]}" \
  env -u HEAVY_BUILD_CLASS -u HEAVY_BUILD_READY_FILE -u HEAVY_BUILD_WAIT_TIMEOUT \
  "${build_env[@]}" HEAVY_BUILD_UNIT="$unit.scope" "$@" 0<&0 8>&- 9>&- &
child=$!
# A signal that came while the scope was being made may have missed it.
[[ -n $cancel_sig ]] && stop_build "$cancel_sig"
write_ready "$unit.scope" "$child"

S_t=() S_u=() s_lo=0 peak=0 peak_nf=0 nf_n=0 usec_last= last_active=$(now_us)
hung_high_logged=
stalled_cpu=0 stalled_wine=0 stall_warned= orphan_seen=0 orphan_since= orphan_warned= orphan_stopped= orph_unknown_logged=
orph_other_logged= wine_idle_logged=
rc= gone_since=
declare -A unpinned=() prev_st=() crowd_prev=()
busy_since= busy_warned= last_sample=$(now_us)
while :; do
  iv=$SAMPLE
  (( EPOCHSECONDS - start_ts < 60 && iv > 2 )) && iv=2
  step=$iv
  (( GUARD_SECS > 0 && GUARD_SECS < step )) && step=$GUARD_SECS
  sleep "$step" &
  sp=$!
  done_pid=
  wait -n -p done_pid "$child" "$sp"
  r=$?
  if [[ ${done_pid:-} == "$child" ]]; then
    rc=$r
    kill "$sp" 2>/dev/null; wait "$sp" 2>/dev/null
    break
  fi
  if [[ -z ${done_pid:-} ]]; then
    # A trap ran. Go round again; the build ends soon if it was stopped.
    kill "$sp" 2>/dev/null; wait "$sp" 2>/dev/null
    continue
  fi
  (( GUARD_SECS > 0 )) && cpu_guard
  if (( $(now_us) - last_sample >= iv * 1000000 - 250000 )); then
    sample_scope
    last_sample=$(now_us)
  fi
  # wait -n can miss a child that bash already reaped, so check it directly.
  if ! kill -0 "$child" 2>/dev/null; then
    wait "$child"; rc=$?
    break
  fi
  # A scope that has stopped while its command still runs here: give it
  # HB_SCOPE_GONE_SECS (120), then end, so this heavy-build never loops on.
  if grep -qx 'populated 1' "$BSLICE/$unit.scope/cgroup.events" 2>/dev/null || (( EPOCHSECONDS - start_ts < NO_SCOPE_SECS )); then
    gone_since=
  elif [[ -z $gone_since ]]; then
    gone_since=$EPOCHSECONDS
  elif (( EPOCHSECONDS - gone_since >= SCOPE_GONE_SECS )); then
    log_line "event=scope-gone unit=$unit gone_s=$(( EPOCHSECONDS - gone_since )) cmd=\"$cmdline\""
    say "the build scope stopped ${SCOPE_GONE_SECS}s ago but its command did not end; ending"
    kill -KILL "$child" 2>/dev/null
    wait "$child"; rc=$?
    break
  fi
done
sample_scope
d=$BSLICE/$unit.scope
oom=0
while read -r k v; do [[ $k == oom_kill ]] && { oom=$v; break; }; done 2>/dev/null < "$d/memory.events"
[[ $oom =~ ^[0-9]+$ ]] || oom=0
# Wine leftovers (winedevice.exe and the like) ignore SIGTERM, so a plain
# stop waits TimeoutStopSec and ends in "Stopping timed out. Killing".
left=$(scope_procs "$d")
if only_wine_leftovers "$left"; then
  log_line "event=stop-kill unit=$unit procs=$(paste -sd, - <<< "$left")"
  systemctl --user kill --signal=KILL "$unit.scope" 2>/dev/null
fi
# Nothing from this build may run on once it ends.
systemctl --user stop "$unit.scope" 2>/dev/null
scope_up=

if [[ -n $orphan_stopped ]]; then
  rc=124
elif [[ -n $TIMEOUT ]] && (( rc > 128 && EPOCHSECONDS - start_ts >= TIMEOUT - 1 )); then
  say "exit 124, stopped after ${TIMEOUT}s (time limit). The command hung or ran far too long. Read the log for the hang or the first failure and fix it. Do not resubmit unchanged. Set HEAVY_BUILD_TIMEOUT=<seconds> only with a reason."
  rc=124
fi
if (( oom > 0 )); then reason=oom
elif (( rc == 124 )); then reason=timeout
elif [[ $cls == app-run ]] && { [[ -n $cancel_sig ]] || (( rc > 128 )); }; then reason=stopped
elif [[ -n $cancel_sig ]]; then reason=cancelled
elif (( rc == 0 )); then reason=ok
else reason=fail
fi
append_history "$rc" "$reason"
exit "$rc"
}
