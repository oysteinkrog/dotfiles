# ---------------------------------------------------------------- settings

# Reads ~/.config/heavy-build.conf. Sets MODE and the live-rule settings.
# For each setting the environment wins, then the file, then the default.
read_conf() {
  local k v
  declare -gA CONFV=()
  if [[ -r $CONF ]]; then
    while IFS='=' read -r k v || [[ -n $k ]]; do
      k=${k//[[:space:]]/}
      [[ $k == HEAVY_BUILD_* ]] || continue
      v=${v%%#*}
      v=${v//[[:space:]\"\']/}
      CONFV[$k]=$v
    done < "$CONF"
  fi
  MODE=shadow
  [[ ${CONFV[HEAVY_BUILD_MODE]:-} == live ]] && MODE=live
  setting HEAVY_BUILD_MAX_JOBS 6
  setting HEAVY_BUILD_CPU_BUDGET 28
  setting HEAVY_BUILD_MEM_RESERVE_GIB 8
  setting HEAVY_BUILD_MAX_CPU_PSI 75
  setting HEAVY_BUILD_CPU_PSI_SECS 30
  setting HEAVY_BUILD_MAX_MEM_PSI 5
  setting HEAVY_BUILD_TC_PCT 50
  setting HEAVY_BUILD_STARVE 1800
  setting HEAVY_BUILD_AGE_SECS 3600
  setting HEAVY_BUILD_AGE_SLOTS 1
  setting HEAVY_BUILD_SWAP_HEADROOM_PCT 25
  setting HEAVY_BUILD_SWAP_HEADROOM_GIB 8
  setting HEAVY_BUILD_RERUN_FAILS 2
  setting HEAVY_BUILD_RERUN_SECS 1800
  setting HEAVY_BUILD_HISTORY_LINES 20000
  setting HEAVY_BUILD_APP_MEM_HIGH_GIB 10
  setting HEAVY_BUILD_MAX_APP_RUNS 2
  (( APP_MEM_HIGH_GIB >= 1 )) || APP_MEM_HIGH_GIB=10
}

setting() {
  local v=${!1:-}
  [[ -n $v ]] || v=${CONFV[$1]:-}
  [[ $v =~ ^[0-9]+$ ]] || v=$2
  printf -v "${1#HEAVY_BUILD_}" %s "$v"
}

# ---------------------------------------------------------------- estimates

# wine_tests_prebuilt WORD... -> true when run-tests.sh is given only test
# projects ending in .dll. run-tests.sh tests such an assembly as it is and
# builds nothing, which needs about half the memory of a run that builds
# (2.2 GB against 4.1 GB, measured 2026-10-16). One project name without .dll
# means a build, and so does no project at all (every default project).
wine_tests_prebuilt() {
  local w seen= n=0 skip=
  for w in "$@"; do
    if [[ -z $seen ]]; then
      [[ $w == *run-tests.sh ]] && seen=1
      continue
    fi
    if [[ -n $skip ]]; then skip=; continue; fi
    case $w in
      ';'|'&&'|'||'|'|'|'&') break ;;
      --filter) skip=1 ;;
      -*) ;;
      *.dll) n=$(( n + 1 )) ;;
      *) return 1 ;;
    esac
  done
  (( n > 0 ))
}

# wine_sig CLASS WORD... -> "<filtered> <sig>" for a run-tests.sh command:
# filtered is 1 when it has a --filter or --filter-for, else 0 (the full suite
# of its projects). sig is an 8-character hash of the class, the test project
# names (directory and .dll cut off), the other flags and the filter values,
# each sorted, so the same tests run from another tree, lane or WINEPREFIX
# get the same sig. Quotes are dropped. Prints nothing without run-tests.sh.
wine_sig() {
  local c=$1 w seen= skip= f=0 p
  local -a parts=()
  shift
  for w in "$@"; do
    w=${w//[\'\"]/}
    if [[ -z $seen ]]; then
      [[ $w == *run-tests.sh ]] && seen=1
      continue
    fi
    if [[ -n $skip ]]; then parts+=("f:$skip=$w"); skip=; continue; fi
    case $w in
      ';'|'&&'|'||'|'|'|'&') break ;;
      --filter|--filter-for) skip=$w f=1 ;;
      --filter=*|--filter-for=*) parts+=("f:$w"); f=1 ;;
      -*) parts+=("o:$w") ;;
      '') ;;
      *) p=${w##*/}; parts+=("p:${p%.dll}") ;;
    esac
  done
  [[ -n $seen ]] || return 0
  echo "$f $(printf '%s\n' "$c" "${parts[@]}" | LC_ALL=C sort | md5sum | cut -c1-8)"
}

# dotnet_sln WORD...: true when a `dotnet build|test|msbuild` or a
# plain `msbuild` builds a whole solution: its project argument ends in .sln
# or .slnx, or it has none (or names a directory) and that directory holds a
# .sln or .slnx and no project file, so MSBuild picks the solution. Words are
# split on blanks, so `bash -c 'cd x && dotnet build'` looks in the current
# directory, not in x.
dotnet_sln() {
  local w seen= skip= proj= f end=
  for w in "$@"; do
    [[ -n $end ]] && break
    case $w in ';'|'&&'|'||'|'|'|'&') [[ -n $seen ]] && break; seen=; continue ;; esac
    if [[ $w == ?*[\;\&\|\)] ]]; then end=1; w=${w%%[\;\&\|\)]*}; fi
    w=${w##*[\;\&\|\(]}
    [[ -n $w ]] || continue
    if [[ -z $seen ]]; then
      if [[ ${w##*/} == msbuild || ${w##*/} == msbuild.exe ]]; then seen=1
      elif [[ ${w##*/} == dotnet ]]; then seen=d
      fi
      continue
    fi
    if [[ $seen == d ]]; then
      case $w in build|test|msbuild) seen=1 ;; *) seen= ;; esac
      continue
    fi
    if [[ -n $skip ]]; then skip=; continue; fi
    case $w in
      -c|-f|-o|-r|-v|-a|-s|-l|--configuration|--framework|--output|--runtime|--verbosity|--arch|--os|--source|--logger|--filter|--settings|--results-directory|--collect|--blame-hang-timeout|--property) skip=1 ;;
      -*|/*:*) ;;
      /*) [[ ${w:1} == */* ]] && { proj=$w; break; } ;;
      *) proj=$w; break ;;
    esac
  done
  [[ -n $seen && $seen != d ]] || return 1
  [[ $proj == *.sln || $proj == *.slnx ]] && return 0
  [[ -z $proj ]] && proj=.
  [[ -d $proj ]] || return 1
  for f in "$proj"/*.*proj; do [[ -e $f ]] && return 1; done
  for f in "$proj"/*.sln "$proj"/*.slnx; do [[ -e $f ]] && return 0; done
  return 1
}

classify() {
  local c=" $* " words
  local rc='(^|[^[:alnum:]_-])cargo[[:space:]]+(\+[^[:space:]]+[[:space:]]+)?'
  if [[ -n ${CLASS_ARG:-} ]]; then echo "$CLASS_ARG"
  elif [[ $c == *run-tests.sh* ]]; then
    read -ra words <<< "$*"
    if wine_tests_prebuilt "${words[@]}"; then echo wine-run-tests-prebuilt
    else echo wine-run-tests
    fi
  elif [[ $c =~ (^|[/[:space:]])(headless-mc|run-mc)\.sh[[:space:]] ]] ||
       [[ ${c,,} == *wine* && ${c,,} =~ (^|[/\\[:space:]])(motioncatalyst|uimcphost)\.exe[[:space:]] ]]; then echo app-run
  elif [[ ${c,,} =~ (^|[^[:alnum:]_-])inspectcode(\.sh|\.exe)?[[:space:]] ]]; then echo jb-inspectcode
  elif [[ $c =~ ${rc}build[[:space:]].*--release || $c == *localbuild* ]]; then echo cargo-release
  elif [[ $c =~ ${rc}clippy ]]; then echo cargo-clippy
  elif [[ $c =~ ${rc}check ]]; then echo cargo-check
  elif [[ $c =~ ${rc}(test|nextest) ]]; then echo cargo-test
  elif [[ $c =~ ${rc}build ]]; then echo cargo-build
  elif [[ ${c,,} =~ (dotnet[[:space:]]+(build|test|msbuild)|msbuild(\.exe)?)[[:space:]] ]] && read -ra words <<< "$*" && dotnet_sln "${words[@]}"; then
    echo dotnet-build-sln
  elif [[ $c =~ dotnet[[:space:]]+test ]]; then echo dotnet-test
  elif [[ $c =~ dotnet[[:space:]]+(build|publish|run) ]]; then echo dotnet-build
  elif [[ ${c,,} == *wine* ]]; then echo wine-script
  else echo other
  fi
}

# "mem_gib cores wall_s floor_gib" per class. The first three were measured on
# 2026-10-07 (85 jobs): p90 peak, average cores, median wall. floor_gib is the
# lowest memory estimate the class can get, set on 2026-10-16 after a
# wine-run-tests run peaked at 17.4 GB on a 9.9 GB estimate and was OOM-killed.
# mem_gib was raised to the floor where it was lower. Classes without a row
# use the default. That 17.4 GB run was a test leak, fixed on 2026-10-16
# (a normal run peaks at 4.6 GB at p90 over 443 runs), so the wine-run-tests
# floor went from 10 to 6 GiB. A key that really used more still gets its own
# peak. jb-inspectcode (JetBrains inspectcode, also run as `jb inspectcode`)
# peaked at 17.4 GB twice on 2026-10-17 on MotionCatalyst.sln, once oom-killed,
# while it was estimated at 3.6 GB as "other". Its floor is 18 GiB; the scope
# gets MemoryHigh 22G and MemoryMax 24G. Cores and wall time are guesses until
# it has history. wine-run-tests-prebuilt is a run of already built .dll files (2.2 GB,
# 33 s); its wall time is a guess until it has history. dotnet-build-sln is a
# dotnet build, test or msbuild of a whole .sln or .slnx (see dotnet_sln). On
# 2026-10-20 one of MotionCatalyst.sln was estimated at 6.6 GiB from the
# dotnet-build p90 and sat at its 16 GiB cap. It gets 16 GiB (no floor) until
# the class has 5 runs of its own; from then on its p90 decides, and capped
# runs count as 1.25 x their cap. Its wall time is a guess.
class_table() {
  case $1 in
    cargo-release)  echo "16.3 3.4 4500 0" ;;
    wine-script)    echo "7.4 5.6 537 0" ;;
    wine-run-tests) echo "6 5.9 114 6" ;;
    wine-run-tests-prebuilt) echo "3 5.9 33 3" ;;
    cargo-test)     echo "13.3 3.4 96 6" ;;
    cargo-clippy)   echo "7.6 2.6 42 6" ;;
    dotnet-build)   echo "5 8.0 17 5" ;;
    dotnet-test)    echo "5.2 6.9 45 0" ;;
    dotnet-build-sln) echo "16 9.2 120 0" ;;
    cargo-check)    echo "3.9 1.7 26 0" ;;
    jb-inspectcode) echo "18 2.0 600 18" ;;
    app-run)        echo "8 1.5 14400 6" ;;
    *)              echo "8 8 600 0" ;;
  esac
}

# The highest memory estimate, in GiB. A scope's MemoryHigh is 1.25 x the
# estimate, clamped to 16G..22G (see "Memory caps scale" below), so no build
# gets more than 22G before it is throttled. A larger estimate would only
# hold back other builds for memory this build cannot be given.
EST_MEM_MAX_GIB=22
# How many days of history a Wine test sig's runs count for (see estimate).
SIG_DAYS=14

# estimate KEY CLASS [SIG FILTERED] -> "mem_gib cores wall_s source".
# history.tsv columns: end_epoch class key wall_s cpu_s peak_bytes exit_code
# reason cap_bytes high_bytes tree_state sig. Older lines have no column 12
# (some no 11, 10, 9 or 8).
# Memory is the largest of: the key's highest peak in its last 10 runs, the
# class p90 peak over its last 50 runs (the class_table value when the class
# has under 5 runs), and the class floor. It is capped at EST_MEM_MAX_GIB.
# A Wine test run with a filter (SIG from wine_sig, FILTERED 1) is estimated
# from its sig instead (history column 12, runs in the last SIG_DAYS days):
# with 5 or more such runs, their p90 peak (mem=sig-p90); with fewer, the
# class p75 (mem=class-p75), or the highest peak of those few runs when that
# is more (mem=sig-max). The key's own peak does not apply. The class floor
# still applies, except that a sig with 10 or more runs may go down to 4 GiB.
# On 2026-10-20 wine-run-tests was planned at 8.5 to 9.8 GB from the class
# p90 while 1,383 runs peaked at 5.6 GB on average, and memory was the main
# reason Wine runs waited (median 12 min). A run without a filter (the full
# suite of its projects) keeps the rule above.
# An OOM-killed run (exit 137 or reason oom, but not cancelled or timeout)
# counts with a peak of at least its scope's MemoryMax (column 9), or its
# peak times 1.25 when column 9 is missing. A run that is not OOM-killed but
# whose peak reached 98% of its MemoryHigh (column 10; for older lines column
# 9 minus 2 GiB, as MemoryMax has always been MemoryHigh + 2G) counts with a
# peak of at least 1.25 x that MemoryHigh: it was throttled at the cap, so
# its peak is a lower bound, not a measurement. Exit 75, 124 and other signals
# (exit 128 and above) are left out. Wall time and cores come from the key's
# last 5 runs, else from the class, and never from OOM-killed runs.
# source: history, class-history, class or default (where wall and cores
# came from), then ",mem=" and what set memory: key, class-p90, class-p75,
# sig-p90, sig-max, class, default, floor or cap.
estimate() {
  local h=$HIST
  [[ -r $h ]] || h=/dev/null
  LC_ALL=C awk -F'\t' -v k="$1" -v c="$2" -v t="$(class_table "$2")" -v maxm="$EST_MEM_MAX_GIB" \
    -v s="${3:-}" -v sf="${4:-0}" -v now="$EPOCHSECONDS" -v swin="$(( ${SIG_DAYS:-14} * 86400 ))" '
    function srt(a, n,   g, i, j, x) { for (g = 1; g * 3 < n; g = g * 3 + 1); for (; g >= 1; g = int(g / 3)) for (i = g + 1; i <= n; i++) { x = a[i]; for (j = i; j > g && a[j - g] + 0 > x + 0; j -= g) a[j] = a[j - g]; a[j] = x } }
    $4 > 0 && $7 != 75 && $7 != 124 {
      oom = ($8 == "oom" || ($7 == 137 && $8 != "cancelled" && $8 != "timeout"))
      if ($7 >= 128 && !oom && $2 != "app-run") next
      pk = $6
      if (oom && pk != "NA") {
        if ($9 ~ /^[0-9]+$/) { if ($9 + 0 > pk + 0) pk = $9 + 0 }
        else pk = pk * 1.25
      } else if (pk != "NA") {
        hi = ($10 ~ /^[0-9]+$/) ? $10 + 0 : ($9 ~ /^[0-9]+$/) ? $9 - 2147483648 : 0
        if (hi > 0 && pk + 0 >= 0.98 * hi && hi * 1.25 > pk + 0) pk = hi * 1.25
      }
      if ($3 == k) { kmn++; kmp[kmn] = pk }
      if ($2 == c) { cmn++; cmp[cmn] = pk }
      if (s != "" && $12 == s && $1 + 0 >= now - swin && pk != "NA") { smn++; smp[smn] = pk }
      if (oom) next
      if ($3 == k) { kn++; kw[kn] = $4; kc[kn] = $5 }
      if ($2 == c) { cn++; cw[cn] = $4; cc[cn] = $5 }
    }
    END {
      split(t, d, " "); mem = d[1]; cores = d[2]; wall = d[3]; floor = d[4] + 0
      src = (c == "other" || c == "cargo-build") ? "default" : "class"
      msrc = src
      if (cn >= 5) {
        n = 0; sc = 0; sw = 0
        for (i = (cn > 50 ? cn - 49 : 1); i <= cn; i++) {
          w[++n] = cw[i]
          if (cc[i] != "NA") { sc += cc[i]; sw += cw[i] }
        }
        srt(w, n); wall = w[int((n + 1) / 2)]
        if (sw > 0) cores = sc / sw
        src = "class-history"
      }
      filt = (s != "" && sf == 1)
      cmem = mem
      if (cmn >= 5) {
        m = 0
        for (i = (cmn > 50 ? cmn - 49 : 1); i <= cmn; i++) if (cmp[i] != "NA") p[++m] = cmp[i]
        if (m > 0) {
          srt(p, m)
          i = int(0.9 * m) + 1; if (i > m) i = m; mem = p[i] / 1073741824; msrc = "class-p90"
          i = int(0.75 * m) + 1; if (i > m) i = m; cmem = p[i] / 1073741824
        }
      }
      if (filt) {
        if (smn >= 5) {
          srt(smp, smn); i = int(0.9 * smn) + 1; if (i > smn) i = smn
          mem = smp[i] / 1073741824; msrc = "sig-p90"
          if (smn >= 10 && floor > 4) floor = 4
        } else {
          mem = cmem; if (msrc == "class-p90") msrc = "class-p75"
          mx = -1
          for (i = 1; i <= smn; i++) if (smp[i] + 0 > mx) mx = smp[i] + 0
          if (mx >= 0 && mx / 1073741824 > mem) { mem = mx / 1073741824; msrc = "sig-max" }
        }
      }
      if (kn >= 1) {
        n = 0; s = 0; nc = 0
        for (i = (kn > 5 ? kn - 4 : 1); i <= kn; i++) {
          w2[++n] = kw[i]
          if (kc[i] != "NA") { s += kc[i] / kw[i]; nc++ }
        }
        srt(w2, n); wall = w2[int((n + 1) / 2)]
        if (nc > 0) cores = s / nc
        src = "history"
      }
      if (kmn >= 1 && !filt) {
        mx = -1
        for (i = (kmn > 10 ? kmn - 9 : 1); i <= kmn; i++) if (kmp[i] != "NA" && kmp[i] + 0 > mx) mx = kmp[i] + 0
        if (mx >= 0 && mx / 1073741824 > mem) { mem = mx / 1073741824; msrc = "key" }
      }
      if (floor > mem) { mem = floor; msrc = "floor" }
      if (maxm > 0 && mem > maxm) { mem = maxm; msrc = "cap" }
      if (mem < 0.1) mem = 0.1
      if (cores < 0.1) cores = 0.1
      if (wall < 1) wall = 1
      printf "%.1f %.1f %d %s,mem=%s\n", mem, cores, wall, src, msrc
    }' "$h" 2>/dev/null || echo "8.0 8.0 600 default,mem=default"
}

# ---------------------------------------------------------------- lock keys

# Directory of the Wine server socket for prefix $1, as wineserver names it.
wine_server_dir() {
  local dev ino
  dev=$(stat -c %D -- "$1" 2>/dev/null) && ino=$(stat -c %i -- "$1" 2>/dev/null) || return 1
  printf '%s/server-%s-%x\n' "$WINE_TMP" "$dev" "$ino"
}

# Prints "pid inside" or "pid outside" (of builds.slice) for each wineserver
# that serves prefix $1.
wineservers_for() {
  local dir d comm cwd cg
  dir=$(wine_server_dir "$1") || return 0
  for d in "$PROC"/[0-9]*; do
    read -r comm 2>/dev/null < "$d/comm" || continue
    [[ $comm == wineserver ]] || continue
    cwd=$(readlink "$d/cwd" 2>/dev/null) || continue
    [[ $cwd == "$dir" ]] || continue
    cg=$(<"$d/cgroup") 2>/dev/null || cg=
    if [[ $cg == */builds.slice/* ]]; then echo "${d##*/} inside"; else echo "${d##*/} outside"; fi
  done
}

# True when the command runs Wine: some word, split on blanks and shell
# separators so sh -c '...' counts, is a Wine program (wine, wine64,
# wineserver, wineboot, winetricks), a known Wine wrapper script, or a script
# under tools/wine/. "wine" inside another path or argument does not count,
# so /var/tmp/claude/x-linux-wine/run.sh gets no Wine key.
wine_cmd() {
  local a w b ws
  for a in "$@"; do
    read -r -d '' -a ws <<< "${a//[;&|()\`]/ }"
    for w in "${ws[@]}"; do
      b=${w##*/}
      case ${b,,} in
        wine|wine64|wineserver|wineboot|winetricks) return 0 ;;
        run-tests.sh|run-mc.sh|headless-mc.sh) return 0 ;;
      esac
      [[ $w == tools/wine/* || $w == */tools/wine/* ]] && return 0
    done
  done
  return 1
}

SHARED_WINEPREFIX=$HOME/.local/share/wineprefixes/motioncatalyst

# run_tests_prefix TOP WORD...: the prefix a tools/wine/run-tests.sh command
# will run in, when its script makes its own prefix per worktree (master, and
# stable/26.1 and 26.2 since PRs #13885/#13886). Prints "own <prefix>" when the
# script will use its own copy, ~/.local/share/wineprefixes/motioncatalyst-
# tests-<tree folder><AgentOutputSuffix> (or <that>-run<pid> when another run
# holds it), or "set <prefix>" when it will use WINEPREFIX. A script with the
# shared-prefix guard (PR #13900, MC_TESTS_SHARED_PREFIX) ignores a WINEPREFIX
# that names the shared prefix. The script read is the command's own
# run-tests.sh when that path exists, else TOP/tools/wine/run-tests.sh.
# Returns 1 with no output for any other command, and for an older script
# without the per-worktree prefix (a lane not rebased yet).
run_tests_prefix() {
  local top=$1 a w ws f= tree wp
  shift
  for a in "$@"; do
    read -r -d '' -a ws <<< "${a//[;&|()\`]/ }"
    for w in "${ws[@]}"; do
      [[ ${w##*/} == run-tests.sh ]] || continue
      if [[ -f $w ]]; then f=$w
      elif [[ -n $top && -f $top/tools/wine/run-tests.sh ]]; then f=$top/tools/wine/run-tests.sh
      fi
      break 2
    done
  done
  [[ -n $f ]] && grep -qF 'motioncatalyst-tests-' "$f" 2>/dev/null || return 1
  tree=$(cd "$(dirname "$f")/../.." 2>/dev/null && pwd) || return 1
  wp=${WINEPREFIX:-}
  if [[ -n $wp && ${wp%/} == "$SHARED_WINEPREFIX" && ${MC_TESTS_SHARED_PREFIX:-} != 1 ]] \
      && grep -qF MC_TESTS_SHARED_PREFIX "$f" 2>/dev/null; then
    wp=
  fi
  if [[ -n $wp ]]; then echo "set $wp"
  else echo "own $HOME/.local/share/wineprefixes/motioncatalyst-tests-${tree##*/}${AgentOutputSuffix:-}"
  fi
}

# The DESKTOP-14957 stopgap. Runs that share one Wine prefix share one
# wineserver, which lives in the scope of whichever run started it; when that
# scope ends, the other runs hang. So such runs get the key wine:<prefix>.
# For run-tests.sh the prefix is the one the script will use (run_tests_prefix);
# a script that uses its own prefix per worktree needs no key, since it never
# shares that prefix with another run. The key also turns itself off in a
# worktree whose wine-env.sh no longer has the shared default, and when a
# wineserver for the prefix already runs outside builds.slice. It never sets
# WINEPREFIX.
wine_key() {
  local top=$1 p rt
  shift
  wine_cmd "$@" || return 0
  if rt=$(run_tests_prefix "$top" "$@"); then
    [[ $rt == own\ * ]] && return 0
    p=${rt#set }
  elif [[ -n ${WINEPREFIX:-} ]]; then
    p=$WINEPREFIX
  else
    [[ -n $top ]] || return 0
    grep -qF -- "$WINE_DEFAULT_LINE" "$top/tools/wine/wine-env.sh" 2>/dev/null || return 0
    p=$SHARED_WINEPREFIX
  fi
  [[ $(wineservers_for "$p") == *outside* ]] && return 0
  echo "wine:$p"
}

# Lock keys for this build, one per line. Spaces in a key become %20.
# A line starting with ! is a note for live.log, not a key.
lock_keys() {
  [[ ${HEAVY_BUILD_KEY:-} == none ]] && return 0
  local s=" $* " ws top= tree= suf
  if [[ $s =~ [^[:alnum:]_-]cargo[[:space:]] ]]; then
    ws=$(cargo locate-project --workspace --message-format plain 2>/dev/null) && [[ -n $ws ]] && echo "cargo:${ws%/Cargo.toml}"
  fi
  if [[ ${s,,} =~ dotnet|msbuild|wine|run-tests\.sh|build\.cmd ]]; then
    top=$(git rev-parse --show-toplevel 2>/dev/null) && tree=1
  elif [[ $s =~ [[:space:]/]build\.sh[[:space:]] ]]; then
    top=$(git rev-parse --show-toplevel 2>/dev/null) && [[ -d $top/tools/BuildCli ]] && tree=1
  fi
  if [[ -n $tree ]]; then
    suf=$(agent_suffix "$@")
    if [[ -z $suf || $top == *#* ]]; then
      echo "tree:$top"
    elif ! grep -qsF AgentOutputSuffix "$top/$SPLIT_MARK"; then
      echo "tree:$top"
      echo "!locksplit=off reason=no-blocks suffix=$suf"
    else
      echo "tree:$top#$suf"
      [[ $s =~ [[:space:]/]build\.(sh|cmd)[[:space:]] && -d $top/tools/BuildCli ]] && echo "tree:$top#buildcli"
    fi
  fi
  wine_key "$top" "$@"
}

# The suffix blocks kpp added last (df22e584067d). A tree without this one may
# still write shared outputs, so a suffixed build there keeps the plain key.
SPLIT_MARK=apps/online/src/web/client/Directory.Build.props

# The build's AgentOutputSuffix, trimmed, or nothing. A value in the args
# (AgentOutputSuffix=, -p:, /p:, also inside sh -c) wins over the environment,
# as an MSBuild global property does. Two different values in the args, or a
# value with characters other than letters, digits, _ . and -, give nothing,
# so the build keeps the plain tree key.
agent_suffix() {
  local a v= n=0 re='(^|[^[:alnum:]_])AgentOutputSuffix=([^;[:space:]"'\'']*)'
  for a; do
    while [[ $a =~ $re ]]; do
      if (( n == 0 )); then v=${BASH_REMATCH[2]}; n=1
      elif [[ ${BASH_REMATCH[2]} != "$v" ]]; then return 0; fi
      a=${a#*"${BASH_REMATCH[0]}"}
    done
  done
  (( n )) || v=${AgentOutputSuffix-}
  v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
  [[ $v =~ ^[A-Za-z0-9_.-]+$ ]] && echo "$v"
}

# Directories of the cargo: and tree: lock keys, one per line. A tree key's
# #suffix is not part of the directory.
key_dirs() {
  local k d
  [[ $keys_csv == - ]] && return 0
  tr ',' '\n' <<< "$keys_csv" | while read -r k; do
    d=${k#*:}
    [[ $k == tree:*#* ]] && d=${d%#*}
    [[ $k == cargo:* || $k == tree:* ]] && echo "$d"
  done | sed 's/%20/ /g'
}

# critical_lane DIR...: prints why a build in one of these directories belongs
# to a critical session, or nothing. A directory counts when the grove lane
# that holds it is critical in [lanes] of sessions.toml, when the lane's grove
# registry owner is a critical session (a swarm lane such as .scratch/vac2,
# owner kpp), or when a live critical session works in that lane (~/work/
# desktop/kpp for kpp). Reads the same files as machine-session, with the
# same MACHINE_SESSION_* overrides.
critical_lane() {
  timeout 5 python3 -I - "$@" 2> /dev/null <<'PY'
import json, os, sys, tomllib
from pathlib import Path

home = Path.home()
env = os.environ.get
try:
    with open(env("MACHINE_SESSION_REGISTRY", home / ".config/machine/sessions.toml"), "rb") as f:
        reg = tomllib.load(f)
except (OSError, ValueError):
    sys.exit()
crit = {k for k, v in reg.get("sessions", {}).items() if v == "critical"}
crit_lanes = {k for k, v in reg.get("lanes", {}).items() if v == "critical"}
if not crit and not crit_lanes:
    sys.exit()
lanes = []
try:
    repos = json.loads(Path(env("MACHINE_SESSION_GROVE_REPOS", home / ".config/grove/repos.json")).read_text())
    repos = repos.get("repos", {})
except (OSError, ValueError):
    repos = {}
for repo in repos.values():
    try:
        projects = json.loads((Path(repo["work_dir"]) / ".grove/registry.json").read_text())["projects"]
    except (OSError, ValueError, KeyError, TypeError):
        continue
    for tag, p in projects.items():
        if p.get("path"):
            lanes.append((p["path"].rstrip("/"), tag, (p.get("owner") or {}).get("session_name")))
lanes.sort(key=lambda l: len(l[0]), reverse=True)

def lane_of(d):
    for path, tag, owner in lanes:
        if d == path or d.startswith(path + "/"):
            return tag, owner
    return None, None

# Lanes where a live critical session works.
proc = Path(env("MACHINE_SESSION_PROC", "/proc"))
worked = {}
for f in Path(env("MACHINE_SESSION_SESSIONS_DIR", home / ".claude/sessions")).glob("*.json"):
    try:
        s = json.loads(f.read_text())
        pid = int(s["pid"])
    except (OSError, ValueError, KeyError, TypeError):
        continue
    if s.get("name") not in crit:
        continue
    try:
        stat = (proc / str(pid) / "stat").read_text()
    except OSError:
        continue
    rest = stat[stat.rfind(")") + 2 :].split()
    if s.get("procStart") and len(rest) > 19 and rest[19] != str(s["procStart"]):
        continue
    tag, _ = lane_of(s.get("cwd") or "")
    if tag:
        worked.setdefault(tag, s["name"])

for d in sys.argv[1:]:
    for d in dict.fromkeys([d.rstrip("/"), os.path.realpath(d)]):
        tag, owner = lane_of(d)
        if not tag:
            continue
        if tag in crit_lanes:
            print(f"grove lane {tag} is critical in ~/.config/machine/sessions.toml")
        elif owner in crit:
            print(f"grove lane {tag} belongs to critical session {owner}")
        elif tag in worked:
            print(f"grove lane {tag} is where critical session {worked[tag]} works")
        else:
            continue
        sys.exit()
PY
}

# ---------------------------------------------------------------- old rule

# True when a process above us holds one of the slot locks, for example
# `flock heavy-build.lock heavy-build ...`. Matches on inode only: on btrfs,
# stat's device number is the subvolume's, not the one /proc/locks prints.
ancestor_holds_lock() {
  local inos="" f ino holders pid p
  for f in "${SLOTS[@]}"; do
    ino=$(stat -c %i -- "$f" 2>/dev/null) && inos+=" $ino"
  done
  [[ -n $inos ]] || return 1
  holders=$(awk -v is="$inos" 'BEGIN {n = split(is, a, " "); for (k = 1; k <= n; k++) want[a[k]] = 1}
    $2 == "FLOCK" && $3 != "->" {split($6, d, ":"); if (d[3] in want) print $5}' /proc/locks 2>/dev/null)
  [[ -n $holders ]] || return 1
  pid=$PPID
  while [[ -n $pid && $pid -gt 1 ]]; do
    for p in $holders; do [[ $p == "$pid" ]] && return 0; done
    pid=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)
  done
  return 1
}

mem_avail_gib() { awk '/^MemAvailable:/ {print int($2 / 1048576); exit}' "$MEMINFO" 2>/dev/null; }

# GiB of swap left before systemd-oomd's 90% limit. Empty when there is no swap.
swap_room_gib() {
  awk '/^SwapTotal:/ {t = $2} /^SwapFree:/ {f = $2}
    END {if (t > 0) print int((0.9 * t - (t - f)) / 1048576)}' "$MEMINFO" 2>/dev/null
}

# Number of scopes with processes in builds.slice (heavy-build or the old rule).
active_build_scopes() {
  local e n=0
  for e in "$BSLICE"/*.scope/cgroup.events; do
    [[ -e $e ]] && grep -qx 'populated 1' "$e" 2>/dev/null && n=$(( n + 1 ))
  done
  echo "$n"
}

# Start time of a process (field 22 of /proc/PID/stat), to tell a live waiter
# from a new process that got the same pid.
proc_start() {
  local s
  { s=$(<"/proc/$1/stat"); } 2>/dev/null || return 1
  s=${s##*) }
  # shellcheck disable=SC2086
  set -- $s
  echo "${20}"
}

# A ticket's first line is "pid starttime"; it is live while that process
# runs. The second line is "prio mem cores wall keys" for the budget rule.
# Waiters running an older heavy-build read only the first line.
ticket_alive() {
  local pid st
  read -r pid st < "$1" 2>/dev/null || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ $(proc_start "$pid") == "$st" ]]
}

write_ticket() {
  rm -f -- "$JDIR/$unit"
  mkdir -p "$QDIR" 2>/dev/null
  printf '%s %s\n%s %s %s %s %s %s\n' "$$" "$(proc_start $$)" "$PRIO" "$est_mem" "$est_cores" "$est_wall" "$keys_csv" "$cls" \
    > "$ticket.tmp" && mv -f "$ticket.tmp" "$ticket"
}

# Sets pos (our place in line, 1 = next), total, and dup (an earlier ticket has
# our hash). Removes tickets whose waiter is gone.
queue_scan() {
  local LC_ALL=C t
  pos=0 total=0 dup=
  for t in "$QDIR"/[0-9]*; do
    [[ -e $t && $t != *.tmp ]] || continue
    if [[ $t != "$ticket" ]] && ! ticket_alive "$t"; then rm -f -- "$t"; continue; fi
    total=$(( total + 1 ))
    if [[ $t == "$ticket" ]]; then
      pos=$total
    elif (( pos == 0 )) && [[ ${t##*-} == "$hash" ]]; then
      dup=1
    fi
  done
}

# Build scopes whose heavy-build was killed (SIGKILL) run on without a slot.
# The unit name carries the heavy-build pid, so a dead pid marks an orphan.
orphan_scopes() {
  local u pid
  systemctl --user list-units --type=scope --state=active --plain --no-legend 'heavy-build-*.scope' 2>/dev/null \
    | awk '{print $1}' | while read -r u; do
        pid=${u#heavy-build-}; pid=${pid%%-*}
        [[ $pid =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null && echo "$u"
      done
}

# Number of slot locks nobody holds, not counting the one on fd 9.
other_free_slots() {
  local f n=0
  for f in "${SLOTS[@]}"; do
    [[ $f == "$held" ]] && continue
    if { exec 7>>"$f" && flock -n 7; } 2>/dev/null; then n=$(( n + 1 )); fi
    exec 7>&- 2>/dev/null
  done
  echo "$n"
}

# Take a free slot, new slots first, so builds still waiting with the old
# `flock heavy-build.lock` rule get slot 0 when it frees up.
try_slot() {
  local f
  for f in "$LOCK.2" "$LOCK.1" "$LOCK"; do
    exec 9>>"$f" || continue
    if flock -n 9; then held=$f; return 0; fi
    exec 9>&-
  done
  return 1
}

# ---------------------------------------------------------------- stale scopes

# "pid:comm" for each process in the scope cgroup $1 whose comm can be read.
scope_procs() {
  local pid comm
  while read -r pid; do
    read -r comm 2>/dev/null < "$PROC/$pid/comm" || continue
    printf '%s:%s\n' "$pid" "$comm"
  done 2>/dev/null < "$1/cgroup.procs"
}

# True when $1 (scope_procs output) is not empty and lists only Wine leftovers.
only_wine_leftovers() {
  local l
  [[ -n $1 ]] || return 1
  while read -r l; do [[ $WINE_LEFTOVERS == *" ${l#*:} "* ]] || return 1; done <<< "$1"
}

# cpu_rate UNIT USAGE_USEC: the scope's CPU use in millicores over the last
# full window of HB_IDLE_SECS (default 120), or "-" until the first window
# ends. Samples ("start_epoch usage_usec rate") live in $CPUDIR/<unit>, shared
# by every heavy-build, so the window spans waiters that come and go.
cpu_rate() {
  local f=$CPUDIR/$1 t0= u0= r=- now=$EPOCHSECONDS
  read -r t0 u0 r 2>/dev/null < "$f"
  if [[ ! $t0 =~ ^[0-9]+$ || ! $u0 =~ ^[0-9]+$ ]] || (( $2 < u0 )); then
    mkdir -p "$CPUDIR" 2>/dev/null
    printf '%s %s -\n' "$now" "$2" > "$f.$$" && mv -f "$f.$$" "$f"
    echo -
    return
  fi
  if (( now > t0 && now - t0 >= IDLE_SECS )); then
    r=$(( ($2 - u0) / (now - t0) / 1000 ))
    printf '%s %s %s\n' "$now" "$2" "$r" > "$f.$$" && mv -f "$f.$$" "$f"
  fi
  echo "${r:--}"
}

# True while the heavy-build (pid $2) that made scope $1 still runs: its
# state file names the pid and start time, or, with no state file, the pid
# still runs heavy-build.
hb_alive() {
  local u p st rest
  if read -r u p st rest 2>/dev/null < "$JDIR/$1"; then
    [[ $(proc_start "$2") == "$st" ]]
    return
  fi
  tr '\0' ' ' < "/proc/$2/cmdline" 2>/dev/null | grep -q heavy-build
}

# Stops heavy-build scopes whose heavy-build is gone, for example killed with
# SIGKILL so its own cleanup never ran. Only a scope that holds nothing but
# Wine leftovers, or that used under 0.05 cores over the last HB_IDLE_SECS,
# is stopped. A scope that still does work is left alone and logged once.
sweep_stale() {
  local d u pid procs list k v usec r why f n
  for d in "$BSLICE"/heavy-build-*.scope; do
    [[ -d $d ]] || continue
    grep -qx 'populated 1' "$d/cgroup.events" 2>/dev/null || continue
    u=${d##*/}; u=${u%.scope}
    pid=${u#heavy-build-}; pid=${pid%%-*}
    [[ $pid =~ ^[0-9]+$ ]] || continue
    hb_alive "$u" "$pid" && continue
    procs=$(scope_procs "$d")
    [[ -n $procs ]] || continue
    list=$(paste -sd, - <<< "$procs")
    usec=0
    while read -r k v; do [[ $k == usage_usec ]] && { usec=$v; break; }; done 2>/dev/null < "$d/cpu.stat"
    [[ $usec =~ ^[0-9]+$ ]] || usec=0
    r=$(cpu_rate "$u" "$usec")
    if only_wine_leftovers "$procs"; then
      why=wine-leftovers
    elif [[ $r =~ ^[0-9]+$ ]] && (( r < 50 )); then
      why=idle
    else
      if [[ ! -e $CPUDIR/$u.noted ]]; then
        : > "$CPUDIR/$u.noted" 2>/dev/null
        log_line "event=stale-keep unit=$u heavy_build_pid=$pid cpu_milli=$r procs=$list reason=\"its heavy-build is gone but the scope still does work, so it stays\""
      fi
      continue
    fi
    log_line "event=sweep unit=$u reason=$why heavy_build_pid=$pid cpu_milli=$r procs=$list"
    [[ $why == wine-leftovers ]] && systemctl --user kill --signal=KILL "$u.scope" 2>/dev/null
    systemctl --user stop "$u.scope" 2>/dev/null
    rm -f -- "$JDIR/$u" "$CPUDIR/$u" "$CPUDIR/$u.noted"
  done
  # Forget the samples of scopes that are gone.
  for f in "$CPUDIR"/*; do
    [[ -e $f ]] || continue
    n=${f##*/}; n=${n%.noted}
    [[ $n == *.* ]] && continue
    [[ -d $BSLICE/$n.scope ]] || rm -f -- "$f"
  done
}

# Keeps $PSIF ("under_since last_sample"): since when CPU pressure (some
# avg10) has stayed at or under HEAVY_BUILD_MAX_CPU_PSI, as seen by waiters
# and running builds. A gap over HB_PSI_GAP_SECS between samples starts the
# count again. Sets cpu_quiet to the seconds it has stayed under (0 while
# over). Without a pressure file the rule is off.
psi_watch() {
  local v= l ip fp since= last= now=$EPOCHSECONDS
  cpu_quiet=999999
  while read -r l; do [[ $l == some\ * ]] && { v=${l#*avg10=}; v=${v%% *}; break; }; done 2>/dev/null < "$PROC/pressure/cpu"
  [[ $v =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
  cpu_quiet=0
  ip=${v%%.*}; fp=00
  [[ $v == *.* ]] && fp=${v#*.}00
  fp=${fp:0:2}
  {
    flock 5
    read -r since last 2>/dev/null < "$PSIF"
    if (( 10#$ip * 100 + 10#$fp > MAX_CPU_PSI * 100 )); then
      since=-
    elif [[ ! $since =~ ^[0-9]+$ || ! $last =~ ^[0-9]+$ ]] || (( now - last > PSI_GAP )); then
      since=$now
    fi
    printf '%s %s\n' "$since" "$now" > "$PSIF.tmp" && mv -f "$PSIF.tmp" "$PSIF"
  } 5>>"$PSIF.lock" 2>/dev/null
  [[ $since =~ ^[0-9]+$ ]] && cpu_quiet=$(( now - since ))
}

# ---------------------------------------------------------------- budget rule

# One line per running build. Own builds come from their state files
# ($JDIR/<unit>: "unit pid pidstart start mem cores wall cur_bytes
# cores60_milli stalled prio keys class"); a state file whose heavy-build is gone is
# removed once its scope is empty. Scopes in builds.slice without a live
# heavy-build (orphans, the old flock rule) come as "F unit cur_bytes cpu_usec
# age_s idle keys", where idle is 1 when the scope used under 0.05 cores over
# the last HB_IDLE_SECS, and keys come from a state file its heavy-build left
# behind (a SIGKILL skips the cleanup), so its lock keys stay held.
# A state file is removed (event=sweep) and charges nothing when its
# heavy-build is in the queue as a waiter, or when its scope has not run for
# HB_NO_SCOPE_SECS (60) since the build was let in: such a heavy-build runs no
# build, and its charge could hold the queue for good.
running_lines() {
  local f u pid st start em ec ew cur c60 stl pr ks cl seen=" " d age usec k v r idle t waiting=" "
  local -A left=()
  for t in "$QDIR"/[0-9]*; do
    [[ -e $t && $t != *.tmp ]] || continue
    t=${t##*/}; t=${t#*-}; waiting+="${t%%-*} "
  done
  for f in "$JDIR"/heavy-build-*; do
    [[ -e $f && $f != *.tmp ]] || continue
    cl=
    read -r u pid st start em ec ew cur c60 stl pr ks cl < "$f" || continue
    if [[ $(proc_start "$pid") != "$st" ]]; then
      if grep -qx 'populated 1' "$BSLICE/$u.scope/cgroup.events" 2>/dev/null; then left[$u]=${ks:--}
      else rm -f -- "$f"; fi
      continue
    fi
    if ! grep -qx 'populated 1' "$BSLICE/$u.scope/cgroup.events" 2>/dev/null; then
      if [[ $waiting == *" $pid "* ]]; then
        rm -f -- "$f"
        log_line "event=sweep unit=$u reason=waiting heavy_build_pid=$pid cores=$ec"
        continue
      fi
      if [[ $start =~ ^[0-9]+$ ]] && (( EPOCHSECONDS - start > NO_SCOPE_SECS )); then
        rm -f -- "$f"
        log_line "event=sweep unit=$u reason=no-scope heavy_build_pid=$pid cores=$ec age_s=$(( EPOCHSECONDS - start ))"
        continue
      fi
    fi
    seen+="$u "
    echo "R $u $start $em $ec $(( start + ${ew%.*} )) $cur $c60 $stl $pr ${ks:--} ${cl:--}"
  done
  for d in "$BSLICE"/*.scope; do
    [[ -d $d ]] || continue
    grep -qx 'populated 1' "$d/cgroup.events" 2>/dev/null || continue
    u=${d##*/}; u=${u%.scope}
    [[ $seen == *" $u "* ]] && continue
    read -r cur 2>/dev/null < "$d/memory.current" || cur=0
    usec=0
    while read -r k v; do [[ $k == usage_usec ]] && { usec=$v; break; }; done 2>/dev/null < "$d/cpu.stat"
    age=$(( EPOCHSECONDS - $(stat -c %Z -- "$d" 2>/dev/null || echo "$EPOCHSECONDS") ))
    [[ $usec =~ ^[0-9]+$ ]] || usec=0
    r=$(cpu_rate "$u" "$usec")
    idle=0
    [[ $r =~ ^[0-9]+$ ]] && (( r < 50 )) && idle=1
    echo "F $u $cur $usec $age $idle ${left[$u]:--}"
  done
}

# One line per live ticket: "W name arrival_s prio mem cores wall keys class".
# Tickets from an older heavy-build have no second line and get the defaults.
waiter_lines() {
  local t name l1 p m c w k cl
  for t in "$QDIR"/[0-9]*; do
    [[ -e $t && $t != *.tmp ]] || continue
    name=${t##*/}
    p= m= c= w= k= cl=
    { read -r l1; read -r p m c w k cl; } < "$t" 2>/dev/null
    echo "W $name $(( ${name%%-*} / 1000000000 )) ${p:-normal} ${m:-8} ${c:-8} ${w:-600} ${k:--} ${cl:--}"
  done
}

# The admission walk. Input: R, F and W lines. Prints
# "start|wait<TAB>rank<TAB>reason<TAB>untracked<TAB>prioheld<TAB>cap" for the
# waiter named by `me`. cap is the builds.slice cap used, as <GiB>G(max|high)
# or none.
# Each reason starts with a short kind and a colon. untracked lists the F scopes
# as unit:GiB, comma separated, or "-".
# shellcheck disable=SC2016
ADMIT_AWK='
function max(a, b) { return a > b ? a : b }
# "avg10 avg60" of the some line of pressure file f, or "-1 -1".
function psi1060(f,   l, a, b, c, v) {
  v = "-1 -1"
  while ((getline l < f) > 0) if (l ~ /^some /) { split(l, a, " "); split(a[2], b, "="); split(a[3], c, "="); v = (b[2] + 0) " " (c[2] + 0) }
  close(f); return v
}
function psi10(f,   l, a, b, v) {
  v = -1
  while ((getline l < f) > 0) if (l ~ /^some /) { split(l, a, " "); split(a[2], b, "="); v = b[2] + 0 }
  close(f); return v
}
# Lock keys a build holds. A tree key tree:<top>#<suffix> also marks <top>
# as held by a suffixed build, so a plain tree:<top> waits for it.
function hold(keys, id,   n, k, i, b) {
  if (keys == "" || keys == "-") return
  n = split(keys, k, ",")
  for (i = 1; i <= n; i++) { busy[k[i]] = id; if ((b = index(k[i], "#")) > 0) subheld[substr(k[i], 1, b - 1)] = k[i] }
}
# The held key that blocks these keys, or "". The same key blocks. A plain
# tree:<top> and any tree:<top>#<suffix> block each other. Two different
# suffixes do not.
function clash(keys,   n, k, i, b) {
  if (keys == "" || keys == "-") return ""
  n = split(keys, k, ",")
  for (i = 1; i <= n; i++) {
    if (k[i] in busy) return k[i]
    if ((b = index(k[i], "#")) > 0) { if (substr(k[i], 1, b - 1) in busy) return substr(k[i], 1, b - 1) }
    else if (k[i] in subheld) return subheld[k[i]]
  }
  return ""
}
# The plain tree key that a waiter ahead (before place o in order) holds
# against these suffixed keys by the writer preference, or "".
function writer(keys, o,   n, k, i, b, t) {
  if (keys == "" || keys == "-") return ""
  n = split(keys, k, ",")
  for (i = 1; i <= n; i++) if ((b = index(k[i], "#")) > 0 && ((t = substr(k[i], 1, b - 1)) in wpos) && wpos[t] < o) return t
  return ""
}
function addrun(id, start, mem, cores, end, cur, c60, stalled, prio, keys, pct, cls,   n, k, i, held, tc, cc) {
  nr++
  if (stalled == 1) { held = cur; tc = 0; cc = 0 }
  else {
    held = max(cur, mem); tc = max(0, mem * pct / 100 - cur)
    cc = (c60 == "-" || now - start < warm) ? cores : max(0.25, c60 / 1000)
  }
  r_end[nr] = max(end, now + poll); r_tc[nr] = tc; r_cc[nr] = cc; r_held[nr] = held
  r_cur[nr] = cur; r_high[nr] = (prio == "high")
  T_n++; T_cpu += cc; T_tc += tc; T_held += held; T_high += (prio == "high"); T_aged += (prio ~ /:aged$/)
  T_nc += (prio !~ /^(high|critical)(:aged)?$/)
  T_app += (cls == "app-run")
  hold(keys, id)
}
function why_not(i, nrun, cpu, tc, held, av, nhigh) {
  if (nrun <= 0) return (av >= solo) ? "" : sprintf("memory: %.1f GiB available, the first build needs %d", av, solo)
  if (nrun >= maxjobs) return sprintf("jobs: %d builds run, the limit is %d", nrun, maxjobs)
  if (w_pr[i] == "high" && nhigh >= 2) return "high-cap: 2 high-priority builds already run"
  if (cpu + w_cores[i] > cpubudget) return sprintf("cores: needs %.1f, %.1f of %d are charged", w_cores[i], cpu, cpubudget)
  if (w_cores[i] >= 2 && cpupsi > maxcpupsi) return sprintf("cpu-pressure: %.1f%%, the limit is %d%%", cpupsi, maxcpupsi)
  if (w_cores[i] >= 2 && cpuquiet < cpuhold) return sprintf("cpu-pressure: %.1f%%, under the %d%% limit for %d s, it must stay under for %d s", cpupsi, maxcpupsi, cpuquiet, cpuhold)
  if (av + swx - tc - w_mem[i] < reserve) return sprintf("memory: needs %.1f GiB; %.1f available%s, %.1f still to come for running builds, reserve %d", w_mem[i], av, swxnote, tc, reserve)
  if (held + w_mem[i] > slicecap) return sprintf("slice-cap: needs %.1f GiB; builds hold %.1f of the %.1f GiB builds.slice cap (%s)", w_mem[i], held, slicecap, capsrc == "high" ? "MemoryHigh" : "MemoryMax")
  return ""
}
# The critical-first switch (cf=1): a normal or low waiter also needs a free
# non-critical slot and cfreserve GiB left after its estimate. "" when it may go on.
function cf_why(i, nnc, tc, av) {
  if (!cf || w_pr[i] == "high" || w_pr[i] == "critical") return ""
  if (nnc >= cfslots) return sprintf("critical-first: %d normal or low builds run, the limit is %d while critical builds go first", nnc, cfslots)
  if (av + swx - tc - w_mem[i] < cfreserve) return sprintf("critical-first: needs %.1f GiB; %.1f available%s, %.1f still to come for running builds, normal and low builds must leave %d", w_mem[i], av, swxnote, tc, cfreserve)
  return ""
}
function pick(i) { addrun(w_id[i], now, w_mem[i], w_cores[i], now + w_wall[i], 0, "-", 0, w_pr[i] (w_aged[i] ? ":aged" : ""), w_keys[i], tcpct, w_cls[i]); picked[i] = 1 }
# When enough running builds should have ended for waiter i to fit.
function shadow_time(i,   j, k, x, idx, nrun, cpu, tc, held, av, nh) {
  for (j = 1; j <= nr; j++) idx[j] = j
  for (j = 2; j <= nr; j++) { x = idx[j]; for (k = j - 1; k >= 1 && r_end[idx[k]] > r_end[x]; k--) idx[k + 1] = idx[k]; idx[k + 1] = x }
  nrun = T_n; cpu = T_cpu; tc = T_tc; held = T_held; av = avail; nh = T_high
  for (j = 1; j <= nr; j++) {
    k = idx[j]
    nrun--; cpu -= r_cc[k]; tc -= r_tc[k]; held -= r_held[k]; av += r_cur[k]; nh -= r_high[k]
    if (why_not(i, nrun, cpu, tc, held, av, nh) == "") return r_end[k]
  }
  return nr > 0 ? r_end[idx[nr]] : now
}
BEGIN {
  while ((getline l < meminfo) > 0) {
    split(l, f, " ")
    if (f[1] == "MemAvailable:") avail = f[2] / 1048576
    else if (f[1] == "SwapTotal:") swt = f[2]
    else if (f[1] == "SwapFree:") swf = f[2]
  }
  close(meminfo)
  # The cap is the lower of memory.max and memory.high; "max" or a missing
  # file means no limit. On a tie memory.max is named.
  slicecap = 1e9; capsrc = "none"
  if ((getline l < slicemax) > 0 && l ~ /^[0-9]+$/) { slicecap = l / 1073741824; capsrc = "max" }
  close(slicemax)
  if ((getline l < slicehigh) > 0 && l ~ /^[0-9]+$/ && l / 1073741824 < slicecap) { slicecap = l / 1073741824; capsrc = "high" }
  close(slicehigh)
  capinfo = (capsrc == "none") ? "none" : sprintf("%.1fG(%s)", slicecap, capsrc)
  # Swap headroom: while system memory pressure (some avg10 and avg60) is
  # under 1.0%, swpct percent of SwapFree, at most swcap GiB, counts as
  # available for the memory and critical-first checks. Never when the
  # pressure is higher or cannot be read.
  swx = 0; swxnote = ""
  split(mempsifile == "" ? "-1 -1" : psi1060(mempsifile), mp, " ")
  if (swpct > 0 && swcap > 0 && swf > 0 && mp[1] >= 0 && mp[1] < 1.0 && mp[2] >= 0 && mp[2] < 1.0) {
    swx = swf / 1048576 * swpct / 100; if (swx > swcap) swx = swcap
    swxnote = sprintf(" (+%.1f swap headroom)", swx)
  }
  cpupsi = psi10(cpupsifile); if (cpupsi < 0) cpupsi = 0
  claudepsi = psi10(claudepsifile); apppsi = psi10(apppsifile)
}
$1 == "R" { addrun($2, $3, $4, $5, $6, $7 / 1073741824, $8, $9, $10, $11, tcpct, $12) }
# A scope without a live heavy-build: charged its current memory plus 2 GiB still to come.
# An idle one only holds its current memory (and its lock keys); it is not a running build.
$1 == "F" && $6 == 1 {
  T_held += $3 / 1073741824
  hold($7, $2)
  untracked = untracked (untracked == "" ? "" : ",") sprintf("%s:%.1fG:idle", $2, $3 / 1073741824)
  next
}
$1 == "F" {
  c = ($5 >= 10) ? $4 / 1e6 / $5 * 1000 : "-"
  addrun($2, 0, $3 / 1073741824 + 2, 8, now + 600, $3 / 1073741824, c, 0, "normal", ($7 == "" ? "-" : $7), 100, "-")
  untracked = untracked (untracked == "" ? "" : ",") sprintf("%s:%.1fG", $2, $3 / 1073741824)
}
$1 == "W" {
  nw++; w_id[nw] = $2; w_arr[nw] = $3; p = $4
  if (p == "low" && now - $3 >= lowage) p = "normal"
  w_pr[nw] = p; w_rank[nw] = (p == "high") ? 0 : (p == "critical") ? 1 : (p == "low") ? 3 : 2
  w_mem[nw] = $5 + 0; w_cores[nw] = $6 + 0; w_wall[nw] = $7 + 0; w_keys[nw] = $8; w_cls[nw] = $9
}
END {
  # The aging slot: the oldest normal or low waiter that has waited agesecs
  # goes ahead of critical ones (rank 0.5), while fewer than ageslots builds
  # let in this way run. A running one has prio <prio>:aged.
  for (n = ageslots - T_aged; n > 0; n--) {
    a = 0
    for (i = 1; i <= nw; i++) if (w_rank[i] >= 2 && now - w_arr[i] >= agesecs && (!a || w_id[i] < w_id[a])) a = i
    if (!a) break
    w_rank[a] = 0.5; w_aged[a] = 1
  }
  for (i = 1; i <= nw; i++) ord[i] = i
  for (i = 2; i <= nw; i++) {
    x = ord[i]
    for (j = i - 1; j >= 1 && (w_rank[ord[j]] > w_rank[x] || (w_rank[ord[j]] == w_rank[x] && w_id[ord[j]] > w_id[x])); j--) ord[j + 1] = ord[j]
    ord[j + 1] = x
  }
  # Writer preference: the first waiter in order with a plain tree:<top> key
  # holds that tree. No waiter behind it with a tree:<top>#<suffix> key may
  # start first. Suffixed waiters ahead of it keep their place.
  for (o = 1; o <= nw; o++) {
    i = ord[o]
    if (w_keys[i] == "" || w_keys[i] == "-") continue
    n = split(w_keys[i], k, ",")
    for (j = 1; j <= n; j++) if (k[j] ~ /^tree:/ && index(k[j], "#") == 0 && !(k[j] in wpref)) { wpref[k[j]] = i; wpos[k[j]] = o }
  }
  gate = ""
  if (swt > 0 && (0.9 * swt - (swt - swf)) / 1048576 < minswap)
    gate = sprintf("swap: %.1f GiB left before the oomd limit, need %d", (0.9 * swt - (swt - swf)) / 1048576, minswap)
  else if (claudepsi >= maxmempsi) gate = sprintf("interactive: claude.slice memory pressure %.1f%%, the limit is %d%%", claudepsi, maxmempsi)
  else if (apppsi >= maxmempsi) gate = sprintf("interactive: app.slice memory pressure %.1f%%, the limit is %d%%", apppsi, maxmempsi)
  # critw: the first critical waiter that waits for job slots, cores or CPU
  # pressure. Normal and low builds may not start ahead of it.
  headi = 0; starving = 0; shadow = 0; critw = 0
  for (o = 1; o <= nw; o++) {
    i = ord[o]
    if (gate != "") { why[i] = gate; continue }
    bk = clash(w_keys[i])
    if (bk != "") { why[i] = "key: lock key " bk " is busy (" busy[bk] ")"; continue }
    # App runs (headless MotionCatalyst) last for hours. At most maxapp of them
    # hold job slots. One that waits for this keeps its place but is never the
    # head of the line, so it cannot starve builds behind it.
    if (w_cls[i] == "app-run" && maxapp > 0 && T_app >= maxapp) { why[i] = sprintf("app-cap: %d app runs hold job slots, the limit is %d", T_app, maxapp); continue }
    wk = writer(w_keys[i], o)
    if (wk != "") { why[i] = "writer: " w_id[wpref[wk]] " waits for " wk ", so no new build with a suffixed key in that tree starts first"; continue }
    if (critw && w_rank[i] > 1) { why[i] = sprintf("critical: %s from a critical session waits for %s, so it goes first", w_id[critw], critwhat); continue }
    if (!headi) {
      r = why_not(i, T_n, T_cpu, T_tc, T_held, avail, T_high)
      if (r == "") r = cf_why(i, T_nc, T_tc, avail)
      if (r == "") { pick(i); why[i] = "fits: next in order"; continue }
      # An aged head never starves the queue: high and critical builds that
      # fit pass it, so it holds only the slot it gets next.
      headi = i; why[i] = r; shadow = shadow_time(i); starving = (now - w_arr[i] >= starve && !w_aged[i])
      if (w_pr[i] == "critical" && r ~ /^(jobs|cores|cpu-pressure):/) { critw = i; critwhat = substr(r, 1, index(r, ":") - 1) }
      continue
    }
    if (starving) { why[i] = sprintf("starve: %s has waited %d min, so nothing may pass it", w_id[headi], (now - w_arr[headi]) / 60); continue }
    r = why_not(i, T_n, T_cpu, T_tc, T_held, avail, T_high)
    if (r == "") r = cf_why(i, T_nc, T_tc, avail)
    if (r != "" && !critw && w_pr[i] == "critical" && r ~ /^(jobs|cores|cpu-pressure):/) { critw = i; critwhat = substr(r, 1, index(r, ":") - 1) }
    if (r != "") { why[i] = r; continue }
    if (w_aged[headi] && w_rank[i] <= 1) { pick(i); why[i] = "fits: the aged build " w_id[headi] " does not fit yet, and " w_pr[i] " builds may pass it"; continue }
    if (now + 1.5 * w_wall[i] > shadow) { why[i] = sprintf("behind: it would not end before %s can start, in about %d min", w_id[headi], (shadow - now) / 60); continue }
    pick(i); why[i] = "backfill: it fits and should end before " w_id[headi] " can start"
  }
  if (untracked == "") untracked = "-"
  for (o = 1; o <= nw; o++) {
    i = ord[o]
    if (w_id[i] != me) continue
    if (picked[i] && w_aged[i]) why[i] = sprintf("aged: it waited %d min, so it goes ahead of critical builds (%s)", (now - w_arr[i]) / 60, why[i])
    # prioheld: this build waits only because a higher-priority build is
    # ahead of it, or for the critical-first switch, so its give-up clock
    # does not run. While the switch is on, a normal or low build that waits
    # for memory counts as held too: the critical builds it lets in take that
    # memory. On 2026-10-20 a 26.1 beta test gave up after 7201 s of such waits.
    kind = substr(why[i], 1, index(why[i], ":") - 1); ph = 0
    if (!picked[i] && kind !~ /^(swap|interactive|key|writer|app-cap)$/ && (kind == "critical" || kind == "critical-first" || (cf && kind == "memory" && w_pr[i] != "high" && w_pr[i] != "critical") || (headi && headi != i && w_rank[headi] < w_rank[i]))) ph = 1
    if (picked[i] && swx > 0) why[i] = why[i] swxnote
    printf "%s\t%d\t%s\t%s\t%d\t%s\n", (picked[i] ? "start" : "wait"), o, why[i], untracked, ph, capinfo
    exit
  }
  printf "wait\t0\tqueue: no ticket for this build\t%s\t0\t%s\n", untracked, capinfo
}'

# Runs the budget rule for this waiter. Sets dec (start or wait), rank, why,
# capinfo (the builds.slice cap used) and
# prioheld (1 when only higher-priority builds ahead hold it back).
decide() {
  local out
  sweep_stale
  if hold_on; then
    dec=wait rank=0 why="hold: new builds are on hold: $(head -c 200 "$HOLD" 2>/dev/null)" untracked=- prioheld=0 capinfo=-
    return
  fi
  critical_first_on
  psi_watch
  out=$( { running_lines; waiter_lines; } | awk -v now="$EPOCHSECONDS" -v me="${ticket##*/}" \
    -v cpuquiet="$cpu_quiet" -v cpuhold="$CPU_PSI_SECS" \
    -v meminfo="$MEMINFO" -v slicemax="$BSLICE/memory.max" -v slicehigh="$BSLICE/memory.high" -v cpupsifile="$PROC/pressure/cpu" \
    -v claudepsifile="$USVC/claude.slice/memory.pressure" -v apppsifile="$USVC/app.slice/memory.pressure" \
    -v maxjobs="$MAX_JOBS" -v cpubudget="$CPU_BUDGET" -v reserve="$MEM_RESERVE_GIB" \
    -v maxcpupsi="$MAX_CPU_PSI" -v maxmempsi="$MAX_MEM_PSI" -v starve="$STARVE" -v solo="$SOLO_MEM_GIB" \
    -v minswap="$MIN_SWAP_ROOM_GIB" -v warm="$WARMUP" -v poll="$POLL" -v lowage=1800 -v tcpct="$TC_PCT" \
    -v agesecs="$AGE_SECS" -v ageslots="$AGE_SLOTS" -v maxapp="$MAX_APP_RUNS" \
    -v cf="$cf_on" -v cfslots="$cf_slots" -v cfreserve="$cf_reserve" \
    -v mempsifile="$PROC/pressure/memory" -v swpct="$SWAP_HEADROOM_PCT" -v swcap="$SWAP_HEADROOM_GIB" "$ADMIT_AWK")
  IFS=$'\t' read -r dec rank why untracked prioheld capinfo <<< "$out"
  if [[ -z ${dec:-} ]]; then dec=wait rank=0 why="error: the budget check printed nothing"; fi
  [[ ${prioheld:-} == 1 ]] || prioheld=0
  untracked=${untracked:--} capinfo=${capinfo:--}
}

# ---------------------------------------------------------------- logging

# Appends one line to the decision log of the current mode.
log_line() {
  local f=$STATE/$MODE.log sz
  mkdir -p "$STATE" 2>/dev/null || return 0
  {
    flock 6
    printf '%(%Y-%m-%dT%H:%M:%S%z)T mode=%s job=%s %s\n' -1 "$MODE" "$jobid" "$*" >&6
    sz=$(stat -c %s -- "$f" 2>/dev/null || echo 0)
    if (( sz > 20000000 )); then tail -n 50000 -- "$f" > "$f.tmp" && mv -f -- "$f.tmp" "$f"; fi
  } 6>>"$f"
}

# True while the manager's hold file is in force: it exists, and it has no
# expires=<epoch> line or that time has not come. On 2026-10-14 a hold meant
# for 18 min stayed 36 min because the manager missed its check; about 28
# builds waited. Logs "hold expired" once per expiry time.
hold_on() {
  local line exp=
  [[ -e $HOLD ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^expires=([0-9]{1,15})([^0-9]|$) ]]; then exp=$(( 10#${BASH_REMATCH[1]} )); break; fi
  done 2>/dev/null < "$HOLD"
  [[ -n $exp ]] || return 0
  (( EPOCHSECONDS < exp )) && return 0
  if [[ $hold_expired_logged != "$exp" ]]; then
    hold_expired_logged=$exp
    say "hold expired at $(printf '%(%H:%M:%S)T' "$exp"); going on although $HOLD is still there"
    log_line "event=hold-expired expires=$exp reason=\"hold expired; the hold file is still there\""
  fi
  return 1
}

# The critical-first switch ($CRITF, see the header). Sets cf_on (1 while the
# file exists and its expires= time, if any, has not come), cf_slots
# (noncrit_slots=, default 1) and cf_reserve (reserve_gib=, default 12).
# Logs "critical-first expired" once per expiry time. Returns 0 when on.
critical_first_on() {
  local line exp=
  cf_on=0 cf_slots=1 cf_reserve=12
  [[ -e $CRITF ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    if [[ -z $exp && $line =~ ^expires=([0-9]{1,15})([^0-9]|$) ]]; then exp=$(( 10#${BASH_REMATCH[1]} ))
    elif [[ $line =~ ^noncrit_slots=([0-9]{1,3})[[:space:]]*$ ]]; then cf_slots=$(( 10#${BASH_REMATCH[1]} ))
    elif [[ $line =~ ^reserve_gib=([0-9]{1,4})[[:space:]]*$ ]]; then cf_reserve=$(( 10#${BASH_REMATCH[1]} ))
    fi
  done 2>/dev/null < "$CRITF"
  if [[ -n $exp ]] && (( EPOCHSECONDS >= exp )); then
    if [[ $critf_expired_logged != "$exp" ]]; then
      critf_expired_logged=$exp
      log_line "event=critical-first-expired expires=$exp reason=\"critical-first expired; the switch file is still there\""
    fi
    return 1
  fi
  cf_on=1
}

# Logs the budget decision when it, its reason kind or the actual outcome
# changes. $1 is what actually happened: wait or start.
log_decision() {
  local k="$dec|${why%%:*}|$1|$MODE|${capinfo:--}" since=
  if [[ $dec == start ]]; then
    [[ -n $would_since ]] || would_since=$EPOCHSECONDS
  else
    would_since=
  fi
  [[ $k == "$last_log" ]] && return
  last_log=$k
  [[ -n $would_since ]] && since=" would_start_for=$(( EPOCHSECONDS - would_since ))s"
  [[ $dec == start && $why == aged:* ]] && since+=" aged=1"
  log_line "decision=$dec reason=\"$why\" cap=${capinfo:--} actual=$1${since} rank=$rank est=${est_mem}G/${est_cores}c/${est_wall}s($est_src) prio=$PRIO keys=$keys_csv untracked=${untracked:--} cmd=\"$cmdline\""
}

# Logs a refusal as decision=refuse, then exits. $1 is the reason, $2 the
# exit code (default 75; 77 for the --wait-timeout).
refuse() {
  log_line "decision=refuse reason=\"$1\" waited_s=$(( EPOCHSECONDS - queued_ts )) stuck_s=${stuck:-0} rank=${pos:-0} prio=$PRIO keys=$keys_csv cmd=\"$cmdline\""
  exit "${2:-75}"
}

# ---------------------------------------------------------------- job state

write_state() {
  mkdir -p "$JDIR" 2>/dev/null
  printf '%s %s %s %s %s %s %s %s %s %s %s %s %s\n' "$unit" "$$" "$mystart" "$start_ts" "$est_mem" "$est_cores" \
    "$est_wall" "$1" "$2" "$3" "$state_prio" "$keys_csv" "$cls" > "$JDIR/$unit.tmp" && mv -f "$JDIR/$unit.tmp" "$JDIR/$unit"
}

now_us() { local t=${EPOCHREALTIME//[!0-9]/}; echo "${t#0}"; }

# Wine prefixes in our scope that have lost their wineserver, one per line.
# A process's prefix is the WINEPREFIX in its own /proc environ, else
# $wine_fb, the prefix heavy-build gave the job (its WINEPREFIX, unless
# run-tests.sh ignores that one). A process with neither is not guessed to
# use ~/.wine: Wine's own children (services.exe, winedevice.exe, test hosts
# started with their own environment) often lack WINEPREFIX and reach their
# wineserver through the inherited WINESERVERSOCKET instead. On 2026-10-14
# that guess warned "the wineserver for ~/.wine is gone" for a run whose own
# prefix was fine. Such processes are counted on a last line "?<count>"
# instead, so the caller can log that it skipped them.
# Only the run's own prefixes ($wine_own, one per line, and <$wine_runs>-run<n>
# when run-tests.sh may have moved there) are printed plainly, and only when
# some process in them is more than a Wine service process (WINE_LEFTOVERS):
# a prefix with only those left is shutting down, not hung. Any other prefix
# without a wineserver is printed as "~<prefix>", for the log only. On
# 2026-10-20 a test-fallback.sh run stopped a UI prefix of its own, and its
# winedevice.exe, still in the scope for a few seconds, set off the warning.
wine_orphans() {
  local d=$1 pid comm p l f fb own o mine nopfx=0
  local -A comm_of=() pfx_of=() busy=() seen=()
  fb=${wine_fb-${WINEPREFIX:-}}
  own=${wine_own-$fb}
  while read -r pid; do
    read -r comm 2>/dev/null < "$PROC/$pid/comm" || continue
    [[ $comm == *.exe || $comm == wine || $comm == wine64 || $comm == wine*-preloader ]] || continue
    comm_of[$pid]=$comm
  done 2>/dev/null < "$d/cgroup.procs"
  (( ${#comm_of[@]} )) || return 0
  local files=()
  for pid in "${!comm_of[@]}"; do files+=("$PROC/$pid/environ"); done
  while IFS= read -r -d '' l; do
    f=${l%%:WINEPREFIX=*}
    pid=${f%/environ}; pid=${pid##*/}
    [[ -n ${pfx_of[$pid]+x} ]] || pfx_of[$pid]=${l#"$f":WINEPREFIX=}
  done < <(grep -a -z -H '^WINEPREFIX=' "${files[@]}" 2>/dev/null)
  for pid in "${!comm_of[@]}"; do
    if [[ -n ${pfx_of[$pid]+x} ]]; then p=${pfx_of[$pid]}
    elif [[ -n $fb ]]; then p=$fb
    else nopfx=$(( nopfx + 1 )); continue
    fi
    p=${p%/}
    [[ -n $p ]] || continue
    seen[$p]=1
    [[ $WINE_LEFTOVERS == *" ${comm_of[$pid]} "* ]] || busy[$p]=1
  done
  for p in "${!seen[@]}"; do
    [[ -d $p ]] || continue
    [[ -n $(wineservers_for "$p") ]] && continue
    mine=
    while IFS= read -r o; do
      [[ -n $o && $p == "${o%/}" ]] && { mine=1; break; }
    done <<< "$own"
    [[ -n ${wine_runs:-} && $p == "${wine_runs%/}"-run[0-9]* ]] && mine=1
    if [[ -z $mine ]]; then echo "~$p"
    elif [[ -n ${busy[$p]:-} ]]; then echo "$p"
    fi
  done | LC_ALL=C sort
  (( nopfx > 0 )) && echo "?$nopfx"
  return 0
}

# Reads our scope's cgroup: memory, CPU time, the 60 s core average, the stall
# test and the Wine orphan test. Rewrites the state file.
sample_scope() {
  local d=$BSLICE/$unit.scope cur=0 pk u= now k v c60=- n rate orph unknown others p idle_s wp
  [[ -d $d ]] || return 0
  read -r cur 2>/dev/null < "$d/memory.current" || cur=0
  [[ $cur =~ ^[0-9]+$ ]] || cur=0
  if read -r pk 2>/dev/null < "$d/memory.peak" && [[ $pk =~ ^[0-9]+$ ]] && (( pk > peak )); then peak=$pk; fi
  (( cur > peak )) && peak=$cur
  while read -r k v; do [[ $k == usage_usec ]] && { u=$v; break; }; done 2>/dev/null < "$d/cpu.stat"
  [[ $u =~ ^[0-9]+$ ]] || return 0
  now=$(now_us)
  usec_last=$u
  S_t+=("$now"); S_u+=("$u")
  n=${#S_t[@]}
  while (( n - s_lo > 2 )) && (( now - S_t[s_lo + 1] >= 60000000 )); do s_lo=$(( s_lo + 1 )); done
  if (( now - S_t[s_lo] >= 1000000 )); then
    c60=$(( (u - S_u[s_lo]) * 1000 / (now - S_t[s_lo]) ))
  fi
  if (( n >= 2 )) && (( now > S_t[n - 2] )); then
    rate=$(( (u - S_u[n - 2]) * 1000 / (now - S_t[n - 2]) ))
    if (( rate >= 50 )); then
      last_active=$now
      stalled_cpu=0
    elif (( now - last_active >= STALL_SECS * 1000000 )) && (( ! stalled_cpu )); then
      stalled_cpu=1
      if [[ -z $stall_warned ]]; then
        stall_warned=1
        # An idle app (MC waiting for its next test) is normal, so no warning.
        [[ $cls == app-run ]] || say "warning: this build used under 0.05 cores for $(( STALL_SECS / 60 )) min ($STALL_SECS s); it may be hung. It no longer counts against the build budget."
        log_line "event=stall unit=$unit cmd=\"$cmdline\""
      fi
    fi
    # Idle Wine test runs, logged only for now, to learn how often tests hang.
    # On 2026-10-19 one run sat idle for 57 min after vstest's blame-hang
    # collector fired. One line per idle spell.
    if [[ $cls == wine-run-tests || $cls == wine-run-tests-prebuilt ]]; then
      if (( rate >= 50 )); then
        wine_idle_logged=
      elif [[ -z $wine_idle_logged ]] && (( now - last_active >= WINE_IDLE_SECS * 1000000 )); then
        wine_idle_logged=1
        idle_s=$(( (now - last_active) / 1000000 ))
        say "note: this Wine test run has used under 0.05 cores for $(( idle_s / 60 )) min ($idle_s s); it may be hung. Logged only, nothing was stopped."
        wp=${wine_main:--}
        log_line "event=wine-idle prefix=${wp// /%20} idle_s=$idle_s unit=$unit cmd=\"$cmdline\""
      fi
    fi
  fi
  orph=$(wine_orphans "$d")
  unknown=$(grep -m1 '^?' <<< "$orph")
  others=$(sed -n 's/^~//p' <<< "$orph")
  orph=$(grep -m1 -v '^[?~]' <<< "$orph")
  while IFS= read -r p; do
    [[ -n $p && $orph_other_logged != *"|$p|"* ]] || continue
    orph_other_logged+="|$p|"
    log_line "event=wine-orphan-other unit=$unit prefix=${p// /%20} reason=\"not this run's own prefix, so no warning and no stop\" cmd=\"$cmdline\""
  done <<< "$others"
  if [[ -n $unknown && -z $orph_unknown_logged ]]; then
    orph_unknown_logged=1
    log_line "event=wine-orphan-skip unit=$unit procs=${unknown#?} reason=\"prefix unknown: WINEPREFIX is not in the process environment or in heavy-build's, so the wineserver check skips these processes instead of guessing ~/.wine\" cmd=\"$cmdline\""
  fi
  if [[ -n $orph ]]; then
    orphan_seen=$(( orphan_seen + 1 ))
    [[ -n $orphan_since ]] || orphan_since=$EPOCHSECONDS
    if (( orphan_seen >= 2 )); then
      stalled_wine=1
      if [[ -z $orphan_warned ]]; then
        orphan_warned=1
        say "warning: the wineserver for $orph is gone (DESKTOP-14957). This run will hang. Stop it and run it again."
        log_line "event=wine-orphan unit=$unit prefix=$orph cmd=\"$cmdline\""
      fi
      if [[ ${HEAVY_BUILD_WINE_ORPHAN:-} == stop && -z $orphan_stopped ]] && (( EPOCHSECONDS - orphan_since >= ORPHAN_STOP_SECS )); then
        orphan_stopped=1
        say "stopping this Wine run: its wineserver has been gone for ${ORPHAN_STOP_SECS} s (HEAVY_BUILD_WINE_ORPHAN=stop)"
        systemctl --user stop "$unit.scope" 2>/dev/null
      fi
    fi
  else
    orphan_seen=0 orphan_since= stalled_wine=0
  fi
  grep -qx 'populated 1' "$d/cgroup.events" 2>/dev/null && write_state "$cur" "$c60" "$(( stalled_cpu || stalled_wine ))"
  psi_watch
}

# ---------------------------------------------------------------- CPU guard
# See "CPU pinning is undone" in the help text for why.

# All CPUs the scope cgroup $1 may use: its cpuset.cpus.effective when the
# cpuset controller is on, else all online CPUs.
all_cpus() {
  local c=
  read -r c 2>/dev/null < "$1/cpuset.cpus.effective"
  [[ -n $c ]] || read -r c 2>/dev/null < "$SYSCPU/online"
  echo "$c"
}

# Thread IDs in the scope cgroup $1 and any cgroups below it. Uses
# cgroup.threads; where it is missing, the threads of each pid in cgroup.procs.
scope_tids() {
  local c pid ts
  while IFS= read -r c; do
    if [[ -r $c/cgroup.threads ]]; then cat -- "$c/cgroup.threads" 2>/dev/null; continue; fi
    while read -r pid; do
      [[ $pid =~ ^[0-9]+$ ]] || continue
      ts=("$PROC/$pid"/task/[0-9]*)
      if [[ -e ${ts[0]} ]]; then printf '%s\n' "${ts[@]##*/}"; else echo "$pid"; fi
    done 2>/dev/null < "$c/cgroup.procs"
  done < <(find "$1" -type d 2>/dev/null)
}

# Reads thread IDs on stdin. Prints "tid tgid state voluntary_switches cpus"
# for each one whose status can be read.
thread_info() {
  grep -x '[0-9]\+' | sed "s|.*|$PROC/&/status|" \
    | xargs -r grep -sH -e '^Tgid:' -e '^State:' -e '^voluntary_ctxt_switches:' -e '^Cpus_allowed_list:' 2>/dev/null \
    | awk '{
        i = index($0, ":"); p = substr($0, 1, i - 1); r = substr($0, i + 1)
        j = index(r, ":"); k = substr(r, 1, j - 1); v = substr(r, j + 1); gsub(/^[ \t]+|[ \t]+$/, "", v)
        n = split(p, a, "/"); t = a[n - 1]
        if (!(t in seen)) { seen[t] = 1; order[++m] = t }
        if (k == "Tgid") g[t] = v
        else if (k == "State") s[t] = substr(v, 1, 1)
        else if (k == "voluntary_ctxt_switches") w[t] = v
        else c[t] = v
      }
      END { for (i = 1; i <= m; i++) { t = order[i]; if (c[t] != "") printf "%s %s %s %s %s\n", t, (g[t] == "" ? t : g[t]), (s[t] == "" ? "?" : s[t]), (w[t] == "" ? "-" : w[t]), c[t] } }'
}

# Number of CPUs in a list such as 0-3,8,30-31.
cpu_count() {
  local n=0 r a b IFS=,
  for r in $1; do
    if [[ $r == *-* ]]; then a=${r%-*} b=${r#*-}; n=$(( n + b - a + 1 )); else n=$(( n + 1 )); fi
  done
  echo "$n"
}

# Sets harmful CPU pinning in our own scope back to all CPUs and watches for
# busy loops. Touches nothing outside $BSLICE/$unit.scope.
# Pinning alone is not harmful: .NET Server GC pins one thread to each CPU on
# purpose (GCHeapAffinitize), and several .NET processes in one scope each put
# a GC thread on CPU 0. So a pinned thread is set back only when
# - its narrow CPU set is crowded: more runnable threads share that exact set
#   than it has CPUs, in two checks in a row (a GC pause lasts milliseconds,
#   the 2026-10-13 loops stayed runnable), or
# - the busy-loop warning is active and the thread itself is spinning.
cpu_guard() {
  local d=$BSLICE/$unit.scope all tid tgid st vcs cpus busy=0 cmd lim10 k i why spin
  local -a T_tid=() T_tgid=() T_cpus=() T_spin=()
  local -A now_st=() runq=() crowded=()
  [[ -d $d ]] || return 0
  all=$(all_cpus "$d")
  [[ -n $all ]] || return 0
  while read -r tid tgid st vcs cpus; do
    spin=0
    [[ $st == R && $vcs != - && ${prev_st[$tid]:-} == "R:$vcs" ]] && { busy=$(( busy + 1 )); spin=1; }
    now_st[$tid]="$st:$vcs"
    [[ $cpus == "$all" ]] && continue
    [[ $st == R ]] && runq[$cpus]=$(( ${runq[$cpus]:-0} + 1 ))
    T_tid+=("$tid") T_tgid+=("$tgid") T_cpus+=("$cpus") T_spin+=("$spin")
  done < <(scope_tids "$d" | thread_info)
  prev_st=()
  for k in "${!now_st[@]}"; do prev_st[$k]=${now_st[$k]}; done
  # Crowded now and at the last check.
  for k in "${!runq[@]}"; do
    (( runq[$k] > $(cpu_count "$k") )) && crowded[$k]=${runq[$k]}
  done
  local -A was=()
  for k in "${!crowd_prev[@]}"; do was[$k]=1; done
  crowd_prev=()
  for k in "${!crowded[@]}"; do crowd_prev[$k]=1; done

  lim10=${est_cores/./}
  lim10=$(( 2 * 10#${lim10:-80} ))
  (( lim10 < 20 )) && lim10=20
  if (( busy * 10 > lim10 )); then
    [[ -n $busy_since ]] || busy_since=$EPOCHSECONDS
    if [[ -z $busy_warned ]] && (( EPOCHSECONDS - busy_since >= BUSY_SECS )); then
      busy_warned=1
      say "warning: $busy threads in this build have spun without sleeping for ${BUSY_SECS} s (estimate: ${est_cores} cores). Busy loops starved the desktop on 2026-10-13. Nothing is killed."
      log_line "event=busy-loops unit=$unit threads=$busy est_cores=$est_cores secs=$(( EPOCHSECONDS - busy_since )) cmd=\"$cmdline\""
    fi
  else
    busy_since=
  fi

  for i in "${!T_tid[@]}"; do
    tid=${T_tid[i]} tgid=${T_tgid[i]} cpus=${T_cpus[i]} why=
    if [[ -n ${crowded[$cpus]:-} && -n ${was[$cpus]:-} ]]; then
      why="crowded runnable=${crowded[$cpus]}"
    elif [[ -n $busy_warned && -n $busy_since ]] && (( T_spin[i] )); then
      why=busy-loop
    else
      continue
    fi
    taskset -p -c "$all" "$tid" >/dev/null 2>&1 || continue
    [[ -n ${unpinned[$tgid]:-} ]] && continue
    unpinned[$tgid]=1
    cmd=$(tr '\0' ' ' < "$PROC/$tgid/cmdline" 2>/dev/null | cut -c1-200)
    cmd=${cmd% }; cmd=${cmd//\"/\'}
    log_line "event=unpin unit=$unit pid=$tgid tid=$tid cpus=$cpus set_to=$all reason=\"$why\" cmd=\"$cmd\""
    say "warning: pid $tgid ($cmd) had threads crowded on CPUs $cpus ($why); set back to $all. Pinned busy loops froze the desktop on 2026-10-13."
  done
}

# ---------------------------------------------------------------- rerun guard

# The state of the git tree the build runs in: "<HEAD 12>-<hash 8>", where
# the hash covers `git status --porcelain` and the size and mtime of each
# path it lists, so an edit to a file that was already modified counts as a
# change. "<HEAD 12>" alone when git status fails or takes over 5 s, "-"
# outside git. --no-optional-locks keeps it off the index lock that builds
# and agents in the same tree use. About 0.5 s in the monorepo.
tree_state() {
  local top head list meta
  top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo -; return; }
  head=$(git -C "$top" rev-parse -q --verify HEAD 2>/dev/null) || head=none
  if ! list=$(cd "$top" && timeout 5 git --no-optional-locks status --porcelain -z --untracked-files=normal 2>/dev/null | tr '\0' '\n'); then
    echo "${head:0:12}"
    return
  fi
  meta=$(cd "$top" && cut -c4- <<< "$list" | xargs -r -d '\n' stat -c '%n %s %Y' -- 2>/dev/null)
  echo "${head:0:12}-$(printf '%s\n%s\n' "$list" "$meta" | md5sum | cut -c1-8)"
}

# rerun_check KEY STATE: prints "<fails> <seconds since the last one>" when
# the last RERUN_FAILS runs of KEY in history all failed within RERUN_SECS
# and the tree state is the same as at the last failure (or either state is
# "-", so time alone decides). Prints nothing when the build may run.
rerun_check() {
  (( RERUN_FAILS > 0 )) || return 0
  [[ -r $HIST ]] || return 0
  awk -F'\t' -v k="$1" -v st="$2" -v n="$RERUN_FAILS" -v win="$RERUN_SECS" -v now="$EPOCHSECONDS" '
    $3 == k { m++; t[m] = $1; e[m] = $7; r[m] = $8; s[m] = $11; has[m] = (NF >= 11) }
    END {
      if (m < n) exit
      for (i = m - n + 1; i <= m; i++) if (r[i] != "fail" || e[i] == 0 || now - t[i] > win) exit
      if (!has[m]) exit
      if (s[m] != "-" && st != "-" && s[m] != st) exit
      print n, now - t[m]
    }' "$HIST" 2>/dev/null
}

# append_history EXIT_CODE REASON. Columns: see the help text at the top.
append_history() {
  local cpu=NA pk=NA wall=$(( EPOCHSECONDS - start_ts ))
  (( wall < 1 )) && wall=1
  [[ -n $usec_last ]] && cpu=$(printf '%d.%03d' $(( usec_last / 1000000 )) $(( usec_last % 1000000 / 1000 )))
  local capb=NA highb=NA
  (( peak > 0 )) && pk=$peak
  if [[ -n ${cap_high:-} ]]; then
    capb=$(( (cap_high + 2) * 1073741824 )) highb=$(( cap_high * 1073741824 ))
    if (( peak * 100 >= highb * 98 )); then
      if [[ $cls == app-run ]]; then
        say "warning: this app run's memory reached its ${cap_high}G MemoryHigh and was held there; HEAVY_BUILD_APP_MEM_HIGH_GIB sets that cap"
      else
        say "warning: this build's memory reached its ${cap_high}G MemoryHigh and was held there; its next estimate is at least $(( cap_high * 5 / 4 )) GiB"
      fi
      log_line "event=capped unit=$unit peak=$peak high=$highb est=${est_mem}G cmd=\"$cmdline\""
    fi
  fi
  mkdir -p "$STATE" 2>/dev/null || return 0
  {
    flock 6
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$EPOCHSECONDS" "$cls" "$hash" "$wall" "$cpu" "$pk" "$1" "$2" "$capb" "$highb" "${tstate:--}" "${sig:--}" >&6
    local hl=${HISTORY_LINES:-20000}; (( hl >= 100 )) || hl=20000
    # Keep HISTORY_LINES lines (about 2 weeks at 1,300 builds a day); trim at 10% over.
    if (( $(wc -l < "$HIST") > hl + hl / 10 )); then tail -n "$hl" -- "$HIST" > "$HIST.tmp" && mv -f -- "$HIST.tmp" "$HIST"; fi
  } 6>>"$HIST"
}

# ---------------------------------------------------------------- main

hash=$(printf '%s\0' "$PWD" "$@" | md5sum | cut -c1-8)
cmdline="$*"
cmdline=${cmdline//\"/\'}
(( ${#cmdline} > 160 )) && cmdline="${cmdline:0:157}..."
cls=$(classify "$@")
sig=- sig_f=0
if [[ $cls == wine-run-tests || $cls == wine-run-tests-prebuilt ]]; then
  read -ra sig_words <<< "$*"
  read -r sig_f sig <<< "$(wine_sig "$cls" "${sig_words[@]}")"
  [[ -n $sig ]] || sig=- sig_f=0
fi
read -r est_mem est_cores est_wall est_src <<< "$(estimate "$hash" "$cls" "${sig#-}" "$sig_f")"
keys_out=$(lock_keys "$@")
keys_note=$(grep '^!' <<< "$keys_out" | sed 's/^!//' | paste -sd' ' -)
keys_csv=$(grep -v '^!' <<< "$keys_out" | sed 's/ /%20/g' | paste -sd, -)
[[ -n $keys_csv ]] || keys_csv=-
# The run's own Wine prefixes, for wine_orphans: wine_main is the prefix the
# command will run in (for run-tests.sh, what run_tests_prefix says, else
# WINEPREFIX), wine_fb the prefix for a Wine process with no WINEPREFIX of its
# own, wine_runs the base of run-tests.sh's <prefix>-run<pid> fallback, and
# wine_own the list: wine_main and the wine: key's prefix.
wine_main=${WINEPREFIX:-} wine_fb=${WINEPREFIX:-} wine_runs=
if wine_cmd "$@" && rt=$(run_tests_prefix "$(git rev-parse --show-toplevel 2>/dev/null)" "$@"); then
  wine_main=${rt#* }
  if [[ $rt == own\ * ]]; then wine_runs=$wine_main wine_fb=; else wine_fb=$wine_main; fi
fi
wine_own=$(tr ',' '\n' <<< "$keys_csv" | sed -n 's/^wine://p' | sed 's/%20/ /g')
[[ -n $wine_main ]] && wine_own+=$'\n'$wine_main
# The default priority comes from the calling session's class, or from the
# grove lane the build runs in. HB_MACHINE_SESSION is a test hook.
if [[ -z ${HEAVY_BUILD_PRIORITY:-} ]]; then
  SESSION_CLASS=$(timeout 5 "${HB_MACHINE_SESSION:-machine-session}" class --pid $$ 2> /dev/null)
  crit_why=
  if [[ $SESSION_CLASS == critical ]]; then
    crit_why="this session is critical in ~/.config/machine/sessions.toml"
  else
    mapfile -t kdirs < <(key_dirs)
    crit_why=$(critical_lane "$PWD" "${kdirs[@]}")
  fi
  if [[ -n $crit_why ]]; then
    PRIO=critical
    say "priority critical: $crit_why"
  elif [[ $SESSION_CLASS == pausable ]]; then
    PRIO=low
    say "priority low: this session is pausable in ~/.config/machine/sessions.toml"
  fi
fi
unit="heavy-build-$$-$RANDOM"
# Each build gets its own Roslyn compiler server. Without an id, every C#
# compile uses one server per SDK, and the first one started (often outside
# heavy-build) runs on outside builds.slice with all the compile work. On
# 2026-10-11 one such server held 12.7 GB and 4.3 cores. This one starts in the
# scope and stops with it.
build_env+=(SharedCompilationId="${SharedCompilationId:-hb-$unit}")
# PRIO in the state file; <prio>:aged for a build let in by the aging slot.
state_prio=$PRIO
script_id=$(stat -L -c '%i %Y' -- "${BASH_SOURCE[0]}" 2>/dev/null)
# Ends this heavy-build if it comes back to the wait section after its build
# started. Only a script rewritten in place under an older heavy-build (one
# without the { } block) can do that; on 2026-10-10 it ran a build twice.
reentry_guard() {
  [[ -n ${build_started:-} ]] || return 0
  say "stopping: this heavy-build came back to the queue after its build started (script was ${script_id:-?}, now $(stat -L -c '%i %Y' -- "${BASH_SOURCE[0]}" 2>/dev/null)). The file was changed in place under it."
  log_line "event=reentry unit=$unit script_was=\"${script_id:-?}\" cmd=\"$cmdline\""
  exit 70
}
jobid=$unit
mystart=$(proc_start $$)
start_ts=$EPOCHSECONDS
ticket=
scope_up= child= cancel_sig=
# Runs on every exit bash can catch, signals included: removes the ticket and
# state file and, once the scope exists, stops it, so nothing from this build
# runs on without a heavy-build to account for it.
on_exit() {
  rm -f -- ${ticket:+"$ticket" "$ticket.tmp"} "$JDIR/$unit" "$JDIR/$unit.tmp" ${READY_FILE:+"$READY_FILE"}
  [[ -n $scope_up ]] && systemctl --user stop "$unit.scope" 2>/dev/null
}
trap on_exit EXIT
# While waiting no scope exists yet, so a signal just ends heavy-build.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
read_conf
# An app run is never planned above its own MemoryHigh.
if [[ $cls == app-run ]] && awk -v m="$est_mem" -v h="$APP_MEM_HIGH_GIB" 'BEGIN { exit !(m > h) }'; then
  est_mem=$APP_MEM_HIGH_GIB.0 est_src="${est_src%%,mem=*},mem=app-high"
fi

# The rerun guard (see the help text). tstate goes into history column 11.
tstate=-
(( RERUN_FAILS > 0 )) && tstate=$(tree_state)
rr=$(rerun_check "$hash" "$tstate")
if [[ -n $rr ]]; then
  rtree=$(git rev-parse --show-toplevel 2>/dev/null) || rtree=$PWD
  read -r rr_n rr_ago <<< "$rr"
  if [[ ${HEAVY_BUILD_ALLOW_RERUN:-} == 1 ]]; then
    log_line "event=rerun-allowed fails=$rr_n last_fail_s=$rr_ago tree=$rtree state=$tstate cmd=\"$cmdline\""
  else
    say "exit 76, not run: this exact command failed $rr_n times in a row in the last $(( RERUN_SECS / 60 )) min with no change in $rtree; read the last log or change something before running it again. While you fix it, rerun only the failing test with a filter. Set HEAVY_BUILD_ALLOW_RERUN=1 to override."
    log_line "decision=rerun-refuse reason=\"rerun: failed $rr_n times in a row in the last $(( RERUN_SECS / 60 )) min, the last ${rr_ago}s ago, with no change in the tree\" tree=$rtree state=$tstate prio=$PRIO keys=$keys_csv cmd=\"$cmdline\""
    exit 76
  fi
fi

reentry_guard
# The give-up clock: seconds of waiting without moving up in line, not counted
# while only higher-priority builds ahead hold this build back.
stuck=0 tick=$SECONDS queued_ts=$EPOCHSECONDS pos=0
held=
if ancestor_holds_lock; then
  say "a parent process holds a build slot; not taking another"
else
  # Lexical order of ticket names is arrival order: time in ns (fixed width),
  # then pid, then a short hash of the directory and command.
  ticket=$QDIR/$(date +%s%N)-$$-$hash
  jobid=${ticket##*/}
  write_ticket
  if [[ -n $keys_note ]]; then
    log_line "$keys_note keys=$keys_csv cmd=\"$cmdline\""
    say "lock key not split by AgentOutputSuffix: this tree has no suffix blocks ($SPLIT_MARK)"
  fi
  said= best= last_log= would_since=
  while :; do
    reentry_guard
    [[ -e $ticket ]] || write_ticket
    read_conf
    queue_scan
    started=
    if [[ $MODE == live ]]; then
      exec 8>>"$ADMIT"
      flock 8
      decide
      if [[ $dec == start ]]; then
        start_ts=$EPOCHSECONDS
        [[ $why == aged:* ]] && state_prio=$PRIO:aged
        write_state 0 - 0   # our reservation, written while we hold the mutex
        rm -f -- "$ticket"
        started=1
      fi
      exec 8>&-
      log_decision "$dec"
      (( rank > 0 )) && pos=$rank
      [[ -n $started ]] && break
    else
      if hold_on; then
        why="new builds are on hold: $(head -c 200 "$HOLD" 2>/dev/null)"
      elif (( pos > 1 )); then
        why="earlier builds go first"
      else
        mem=$(mem_avail_gib)
        room=$(swap_room_gib)
        need=$MIN_MEM_GIB
        (( $(active_build_scopes) == 0 )) && need=$SOLO_MEM_GIB
        if [[ $mem =~ ^[0-9]+$ ]] && (( mem < need )); then
          why="only ${mem} GiB of memory is available; a build starts at ${need} GiB"
        elif [[ $room =~ ^-?[0-9]+$ ]] && (( room < MIN_SWAP_ROOM_GIB )); then
          why="swap is near the systemd-oomd limit (${room} GiB left before 90%, need ${MIN_SWAP_ROOM_GIB})"
        elif try_slot; then
          orphans=$(orphan_scopes | wc -l)
          if (( orphans == 0 || orphans <= $(other_free_slots) )); then
            started=1
          else
            exec 9>&-; held=
            why="a build whose heavy-build was killed is still running ($(orphan_scopes | tr '\n' ' '))"
          fi
        else
          why="all 3 build slots are in use"
        fi
      fi
      # The budget rule only watches in shadow mode.
      oldwhy=${why:-}
      decide
      if [[ -n $started ]]; then
        log_decision start
        break
      fi
      log_decision wait
      why=$oldwhy
      prioheld=0   # the old rule is first come, first served
    fi
    # While the manager's hold file exists the clock stays at 0, so a hold of
    # any length never ends in exit 75. On 2026-10-14 a build was refused
    # after 7201 s that it spent waiting only on the hold. The clock starts
    # from 0 again when the hold lifts.
    if hold_on; then
      stuck=0
    elif (( ! prioheld )); then
      stuck=$(( stuck + SECONDS - tick ))
    fi
    tick=$SECONDS
    if [[ -n $best ]] && (( pos > 0 && pos < best )); then stuck=0; fi
    (( pos > 0 )) && { [[ -z $best ]] || (( pos < best )); } && best=$pos
    line="in line: position $pos of $total${dup:+ (an identical build is ahead)}"
    if [[ -n $WAIT_TIMEOUT ]] && (( EPOCHSECONDS - queued_ts >= WAIT_TIMEOUT )); then
      say "exit 77, not run: --wait-timeout ${WAIT_TIMEOUT}s ran out before the queue let it in: $why; $line. Nothing ran. Try again later, or give a longer --wait-timeout."
      refuse "wait-timeout: not let in within ${WAIT_TIMEOUT}s: $why" 77
    fi
    if (( stuck >= WAIT )); then
      say "exit 75, not run: gave up after ${stuck}s without moving up: $why; $line. Nothing ran. Do not resubmit at once; try again later or tell the manager session."
      refuse "wait: gave up after ${stuck}s without moving up: $why"
    fi
    key="${why%% *} $pos"
    if [[ $key != "$said" ]]; then say "waiting: $why; $line"; said=$key; fi
    sleep "$POLL"
  done
  rm -f -- "$ticket"
fi

avail=$(LC_ALL=C df -B1G --output=avail -- . 2>/dev/null | tail -1 | tr -d ' ')
if [[ $avail =~ ^[0-9]+$ ]] && (( avail < REFUSE_GIB )) && [[ ${HEAVY_BUILD_FORCE:-0} != 1 ]]; then
  say "exit 75, not run: $(df --output=target -- . | tail -1) has ${avail} GiB free; the limit is ${REFUSE_GIB} GiB."
  say "stop and tell the manager session. Do not delete other build output to make room."
  refuse "disk: $(df --output=target -- . | tail -1) has ${avail} GiB free, the limit is ${REFUSE_GIB} GiB"
fi

# Memory caps scale with the estimate: MemoryHigh = 1.25 x estimate, 16G to 22G.
# estimate() never returns more than EST_MEM_MAX_GIB (22), the top of this range.
mem10=${est_mem/./}
cap_high=$(( (10#$mem10 * 125 + 999) / 1000 ))
(( cap_high < 16 )) && cap_high=16
(( cap_high > 22 )) && cap_high=22
# An app run gets a fixed MemoryHigh (HEAVY_BUILD_APP_MEM_HIGH_GIB, default 10).
[[ $cls == app-run ]] && cap_high=$APP_MEM_HIGH_GIB
props=(-p MemoryHigh="${cap_high}G" -p MemoryMax="$(( cap_high + 2 ))G" -p MemorySwapMax=2G -p OOMPolicy=kill -p TimeoutStopSec=3s)
[[ -n $TIMEOUT ]] && props+=(-p RuntimeMaxSec="$TIMEOUT")
desc="heavy-build $cls prio=$PRIO${HEAVY_BUILD_REASON:+ reason: $HEAVY_BUILD_REASON}"

# The signal traps go in before the scope exists, so no signal can end
# heavy-build between making the scope and watching it.
stop_build() {
  cancel_sig=$1
  [[ -n $child ]] && kill "-$1" "$child" 2>/dev/null
  systemctl --user kill --signal="$1" "$unit.scope" 2>/dev/null
}
trap 'stop_build TERM' TERM HUP
trap 'stop_build INT' INT

start_ts=$EPOCHSECONDS
write_state 0 - 0
build_started=1
scope_up=1
systemd-run --user --scope --quiet --collect --expand-environment=no \
  --unit="$unit" --slice=builds.slice --description="$desc" "${props[@]}" \
  env -u HEAVY_BUILD_CLASS -u HEAVY_BUILD_READY_FILE -u HEAVY_BUILD_WAIT_TIMEOUT \
  "${build_env[@]}" HEAVY_BUILD_UNIT="$unit.scope" "$@" 0<&0 8>&- 9>&- &
child=$!
# A signal that came while the scope was being made may have missed it.
[[ -n $cancel_sig ]] && stop_build "$cancel_sig"
write_ready "$unit.scope" "$child"

S_t=() S_u=() s_lo=0 peak=0 usec_last= last_active=$(now_us)
stalled_cpu=0 stalled_wine=0 stall_warned= orphan_seen=0 orphan_since= orphan_warned= orphan_stopped= orph_unknown_logged=
orph_other_logged= wine_idle_logged=
rc= gone_since=
declare -A unpinned=() prev_st=() crowd_prev=()
busy_since= busy_warned= last_sample=$(now_us)
while :; do
  iv=$SAMPLE
  (( EPOCHSECONDS - start_ts < 60 && iv > 2 )) && iv=2
  step=$iv
  (( GUARD_SECS > 0 && GUARD_SECS < step )) && step=$GUARD_SECS
  sleep "$step" &
  sp=$!
  done_pid=
  wait -n -p done_pid "$child" "$sp"
  r=$?
  if [[ ${done_pid:-} == "$child" ]]; then
    rc=$r
    kill "$sp" 2>/dev/null; wait "$sp" 2>/dev/null
    break
  fi
  if [[ -z ${done_pid:-} ]]; then
    # A trap ran. Go round again; the build ends soon if it was stopped.
    kill "$sp" 2>/dev/null; wait "$sp" 2>/dev/null
    continue
  fi
  (( GUARD_SECS > 0 )) && cpu_guard
  if (( $(now_us) - last_sample >= iv * 1000000 - 250000 )); then
    sample_scope
    last_sample=$(now_us)
  fi
  # wait -n can miss a child that bash already reaped, so check it directly.
  if ! kill -0 "$child" 2>/dev/null; then
    wait "$child"; rc=$?
    break
  fi
  # A scope that has stopped while its command still runs here: give it
  # HB_SCOPE_GONE_SECS (120), then end, so this heavy-build never loops on.
  if grep -qx 'populated 1' "$BSLICE/$unit.scope/cgroup.events" 2>/dev/null || (( EPOCHSECONDS - start_ts < NO_SCOPE_SECS )); then
    gone_since=
  elif [[ -z $gone_since ]]; then
    gone_since=$EPOCHSECONDS
  elif (( EPOCHSECONDS - gone_since >= SCOPE_GONE_SECS )); then
    log_line "event=scope-gone unit=$unit gone_s=$(( EPOCHSECONDS - gone_since )) cmd=\"$cmdline\""
    say "the build scope stopped ${SCOPE_GONE_SECS}s ago but its command did not end; ending"
    kill -KILL "$child" 2>/dev/null
    wait "$child"; rc=$?
    break
  fi
done
sample_scope
d=$BSLICE/$unit.scope
oom=0
while read -r k v; do [[ $k == oom_kill ]] && { oom=$v; break; }; done 2>/dev/null < "$d/memory.events"
[[ $oom =~ ^[0-9]+$ ]] || oom=0
# Wine leftovers (winedevice.exe and the like) ignore SIGTERM, so a plain
# stop waits TimeoutStopSec and ends in "Stopping timed out. Killing".
left=$(scope_procs "$d")
if only_wine_leftovers "$left"; then
  log_line "event=stop-kill unit=$unit procs=$(paste -sd, - <<< "$left")"
  systemctl --user kill --signal=KILL "$unit.scope" 2>/dev/null
fi
# Nothing from this build may run on once it ends.
systemctl --user stop "$unit.scope" 2>/dev/null
scope_up=

if [[ -n $orphan_stopped ]]; then
  rc=124
elif [[ -n $TIMEOUT ]] && (( rc > 128 && EPOCHSECONDS - start_ts >= TIMEOUT - 1 )); then
  say "stopped after HEAVY_BUILD_TIMEOUT=${TIMEOUT}s"
  rc=124
fi
if (( oom > 0 )); then reason=oom
elif (( rc == 124 )); then reason=timeout
elif [[ -n $cancel_sig ]]; then reason=cancelled
elif (( rc == 0 )); then reason=ok
elif [[ $cls == app-run ]] && (( rc > 128 )); then reason=stopped
else reason=fail
fi
append_history "$rc" "$reason"
exit "$rc"
}
