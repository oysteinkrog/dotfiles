#!/bin/sh
# Open the Build Queue widget (org.oysteinkrog.buildqueue) as its own window.
#
# plasmawindowed allows one process per session bus: a second "plasmawindowed X" hands X to
# the running one, which swaps its applet for X. So the Agenda window would turn into the
# build queue. This gives the build queue its own small session bus, with no service
# activation, so it never touches the Agenda process and starts no portals or daemons.
# Never run a bare "plasmawindowed org.oysteinkrog.buildqueue" on the main session bus, for
# a test or anything else: on 2026-10-26 one such call took over the running Agenda window
# and it exited. Test in a nested kwin_wayland under its own dbus-run-session.
# The widget needs nothing from the session bus: its data comes from buildqueue-fetch, which
# this script runs and which writes $XDG_RUNTIME_DIR/buildqueue/queue.json.

set -eu
dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/buildqueue"
mkdir -p "$dir"
cat >"$dir/bus.conf" <<EOF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:dir=$dir</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
  </policy>
</busconfig>
EOF

# One fetch process for the life of the window, writing the file the widget reads. It
# stops when this script exits (it watches its parent), or on the trap below.
"$HOME/bin/buildqueue-fetch" --serve "$dir/queue.json" 5 &
fetch=$!
trap 'kill "$fetch" 2>/dev/null' EXIT INT TERM
# The widget reads queue.json with XMLHttpRequest, which needs this for a local file.
QML_XHR_ALLOW_FILE_READ=1 dbus-run-session --config-file="$dir/bus.conf" -- plasmawindowed org.oysteinkrog.buildqueue
