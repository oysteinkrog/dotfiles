#!/bin/sh
# Open the Build Queue widget (org.oysteinkrog.buildqueue) as its own window.
#
# plasmawindowed allows one process per session bus: a second "plasmawindowed X" hands X to
# the running one, which swaps its applet for X. So the Agenda window would turn into the
# build queue. This gives the build queue its own small session bus, with no service
# activation, so it never touches the Agenda process and starts no portals or daemons.
# The widget needs nothing from the session bus: its data comes from buildqueue-fetch.

set -eu
dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/buildqueue"
mkdir -p "$dir"
cat >"$dir/bus.conf" <<EOF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:dir=$dir</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
  </policy>
</busconfig>
EOF
exec dbus-run-session --config-file="$dir/bus.conf" -- plasmawindowed org.oysteinkrog.buildqueue
