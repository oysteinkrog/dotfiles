#!/usr/bin/env python3
"""Restart idle Claude Code sessions that still run an old Claude version.

    claude-version-restart [--dry-run] [--recheck-delay SECONDS] [--verbose]
    claude-version-restart --only SID [--live | --dry-run] [--verbose]

--only SID looks at that one session (a session id or its start) and logs
nothing about the others. --live acts on it whatever the mode file says; it
needs --only, so the timer can never use it. Use it for a supervised test.

A systemd user timer runs this every 5 minutes (claude-version-restart.timer).
It looks at every live Claude process in ~/.claude/sessions/<pid>.json and
restarts a session only when all of these hold:

- kind is interactive, entrypoint is cli, and CLAUDE_PERSIST is not 0;
- its version is older than the installed one (~/.local/bin/claude);
- it is not critical in ~/.config/machine/sessions.toml, not a manager-*
  session, and not an ancestor of this process;
- status is idle, and statusUpdatedAt is at least 10 minutes old, on two reads
  30 seconds apart that agree;
- its only child processes are MCP servers;
- no key press on the local keyboard (/run/local-input/last) and no input in
  its own terminal (the tty's access time) for 10 minutes;
- it has a pane in the running FrankenTerm mux server;
- its cwd, its transcript and its claude-persist entry exist;
- no /goal is open, unless it is the only thing to re-arm;
- no ScheduleWakeup is due within 2 minutes;
- no failed restart of it in the last 24 hours.

A restart stops the Claude process with SIGTERM (SIGKILL after 20 seconds,
logged) and resumes the session with `claude --resume` and a prompt from
claude-persist-resume.py, which re-arms /goal, /loop and cron jobs:

- in the same pane, when the tab runs under claude-tab-run (CLAUDE_TAB_RUN is
  set): this writes an intent file, and claude-tab-run resumes the session
  when Claude exits;
- otherwise only with --allow-new-tab (the timer never passes it; such
  sessions are skipped as needs-new-tab, because the FrankenTerm GUI keeps
  its own tab order in ~/.local/share/frankenterm/window-state.json and
  `cli move-tab` changes only the mux's order): in a new tab
  (claude-persist.sh respawn), moved to the old tab's
  place. Once the new session is verified, the old pane is closed with
  SIGHUP to its shell, but only if that shell is idle (no child processes)
  and the pane is still open. Otherwise it is kept and logged.

It then waits 60 seconds for a sessions file with the same session id, cwd
and the new version. A failure blocks that session for 24 hours.

Mode: ~/.config/claude-restart/mode. Missing or "dry-run": log what would
happen and change nothing. "live": restart. --dry-run forces dry-run.

Log: ~/.local/state/claude-restart/decisions.log, one line per session per run.
State: ~/.local/state/claude-restart/ (locks, intents, entries, sessions).
"""

from __future__ import annotations

import argparse
import fcntl
import importlib.util
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

HOME = Path.home()
QUIET_SECONDS = 600
WAKEUP_MARGIN = 120
BACKOFF_SECONDS = 24 * 3600
TERM_TIMEOUT = 20
VERIFY_TIMEOUT = 60
EXCLUDE_NAMES = re.compile(r"^manager")
BULK_WINDOW = 2.0  # seconds; see Monitor.bulk_input
BULK_SHARE = 0.25
MAX_PER_RUN = 3  # restarts per run; the rest wait for the next run
LOG_MAX = 5 << 20  # decisions.log moves to decisions.log.1 above this size


def version_key(v: str) -> tuple[int, ...]:
    out = []
    for part in re.split(r"[.\-+]", v or ""):
        if not part.isdigit():
            break
        out.append(int(part))
    return tuple(out)


def project_slug(cwd: str) -> str:
    return re.sub(r"[^A-Za-z0-9]", "-", cwd)


def load_resume_module(path: Path):
    spec = importlib.util.spec_from_file_location("claude_persist_resume", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


# ------------------------------------------------------------------ system


class System:
    """Everything that reads or changes the live machine. Tests replace it."""

    def __init__(self, claude_dir: Path, persist_sh: Path):
        self.claude_dir = claude_dir
        self.persist_sh = persist_sh
        self.ft_cli = HOME / ".local/bin/frankenterm-gui"

    def now(self) -> float:
        return time.time()

    def sleep(self, s: float) -> None:
        time.sleep(s)

    def boot_time(self) -> float:
        for line in Path("/proc/stat").read_text().splitlines():
            if line.startswith("btime "):
                return float(line.split()[1])
        return 0.0

    def alive(self, pid: int) -> bool:
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            return False
        return stat.rsplit(")", 1)[-1].split()[0] != "Z"

    def parent(self, pid: int) -> int:
        try:
            return int(
                Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[-1].split()[1]
            )
        except (OSError, ValueError, IndexError):
            return 0

    def cmdline(self, pid: int) -> list[str]:
        try:
            raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        except OSError:
            return []
        return [a.decode(errors="replace") for a in raw.split(b"\0") if a]

    def environ(self, pid: int) -> dict[str, str]:
        try:
            raw = Path(f"/proc/{pid}/environ").read_bytes()
        except OSError:
            return {}
        env = {}
        for item in raw.split(b"\0"):
            k, sep, v = item.decode(errors="replace").partition("=")
            if sep:
                env[k] = v
        return env

    def children(self, pid: int) -> list[int]:
        out: list[int] = []
        for task in Path(f"/proc/{pid}/task").glob("*"):
            try:
                out += [int(c) for c in (task / "children").read_text().split()]
            except (OSError, ValueError):
                pass
        return out

    def tty(self, pid: int) -> str | None:
        try:
            t = os.readlink(f"/proc/{pid}/fd/0")
        except OSError:
            return None
        return t if t.startswith("/dev/pts/") else None

    def tty_atime(self, tty: str) -> float | None:
        try:
            return os.stat(tty).st_atime
        except OSError:
            return None

    def input_last(self) -> float | None:
        try:
            return os.stat("/run/local-input/last").st_mtime
        except OSError:
            return None

    def installed_version(self) -> str:
        return os.path.basename(os.readlink(HOME / ".local/bin/claude"))

    def mcp_commands(self, cwd: str) -> list[list[str]]:
        """Configured stdio MCP server commands (user scope, project, .mcp.json)."""
        found: list[list[str]] = []

        def add(servers):
            if isinstance(servers, dict):
                for cfg in servers.values():
                    if isinstance(cfg, dict) and cfg.get("command"):
                        found.append(
                            [str(cfg["command"])]
                            + [str(a) for a in cfg.get("args") or []]
                        )

        for path in (HOME / ".claude.json", Path(cwd) / ".mcp.json"):
            try:
                data = json.loads(path.read_text())
            except (OSError, ValueError):
                continue
            add(data.get("mcpServers"))
            add(((data.get("projects") or {}).get(cwd) or {}).get("mcpServers"))
        return found

    def classes(self) -> dict[int, str] | None:
        try:
            out = subprocess.run(
                [str(HOME / "bin/machine-session"), "list", "--json"],
                capture_output=True,
                text=True,
                timeout=60,
                check=True,
            ).stdout
            return {int(s["pid"]): str(s.get("class") or "") for s in json.loads(out)}
        except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
            return None

    def ft(self, *args: str) -> tuple[int, str]:
        env = {
            k: v
            for k, v in os.environ.items()
            if k
            not in ("FRANKENTERM_UNIX_SOCKET", "WEZTERM_UNIX_SOCKET", "WEZTERM_PANE")
        }
        try:
            p = subprocess.run(
                [str(self.ft_cli), "cli", *args],
                capture_output=True,
                text=True,
                timeout=30,
                env=env,
            )
        except (OSError, subprocess.SubprocessError) as e:
            return 1, str(e)
        return p.returncode, p.stdout

    def mux_panes(self) -> list[dict] | None:
        rc, out = self.ft("list", "--json")
        if rc != 0:
            return None
        try:
            return json.loads(out)
        except ValueError:
            return None

    def kill(self, pid: int, sig: int) -> None:
        os.kill(pid, sig)

    def respawn(self, entry_file: Path, window_id) -> tuple[int, str]:
        cmd = ["bash", str(self.persist_sh), "respawn", str(entry_file)]
        if window_id is not None:
            cmd.append(str(window_id))
        try:
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError) as e:
            return 1, str(e)
        return p.returncode, p.stdout.strip()


# ------------------------------------------------------------------ model


@dataclass
class Session:
    pid: int
    file: Path
    data: dict
    sid: str = ""
    name: str = ""
    version: str = ""
    cwd: str = ""
    method: str = ""  # tab-run or new-tab
    tab_run_pid: int = 0
    pane: dict = field(default_factory=dict)
    tab_index: int = -1
    entry_file: Path | None = None
    transcript: Path | None = None
    rearm: str = ""

    @property
    def key(self) -> str:
        """One session id can run in two folders, so key by both."""
        return f"{self.sid}@{project_slug(self.cwd)}"


class Skip(Exception):
    pass


# Sessions files of processes that are gone. Counted in one line per run
# instead of one line each.
STALE = "stale sessions file, process gone"


class Monitor:
    def __init__(
        self,
        sysobj: System,
        args,
        claude_dir: Path,
        state_dir: Path,
        persist_dir: Path,
        resume_py: Path,
        mode: str,
    ):
        self.sys = sysobj
        self.args = args
        self.claude_dir = claude_dir
        self.state = state_dir
        self.persist_dir = persist_dir
        self.resume = load_resume_module(resume_py)
        self.mode = mode
        self.run_id = time.strftime("%Y%m%dT%H%M%S")
        self.log_path = state_dir / "decisions.log"
        self.locks: dict[str, int] = {}

    # -------------------------------------------------------------- log

    def log(self, s: Session | None, decision: str, reason: str) -> None:
        self.state.mkdir(parents=True, exist_ok=True)
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(self.sys.now()))
        who = ""
        if s is not None:
            who = (
                f" pid={s.pid} sid={(s.sid or '-')[:8]} name={shlex.quote(s.name or '-')}"
                f" v={s.version or '-'}"
            )
        line = f"{stamp} run={self.run_id} mode={self.mode} {decision}{who} reason={json.dumps(reason)}\n"
        try:
            if self.log_path.stat().st_size > LOG_MAX:
                self.log_path.replace(self.log_path.with_name("decisions.log.1"))
        except OSError:
            pass
        with open(self.log_path, "a") as fh:
            fh.write(line)
        if self.args.verbose:
            sys.stdout.write(line)

    # -------------------------------------------------------------- checks

    def read_sessions(self) -> list[Session]:
        out = []
        for f in sorted((self.claude_dir / "sessions").glob("*.json")):
            try:
                pid = int(f.stem)
            except ValueError:
                continue
            try:
                data = json.loads(f.read_text())
            except (OSError, ValueError):
                data = None
            s = Session(pid=pid, file=f, data=data or {})
            if data:
                s.sid = str(data.get("sessionId") or "")
                s.name = str(data.get("name") or "")
                s.version = str(data.get("version") or "")
                s.cwd = str(data.get("cwd") or "")
            out.append(s)
        return out

    def ancestors(self) -> set[int]:
        out, p = set(), os.getpid()
        while p > 1 and p not in out:
            out.add(p)
            p = self.sys.parent(p)
        return out

    def is_ancestor(self, anc: int, pid: int) -> bool:
        p, n = pid, 0
        while p > 1 and n < 20:
            if p == anc:
                return True
            p, n = self.sys.parent(p), n + 1
        return False

    def is_mcp(self, argv: list[str], configured: list[list[str]]) -> bool:
        if not argv:
            return True  # gone already
        if "mcp" in " ".join(argv).lower():
            return True
        for cfg in configured:
            if os.path.basename(argv[0]) == os.path.basename(cfg[0]) and all(
                a in argv for a in cfg[1:3]
            ):
                return True
        return False

    def check(self, s: Session, ctx: dict) -> None:
        """Raise Skip(reason) unless the session may be restarted. Fills in
        the session's pane, method and re-arm summary."""
        d = s.data
        now = self.sys.now()
        if not d:
            raise Skip("unreadable sessions file")
        try:
            fresh = s.file.stat().st_mtime >= ctx["boot"]
        except OSError:
            fresh = False
        if not fresh or not self.sys.alive(s.pid):
            raise Skip(STALE)
        if d.get("kind") != "interactive":
            raise Skip(f"kind={d.get('kind')}")
        if (d.get("entrypoint") or "cli") != "cli":
            raise Skip(f"entrypoint={d.get('entrypoint')}")
        if s.pid in ctx["ancestors"]:
            raise Skip("ancestor of this monitor")
        if not s.version:
            raise Skip("no version in sessions file")
        if version_key(s.version) >= version_key(ctx["installed"]):
            raise Skip(
                f"version {s.version} is not older than installed {ctx['installed']}"
            )
        env = self.sys.environ(s.pid)
        if env.get("CLAUDE_PERSIST") == "0":
            raise Skip("CLAUDE_PERSIST=0")
        if ctx["classes"] is None:
            raise Skip("could not read session classes (machine-session list)")
        cls = ctx["classes"].get(s.pid)
        if cls is None:
            raise Skip("session class unknown")
        if cls == "critical":
            raise Skip("critical session")
        if EXCLUDE_NAMES.search(s.name):
            raise Skip("manager session")
        status = d.get("status")
        if status != "idle":
            extra = f" ({d.get('waitingFor')})" if d.get("waitingFor") else ""
            raise Skip(f"status={status}{extra}")
        upd = (d.get("statusUpdatedAt") or 0) / 1000
        if now - upd < QUIET_SECONDS:
            raise Skip(f"idle for only {int(now - upd)}s")
        configured = self.sys.mcp_commands(s.cwd)
        for c in self.sys.children(s.pid):
            argv = self.sys.cmdline(c)
            if not self.is_mcp(argv, configured):
                raise Skip(f"child process: {' '.join(argv)[:80]}")
        last_key = ctx["input_last"]
        if last_key is not None and now - last_key < QUIET_SECONDS:
            raise Skip(f"key press {int(now - last_key)}s ago")
        tty = self.sys.tty(s.pid)
        if tty:
            at = self.sys.tty_atime(tty)
            if (
                at is not None
                and now - at < QUIET_SECONDS
                and not self.bulk_input(at, ctx["tty_atimes"])
            ):
                raise Skip(f"input in its terminal {int(now - at)}s ago")
        panes = ctx["panes"]
        if panes is None:
            raise Skip("mux server not reachable")
        pane_env = env.get("WEZTERM_PANE")
        match = [p for p in panes if tty and p.get("tty_name") == tty]
        if not match or (
            pane_env is not None and str(match[0].get("pane_id")) != pane_env
        ):
            raise Skip("no pane in the current mux server")
        s.pane = match[0]
        tabs: list = []
        for p in panes:
            if (
                p.get("window_id") == s.pane.get("window_id")
                and p.get("tab_id") not in tabs
            ):
                tabs.append(p.get("tab_id"))
        s.tab_index = tabs.index(s.pane.get("tab_id"))
        if not s.cwd or not os.path.isdir(s.cwd):
            raise Skip("cwd is gone")
        s.transcript = (
            self.claude_dir / "projects" / project_slug(s.cwd) / f"{s.sid}.jsonl"
        )
        if not s.transcript.is_file():
            raise Skip("no transcript")
        s.entry_file = self.persist_dir / f"{s.sid}@{project_slug(s.cwd)}.json"
        if not s.entry_file.is_file():
            raise Skip("no claude-persist entry")
        info = self.resume.analyze(str(s.transcript), "idle", now)
        if info["goal"]:
            if info["loop_pending"] or info["crons"] or "\n" in info["goal"]:
                raise Skip("unmet /goal that does not re-arm cleanly")
        if info["loop_pending"] and info["loop"][0] - now < WAKEUP_MARGIN:
            raise Skip(f"ScheduleWakeup due in {int(info['loop'][0] - now)}s")
        rearm = []
        if info["goal"]:
            rearm.append("goal")
        if info["loop_pending"]:
            rearm.append(f"loop in {int(info['loop'][0] - now)}s")
        if info["crons"]:
            rearm.append(f"{len(info['crons'])} cron")
        s.rearm = ", ".join(rearm)
        st = self.read_state(s.key)
        if st.get("failed_at") and now - st["failed_at"] < BACKOFF_SECONDS:
            raise Skip(
                f"restart failed {int(now - st['failed_at'])}s ago, waiting 24 h"
            )
        tr = env.get("CLAUDE_TAB_RUN", "")
        if (
            tr.isdigit()
            and self.sys.alive(int(tr))
            and self.is_ancestor(int(tr), s.pid)
        ):
            s.method, s.tab_run_pid = "tab-run", int(tr)
        else:
            s.method = "new-tab"
            if not getattr(self.args, "allow_new_tab", False):
                raise Skip(
                    "needs-new-tab: not under claude-tab-run; a new tab would"
                    " change the tab order the FrankenTerm GUI shows"
                )

    # -------------------------------------------------------------- state

    def read_state(self, key: str) -> dict:
        try:
            return json.loads((self.state / "sessions" / f"{key}.json").read_text())
        except (OSError, ValueError):
            return {}

    def write_json(self, path: Path, data: dict) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name(path.name + ".tmp")
        tmp.write_text(json.dumps(data, indent=1) + "\n")
        tmp.replace(path)

    def lock(self, key: str) -> bool:
        d = self.state / "locks"
        d.mkdir(parents=True, exist_ok=True)
        fd = os.open(d / f"{key}.lock", os.O_CREAT | os.O_RDWR, 0o644)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(fd)
            return False
        self.locks[key] = fd
        return True

    def unlock(self, key: str) -> None:
        fd = self.locks.pop(key, None)
        if fd is not None:
            os.close(fd)

    # -------------------------------------------------------------- run

    def claude_tty_atimes(self) -> list[float]:
        """The tty access time of every live interactive Claude session."""
        out = []
        for s in self.read_sessions():
            if s.data.get("kind") != "interactive" or not self.sys.alive(s.pid):
                continue
            tty = self.sys.tty(s.pid)
            at = self.sys.tty_atime(tty) if tty else None
            if at is not None:
                out.append(at)
        return out

    @staticmethod
    def bulk_input(at: float, atimes: list[float]) -> bool:
        """Was this tty access time part of a burst that touched many panes at
        once? The FrankenTerm GUI writes to every pane together (focus or
        attach events), which sets each tty's access time like typing does.
        On 2026-10-17, 37 of 44 ptys showed input from the same second. A burst
        is at least 2 panes and at least BULK_SHARE of all Claude panes within
        BULK_WINDOW seconds of this one."""
        if not atimes:
            return False
        near = sum(1 for a in atimes if abs(a - at) <= BULK_WINDOW)
        return near >= 2 and near >= BULK_SHARE * len(atimes)

    def context(self) -> dict:
        return {
            "tty_atimes": self.claude_tty_atimes(),
            "boot": self.sys.boot_time(),
            "ancestors": self.ancestors(),
            "installed": self.sys.installed_version(),
            "classes": self.sys.classes(),
            "input_last": self.sys.input_last(),
            "panes": self.sys.mux_panes(),
        }

    def run(self) -> list[tuple[Session, str]]:
        """One pass. Returns (session, decision) for every session seen."""
        ctx = self.context()
        first: dict[int, Session] = {}
        results: list[tuple[Session, str]] = []
        stale = 0
        for s in self.read_sessions():
            only = getattr(self.args, "only", None)
            if only and not s.sid.startswith(only):
                continue
            try:
                self.check(s, ctx)
                first[s.pid] = s
            except Skip as e:
                results.append((s, "skip: " + str(e)))
                if str(e) == STALE:
                    stale += 1
                else:
                    self.log(s, "skip", str(e))
        if stale:
            self.log(
                None, "note", f"{stale} stale sessions files of processes that are gone"
            )
        if not first:
            return results
        self.sys.sleep(self.args.recheck_delay)
        ctx = self.context()
        again = {s.pid: s for s in self.read_sessions() if s.pid in first}
        acted = 0
        for pid, s1 in first.items():
            s = again.get(pid)
            try:
                if s is None:
                    raise Skip("sessions file gone at the second read")
                self.check(s, ctx)
                if (s.data.get("statusUpdatedAt"), s.sid) != (
                    s1.data.get("statusUpdatedAt"),
                    s1.sid,
                ):
                    raise Skip("status changed between the two reads")
                if acted >= MAX_PER_RUN:
                    raise Skip(f"over the limit of {MAX_PER_RUN} restarts per run")
                if not self.lock(s.key):
                    raise Skip("locked by another run")
            except Skip as e:
                why = str(e)
                if not why.startswith("over the limit"):
                    why = "second read: " + why
                self.log(s or s1, "skip", why)
                results.append((s or s1, "skip: " + why))
                continue
            acted += 1
            try:
                results.append((s, self.act(s, ctx)))
            finally:
                self.unlock(s.key)
        return results

    def describe(self, s: Session) -> str:
        where = (
            "in the same pane (claude-tab-run)"
            if s.method == "tab-run"
            else f"in a new tab at index {s.tab_index} (old pane {s.pane.get('pane_id')} closes when idle)"
        )
        rearm = f", re-arm {s.rearm}" if s.rearm else ""
        return f"{s.version} -> {self.installed} {where}{rearm}"

    def act(self, s: Session, ctx: dict) -> str:
        self.installed = ctx["installed"]
        if self.mode != "live":
            self.log(s, "candidate", "would restart " + self.describe(s))
            return "candidate"
        self.log(s, "restart", "restarting " + self.describe(s))
        ok, why = self.restart(s, ctx)
        st = self.read_state(s.key)
        st.update({"last_attempt": self.sys.now(), "last_result": "ok" if ok else why})
        if ok:
            st.pop("failed_at", None)
        else:
            st["failed_at"] = self.sys.now()
        self.write_json(self.state / "sessions" / f"{s.key}.json", st)
        self.log(s, "restarted" if ok else "failed", why)
        return "restarted" if ok else "failed: " + why

    def restart(self, s: Session, ctx: dict) -> tuple[bool, str]:
        """Stop the session's Claude process and resume it on the new version.
        Only runs in live mode."""
        now = self.sys.now()
        stamp = int(now)
        entry = json.loads(s.entry_file.read_text())
        entry["status"] = "idle"
        entry_copy = self.state / "entries" / f"{s.key}-{stamp}.json"
        self.write_json(entry_copy, entry)
        intent = {
            "session_id": s.sid,
            "pid": s.pid,
            "cwd": s.cwd,
            "old_version": s.version,
            "target_version": ctx["installed"],
            "method": s.method,
            "tab_run_pid": s.tab_run_pid,
            "pane_id": s.pane.get("pane_id"),
            "window_id": s.pane.get("window_id"),
            "tab_id": s.pane.get("tab_id"),
            "tab_index": s.tab_index,
            "entry_file": str(entry_copy),
            "created": now,
        }
        # The process at the root of the old pane (bash -c "...; exec fish -l",
        # or the fish the user started Claude from). Recorded before Claude is
        # stopped, so the pane can be closed once the new tab works.
        old_shell = self.pane_root(s.pid, s.pane.get("pane_id"))
        intent["old_shell_pid"] = old_shell
        intents = self.state / "intents"
        self.write_json(intents / f"{s.key}.json", intent)
        tab_intent = intents / f"tabrun-{s.tab_run_pid}.json"
        if s.method == "tab-run":
            self.write_json(tab_intent, intent)

        def drop_tab_intent():
            if s.method == "tab-run" and tab_intent.exists():
                tab_intent.unlink()

        try:
            self.sys.kill(s.pid, signal.SIGTERM)
        except OSError as e:
            drop_tab_intent()
            return False, f"SIGTERM failed: {e}"
        deadline = self.sys.now() + TERM_TIMEOUT
        while self.sys.alive(s.pid) and self.sys.now() < deadline:
            self.sys.sleep(0.5)
        if self.sys.alive(s.pid):
            self.log(
                s,
                "sigkill",
                f"still running {TERM_TIMEOUT}s after SIGTERM, sending SIGKILL",
            )
            try:
                self.sys.kill(s.pid, signal.SIGKILL)
            except OSError:
                pass
            self.sys.sleep(1)
            if self.sys.alive(s.pid):
                drop_tab_intent()
                return False, "process survived SIGKILL"
        if s.method == "new-tab":
            # Never start a second process on the session. Something else (a
            # person following Claude's "claude --resume" hint) may have
            # resumed it already; two processes can corrupt the transcript.
            for n in self.read_sessions():
                if (
                    n.sid == s.sid
                    and n.cwd == s.cwd
                    and n.pid != s.pid
                    and self.sys.alive(n.pid)
                ):
                    return (
                        False,
                        f"session already running as pid {n.pid}, not respawned",
                    )
            rc, pane = self.sys.respawn(entry_copy, s.pane.get("window_id"))
            if rc != 0 or not pane.strip().isdigit():
                return False, f"respawn failed (rc={rc}): {pane[:120]}"
            for p in self.sys.mux_panes() or []:
                if str(p.get("pane_id")) == pane.strip():
                    rc, out = self.sys.ft(
                        "move-tab",
                        "--tab-id",
                        str(p["tab_id"]),
                        "--index",
                        str(s.tab_index),
                    )
                    if rc != 0:
                        self.log(
                            s,
                            "note",
                            f"move-tab failed (rc={rc}), new tab stays at the end",
                        )
                    break
        deadline = self.sys.now() + VERIFY_TIMEOUT
        while self.sys.now() < deadline:
            for n in self.read_sessions():
                if (
                    n.sid == s.sid
                    and n.pid != s.pid
                    and self.sys.alive(n.pid)
                    and n.cwd == s.cwd
                    and version_key(n.version) >= version_key(ctx["installed"])
                ):
                    if s.method == "new-tab":
                        self.close_old_pane(s, old_shell)
                    return True, f"resumed as pid {n.pid} on {n.version}"
            self.sys.sleep(2)
        drop_tab_intent()
        return False, f"no new session on {ctx['installed']} within {VERIFY_TIMEOUT}s"

    def pane_root(self, pid: int, pane_id) -> int:
        """The highest ancestor of pid that still belongs to the pane (its
        WEZTERM_PANE is pane_id), or 0."""
        root, p, n = 0, pid, 0
        while n < 20:
            pp = self.sys.parent(p)
            if pp <= 1 or self.sys.environ(pp).get("WEZTERM_PANE") != str(pane_id):
                break
            root, p, n = pp, pp, n + 1
        return root

    def close_old_pane(self, s: Session, shell: int) -> None:
        """Close the old pane after a new-tab restart: SIGHUP its shell, only
        when it is an idle shell in that pane and the pane is still open."""
        pane_id = s.pane.get("pane_id")
        argv = self.sys.cmdline(shell) if shell else []
        name = os.path.basename(argv[0]).lstrip("-") if argv else ""
        if not shell or not self.sys.alive(shell):
            why = "no shell found"
        elif name not in ("fish", "bash", "zsh", "sh"):
            why = f"pane root is {name or '?'}, not a shell"
        elif self.sys.environ(shell).get("WEZTERM_PANE") != str(pane_id):
            why = "shell is not in that pane"
        elif self.sys.children(shell):
            why = "busy"
        elif not any(
            str(p.get("pane_id")) == str(pane_id) for p in self.sys.mux_panes() or []
        ):
            why = "pane is gone from cli list"
        else:
            try:
                self.sys.kill(shell, signal.SIGHUP)
            except OSError as e:
                self.log(s, "old-pane-kept", f"SIGHUP to {shell} failed: {e}")
                return
            self.log(
                s, "old-pane-closed", f"SIGHUP to {name} {shell} in pane {pane_id}"
            )
            return
        self.log(s, "old-pane-kept", f"{why} (pane {pane_id}, shell {shell})")


def read_mode(path: Path) -> str:
    try:
        text = path.read_text().strip()
    except OSError:
        return "dry-run"
    return "live" if text == "live" else "dry-run"


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument(
        "--dry-run",
        action="store_true",
        help="never restart, whatever the mode file says",
    )
    ap.add_argument("--recheck-delay", type=float, default=30.0)
    ap.add_argument("--only", metavar="SID", help="look only at this session id")
    ap.add_argument(
        "--live",
        action="store_true",
        help="act on the --only session, ignoring the mode file",
    )
    ap.add_argument(
        "--allow-new-tab",
        action="store_true",
        help="also restart sessions not under claude-tab-run, in a new tab"
        " (changes the GUI tab order; manual use only)",
    )
    ap.add_argument("--verbose", "-v", action="store_true", help="print decisions too")
    args = ap.parse_args(argv)
    if args.live and (not args.only or args.dry_run):
        ap.error("--live needs --only SID and cannot go with --dry-run")
    if args.only is not None and len(args.only) < 8:
        ap.error("--only needs at least 8 characters of the session id")

    state = (
        Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "claude-restart"
    )
    if args.dry_run:
        mode = "dry-run"
    elif args.live:
        mode = "live"
    else:
        mode = read_mode(HOME / ".config/claude-restart/mode")
    state.mkdir(parents=True, exist_ok=True)
    run_lock = os.open(state / "run.lock", os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(run_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("another claude-version-restart run is active", file=sys.stderr)
        return 0
    hooks = HOME / ".claude/hooks"
    mon = Monitor(
        System(HOME / ".claude", hooks / "claude-persist.sh"),
        args,
        claude_dir=HOME / ".claude",
        state_dir=state,
        persist_dir=HOME / ".local/state/claude-persist/sessions",
        resume_py=hooks / "claude-persist-resume.py",
        mode=mode,
    )
    results = mon.run()
    n = sum(1 for _, d in results if d == "candidate" or d == "restarted")
    print(
        f"{mode}: {len(results)} sessions, {n} {'candidates' if mode != 'live' else 'restarted'}"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
