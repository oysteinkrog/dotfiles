#!/usr/bin/env python3
"""Pick one colour theme for the desktop: the panels, fooyin and any app with a hook.

  os-theme            print the current theme
  os-theme --list     list the themes, the current one marked with *
  os-theme NAME       switch to NAME

Themes:  ~/.config/os-theme/themes.json (version controlled). Token names are stable: new ones may
         be added, none are renamed or removed. A reader ignores tokens it does not know, and treats
         a missing file or an unknown name as "plasma".
Choice:  ~/.local/state/os-theme/current, one line (local state, not in the repo).
Colours: ~/.local/state/os-theme/colors, the theme as a KDE colours file ([Colors:Window],
         [Colors:View], [Colors:Selection], ...), for apps that already read that format. Not
         written for "plasma", which means "follow the Plasma style".
Hooks:   every executable in ~/.config/os-theme/hooks runs after a switch, with the theme name.

For now it also writes ~/.config/desktop-panels/theme, which the panel widgets still read.
panel-theme is the same command under its old name.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state")) / "os-theme"
THEMES = CONFIG / "os-theme" / "themes.json"
HOOKS = CONFIG / "os-theme" / "hooks"
CHOICE = STATE / "current"
COLOURS = STATE / "colors"
LEGACY_CHOICE = CONFIG / "desktop-panels" / "theme"

# KDE colours file entries, from theme tokens. Groups and keys as in a Plasma .colors file.
KDE_KEYS = {
    "Window": {"BackgroundNormal": "window", "BackgroundAlternate": "band", "ForegroundNormal": "text",
               "ForegroundInactive": "muted", "DecorationFocus": "accent"},
    "View": {"BackgroundNormal": "card", "BackgroundAlternate": "band", "ForegroundNormal": "text",
             "ForegroundInactive": "muted", "ForegroundLink": "accent", "ForegroundActive": "accent",
             "ForegroundPositive": "positive", "ForegroundNeutral": "warning",
             "ForegroundNegative": "negative", "DecorationFocus": "accent"},
    "Button": {"BackgroundNormal": "band", "ForegroundNormal": "text", "DecorationFocus": "accent"},
    "Selection": {"BackgroundNormal": "accent", "ForegroundNormal": "onAccent"},
    "Tooltip": {"BackgroundNormal": "card", "ForegroundNormal": "text"},
    "Header": {"BackgroundNormal": "band", "ForegroundNormal": "text"},
    "Complementary": {"BackgroundNormal": "window", "ForegroundNormal": "text"},
}


def load_themes():
    try:
        return json.loads(THEMES.read_text())
    except (OSError, ValueError):
        return {"plasma": {"label": "Plasma style"}}


def current(themes):
    for path in (CHOICE, LEGACY_CHOICE):  # the legacy file until every reader has moved
        try:
            name = path.read_text().strip()
        except OSError:
            continue
        return name if name in themes else "plasma"
    return "plasma"


def write_atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def kde_colours(theme):
    def rgb(token):
        value = theme.get(token, "")
        if not (value.startswith("#") and len(value) == 7):
            return None
        return ",".join(str(int(value[i : i + 2], 16)) for i in (1, 3, 5))

    lines = [f"# Generated by os-theme from the {theme.get('label', '')!r} theme. Do not edit."]
    for group, keys in KDE_KEYS.items():
        lines.append(f"\n[Colors:{group}]")
        lines += [f"{key}={rgb(token)}" for key, token in keys.items() if rgb(token)]
    return "\n".join(lines) + "\n"


def run_hooks(name):
    notes = []
    for hook in sorted(HOOKS.glob("*")) if HOOKS.is_dir() else []:
        if not (hook.is_file() and os.access(hook, os.X_OK)):
            continue
        result = subprocess.run([str(hook), name], capture_output=True, text=True)
        if result.returncode != 0:
            notes.append(f"  {hook.name}: failed ({result.returncode}) {result.stderr.strip()}")
        elif result.stdout.strip():
            notes.append(f"  {hook.name}: {result.stdout.strip()}")
    return notes


def switch(name, theme):
    write_atomic(CHOICE, name + "\n")
    write_atomic(LEGACY_CHOICE, name + "\n")
    if name == "plasma":
        COLOURS.unlink(missing_ok=True)
    else:
        write_atomic(COLOURS, kde_colours(theme))
    print(f"{name}: panels change within 5 s.")
    for note in run_hooks(name):
        print(note)


def main(args):
    themes = load_themes()
    if not args:
        print(current(themes))
    elif args[0] in ("--list", "-l"):
        cur = current(themes)
        for name, theme in themes.items():
            print(f"{'*' if name == cur else ' '} {name:15} {theme.get('label', '')}")
    elif args[0] in ("--help", "-h"):
        print(__doc__.strip())
    elif args[0] in themes:
        switch(args[0], themes[args[0]])
    else:
        print(f"os-theme: no theme {args[0]!r}; try --list", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
