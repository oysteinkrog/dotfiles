#!/usr/bin/env bash
# claude-throttle-log: record how often MemoryHigh throttles Claude sessions. Read only:
# it reads cgroup files and appends to a log, nothing else. Run by
# claude-throttle-log.timer every 5 min while the soft limits are new.
#
# One tab-separated line per cgroup (claude.slice itself, then each claude-*.scope):
#   time  cgroup  memory.high  high_events  max_events  ram_bytes  swap_bytes
#   mem_some_avg60  mem_full_avg60  cpu_usage_usec  swap_max  swap_max_events
# high_events counts every time the cgroup went over memory.high since it started, and
# swap_max_events every time it hit memory.swap.max, so compare runs to see new hits.
# A log with the older 10-column header is moved to log.v1.tsv. Log: ~/.local/state/claude-throttle/log.tsv
set -euo pipefail
export LC_ALL=C

SLICE=/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/claude.slice
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/claude-throttle
LOG=$STATE/log.tsv
mkdir -p -- "$STATE"
[ -d "$SLICE" ] || { echo "claude-throttle-log: no claude.slice" >&2; exit 0; }
HEADER='time	cgroup	memory_high	high_events	max_events	ram_bytes	swap_bytes	mem_some_avg60	mem_full_avg60	cpu_usage_usec	swap_max	swap_max_events'
if [ -s "$LOG" ] && [ "$(head -1 "$LOG")" != "$(printf '%b' "$HEADER")" ]; then
  mv -- "$LOG" "$STATE/log.v1.tsv"
fi
[ -s "$LOG" ] || printf '%b\n' "$HEADER" >> "$LOG"

now=$(date -Is)
row() {
  local d=$1 high events_high events_max ram swap some full cpu swap_max swap_events
  # A scope can end between the glob and the reads; skip it then.
  high=$(cat "$d/memory.high" 2>/dev/null) || return 0
  events_high=$(awk '$1=="high"{print $2}' "$d/memory.events" 2>/dev/null) || return 0
  events_max=$(awk '$1=="max"{print $2}' "$d/memory.events" 2>/dev/null) || return 0
  ram=$(cat "$d/memory.current" 2>/dev/null) || return 0
  swap=$(cat "$d/memory.swap.current" 2>/dev/null) || return 0
  some=$(awk '$1=="some"{sub("avg60=","",$3); print $3}' "$d/memory.pressure" 2>/dev/null) || return 0
  full=$(awk '$1=="full"{sub("avg60=","",$3); print $3}' "$d/memory.pressure" 2>/dev/null) || return 0
  cpu=$(awk '$1=="usage_usec"{print $2}' "$d/cpu.stat" 2>/dev/null) || return 0
  swap_max=$(cat "$d/memory.swap.max" 2>/dev/null) || return 0
  swap_events=$(awk '$1=="max"{print $2}' "$d/memory.swap.events" 2>/dev/null) || return 0
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$now" "${d##*/}" "$high" "$events_high" \
    "$events_max" "$ram" "$swap" "$some" "$full" "$cpu" "$swap_max" "$swap_events"
}

{
  row "$SLICE"
  for d in "$SLICE"/claude-*.scope; do
    [ -d "$d" ] && row "$d"
  done
} >> "$LOG"
