#!/bin/sh
# Press Enter after voxtype pastes, but only in the apps listed in
# ~/.config/voxtype/auto-enter-apps (one name per line, # for comments).
# A line matches when it appears anywhere in the focused window's class,
# ignoring case: "frankenterm" matches com.dicklesworthstone.frankenterm.office.
# Run by voxtype as [output] post_output_command.

list="${XDG_CONFIG_HOME:-$HOME/.config}/voxtype/auto-enter-apps"
[ -r "$list" ] || exit 0

class=$(kdotool getactivewindow getwindowclassname 2>/dev/null) || exit 0
[ -n "$class" ] || exit 0

grep -v '^[[:space:]]*\(#\|$\)' "$list" | while IFS= read -r app; do
    app=$(printf '%s' "$app" | tr -d '[:space:]')
    if printf '%s' "$class" | grep -qiF -- "$app"; then
        # Let the app take in the pasted text before Enter arrives.
        sleep 0.15
        if [ -p "${DOTOOL_PIPE:-/tmp/dotool-pipe}" ]; then
            echo "key enter" | dotoolc
        else
            echo "key enter" | dotool
        fi
        exit 0
    fi
done
exit 0
