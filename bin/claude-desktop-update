#!/usr/bin/env bash
# claude-desktop-update: keep Claude Desktop current from Anthropic's apt repo.
#
# Electron's autoUpdater has no Linux support, so the app cannot update itself.
# This reads Anthropic's apt index, and when it lists a newer version than the
# installed one, builds a pacman package from the AUR recipe (aur/claude-desktop)
# with the new version and the index's sha256, then installs it.
#
# It never installs while the app is running: it builds the package, sends a
# notification and installs on the next run after the app is closed.
#
# Run by claude-desktop-update.timer. Flags: --check (report only).
set -euo pipefail

INDEX=https://downloads.claude.ai/claude-desktop/apt/stable/dists/stable/main/binary-amd64/Packages
AUR=https://aur.archlinux.org/claude-desktop.git
STATE=${XDG_CACHE_HOME:-$HOME/.cache}/claude-desktop-update
APP=/usr/lib/claude-desktop/claude-desktop

log() { echo "claude-desktop-update: $*"; }
notify() { notify-send -a "Claude Desktop" -i claude-desktop "Claude Desktop update" "$1" 2>/dev/null || true; }

mkdir -p "$STATE"

# Newest amd64 entry in the index: "version sha256".
read -r latest sha < <(curl -fsS --max-time 60 "$INDEX" | awk '
  /^Version: /{v=$2} /^SHA256: /{s=$2}
  /^$/{if (v) print v, s; v=s=""} END{if (v) print v, s}' | sort -V | tail -1)
[[ -n ${latest:-} && ${sha:-} =~ ^[0-9a-f]{64}$ ]] || { log "could not read the apt index"; exit 1; }

installed=$(pacman -Q claude-desktop 2>/dev/null | awk '{print $2}' | sed 's/-[0-9]*$//')
if [[ -n $installed ]] && (( $(vercmp "$latest" "$installed") <= 0 )); then
  log "up to date ($installed)"
  exit 0
fi
log "installed ${installed:-none}, available $latest"
[[ ${1:-} == --check ]] && exit 0

pkg=$(ls "$STATE"/pkg/claude-desktop-"$latest"-*-x86_64.pkg.tar.* 2>/dev/null | head -1 || true)
if [[ -z $pkg ]]; then
  if [[ -d $STATE/aur/.git ]]; then
    git -C "$STATE/aur" fetch -q origin && git -C "$STATE/aur" reset -q --hard origin/HEAD
  else
    git clone -q "$AUR" "$STATE/aur"
  fi
  cd "$STATE/aur"
  # Point the recipe at the new .deb unless the AUR already did.
  if [[ $(sed -n 's/^pkgver=//p' PKGBUILD) != "$latest" ]]; then
    sed -i -e "s/^pkgver=.*/pkgver=$latest/" -e "s/^pkgrel=.*/pkgrel=1/" \
      -e "s/^sha256sums_x86_64=.*/sha256sums_x86_64=('$sha')/" PKGBUILD
  fi
  mkdir -p "$STATE/pkg" "$STATE/src"
  PKGDEST=$STATE/pkg SRCDEST=$STATE/src makepkg -f --noconfirm --nodeps >"$STATE/makepkg.log" 2>&1 \
    || { log "makepkg failed, see $STATE/makepkg.log"; notify "Building $latest failed. See $STATE/makepkg.log"; exit 1; }
  git -C "$STATE/aur" checkout -q -- PKGBUILD
  pkg=$(ls "$STATE"/pkg/claude-desktop-"$latest"-*-x86_64.pkg.tar.* | head -1)
fi

if pgrep -f "^$APP" >/dev/null; then
  log "app is running, $latest will install after it is closed"
  if [[ ! -e $STATE/notified-$latest ]]; then
    notify "Version $latest is ready. It installs within the hour after you quit Claude Desktop."
    touch "$STATE/notified-$latest"
  fi
  exit 0
fi

sudo -n pacman -U --noconfirm --needed "$pkg"
log "installed $latest"
notify "Updated to $latest."
# Keep only the package just installed, and drop old .debs and markers.
find "$STATE/pkg" "$STATE/src" -type f ! -name "*$latest*" -delete
rm -f "$STATE"/notified-*
