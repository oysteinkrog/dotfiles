#!/usr/bin/env bash
# secret — read one secret from ~/.config/secrets/.env.
#
# Usage:
#   secret KEY                print the value to stdout
#   secret --list             list available keys (no values)
#   secret --list --work      only keys owned by work (work.env)
#   secret --list --personal  only keys owned by Oystein (personal.env)
#
# .env is generated by `secrets-build` from work.env and personal.env in the
# same folder. Edit those two files, never .env, then run secrets-build.
#
# Shell-agnostic replacement for the former fish-only function; works from
# bash, fish, scripts, cron, anything on PATH. Never source the .env file
# into a shell: fetch only the key you need, at the moment you need it.
set -euo pipefail

env_file="${SECRETS_ENV_FILE:-$HOME/.config/secrets/.env}"

src_dir="$(dirname "$env_file")"
for src in "$src_dir/work.env" "$src_dir/personal.env"; do
    if [ -f "$src" ] && [ "$src" -nt "$env_file" ]; then
        echo "secret: $(basename "$src") is newer than $(basename "$env_file"); run secrets-build" >&2
    fi
done

if [ "${1:-}" = --list ]; then
    case "${2:-}" in
        "") awk -F= '/^[A-Za-z_][A-Za-z0-9_]*=/ {print $1}' "$env_file" | sort -u ;;
        --work|--personal)
            src="$src_dir/${2#--}.env"
            [ -f "$src" ] || { echo "secret: $src not found" >&2; exit 1; }
            awk -F= '/^[A-Za-z_][A-Za-z0-9_]*=/ {print $1}' "$src" | sort -u ;;
        *) echo "usage: secret --list [--work|--personal]" >&2; exit 2 ;;
    esac
    exit 0
fi

if [ $# -ne 1 ]; then
    echo "usage: secret KEY  |  secret --list" >&2
    exit 2
fi

if [ ! -f "$env_file" ]; then
    echo "secret: $env_file not found" >&2
    exit 1
fi

val=$(awk -F= -v k="$1" '$1==k {sub(/^[^=]+=/,""); print; exit}' "$env_file")
if [ -z "$val" ]; then
    echo "secret: $1 not found in $env_file" >&2
    exit 1
fi
printf '%s\n' "$val"
