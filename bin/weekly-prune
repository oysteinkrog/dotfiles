#!/usr/bin/env python3
"""weekly-prune: weekly cleanup of cache directories that grow without bound.

Dry run is the default. Nothing is deleted without --apply.
Run from weekly-prune.timer (Sunday 22:30, idle IO, Nice 10).

Items (each prints its size and what would go):
  uv         `uv cache prune`. Dry run shows the cache size only.
  nuget      `dotnet nuget locals http-cache --clear` and plugins-cache.
             global-packages (~/.nuget/packages) is never touched: builds need it.
  paru       ~/.cache/paru/clone/<pkg>/{src,pkg} and *.pkg.tar.* older than 30 days.
             The PKGBUILD checkouts stay.
  cdu        ~/.cache/claude-desktop-update/pkg/*.pkg.tar.*: all but the newest.
             The notified-* marker files are kept (the updater reads them).
  debug      ~/.debug/.build-id/<xx>/<id> entries older than 30 days.
  trash      ~/.local/share/Trash items whose trashinfo DeletionDate is over 7 days old.
  docker     `docker builder prune -f --filter until=168h`, only if docker answers.

Log: sizes per item and a total go to ~/.local/state/weekly-prune/log.
Skip an item with --skip NAME (repeatable). Run one item with --only NAME.
"""
import argparse
import datetime as dt
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import unquote

HOME = Path.home()
G = 2**30
STATE = Path(os.environ.get("WEEKLY_PRUNE_STATE", HOME / ".local/state/weekly-prune"))
HOME_CACHE = Path(os.environ.get("WEEKLY_PRUNE_HOME", HOME))  # test hook
DAY = 86400
NOW = time.time()
ITEMS = ["uv", "nuget", "paru", "cdu", "debug", "trash", "docker"]


def du(path):
    """Apparent size in bytes of a path (file, dir or symlink), no symlink following."""
    try:
        p = Path(path)
        if p.is_symlink() or p.is_file():
            return p.lstat().st_size
        r = subprocess.run(["du", "-sb", "--", str(p)], capture_output=True, text=True, timeout=1800)
        return int(r.stdout.split()[0]) if r.stdout else 0
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 0


def remove(path):
    p = Path(path)
    if p.is_symlink() or p.is_file():
        p.unlink()
    elif p.is_dir():
        shutil.rmtree(p)


def run(cmd, timeout=3600):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    return r.returncode, (r.stdout + r.stderr).strip()


def mtime(p):
    try:
        return Path(p).lstat().st_mtime
    except OSError:
        return NOW


class Report:
    def __init__(self, apply):
        self.apply, self.lines, self.total = apply, [], 0

    def item(self, name, nbytes, note, count=None):
        self.total += nbytes
        c = f" x{count}" if count is not None else ""
        line = f"{name:7} {nbytes / G:9.2f} GiB{c}  {note}"
        self.lines.append(line)
        print(line, flush=True)


def item_uv(rep, apply):
    if not shutil.which("uv"):
        return rep.item("uv", 0, "uv not installed")
    rc, out = run(["uv", "cache", "dir"])
    d = Path(out.splitlines()[-1]) if rc == 0 and out else HOME_CACHE / ".cache/uv"
    before = du(d)
    if not apply:
        return rep.item("uv", 0, f"cache is {before / G:.2f} GiB; `uv cache prune` would run (size freed unknown until run)")
    rc, out = run(["uv", "cache", "prune"])
    after = du(d)
    rep.item("uv", max(before - after, 0), f"uv cache prune rc={rc}: {out.splitlines()[-1] if out else ''}")


def item_nuget(rep, apply):
    if not shutil.which("dotnet"):
        return rep.item("nuget", 0, "dotnet not installed")
    dirs = [HOME_CACHE / ".local/share/NuGet/http-cache", HOME_CACHE / ".local/share/NuGet/plugin-cache"]
    before = sum(du(d) for d in dirs if d.exists())
    if not apply:
        return rep.item("nuget", before, "http-cache + plugins-cache would be cleared (global-packages kept)")
    notes = []
    for which in ("http-cache", "plugins-cache"):
        rc, _ = run(["dotnet", "nuget", "locals", which, "--clear"])
        notes.append(f"{which} rc={rc}")
    after = sum(du(d) for d in dirs if d.exists())
    rep.item("nuget", max(before - after, 0), ", ".join(notes))


def item_paru(rep, apply):
    clone = HOME_CACHE / ".cache/paru/clone"
    if not clone.is_dir():
        return rep.item("paru", 0, "no clone dir")
    cutoff = NOW - 30 * DAY
    victims = []
    for pkg in sorted(clone.iterdir()):
        if not pkg.is_dir() or pkg.is_symlink():
            continue
        for sub in ("src", "pkg"):
            p = pkg / sub
            if p.is_dir() and not p.is_symlink() and mtime(p) < cutoff:
                victims.append(p)
        for f in pkg.glob("*.pkg.tar.*"):
            if f.is_file() and mtime(f) < cutoff:
                victims.append(f)
    size = sum(du(v) for v in victims)
    if apply:
        for v in victims:
            remove(v)
    rep.item("paru", size, "old build dirs and packages" + ("" if apply else " (would delete)"), len(victims))
    for v in victims[:20]:
        print(f"          {v}")


def item_cdu(rep, apply):
    pkgdir = HOME_CACHE / ".cache/claude-desktop-update/pkg"
    if not pkgdir.is_dir():
        return rep.item("cdu", 0, "no pkg dir")
    files = sorted((f for f in pkgdir.glob("*.pkg.tar.*") if f.is_file()), key=mtime, reverse=True)
    victims = files[1:]
    size = sum(du(v) for v in victims)
    if apply:
        for v in victims:
            remove(v)
    keep = files[0].name if files else "none"
    rep.item("cdu", size, f"keep newest {keep}" + ("" if apply else " (would delete the rest)"), len(victims))


def item_debug(rep, apply):
    # perf build-id cache: .build-id/<xx>/<id> are symlinks to <path>/<id> dirs that hold the data.
    base = HOME_CACHE / ".debug"
    root = base / ".build-id"
    if not root.is_dir():
        return rep.item("debug", 0, "no .debug/.build-id")
    cutoff = NOW - 30 * DAY
    prefix = str(base.resolve()) + "/"
    victims = []  # (link, real target dir or None)
    for sub in sorted(root.iterdir()):
        if not sub.is_dir() or sub.is_symlink():
            continue
        for e in sub.iterdir():
            real = Path(os.path.realpath(e)) if e.is_symlink() else None
            if real is not None and not str(real).startswith(prefix):
                continue  # never follow a link out of ~/.debug
            if real is not None and not real.exists():
                real = None  # dangling link: remove the link only
            if mtime(real if real is not None else e) < cutoff:
                victims.append((e, real))
    size = sum(du(t) for _, t in victims if t is not None)
    if apply:
        for link, real in victims:
            if real is not None:
                remove(real)
            remove(link)
        for sub in root.iterdir():  # drop emptied two-hex dirs
            try:
                sub.rmdir()
            except OSError:
                pass
    rep.item("debug", size, "build-id entries older than 30 days" + ("" if apply else " (would delete)"), len(victims))


def item_trash(rep, apply):
    trash = HOME_CACHE / ".local/share/Trash"
    info, files = trash / "info", trash / "files"
    if not info.is_dir():
        return rep.item("trash", 0, "no trash")
    cutoff = dt.datetime.fromtimestamp(NOW - 7 * DAY)
    victims, skipped = [], 0
    for ti in sorted(info.glob("*.trashinfo")):
        date = None
        try:
            for line in ti.read_text(errors="replace").splitlines():
                if line.startswith("DeletionDate="):
                    date = dt.datetime.fromisoformat(line.split("=", 1)[1].strip())
        except (OSError, ValueError):
            pass
        if date is None:
            skipped += 1  # no usable date: never guess
            continue
        if date < cutoff:
            victims.append((ti, files / ti.name[: -len(".trashinfo")]))
    size = sum(du(f) for _, f in victims if os.path.lexists(f))
    if apply:
        for ti, f in victims:
            if os.path.lexists(f):
                remove(f)
            ti.unlink(missing_ok=True)
    note = "items trashed over 7 days ago" + ("" if apply else " (would delete)")
    if skipped:
        note += f"; {skipped} without a DeletionDate left alone"
    rep.item("trash", size, note, len(victims))
    if not apply:
        for ti, f in victims[:15]:
            print(f"          {f.name}")


def item_docker(rep, apply):
    if not shutil.which("docker"):
        return rep.item("docker", 0, "docker not installed")
    rc, _ = run(["docker", "info", "--format", "{{.ID}}"], timeout=30)
    if rc != 0:
        return rep.item("docker", 0, "docker not running, skipped")
    if not apply:
        rc, out = run(["docker", "buildx", "du"], timeout=120)
        tail = out.splitlines()[-1] if out else "?"
        return rep.item("docker", 0, f"would run builder prune --filter until=168h; buildx du: {tail}")
    rc, out = run(["docker", "builder", "prune", "-f", "--filter", "until=168h"], timeout=1800)
    rep.item("docker", 0, f"builder prune rc={rc}: {out.splitlines()[-1] if out else ''}")


FUNCS = {n: globals()[f"item_{n}"] for n in ITEMS}


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--apply", action="store_true", help="delete; without it this is a dry run")
    ap.add_argument("--only", choices=ITEMS)
    ap.add_argument("--skip", action="append", default=[], choices=ITEMS)
    args = ap.parse_args()

    STATE.mkdir(parents=True, exist_ok=True)
    rep = Report(args.apply)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
    print(f"weekly-prune {stamp} mode={'APPLY' if args.apply else 'dry-run'}", flush=True)
    for name in ITEMS:
        if (args.only and name != args.only) or name in args.skip:
            continue
        try:
            FUNCS[name](rep, args.apply)
        except Exception as e:  # one failing item must not stop the others
            line = f"{name:7} ERROR {type(e).__name__}: {e}"
            rep.lines.append(line)
            print(line, flush=True)
    summary = f"total {rep.total / G:.2f} GiB {'freed' if args.apply else 'reclaimable (known items)'}"
    print(summary)
    log = STATE / "log"
    try:
        if log.stat().st_size > 2 * 2**20:
            log.replace(STATE / "log.1")
    except OSError:
        pass
    with open(log, "a") as fh:
        fh.write(f"{stamp} {'APPLY' if args.apply else 'dry-run'}\n")
        for line in rep.lines:
            fh.write("  " + line + "\n")
        fh.write("  " + summary + "\n")


if __name__ == "__main__":
    sys.exit(main())
