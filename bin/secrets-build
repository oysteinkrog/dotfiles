#!/usr/bin/env python3
"""Build ~/.config/secrets/.env from the owned source files.

The store is split by owner:
  ~/.config/secrets/work.env      Initial Force and Swing Catalyst keys
  ~/.config/secrets/personal.env  Oystein's own keys
Edit only those two files. `.env` is a generated snapshot of both, kept so every
existing reader (`secret`, `with-secrets`, MCP wrappers, hooks) works unchanged.

Usage:
  secrets-build            validate the sources and publish a new .env
  secrets-build --check    validate and compare with the live .env, change nothing
  secrets-build --list     print KEY<TAB>source for every key (no values)

Rules: each line is KEY=VALUE or a comment or blank; a key may appear once,
in one file only. On any error nothing is written and the old .env stays.
Never prints a value.
"""
from __future__ import annotations

import fcntl
import os
import re
import sys
import tempfile
from pathlib import Path

DIR = Path(os.environ.get("SECRETS_DIR", Path.home() / ".config" / "secrets"))
SOURCES = [("work", DIR / "work.env"), ("personal", DIR / "personal.env")]
OUT = DIR / ".env"
LOCK = DIR / ".build.lock"
KEY_LINE = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")


def fail(msg: str) -> "NoReturn":  # type: ignore[name-defined]
    print(f"secrets-build: {msg}", file=sys.stderr)
    sys.exit(1)


def read_sources() -> list[tuple[str, str, str]]:
    """Return (key, value, source) in source order. Exit on any problem."""
    seen: dict[str, str] = {}
    rows: list[tuple[str, str, str]] = []
    errors: list[str] = []
    for name, path in SOURCES:
        if not path.exists():
            errors.append(f"{path} is missing")
            continue
        if path.stat().st_mode & 0o077:
            errors.append(f"{path} must be mode 600")
        for n, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            line = raw.rstrip("\r")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            m = KEY_LINE.match(line)
            if not m:
                errors.append(f"{path.name}:{n}: not KEY=VALUE")
                continue
            key, val = m.group(1), m.group(2)
            if not val:
                errors.append(f"{path.name}:{n}: {key} has an empty value")
            if key in seen:
                errors.append(f"{path.name}:{n}: {key} is already in {seen[key]}")
                continue
            seen[key] = path.name
            rows.append((key, val, name))
    if errors:
        fail("nothing written:\n  " + "\n  ".join(errors))
    if not rows:
        fail("no keys found in the sources")
    return rows


def read_live() -> dict[str, str]:
    live: dict[str, str] = {}
    if OUT.exists():
        for line in OUT.read_text(encoding="utf-8").splitlines():
            m = KEY_LINE.match(line)
            if m and m.group(1) not in live:
                live[m.group(1)] = m.group(2)
    return live


def compare(rows: list[tuple[str, str, str]]) -> int:
    live = read_live()
    new = {k: v for k, v, _ in rows}
    added = sorted(set(new) - set(live))
    removed = sorted(set(live) - set(new))
    changed = sorted(k for k in set(new) & set(live) if new[k] != live[k])
    for label, keys in (("added", added), ("removed", removed), ("value changed", changed)):
        if keys:
            print(f"{label}: {', '.join(keys)}")
    if not (added or removed or changed):
        print(f"same {len(new)} keys and values as {OUT}")
        return 0
    return 3


def publish(rows: list[tuple[str, str, str]]) -> None:
    body = "".join(f"{k}={v}\n" for k, v, _ in rows)
    fd, tmp = tempfile.mkstemp(prefix=".env.", dir=DIR)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(body)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, OUT)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def main() -> int:
    args = sys.argv[1:]
    if args not in ([], ["--check"], ["--list"]):
        print(__doc__.split("Usage:")[1].split("Rules:")[0].rstrip(), file=sys.stderr)
        return 2
    LOCK.touch(mode=0o600, exist_ok=True)
    with open(LOCK) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        rows = read_sources()
        if args == ["--list"]:
            for k, _, src in sorted(rows):
                print(f"{k}\t{src}")
            return 0
        if args == ["--check"]:
            return compare(rows)
        diff = compare(rows)
        if diff == 0:
            os.utime(OUT)  # mark the snapshot as current for `secret`'s stale check
            return 0
        publish(rows)
        print(f"wrote {OUT} ({len(rows)} keys)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
