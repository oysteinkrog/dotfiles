#!/usr/bin/env python3
"""Turn memory pressure into a level (normal, slow, pause) for heavy-build.

    pressure-coordinator             run for good, one sample every 5 s
    pressure-coordinator --once      take two samples 5 s apart and print them
    pressure-coordinator --self-test run the built-in tests in a sandbox

Runs as pressure-coordinator.service, a systemd user unit in background.slice.
It only reads /proc and the cgroup tree and writes its own files. It never
kills, stops, freezes or signals any process, and it changes no cgroup limit.

Files it writes:

  ~/.local/state/pressure/level   one line, rewritten every sample (temp + mv):
      level=slow since=<epoch> updated=<epoch> reason="memory full avg10 6.1%"
      top=claude-123.scope:8.2%
    heavy-build ignores it when updated is more than 30 s old.
  ~/.local/state/pressure/log     each level change, and one sample a minute.
    Cut to its last half when it passes log_max_bytes.
  $XDG_RUNTIME_DIR/heavy-build.hold.pressure
    Only at pause: "expires=<now + 30> pressure-coordinator: level pause (...)",
    refreshed every sample and removed when the level drops. This is its own
    file. The manager's heavy-build.hold is never read, written or removed here.

Signals (each sample):
  - memory PSI full avg10, system wide (/proc/pressure/memory);
  - memory PSI some and full avg10 of each child of claude.slice, app.slice and
    session.slice. A child whose memory.events "high" or "max" counter rose in
    the last 60 s is skipped: it is held back by its own MemoryHigh or
    MemoryMax, not by the machine. (On 2026-10-21 one Chrome unit at its own
    MemoryHigh made app.slice look stressed and blocked every build.)
  - disk swap-in (pswpin), swap-out (pswpout), major faults (pgmajfault) and
    zswap writeback (zswpwb), per second over the last 60 s;
  - io PSI full avg10;
  - MemAvailable, and swap room: 90% of SwapTotal minus swap used.

Thresholds (defaults; each is settable in ~/.config/pressure-coordinator.conf
as key=value, keys as in DEFAULTS below). From the 2026-10-21 swap-aware
redesign, section 4:

  slow  when any of these holds for enter_secs (15 s):
          memory full avg10 >= 2%           (slow_mem_full)
          a session's memory some avg10 >= 10%   (slow_scope_some)
          disk swap-in >= 2000 pages/s      (slow_swapin)
          swap room < 24 GiB                (slow_swap_room_gib)
  pause when any of these holds for enter_secs:
          memory full avg10 >= 5%           (pause_mem_full)
          a session's memory full avg10 >= 10%   (pause_scope_full)
          disk swap-in >= 8000 pages/s      (pause_swapin)
          MemAvailable < 2 GiB              (pause_mem_avail_gib)
        and at once (no wait) when swap room < 12 GiB (pause_swap_room_gib).

  One level down only after leave_secs (120 s) in which every signal of the
  current level stayed under half its enter threshold (MemAvailable over twice
  its threshold) and swap room stayed over 32 GiB (recover_swap_room_gib).

One change from the design: it named pgmajfault over 1000/s (slow) and
4000/s (pause). Measured on 2026-10-22 at 09:01, ten minutes after a reboot,
pgmajfault ran at 1150/s while disk swap-in was 4 pages/s and memory full
was 0.5%: most major faults were page cache reads by builds, not swap. So
disk swap-in pages (pswpin) are the trigger, and pgmajfault is only logged
unless slow_majfault or pause_majfault is set above 0. zswap hits do not
count in pswpin, so pswpin is real disk reads. io PSI and zswap writeback are
logged only (slow_io_full and pause_io_full are 0, meaning off).
"""

from __future__ import annotations

import os
import re
import shutil
import signal
import sys
import tempfile
import time
from collections import deque
from pathlib import Path

DEFAULTS: dict[str, float] = {
    "interval": 5,
    "enter_secs": 15,
    "leave_secs": 120,
    "rate_window_secs": 60,
    "own_limit_secs": 60,
    "slow_mem_full": 2,
    "pause_mem_full": 5,
    "slow_scope_some": 10,
    "pause_scope_full": 10,
    "slow_swapin": 2000,
    "pause_swapin": 8000,
    "slow_majfault": 0,
    "pause_majfault": 0,
    "slow_io_full": 0,
    "pause_io_full": 0,
    "slow_swap_room_gib": 24,
    "pause_swap_room_gib": 12,
    "pause_mem_avail_gib": 2,
    "recover_swap_room_gib": 32,
    "hold_ttl_secs": 30,
    "sample_log_secs": 60,
    "log_max_bytes": 5_000_000,
}
LEVELS = ("normal", "slow", "pause")
SLICES = ("claude.slice", "app.slice", "session.slice")
GIB = 1024**3


def read_conf(path: Path) -> dict[str, float]:
    """DEFAULTS, with numbers from key=value lines in path. Bad lines are skipped."""
    cfg = dict(DEFAULTS)
    try:
        text = path.read_text()
    except OSError:
        return cfg
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if "=" not in line:
            continue
        k, v = (s.strip() for s in line.split("=", 1))
        if k in cfg:
            try:
                cfg[k] = float(v)
            except ValueError:
                pass
    return cfg


def psi(path: Path) -> tuple[float, float]:
    """(some avg10, full avg10) of a pressure file, (-1, -1) when unreadable."""
    some = full = -1.0
    try:
        for line in path.read_text().splitlines():
            m = re.match(r"(some|full) avg10=([0-9.]+)", line)
            if m:
                if m.group(1) == "some":
                    some = float(m.group(2))
                else:
                    full = float(m.group(2))
    except OSError:
        pass
    return some, full


def kv_file(path: Path) -> dict[str, int]:
    out: dict[str, int] = {}
    try:
        for line in path.read_text().splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1].isdigit():
                out[parts[0].rstrip(":")] = int(parts[1])
    except OSError:
        pass
    return out


class Coordinator:
    def __init__(
        self,
        cfg: dict[str, float],
        proc: Path,
        usvc: Path,
        state_dir: Path,
        run_dir: Path,
    ) -> None:
        self.cfg = cfg
        self.proc = proc
        self.usvc = usvc
        self.state_dir = state_dir
        self.level_file = state_dir / "level"
        self.log_file = state_dir / "log"
        self.hold_file = run_dir / "heavy-build.hold.pressure"
        self.level = 0
        self.since = 0.0
        self.above_since: dict[int, float | None] = {1: None, 2: None}
        self.calm_since: float | None = None
        self.counters: deque[tuple[float, dict[str, int]]] = deque()
        self.events: dict[str, tuple[int, float]] = {}
        self.last_sample_log = 0.0
        self.reason = ""

    # ------------------------------------------------------------ sampling

    def scopes(self, now: float) -> tuple[float, float, str]:
        """Highest some and full avg10 over children of the session slices that
        are not at their own limit, and the name of the top one."""
        best_some = best_full = 0.0
        top = ""
        seen: set[str] = set()
        for sl in SLICES:
            try:
                kids = [p for p in (self.usvc / sl).iterdir() if p.is_dir()]
            except OSError:
                continue
            for kid in kids:
                key = str(kid)
                seen.add(key)
                ev = kv_file(kid / "memory.events")
                n = ev.get("high", 0) + ev.get("max", 0)
                old = self.events.get(key)
                rose_at = old[1] if old else -1e18
                if old is not None and n > old[0]:
                    rose_at = now
                self.events[key] = (n, rose_at)
                if now - rose_at < self.cfg["own_limit_secs"]:
                    continue
                some, full = psi(kid / "memory.pressure")
                if some > best_some or full > best_full:
                    if max(some, full) > max(best_some, best_full):
                        top = f"{kid.name}:{max(some, full):.1f}%"
                    best_some = max(best_some, some)
                    best_full = max(best_full, full)
        for key in list(self.events):
            if key not in seen:
                del self.events[key]
        return best_some, best_full, top

    def sample(self, now: float) -> dict[str, float | str]:
        cfg = self.cfg
        _, mem_full = psi(self.proc / "pressure/memory")
        _, io_full = psi(self.proc / "pressure/io")
        vm = kv_file(self.proc / "vmstat")
        mi = kv_file(self.proc / "meminfo")
        cnt = {k: vm.get(k, 0) for k in ("pswpin", "pswpout", "pgmajfault", "zswpwb")}
        self.counters.append((now, cnt))
        while (
            len(self.counters) > 2
            and now - self.counters[1][0] >= cfg["rate_window_secs"]
        ):
            self.counters.popleft()
        t0, c0 = self.counters[0]
        dt = now - t0

        def rate(k: str) -> float:
            return (cnt[k] - c0[k]) / dt if dt > 0 else 0.0

        sw_total = mi.get("SwapTotal", 0) * 1024
        sw_used = sw_total - mi.get("SwapFree", 0) * 1024
        scope_some, scope_full, top = self.scopes(now)
        return {
            "mem_full": max(mem_full, 0.0),
            "io_full": max(io_full, 0.0),
            "scope_some": scope_some,
            "scope_full": scope_full,
            "top": top or "-",
            "swapin": rate("pswpin"),
            "swapout": rate("pswpout"),
            "majfault": rate("pgmajfault"),
            "zswpwb": rate("zswpwb"),
            "mem_avail_gib": mi.get("MemAvailable", 0) / 1048576,
            "swap_used_gib": sw_used / GIB,
            # No swap at all counts as plenty of room: the rule is about oomd
            # and the kernel running out of swap slots.
            "swap_room_gib": (0.9 * sw_total - sw_used) / GIB if sw_total else 1e9,
        }

    # ------------------------------------------------------------ levels

    def triggers(
        self, s: dict[str, float | str], lvl: int, scale: float = 1.0
    ) -> list[str]:
        """The enter conditions of level lvl that hold. scale 0.5 asks
        "is any signal at half its threshold or more" for the leave test."""
        c = self.cfg
        p = "slow" if lvl == 1 else "pause"
        out: list[str] = []

        def ge(sig: str, key: str, label: str, unit: str) -> None:
            th = c[key]
            v = float(s[sig])
            if th > 0 and v >= th * scale:
                out.append(f"{label} {v:.1f}{unit}")

        ge("mem_full", f"{p}_mem_full", "memory full avg10", "%")
        if lvl == 1:
            ge(
                "scope_some",
                "slow_scope_some",
                f"{str(s['top']).split(':')[0]} some avg10",
                "%",
            )
        else:
            ge(
                "scope_full",
                "pause_scope_full",
                f"{str(s['top']).split(':')[0]} full avg10",
                "%",
            )
        ge("swapin", f"{p}_swapin", "disk swap-in", " pages/s")
        ge("majfault", f"{p}_majfault", "major faults", "/s")
        ge("io_full", f"{p}_io_full", "io full avg10", "%")
        room = float(s["swap_room_gib"])
        if scale < 1:
            if room <= c["recover_swap_room_gib"]:
                out.append(f"swap room {room:.1f} GiB")
        elif room < c[f"{p}_swap_room_gib"]:
            out.append(f"swap room {room:.1f} GiB")
        if lvl == 2:
            avail = float(s["mem_avail_gib"])
            if avail < c["pause_mem_avail_gib"] / scale:
                out.append(f"MemAvailable {avail:.1f} GiB")
        return out

    def step(self, now: float, s: dict[str, float | str]) -> str | None:
        """Moves the level for sample s. Returns the old level name when it changed."""
        c = self.cfg
        hot = {lvl: self.triggers(s, lvl) for lvl in (1, 2)}
        for lvl in (1, 2):
            if hot[lvl]:
                if self.above_since[lvl] is None:
                    self.above_since[lvl] = now
            else:
                self.above_since[lvl] = None
        old = self.level
        target = 0
        for lvl in (2, 1):
            since = self.above_since[lvl]
            if lvl <= self.level or since is None:
                continue
            at_once = lvl == 2 and float(s["swap_room_gib"]) < c["pause_swap_room_gib"]
            if at_once or now - since >= c["enter_secs"]:
                target = lvl
                break
        if target > self.level:
            self.level = target
            self.calm_since = None
            self.reason = "; ".join(hot[target])
        elif self.level > 0:
            warm = self.triggers(s, self.level, 0.5)
            if warm:
                self.calm_since = None
                cur = hot[self.level] or warm
                self.reason = (
                    "; ".join(cur)
                    if hot[self.level]
                    else "still over half: " + "; ".join(cur)
                )
            else:
                if self.calm_since is None:
                    self.calm_since = now
                calm = now - self.calm_since
                if calm >= c["leave_secs"]:
                    self.level -= 1
                    self.calm_since = None
                    if self.level == 0:
                        self.reason = "all signals low"
                    else:
                        self.reason = (
                            "; ".join(hot[self.level])
                            or f"calm for {calm:.0f} s, down from pause"
                        )
                else:
                    self.reason = f"calm for {calm:.0f} of {c['leave_secs']:.0f} s"
        else:
            pending = hot[2] or hot[1]
            self.reason = (
                "rising: " + "; ".join(pending) if pending else "all signals low"
            )
        if self.level != old:
            self.since = now
            return LEVELS[old]
        return None

    # ------------------------------------------------------------ output

    def write_atomic(self, path: Path, text: str) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
        try:
            with os.fdopen(fd, "w") as f:
                f.write(text)
            os.replace(tmp, path)
        except BaseException:
            Path(tmp).unlink(missing_ok=True)
            raise

    def level_line(self, now: float, s: dict[str, float | str]) -> str:
        reason = self.reason.replace('"', "'")[:160]
        return (
            f"level={LEVELS[self.level]} since={int(self.since)} updated={int(now)} "
            f'reason="{reason}" top={s["top"]}\n'
        )

    def signals_text(self, s: dict[str, float | str]) -> str:
        return (
            f"mem_full10={s['mem_full']:.2f} scope_some10={s['scope_some']:.2f} "
            f"scope_full10={s['scope_full']:.2f} top={s['top']} io_full10={s['io_full']:.2f} "
            f"swapin_ps={s['swapin']:.0f} swapout_ps={s['swapout']:.0f} "
            f"majfault_ps={s['majfault']:.0f} zswpwb_ps={s['zswpwb']:.0f} "
            f"mem_avail_gib={s['mem_avail_gib']:.1f} swap_used_gib={s['swap_used_gib']:.1f} "
            f"swap_room_gib={s['swap_room_gib']:.1f}"
        )

    def log(self, now: float, text: str) -> None:
        self.state_dir.mkdir(parents=True, exist_ok=True)
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(now))
        with open(self.log_file, "a") as f:
            f.write(f"{stamp} {text}\n")
        try:
            size = self.log_file.stat().st_size
        except OSError:
            return
        if size > self.cfg["log_max_bytes"]:
            with open(self.log_file, "rb") as f:
                f.seek(size // 2)
                f.readline()
                rest = f.read()
            self.write_atomic(self.log_file, rest.decode(errors="replace"))

    def update_hold(self, now: float) -> None:
        if self.level == 2:
            ttl = int(self.cfg["hold_ttl_secs"])
            self.write_atomic(
                self.hold_file,
                f"expires={int(now) + ttl} pressure-coordinator: level pause ({self.reason[:160]})\n",
            )
        else:
            self.hold_file.unlink(missing_ok=True)

    def tick(self, now: float) -> None:
        s = self.sample(now)
        old = self.step(now, s)
        self.write_atomic(self.level_file, self.level_line(now, s))
        self.update_hold(now)
        if old is not None:
            self.log(
                now,
                f'event=level from={old} to={LEVELS[self.level]} reason="{self.reason}" '
                + self.signals_text(s),
            )
        if now - self.last_sample_log >= self.cfg["sample_log_secs"]:
            self.last_sample_log = now
            self.log(
                now,
                f'event=sample level={LEVELS[self.level]} reason="{self.reason}" '
                + self.signals_text(s),
            )

    def shutdown(self) -> None:
        """Takes the pressure hold away so a stopped coordinator holds nothing."""
        self.hold_file.unlink(missing_ok=True)


def default_paths() -> tuple[Path, Path, Path, Path, Path]:
    home = Path.home()
    uid = os.getuid()
    state = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "pressure"
    run = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{uid}"))
    conf = (
        Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
        / "pressure-coordinator.conf"
    )
    usvc = Path(f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service")
    return Path("/proc"), usvc, state, run, conf


def run_forever() -> int:
    proc, usvc, state, run, conf = default_paths()
    co = Coordinator(read_conf(conf), proc, usvc, state, run)
    stop = False

    def on_term(_sig: int, _frame: object) -> None:
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    co.since = time.time()
    co.log(co.since, "event=start level=normal")
    conf_mtime = -1.0
    while not stop:
        now = time.time()
        try:
            m = conf.stat().st_mtime
        except OSError:
            m = 0.0
        if m != conf_mtime:
            conf_mtime = m
            co.cfg = read_conf(conf)
        try:
            co.tick(now)
        except Exception as e:  # keep running; a bad sample must not stop the brake
            try:
                co.log(now, f'event=error error="{type(e).__name__}: {e}"')
            except OSError:
                pass
        end = now + co.cfg["interval"]
        while not stop and time.time() < end:
            time.sleep(min(0.5, max(0.0, end - time.time())))
    co.shutdown()
    co.log(time.time(), "event=stop")
    return 0


def run_once() -> int:
    proc, usvc, state, run, conf = default_paths()
    co = Coordinator(
        read_conf(conf), proc, usvc, Path(tempfile.mkdtemp()), Path(tempfile.mkdtemp())
    )
    co.sample(time.time())
    time.sleep(5)
    now = time.time()
    s = co.sample(now)
    co.step(now, s)
    print(co.signals_text(s))
    print("raw slow triggers:", co.triggers(s, 1) or "none")
    print("raw pause triggers:", co.triggers(s, 2) or "none")
    for d in (co.state_dir, co.hold_file.parent):
        shutil.rmtree(d, ignore_errors=True)
    return 0


# ---------------------------------------------------------------- self-test


def self_test() -> int:
    base = Path(os.environ.get("TMPDIR", "/var/tmp"))
    root = Path(tempfile.mkdtemp(prefix="pc-test.", dir=base))
    fails = 0
    try:
        proc, usvc, state, run = (
            root / "proc",
            root / "usvc",
            root / "state",
            root / "run",
        )
        for d in (proc / "pressure", state, run):
            d.mkdir(parents=True)
        for sl in SLICES:
            (usvc / sl).mkdir(parents=True)
        chrome = usvc / "app.slice/app-chrome.service"
        sess = usvc / "claude.slice/claude-1.scope"
        for d in (chrome, sess):
            d.mkdir()
        vm = {"pswpin": 0, "pswpout": 0, "pgmajfault": 0, "zswpwb": 0}

        def setp(path: Path, some: float, full: float) -> None:
            path.write_text(
                f"some avg10={some:.2f} avg60=0.00 avg300=0.00 total=1\n"
                f"full avg10={full:.2f} avg60=0.00 avg300=0.00 total=1\n"
            )

        def world(
            mem_full: float = 0.0,
            avail_gib: float = 30,
            swap_total_gib: float = 256,
            swap_used_gib: float = 10,
            chrome_full: float = 0.0,
            chrome_high: float = 0,
            sess_some: float = 0.0,
            sess_full: float = 0.0,
            swapin_add: float = 0,
        ) -> None:
            setp(proc / "pressure/memory", mem_full, mem_full)
            setp(proc / "pressure/io", 0, 0)
            vm["pswpin"] += int(swapin_add)
            (proc / "vmstat").write_text("".join(f"{k} {v}\n" for k, v in vm.items()))
            kib = 1048576
            (proc / "meminfo").write_text(
                f"MemAvailable: {int(avail_gib * kib)} kB\n"
                f"SwapTotal: {int(swap_total_gib * kib)} kB\n"
                f"SwapFree: {int((swap_total_gib - swap_used_gib) * kib)} kB\n"
            )
            setp(chrome / "memory.pressure", chrome_full, chrome_full)
            (chrome / "memory.events").write_text(
                f"low 0\nhigh {int(chrome_high)}\nmax 0\noom 0\n"
            )
            setp(sess / "memory.pressure", sess_some, sess_full)
            (sess / "memory.events").write_text("low 0\nhigh 0\nmax 0\noom 0\n")

        def check(name: str, ok: bool, extra: str = "") -> None:
            nonlocal fails
            print(
                ("ok: " if ok else "FAIL: ") + name + (f" ({extra})" if extra else "")
            )
            if not ok:
                fails += 1

        def fresh() -> Coordinator:
            for p in (
                state / "level",
                state / "log",
                run / "heavy-build.hold.pressure",
            ):
                p.unlink(missing_ok=True)
            return Coordinator(dict(DEFAULTS), proc, usvc, state, run)

        def lvl(co: Coordinator) -> str:
            return LEVELS[co.level]

        def run_for(co: Coordinator, t: float, secs: float, **w: float) -> float:
            end = t + secs
            while t < end:
                t += 5
                world(**w)
                co.tick(t)
            return t

        # 1. Calm machine: normal, level file in the agreed format, no hold.
        co = fresh()
        t = run_for(co, 1000.0, 30)
        line = (state / "level").read_text()
        check("calm: level normal", lvl(co) == "normal")
        check(
            "level file: one line, level= since= updated= reason= top=",
            re.fullmatch(
                r'level=normal since=\d+ updated=1030 reason="[^"]*" top=\S+\n', line
            )
            is not None,
            line.strip(),
        )
        check(
            "level file: no temp file left",
            [p.name for p in state.iterdir() if p.name.startswith(".")] == [],
        )
        check(
            "calm: no pressure hold", not (run / "heavy-build.hold.pressure").exists()
        )

        # 2. Memory full 3% enters slow only after 15 s.
        t = run_for(co, t, 10, mem_full=3)
        check("mem full 3% for 10 s: still normal", lvl(co) == "normal")
        t = run_for(co, t, 10, mem_full=3)
        check("mem full 3% for 20 s: slow", lvl(co) == "slow", co.reason)
        check(
            "slow: transition logged",
            "event=level from=normal to=slow" in (state / "log").read_text(),
        )
        check(
            "slow: no pressure hold", not (run / "heavy-build.hold.pressure").exists()
        )

        # 3. Memory full 6% for 15 s: pause, and the pressure hold is written.
        t = run_for(co, t, 20, mem_full=6)
        hold = (
            (run / "heavy-build.hold.pressure").read_text()
            if lvl(co) == "pause"
            else ""
        )
        check("mem full 6%: pause", lvl(co) == "pause", co.reason)
        check(
            "pause: hold file has expires=now+30 and the reason",
            hold.startswith(
                f"expires={int(t) + 30} pressure-coordinator: level pause (memory full avg10 6.0%"
            ),
            hold.strip(),
        )
        check(
            "pause: the manager's hold file is not touched",
            not (run / "heavy-build.hold").exists(),
        )

        # 4. Leave one level at a time, each after 120 s of calm.
        t = run_for(co, t, 60, mem_full=3)
        check(
            "mem full 3% (over half of 5): still pause", lvl(co) == "pause", co.reason
        )
        t = run_for(co, t, 100, mem_full=1.5)
        check("calm 100 s: still pause", lvl(co) == "pause", co.reason)
        t = run_for(co, t, 25, mem_full=1.5)
        check("calm 120 s: down to slow", lvl(co) == "slow", co.reason)
        check(
            "down to slow: pressure hold removed",
            not (run / "heavy-build.hold.pressure").exists(),
        )
        t = run_for(co, t, 125, mem_full=0.5)
        check("slow, calm 120 s: back to normal", lvl(co) == "normal", co.reason)

        # 5. A unit at its own MemoryHigh is not machine pressure.
        co = fresh()
        world()
        co.tick(2000.0)
        hi = 0
        t = 2000.0
        for _ in range(12):
            hi += 5
            t = run_for(co, t, 5, chrome_full=60, chrome_high=hi)
        check(
            "Chrome at its own MemoryHigh, full 60%: stays normal",
            lvl(co) == "normal",
            co.reason,
        )
        t = run_for(co, t, 90, chrome_full=60, chrome_high=hi)
        check(
            "its high counter still for 60 s: now it counts, pause",
            lvl(co) == "pause",
            co.reason,
        )

        # 6. A session scope stalling counts.
        co = fresh()
        run_for(co, 3000.0, 25, sess_some=12)
        check(
            "session some 12% for 25 s: slow, named",
            lvl(co) == "slow" and "claude-1.scope" in co.reason,
            co.reason,
        )

        # 7. Swap room under 12 GiB: pause at once.
        co = fresh()
        run_for(co, 4000.0, 5, swap_total_gib=100, swap_used_gib=80)
        check(
            "swap room 10 GiB: pause on the first sample", lvl(co) == "pause", co.reason
        )
        co = fresh()
        run_for(co, 4500.0, 20, swap_total_gib=100, swap_used_gib=70)
        check("swap room 20 GiB for 20 s: slow", lvl(co) == "slow", co.reason)

        # 8. Disk swap-in rate.
        co = fresh()
        run_for(co, 5000.0, 30, swapin_add=5000)
        check("1000 swap-in pages/s: normal", lvl(co) == "normal", co.reason)
        run_for(co, 5030.0, 60, swapin_add=15000)
        check(
            "3000 swap-in pages/s over the window: slow", lvl(co) == "slow", co.reason
        )

        # 9. MemAvailable under 2 GiB: pause after 15 s.
        co = fresh()
        run_for(co, 6000.0, 20, avail_gib=1.5)
        check("MemAvailable 1.5 GiB: pause", lvl(co) == "pause", co.reason)
        co.shutdown()
        check(
            "shutdown: pressure hold removed",
            not (run / "heavy-build.hold.pressure").exists(),
        )

        # 10. Config file: numbers win, bad lines are skipped.
        conf = root / "pc.conf"
        conf.write_text("slow_mem_full = 1.5  # note\nbogus=1\npause_mem_full=x\n\n")
        cfg = read_conf(conf)
        check("conf: slow_mem_full=1.5 read", cfg["slow_mem_full"] == 1.5)
        check("conf: bad value keeps the default", cfg["pause_mem_full"] == 5)

        # 11. Log cap.
        co = fresh()
        co.cfg["log_max_bytes"] = 2000
        for i in range(100):
            co.log(7000.0 + i, f"event=sample n={i} " + "x" * 40)
        size = (state / "log").stat().st_size
        tail = (state / "log").read_text().splitlines()[-1]
        check("log: stays under about the cap", size <= 2100, str(size))
        check("log: keeps the newest line", "n=99 " in tail)

        # 12. Never signals anything: no kill calls in this file.
        src = Path(__file__).read_text()
        code = src.split("def self_test")[0]
        bad = re.findall(
            r"os\.kill|killpg|subprocess|cgroup\.freeze|cgroup\.kill|memory\.high\b.*write",
            code,
        )
        check("source: no kill, killpg, subprocess or cgroup writes", not bad, str(bad))
    finally:
        shutil.rmtree(root, ignore_errors=True)
    print("all ok" if not fails else f"{fails} failed")
    return 1 if fails else 0


def main() -> int:
    if "--self-test" in sys.argv[1:]:
        return self_test()
    if "--once" in sys.argv[1:]:
        return run_once()
    if sys.argv[1:]:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    return run_forever()


if __name__ == "__main__":
    sys.exit(main())
