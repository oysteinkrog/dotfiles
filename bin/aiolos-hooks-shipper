#!/usr/bin/env python3
"""
aiolos-hooks-shipper — drains the local hook event spool to aiolos.

Tails ~/.cache/aiolos-hooks/spool.jsonl (NUL-separated JSON records), POSTs
each event to AIOLOS_OBSERVE_URL using a persistent HTTP/1.1 keep-alive
session, tracks the read offset in spool.jsonl.offset, and truncates the
spool back to zero once fully drained.

Environment:
  AIOLOS_HOOK_SPOOL    spool file (default ~/.cache/aiolos-hooks/spool.jsonl)
  AIOLOS_OBSERVE_URL   upload address (or AIOLOS_OBSERVE_URL in ~/.config/secrets/.env)
  AIOLOS_HOOK_POLL     idle poll interval in seconds (default 0.5)
  ~/.config/secrets/.env may contain AIOLOS_OBSERVE_KEY=<bccf_*>
"""

import os
import signal
import sys
import time
from pathlib import Path

import requests

HOME = Path.home()
SPOOL = Path(os.environ.get("AIOLOS_HOOK_SPOOL", HOME / ".cache/aiolos-hooks/spool.jsonl"))
OFFSET = Path(str(SPOOL) + ".offset")


def _secret(name):
    env_file = HOME / ".config/secrets/.env"
    if not env_file.exists():
        return None
    for line in env_file.read_text().splitlines():
        if line.startswith(name + "="):
            return line.split("=", 1)[1].strip()
    return None


URL = os.environ.get("AIOLOS_OBSERVE_URL") or _secret("AIOLOS_OBSERVE_URL")
if not URL:
    sys.exit("aiolos-hooks-shipper: set AIOLOS_OBSERVE_URL in the env or in ~/.config/secrets/.env")
POLL = float(os.environ.get("AIOLOS_HOOK_POLL", "0.5"))


def load_key():
    return _secret("AIOLOS_OBSERVE_KEY")


key = load_key()
session = requests.Session()
headers = {"Content-Type": "application/json"}
if key:
    headers["Authorization"] = f"Bearer {key}"

stopping = False


def _stop(*_):
    global stopping
    stopping = True


signal.signal(signal.SIGTERM, _stop)
signal.signal(signal.SIGINT, _stop)


def read_offset() -> int:
    try:
        return int(OFFSET.read_text().strip())
    except Exception:
        return 0


def write_offset(n: int) -> None:
    OFFSET.write_text(str(n))


def post(body: bytes) -> None:
    try:
        session.post(URL, data=body, headers=headers, timeout=5)
    except Exception:
        # Best-effort. Don't crash the shipper on transient network errors;
        # the offset is only advanced after this call returns, so events are
        # not dropped — they'll be retried on next loop iteration if the
        # request raised before reaching the server. (The server itself
        # accepts duplicates idempotently; observe.db has its own id PK.)
        pass


while not stopping:
    try:
        if not SPOOL.exists():
            time.sleep(POLL)
            continue
        off = read_offset()
        size = SPOOL.stat().st_size
        if off >= size:
            # Fully drained — truncate so the file doesn't grow forever.
            if size > 0:
                with SPOOL.open("wb"):
                    pass
                write_offset(0)
            time.sleep(POLL)
            continue
        with SPOOL.open("rb") as fh:
            fh.seek(off)
            chunk = fh.read()
        records = chunk.split(b"\x00")
        if chunk.endswith(b"\x00"):
            complete = records[:-1]
            consumed = len(chunk)
        else:
            complete = records[:-1]
            consumed = len(chunk) - len(records[-1])
        for rec in complete:
            if not rec.strip():
                continue
            post(rec)
        write_offset(off + consumed)
    except Exception:
        time.sleep(POLL)
