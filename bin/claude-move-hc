#!/usr/bin/env bash
# claude-move-hc: move one Claude Code session from FrankenTerm into herdr-core.
#
#   claude-move-hc SESSION_ID [NAME]
#
# Builds the resume command now (from the claude-persist entry), then starts a
# detached systemd unit that waits for the session's Claude to exit and resumes
# it with `hc run --bg --name NAME`. End the session in its FrankenTerm tab with
# /exit after running this. The tab drops to a shell, which you can close.
# The session never runs twice: the resume waits for the old pid to be gone.
#
# NAME defaults to the session's title as a herdr name. Log: the unit's journal
# (journalctl --user -u claude-move-<first 8 of the id>).
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-persist"
PERSIST="$HOME/.claude/hooks/claude-persist.sh"
HC_BIN="${CLAUDE_PERSIST_HC_BIN:-$HOME/.local/bin/herdr-core}"

if [ "${1:-}" = --wait ]; then
  # Internal: runs inside the systemd unit.
  pid=$2 name=$3 cwd=$4 script=$5
  for _ in $(seq 3600); do
    [ -d "/proc/$pid" ] || break
    sleep 1
  done
  if [ -d "/proc/$pid" ]; then echo "Claude pid $pid still runs after 60 min; not moving"; exit 1; fi
  sleep 2
  "$HC_BIN" server status >/dev/null 2>&1 || { echo "herdr-core is not running"; exit 1; }
  # The herdr app shows only terminals with a herdr.space label. Each moved
  # agent gets its own space, named after the agent (CLAUDE_MOVE_SPACE picks
  # another name), and its tab is named after the agent too.
  app="$HOME/.local/bin/herdr-app"
  want=${CLAUDE_MOVE_SPACE:-$name}
  space=$("$app" ls 2>/dev/null | jq -r --arg n "$want" '[.spaces[] | select(.name == $n and .machine == null) | .id][0] // empty' || true)
  shell_tab="" tab=""
  if [ -z "$space" ]; then
    # space.new always opens a shell tab; close it once the agent's tab exists.
    made=$("$app" do space.new --name "$want" --folder "$cwd" --focus false 2>/dev/null || true)
    space=$(jq -r '.space // empty' <<<"$made" 2>/dev/null || true); shell_tab=$(jq -r '.tab // empty' <<<"$made" 2>/dev/null || true)
  fi
  lbl=()
  if [ -n "$space" ]; then
    lbl=(--label "herdr.space=$space")
  else
    # No herdr app window running (for example on a desktop where it was never
    # opened). Label with a stable id of our own: the app turns an id it does not
    # know into a new space when it next opens, so the agent still shows up.
    lbl=(--label "herdr.space=sp$(printf %s "$name" | sha256sum | cut -c1-32)")
  fi
  "$HC_BIN" run --bg --name "$name" "${lbl[@]}" --cwd "$cwd" -- bash "$script"
  addr=$("$HC_BIN" get "$name" --json 2>/dev/null | jq -r '.address // empty')
  if [ -n "$space" ] && [ -n "$addr" ]; then
    for _ in $(seq 20); do
      tab=$("$app" ls 2>/dev/null | jq -r --arg s "$space" --arg t "$addr" \
        '[.spaces[] | select(.id == $s) | .tabs[] | select(any(.terminals[]; .terminal == $t)) | .id][0] // empty' || true)
      [ -n "$tab" ] && break
      sleep 1
    done
    if [ -n "$tab" ]; then
      "$app" do tab.rename --id "$tab" --name "$name" >/dev/null 2>&1 || true
      [ -n "$shell_tab" ] && "$app" do tab.close --id "$shell_tab" --confirmed true >/dev/null 2>&1 || true
    fi
  fi
  "$HOME/bin/styring-arrange" >/dev/null 2>&1 || true
  echo "resumed in herdr-core terminal $name, space $want"
  exit 0
fi

sid=${1:?usage: claude-move-hc SESSION_ID [NAME]}
shopt -s nullglob
files=("$STATE_DIR/sessions/$sid"*@*.json)
if [ ${#files[@]} -gt 1 ]; then
  # A session that changed folder has one entry per folder. Keep the one whose
  # cwd is where the running Claude works now.
  keep=()
  for c in "${files[@]}"; do
    p=$(jq -r '.pid // empty' "$c"); w=$(jq -r '.cwd' "$c")
    [ -n "$p" ] && [ "$(readlink "/proc/$p/cwd" 2>/dev/null)" = "$w" ] && keep+=("$c")
  done
  files=("${keep[@]}")
fi
[ ${#files[@]} -eq 1 ] || { echo "need exactly one entry for $sid, found ${#files[@]}" >&2; exit 1; }
f=${files[0]}
full=$(jq -r '.session_id' "$f"); cwd=$(jq -r '.cwd' "$f"); pid=$(jq -r '.pid // empty' "$f")
[ -n "$pid" ] || { echo "entry $f has no pid" >&2; exit 1; }
if [ $# -ge 2 ]; then
  name=$2
else
  name=$(jq -r '.title // empty' "$f" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9_-]\{1,\}/-/g; s/^[^a-z]*//; s/-*$//' | cut -c1-32)
  name=${name:-${full:0:8}}
fi
name=$(printf %s "$name" | tr "A-Z" "a-z")
[[ $name =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || { echo "bad herdr name: $name" >&2; exit 1; }

mkdir -p "$STATE_DIR/hc-run"
script="$STATE_DIR/hc-run/$full.sh"
lp=$(fish -lc 'string join : $PATH' 2>/dev/null || true)
{
  echo '#!/bin/bash'
  [ -n "$lp" ] && echo "export PATH=$(printf '%q' "$lp")"
  echo 'unset LD_PRELOAD AIOLOS_RC_PORT AIOLOS_RC_SCOPED CLAUDECODE CLAUDE_CODE_ENTRYPOINT ANTHROPIC_BASE_URL CLAUDE_CODE_CHILD_SESSION'
  bash "$PERSIST" resume-cmd "$f"
  echo 'exec fish -l'
} > "$script"
grep -q -- "--resume" "$script" || { echo "no resume command in $script" >&2; exit 1; }

unit="claude-move-${full:0:8}"
systemd-run --user --unit="$unit" --collect --quiet \
  "$HOME/bin/claude-move-hc" --wait "$pid" "$name" "$cwd" "$script"
echo "waiting for Claude pid $pid to exit; then it resumes in herdr-core as '$name' (unit $unit)"
