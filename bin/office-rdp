#!/bin/sh
# RDP to the office desktop (KRDP), fixed 2560x1440 fullscreen with no scaling.
# xfreerdp3 runs under XWayland, which gets real pixels from KDE. The SDL client sent
# its 125%-scaled size (2048x1152) on fullscreen, and KRDP then shrank the office monitor.
# -dynamic-resolution stops any resize request, so the office monitor stays at 1440p.
# AVC444 video; sound and microphone go through PipeWire (pulse API).
# Uses the localbuilds freerdp-client build in /opt/freerdp-client: the distro FreeRDP has
# no GPU H.264 decode (WITH_FFMPEG_HWACCEL) and no Opus, and this one has both. /gdi:hw
# is what turns the GPU decode on (FreeRDP uses VA-API only when SoftwareGdi is off).
# latency:80 asks PipeWire for an 80 ms buffer: KRDP then measured about 165 ms client
# latency, against about 220 ms with the default buffer (2026-10-24, Opus 48 kHz).
# Ctrl+Alt+Enter leaves fullscreen. +smart-sizing scales the picture to the window, so the
# window can be resized freely while the office stays at 2560x1440. (Dynamic resolution
# would resize the office monitor, which only has its EDID modes.)
# /timeout:60000 raises TCP_USER_TIMEOUT from 9 s: when the office machine is under heavy
# build load, KRDP and tailscaled stall for 10 to 35 s and the 9 s default dropped the session.
# RDP has no key login, so the KRDP password lives in KDE Wallet (Secret Service).
# The first run asks for it in a dialog and saves it. Arguments go to xfreerdp3 on stdin
# (/args-from:stdin), so the password never shows in the process list.
# /wm-class:office-rdp matches office-rdp.desktop (StartupWMClass), so KDE shows the window
# under the taskbar launcher instead of as a separate icon.
# Output goes to ~/.cache/office-rdp.log. Run with --forget to drop the saved password.
set -u
log="${XDG_CACHE_HOME:-$HOME/.cache}/office-rdp.log"

if [ "${1:-}" = "--forget" ]; then
  exec secret-tool clear service office-rdp user oystein
fi

pw=$(secret-tool lookup service office-rdp user oystein 2>/dev/null)
while [ -z "$pw" ]; do
  pw=$(kdialog --title "Office desktop (RDP)" --password "Linux login password for oystein on the office desktop (not the wallet password):") || exit 1
  [ -n "$pw" ] || exit 1
  # Check it on the office machine first. unix_chkpwd skips pam_faillock, so a typo
  # here does not count toward the 3-strikes lockout that a failed RDP login does.
  printf '%s\0' "$pw" | ssh -o BatchMode=yes -o ConnectTimeout=10 office /usr/bin/unix_chkpwd oystein nullok
  case $? in
    0) printf '%s' "$pw" | secret-tool store --label="Office desktop RDP (KRDP)" service office-rdp user oystein ;;
    7) kdialog --title "Office desktop (RDP)" --sorry "The office machine says that password is wrong. Try again."; pw= ;;
    *) ;;  # ssh failed: cannot check, so try RDP without saving
  esac
done

{
  printf '%s\n' /v:100.78.187.79 /u:oystein "/p:$pw" /cert:tofu \
    /size:2560x1440 /f -dynamic-resolution /floatbar:sticky:off,default:hidden,show:fullscreen \
    /gfx:AVC444:on /sound:sys:pulse,latency:80 /microphone:sys:pulse /network:lan +clipboard /timeout:60000 /gdi:hw +smart-sizing /wm-class:office-rdp
  for a in "$@"; do printf '%s\n' "$a"; done
} | /opt/freerdp-client/bin/xfreerdp3 /args-from:stdin >"$log" 2>&1
rc=$?

# Wrong password: forget it so the next launch asks again. KRDP checks the password
# with PAM after the connection is up and then ends it as a logoff during the
# capabilities exchange, so FreeRDP never reports a logon failure itself.
if grep -q -E "LOGON_FAILURE|AUTHENTICATION_FAILED|CAPABILITIES_EXCHANGE.*QUIT_SESSION" "$log"; then
  secret-tool clear service office-rdp user oystein
  kdialog --title "Office desktop (RDP)" --error "Login failed. The saved password was removed; launch again to enter it."
elif [ "$rc" -ge 128 ]; then  # codes below 128 are normal disconnects and logoffs
  kdialog --title "Office desktop (RDP)" --sorry "xfreerdp3 exited with code $rc. Log: $log"
fi
exit "$rc"
