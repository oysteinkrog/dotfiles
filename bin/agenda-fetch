#!/usr/bin/env python3
"""Print the coming days of Google Calendar events and open Google Tasks as JSON.

    agenda-fetch

Feeds the agenda Plasma widget (~/.local/share/plasma/plasmoids/org.oysteinkrog.agenda),
which runs this every two minutes. Reads through gog, so it needs no login of its own.
Settings are in ~/.config/agenda/config.json:

    {"account": "you@example.com", "calendars": ["calendar id", ...], "days": 7}

Calendars are fetched one at a time, because gog's merged list does not say which
calendar an event came from, and the colour comes from that. On any error the last good
result is printed again with an "error" field, so the widget keeps showing something.
"""

import configparser
import datetime as dt
import json
import pathlib
import subprocess
import sys

HOME = pathlib.Path.home()
CONFIG = HOME / ".config/agenda/config.json"
CACHE = HOME / ".cache/agenda/last.json"
GOG = [
    str(HOME / "bin/with-secrets"),
    "GOG_KEYRING_PASSWORD",
    "--",
    str(HOME / "bin/gog"),
]


def gog(account, *args):
    r = subprocess.run(
        [*GOG, "-a", account, *args, "-j", "--no-input"],
        capture_output=True,
        text=True,
        timeout=60,
    )
    if r.returncode != 0:
        raise RuntimeError(
            f"gog {args[0]} {args[1]}: {(r.stderr or r.stdout).strip()[:200]}"
        )
    return json.loads(r.stdout)


def ms(value):
    return int(dt.datetime.fromisoformat(value).timestamp() * 1000)


def event_times(e):
    """Start and end in epoch ms, and whether the event is all-day."""
    start, end = e["start"], e["end"]
    if "date" in start:
        # Naive datetimes are local time, so each date gets its own UTC offset
        # (summer or winter time), not today's.
        s = dt.datetime.combine(dt.date.fromisoformat(start["date"]), dt.time())
        en = dt.datetime.combine(dt.date.fromisoformat(end["date"]), dt.time())
        return int(s.timestamp() * 1000), int(en.timestamp() * 1000), True
    return ms(start["dateTime"]), ms(end["dateTime"]), False


def declined(e):
    return any(
        a.get("self") and a.get("responseStatus") == "declined"
        for a in e.get("attendees", [])
    )


def fetch(cfg):
    account = cfg["account"]
    days = int(cfg.get("days", 7))
    calendars = {
        c["id"]: c for c in gog(account, "calendar", "calendars").get("calendars", [])
    }

    events, seen = [], set()
    for cal_id in cfg["calendars"]:
        cal = calendars.get(cal_id, {})
        data = gog(
            account,
            "calendar",
            "events",
            cal_id,
            "--from",
            "today",
            "--days",
            str(days),
            "--max",
            "250",
            "--all-pages",
        )
        for e in data.get("events", []):
            if e.get("status") == "cancelled" or declined(e):
                continue
            key = e.get("iCalUID", e["id"]) + e["start"].get(
                "dateTime", e["start"].get("date", "")
            )
            if key in seen:
                continue
            seen.add(key)
            start, end, all_day = event_times(e)
            events.append(
                {
                    "title": e.get("summary") or "(no title)",
                    "start": start,
                    "end": end,
                    "allDay": all_day,
                    "location": e.get("location", ""),
                    "meet": e.get("hangoutLink", ""),
                    "link": e.get("htmlLink", ""),
                    "calendar": cal.get("summaryOverride")
                    or cal.get("summary", cal_id),
                    "color": cal.get("backgroundColor", ""),
                }
            )
    events.sort(key=lambda x: (x["start"], not x["allDay"], x["title"]))

    tasks = []
    for lst in gog(account, "tasks", "lists").get("tasklists", []):
        for t in gog(account, "tasks", "list", lst["id"], "--max", "100").get(
            "tasks", []
        ):
            if t.get("status") != "needsAction" or not t.get("title", "").strip():
                continue
            tasks.append(
                {
                    "title": t["title"].strip(),
                    "due": t.get("due", "")[:10],
                    "link": t.get("webViewLink", ""),
                }
            )
    tasks.sort(key=lambda t: (t["due"] == "", t["due"], t["title"]))

    return {
        "updated": int(dt.datetime.now().timestamp() * 1000),
        "error": "",
        "events": events,
        "tasks": tasks,
        "away": away(account, cfg.get("away", []), cfg.get("slack", False)),
    }


def away(account, sources, slack=False):
    """Who is out, at home or on part-time hours today, from shared calendars.

    sources: [{"id": calendar id, "kind": "absence" | "hours"}]. In an absence calendar
    an entry is "home" when its title says WFH, otherwise "out". An hours calendar holds
    the working hours of part-time staff. The name is the first part of the poster's
    email, because titles use initials ("CC-OOO"). Your own entries are left out.
    With slack set, Slack statuses add anyone the calendars do not already list.
    """
    people, seen = [], set()
    for src in sources:
        data = gog(account, "calendar", "events", src["id"], "--today", "--max", "100")
        for e in data.get("events", []):
            if e.get("status") == "cancelled":
                continue
            email = e.get("creator", {}).get("email", "")
            if email == account:
                continue
            name = email.split("@")[0].split(".")[0].capitalize() or e.get(
                "summary", ""
            )
            title = e.get("summary", "")
            if src["kind"] == "hours":
                kind = "hours"
            elif "wfh" in title.lower() or "home" in title.lower():
                kind = "home"
            else:
                kind = "out"
            start, end, all_day = event_times(e)
            if (name, kind, start) in seen:
                continue
            seen.add((name, kind, start))
            people.append(
                {
                    "name": name,
                    "kind": kind,
                    "start": start,
                    "end": end,
                    "allDay": all_day,
                    "title": title,
                    "email": email,
                    "source": "calendar",
                    "link": e.get("htmlLink", ""),
                }
            )
    if slack:
        # The calendar wins for out and home. Slack's "out" wins over part-time hours,
        # because a sick day is the news there.
        listed = {p["email"] for p in people if p["kind"] != "hours"} | {account}
        extra = [p for p in slack_away() if p["email"] not in listed]
        out = {p["email"] for p in extra if p["kind"] == "out"}
        people = [p for p in people if p["email"] not in out] + extra
    order = {"out": 0, "home": 1, "hours": 2}
    people.sort(key=lambda p: (order[p["kind"]], p["name"]))
    return people


# Slack statuses that mean someone is out or at home, by text (English and Norwegian)
# or emoji.
OUT_WORDS = (
    "sick",
    "syk",
    "out of office",
    "ooo",
    "vacation",
    "ferie",
    "holiday",
    "leave",
    "permisjon",
    "day off",
    "fridag",
)
OUT_EMOJI = (
    ":face_with_thermometer:",
    ":palm_tree:",
    ":no_entry:",
    ":airplane:",
    ":beach_with_umbrella:",
    ":mask:",
    ":sneezing_face:",
)
HOME_WORDS = ("working remotely", "remote", "wfh", "home", "hjemme", "hjemmekontor")
HOME_EMOJI = (":house_with_garden:", ":house:")


def slack_away():
    """Who is out or at home today by Slack status.

    The token must not reach any command line, so this runs a copy of this script
    under with-secrets, which reads it from the environment (--slack below).
    """
    r = subprocess.run(
        [
            str(HOME / "bin/with-secrets"),
            "SLACK_BOT_TOKEN",
            "--",
            sys.executable,
            __file__,
            "--slack",
        ],
        capture_output=True,
        text=True,
        timeout=60,
    )
    if r.returncode != 0:
        raise RuntimeError(f"slack: {(r.stderr or r.stdout).strip()[:200]}")
    return json.loads(r.stdout)


def slack_statuses():
    """Print the Slack part of away() as JSON. Needs SLACK_BOT_TOKEN in the environment.

    Skipped: expired statuses (Slack does not always clear them), statuses copied from
    Google Calendar (the calendar is read already), and "working remotely" without an
    end time, which is someone's normal week rather than news.
    """
    import os
    import urllib.request

    req = urllib.request.Request(
        "https://slack.com/api/users.list?limit=500",
        headers={"Authorization": "Bearer " + os.environ["SLACK_BOT_TOKEN"]},
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = json.load(resp)
    if not data.get("ok"):
        raise RuntimeError(data.get("error", "users.list failed"))

    now = dt.datetime.now().timestamp()
    people = []
    for u in data.get("members", []):
        if u.get("deleted") or u.get("is_bot") or u.get("id") == "USLACKBOT":
            continue
        p = u.get("profile", {})
        text, emoji = p.get("status_text", ""), p.get("status_emoji", "")
        expires = p.get("status_expiration", 0)
        if not (text or emoji) or (expires and expires < now):
            continue
        if "google calendar" in text.lower():
            continue
        low = text.lower()
        if any(w in low for w in OUT_WORDS) or emoji in OUT_EMOJI:
            kind = "out"
        elif (any(w in low for w in HOME_WORDS) or emoji in HOME_EMOJI) and expires:
            kind = "home"
        else:
            continue
        email = p.get("email", "")
        name = (
            email.split("@")[0].split(".")[0].capitalize()
            or p.get("first_name")
            or u.get("name", "")
        )
        people.append(
            {
                "name": name,
                "email": email,
                "kind": kind,
                "start": int(now * 1000),
                "end": int(expires * 1000) if expires else 0,
                "allDay": False,
                "title": text or emoji,
                "source": "slack",
                "link": "",
            }
        )
    json.dump(people, sys.stdout)


def theme():
    """Colours of the current Plasma style (the panels), from plasma-style-colours.

    In a plasmawindowed window the widget gets the app colour scheme instead, so it
    would not match the panels without this. Empty when the colours cannot be read.
    """
    try:
        path = subprocess.run(
            [str(HOME / "bin/plasma-style-colours")],
            capture_output=True,
            text=True,
            timeout=10,
            check=True,
        ).stdout.strip()
        cp = configparser.ConfigParser(interpolation=None, strict=False)
        cp.optionxform = str
        cp.read(path)

        def hex_of(group, key):
            r, g, b = (int(x) for x in cp[group][key].split(",")[:3])
            return f"#{r:02x}{g:02x}{b:02x}"

        return {
            "background": hex_of("Colors:Window", "BackgroundNormal"),
            "alternate": hex_of("Colors:View", "BackgroundNormal"),
            "text": hex_of("Colors:Window", "ForegroundNormal"),
            "inactive": hex_of("Colors:Window", "ForegroundInactive"),
            "negative": hex_of("Colors:Window", "ForegroundNegative"),
            "accent": hex_of("Colors:Selection", "BackgroundNormal"),
            "accentText": hex_of("Colors:Selection", "ForegroundNormal"),
        }
    except (OSError, subprocess.SubprocessError, KeyError, ValueError):
        return {}


def main():
    try:
        cfg = json.loads(CONFIG.read_text())
        result = fetch(cfg)
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps(result))
    except Exception as exc:  # the widget shows the error and the last good data
        try:
            result = json.loads(CACHE.read_text())
        except (OSError, ValueError):
            result = {"updated": 0, "events": [], "tasks": []}
        result["error"] = str(exc)
    result["theme"] = theme()
    json.dump(result, sys.stdout)


if __name__ == "__main__":
    if sys.argv[1:] == ["--slack"]:
        slack_statuses()
    else:
        main()
