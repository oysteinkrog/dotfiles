#!/usr/bin/env python3
"""Pick the colour theme of the desktop panels (the Agenda and Build Queue widgets).

  panel-theme            print the current theme
  panel-theme --list     list the themes, the current one marked with *
  panel-theme NAME       switch both panels to NAME

The themes are in panel-themes.json next to this script. The choice is one line in
~/.config/desktop-panels/theme; each panel's fetch script reads it on every cycle.
"""
import json
import os
import sys
from pathlib import Path

THEMES = Path(__file__).resolve().parent / "panel-themes.json"
CHOICE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "desktop-panels" / "theme"


def current(themes):
    try:
        name = CHOICE.read_text().strip()
    except OSError:
        name = ""
    return name if name in themes else "plasma"


def main(args):
    themes = json.loads(THEMES.read_text())
    if not args:
        print(current(themes))
    elif args[0] in ("--list", "-l"):
        cur = current(themes)
        for name, t in themes.items():
            print(f"{'*' if name == cur else ' '} {name:15} {t.get('label', '')}")
    elif args[0] in ("--help", "-h"):
        print(__doc__.strip())
    elif args[0] in themes:
        CHOICE.parent.mkdir(parents=True, exist_ok=True)
        tmp = CHOICE.with_suffix(".tmp")
        tmp.write_text(args[0] + "\n")
        os.replace(tmp, CHOICE)
        print(args[0])
    else:
        print(f"panel-theme: no theme {args[0]!r}; try --list", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
