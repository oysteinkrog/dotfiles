#!/usr/bin/env python3
"""Keep KDE Plasma settings in dotfiles without symlinking the rc files.

KDE replaces an rc file when it saves it, which turns a symlink into a plain file,
and the files hold per-machine IDs. So the repo holds only the keys we care about,
in KDE's own format, and this tool writes them one by one with kwriteconfig6.

  Shared:    ~/.dotfiles/kde/<rcfile>                         (default for every machine)
  Per host:  ~/work/life/setup/machines/<host>/kde/<rcfile>    (overrides, only for keys that differ)
  Watched:   ~/.dotfiles/kde/_watch.txt    rc files `diff` scans for settings not in the repo
  Ignored:   ~/.dotfiles/kde/_ignore.txt   file:[group]:key globs `diff` never reports

  kde-config apply [--dry-run]           write repo values that differ from the live config
  kde-config diff [--ssh HOST | --config-dir DIR] [FILE]
                                         drift (live differs from repo) and untracked keys
  kde-config capture [--host] [--ssh HOST] FILE [GROUP [KEY]]
                                         copy live values into the repo; GROUP is KDE
                                         notation, e.g. '[Notifications]' or '[Script-x][y]'

DOTFILES_HOST and DOTFILES_HOSTS pick another host profile, as in setup/lib.sh.
"""
import argparse
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
from pathlib import Path

DOTFILES = Path(os.environ.get("DOTFILES", Path.home() / ".dotfiles"))
SHARED = DOTFILES / "kde"
HOSTS_ROOT = Path(os.environ.get("DOTFILES_HOSTS", Path.home() / "work/life/setup/machines"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def host_name(ssh=None):
    if os.environ.get("DOTFILES_HOST"):
        return os.environ["DOTFILES_HOST"]
    if ssh:
        # The other machine's own profile, not this one's.
        return subprocess.run(["ssh", ssh, "hostnamectl hostname"], capture_output=True, text=True, check=True).stdout.strip()
    try:
        return subprocess.run(["hostnamectl", "hostname"], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return socket.gethostname()


HOST_KDE = HOSTS_ROOT / host_name() / "kde"
GROUP_RE = re.compile(r"^(\[[^\]]*\])+$")


def parse(path):
    """{group: {key: raw value}} for one rc file. group is the header, e.g. '[A][B]'."""
    out = {}
    if not path.is_file():
        return out
    group = ""
    for line in path.read_text(errors="replace").splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        if s.startswith("["):
            if GROUP_RE.match(s):
                group = re.sub(r"\[\$[a-z]+\]$", "", s)
            continue
        if "=" in s:
            k, v = s.split("=", 1)
            out.setdefault(group, {})[k.strip()] = v
    return out


def unescape(raw):
    """KDE escapes in a raw value, decoded to what kwriteconfig6 expects."""
    out, i = [], 0
    while i < len(raw):
        c = raw[i]
        if c == "\\" and i + 1 < len(raw):
            n = raw[i + 1]
            if n == "x" and i + 3 < len(raw):
                out.append(chr(int(raw[i + 2:i + 4], 16)))
                i += 4
                continue
            out.append({"t": "\t", "n": "\n", "r": "\r", "s": " ", "\\": "\\", ";": "\\;", ",": "\\,"}.get(n, "\\" + n))
            i += 2
            continue
        out.append(c)
        i += 1
    return "".join(out)


def group_args(group):
    return [a for g in re.findall(r"\[([^\]]*)\]", group) for a in ("--group", g)]


def repo_files():
    names = set()
    for d in (SHARED, HOST_KDE):
        if d.is_dir():
            names |= {p.name for p in d.iterdir()
                      if p.is_file() and not p.name.startswith(("_", ".")) and p.suffix != ".md"}
    return sorted(names)


def wanted(name):
    """Merged repo values for one rc file: shared, then host overrides on top."""
    merged = {}
    for d in (SHARED, HOST_KDE):
        for g, kv in parse(d / name).items():
            merged.setdefault(g, {}).update(kv)
    return merged


def lines_of(path):
    if not path.is_file():
        return []
    return [l.strip() for l in path.read_text().splitlines() if l.strip() and not l.lstrip().startswith("#")]


def ignored(name, group, key, value):
    if "[$" in key:
        return True
    if name == "kglobalshortcutsrc":
        # Every registered action is listed; only report keys set away from their default.
        parts = value.split(",")
        if len(parts) < 3 or parts[0] == parts[1] or key == "_k_friendly_name":
            return True
    ref = f"{name}:{group}:{key}"
    return any(p.fullmatch(ref) for p in IGNORE)


# Only * is a wildcard: group names are full of [ ] that fnmatch would read as classes.
IGNORE = [re.compile(".*".join(map(re.escape, p.split("*")))) for p in lines_of(SHARED / "_ignore.txt")]


def cmd_apply(args):
    changed = 0
    for name in repo_files():
        live = parse(CONFIG / name)
        for group, kv in wanted(name).items():
            for key, value in kv.items():
                if live.get(group, {}).get(key) == value:
                    continue
                changed += 1
                print(f"{name} {group} {key}={value}")
                if not args.dry_run:
                    subprocess.run(["kwriteconfig6", "--notify", "--file", name, *group_args(group),
                                    "--key", key, "--", unescape(value)], check=True)
    print(f"{changed} setting(s) {'would change' if args.dry_run else 'written'}", file=sys.stderr)


def fetch_ssh(host, names):
    tmp = Path(tempfile.mkdtemp(prefix="kde-config-", dir="/var/tmp"))
    tar = subprocess.run(["ssh", host, "cd ~/.config && tar cf - --ignore-failed-read " + " ".join(names) + " 2>/dev/null"],
                         capture_output=True)
    subprocess.run(["tar", "xf", "-", "-C", str(tmp)], input=tar.stdout, check=False)
    return tmp


def cmd_diff(args):
    names = [args.file] if args.file else sorted(set(repo_files()) | set(lines_of(SHARED / "_watch.txt")))
    tmp = None
    cfg = CONFIG
    if args.ssh:
        tmp = cfg = fetch_ssh(args.ssh, names)
    elif args.config_dir:
        cfg = Path(args.config_dir)
    found = 0
    try:
        for name in names:
            live, want = parse(cfg / name), wanted(name)
            for group in sorted(set(live) | set(want)):
                for key in sorted(set(live.get(group, {})) | set(want.get(group, {}))):
                    lv, wv = live.get(group, {}).get(key), want.get(group, {}).get(key)
                    if wv is not None and lv != wv:
                        print(f"drift      {name} {group} {key}: live={lv!r} repo={wv!r}")
                        found += 1
                    elif wv is None and not ignored(name, group, key, lv):
                        print(f"untracked  {name} {group} {key}={lv}")
                        found += 1
    finally:
        if tmp:
            shutil.rmtree(tmp)
    print(f"{found} difference(s)", file=sys.stderr)
    return 1 if found else 0


def write_key(path, group, key, value):
    """Set key in group in a repo file, keeping comments and order."""
    lines = path.read_text().splitlines() if path.is_file() else []
    start = next((i for i, l in enumerate(lines) if l.strip() == group), None)
    if start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines += [group, f"{key}={value}"]
    else:
        end = next((i for i in range(start + 1, len(lines)) if lines[i].strip().startswith("[")), len(lines))
        for i in range(start + 1, end):
            if lines[i].split("=", 1)[0].strip() == key and "=" in lines[i]:
                lines[i] = f"{key}={value}"
                break
        else:
            last = max((i for i in range(start, end) if lines[i].strip()), default=start)
            lines.insert(last + 1, f"{key}={value}")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n")


def cmd_capture(args):
    dest = HOST_KDE if args.host else SHARED
    tmp = fetch_ssh(args.ssh, [args.file]) if args.ssh else None
    live, want = parse((tmp or CONFIG) / args.file), wanted(args.file)
    if tmp:
        shutil.rmtree(tmp)
    hosted = parse(HOST_KDE / args.file)
    n = 0
    for group, kv in live.items():
        if args.group and group != args.group:
            continue
        for key, value in kv.items():
            if args.key and key != args.key:
                continue
            explicit = bool(args.key)
            if want.get(group, {}).get(key) == value or (not explicit and ignored(args.file, group, key, value)):
                continue
            # A key the host file already overrides stays there unless --host is off and it is new.
            target = HOST_KDE if (args.host or key in hosted.get(group, {})) else dest
            write_key(target / args.file, group, key, value)
            print(f"{target / args.file}: {group} {key}={value}")
            n += 1
    print(f"{n} setting(s) captured", file=sys.stderr)


def main():
    global HOST_KDE
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("apply")
    a.add_argument("--dry-run", action="store_true")
    d = sub.add_parser("diff")
    d.add_argument("--ssh", metavar="HOST", help="compare another machine's live config with this repo")
    d.add_argument("--config-dir", help="compare a copied config folder")
    d.add_argument("file", nargs="?")
    c = sub.add_parser("capture")
    c.add_argument("--host", action="store_true", help=f"write to {HOST_KDE} instead of the shared folder")
    c.add_argument("--ssh", metavar="HOST", help="take the values from another machine's live config")
    c.add_argument("file")
    c.add_argument("group", nargs="?")
    c.add_argument("key", nargs="?")
    args = ap.parse_args()
    if getattr(args, "ssh", None):
        HOST_KDE = HOSTS_ROOT / host_name(args.ssh) / "kde"
    sys.exit({"apply": cmd_apply, "diff": cmd_diff, "capture": cmd_capture}[args.cmd](args) or 0)


if __name__ == "__main__":
    main()
