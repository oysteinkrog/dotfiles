#!/usr/bin/env python3
"""Watch the kernel's kmalloc-128 slab and stop a runaway leak before it takes the machine.

    slab-guard [LIMIT_MB]        default 2048

KWin 6.7 with the NVIDIA driver can leak kmalloc-128 objects (drm_display_mode copies),
reportedly with an EDID override. On 2026-10-03 it grew to 54 GB and the kernel ran out
of memory; the trigger could not be reproduced afterwards. This runs as root, checks the
slab every 10 seconds and logs its size every 10 minutes or when it grows by 256 MB.
Past LIMIT_MB it traces 128-byte allocations for 5 seconds and saves the processes and
full kernel call stacks to /var/log/slab-guard/, which is what a real fix needs. Then it
removes every EDID override edid-add-mode made, so the monitors use their own modes.
"""

import pathlib
import subprocess
import sys
import time

TRACE = pathlib.Path("/sys/kernel/tracing/events/kmem/kmalloc")
HISTS = [
    f"hist:keys={key}:vals=hitcount:sort=hitcount.descending if bytes_alloc==128"
    for key in ("call_site.sym", "common_pid.execname", "common_stacktrace")
]
REPORTS = pathlib.Path("/var/log/slab-guard")
KEPT = pathlib.Path("/run/edid-add-mode")


def log(msg, prio=6):
    print(f"<{prio}>{msg}", flush=True)  # systemd reads the <N> prefix as the priority


def slab_mb():
    for line in pathlib.Path("/proc/slabinfo").read_text().splitlines():
        if line.startswith("kmalloc-128 "):
            f = line.split()
            return int(f[1]) * int(f[3]) / 2**20  # active objects * object size
    return 0.0


def who_allocates():
    """Trace 128-byte allocations for 5 seconds; save the report, return the top callers."""
    trigger = TRACE / "trigger"
    try:
        for h in HISTS:
            with open(trigger, "a") as f:
                f.write(h)
        time.sleep(5)
        report = (TRACE / "hist").read_text()
    except OSError as e:
        return [f"tracing failed: {e}"]
    finally:
        for h in HISTS:
            try:
                with open(trigger, "a") as f:
                    f.write("!" + h)
            except OSError:
                pass
    REPORTS.mkdir(parents=True, exist_ok=True)
    path = REPORTS / time.strftime("%Y%m%d-%H%M%S.txt")
    path.write_text(report)
    lines = [ln for ln in report.splitlines() if not ln.startswith("#")]
    sites = [ln for ln in lines if "call_site" in ln][:8]
    procs = [ln for ln in lines if "common_pid" in ln][:5]
    return [f"full report with call stacks: {path}", *sites, *procs]


def remove_overrides():
    for kept in KEPT.glob("*.bin"):
        conn = kept.stem
        for override in pathlib.Path("/sys/kernel/debug/dri").glob(
            f"*/{conn}/edid_override"
        ):
            card = override.parent.parent.name
            try:
                override.write_text("reset")
                pathlib.Path(f"/sys/class/drm/card{card}-{conn}/status").write_text(
                    "detect"
                )
                subprocess.run(
                    [
                        "udevadm",
                        "trigger",
                        "--action=change",
                        f"/sys/class/drm/card{card}",
                    ],
                    check=False,
                )
                log(f"removed the EDID override on {conn}", 2)
            except OSError as e:
                log(f"could not remove the EDID override on {conn}: {e}", 2)


def main():
    limit = float(sys.argv[1]) if len(sys.argv) > 1 else 2048
    last_logged, last_time, tripped = slab_mb(), 0.0, False
    log(f"watching kmalloc-128, now {last_logged:.0f} MB, limit {limit:.0f} MB")
    while True:
        mb = slab_mb()
        now = time.monotonic()
        if mb - last_logged >= 256 or now - last_time >= 600:
            log(f"kmalloc-128 {mb:.0f} MB", 4 if mb - last_logged >= 256 else 6)
            last_logged, last_time = mb, now
        if mb > limit and not tripped:
            log(
                f"kmalloc-128 is {mb:.0f} MB, over {limit:.0f} MB: likely the KWin/NVIDIA leak",
                2,
            )
            for line in who_allocates():
                log(f"  {line.strip()}", 2)
            remove_overrides()
            tripped = True  # once per run; the log shows whether removing them helped
        elif mb < limit / 2:
            tripped = False
        time.sleep(10)


if __name__ == "__main__":
    main()
