#!/bin/bash
# Start the installed Swing Catalyst inside a Wine virtual desktop of a fixed size,
# so every MC window (main window, dialogs, menus, popups) lives in one host window.
# Capture that one window in OBS with "Window Capture (PipeWire)".
# Usage: mc-record [WIDTHxHEIGHT]   (default 1920x1080)
set -euo pipefail
SIZE="${1:-1920x1080}"
export WINEPREFIX=/home/oystein/.wine
export DXVK_CONFIG_FILE=/home/oystein/.wine/dxvk.conf
export WINEDEBUG=fixme-all
WINE=/home/oystein/.local/share/motioncatalyst-wine/current/bin/wine
cd "/home/oystein/.wine/drive_c/Program Files/Initial Force/Swing Catalyst/bin"
exec "$WINE" explorer "/desktop=MCRecord,$SIZE" MotionCatalyst.exe
