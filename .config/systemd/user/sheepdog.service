[Unit]
Description=sheepdog voice orchestrator for herdr-core agents (tailnet address only)
After=hc-core.service network-online.target
Wants=hc-core.service

[Service]
Environment=PATH=%h/.local/share/sheepdog/bin:%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SHEEPDOG_HC_SOCKET=%t/herdr-core/default.sock
# Keys come from the secrets store, only into this process. The Anthropic orchestrator
# goes through the same proxy as Claude Code (ANTHROPIC_BASE_URL).
ExecStart=/bin/sh -c 'export SHEEPDOG_WEB_BIND=$(tailscale ip -4); exec with-secrets GEMINI_API_KEY ANTHROPIC_API_KEY ANTHROPIC_BASE_URL -- sh -c "SHEEPDOG_ANTHROPIC_BASE_URL=\\$ANTHROPIC_BASE_URL exec sheepdog serve"'
Restart=on-failure
RestartSec=10
MemoryMax=1G

[Install]
WantedBy=default.target
