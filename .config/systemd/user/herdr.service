[Unit]
Description=herdr headless server (agent session runtime, trial since 2026-11-04)

[Service]
Type=simple
ExecStart=%h/.local/bin/herdr server
Restart=on-failure
RestartSec=5
# Keep agent panes alive if the server is stopped: only the main process gets the signal.
KillMode=process

[Install]
WantedBy=default.target
