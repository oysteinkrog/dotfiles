[Unit]
Description=Remove unused Wine test prefixes (wine-test-prefix-prune)

[Service]
Type=oneshot
# Live pass: deletes for real, one prefix at a time under /var/tmp/claude/grove-delete.lock.
# Add --dry-run here to stop deleting.
ExecStart=%h/bin/wine-test-prefix-prune
Nice=19
IOSchedulingClass=idle
MemoryMax=1G
TimeoutStartSec=3h
