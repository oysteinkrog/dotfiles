[Unit]
Description=Heavy builds started by heavy-build

# heavy-build puts each build in its own scope here, capped at 16G to 22G high
# (2G more for the hard max) by its memory estimate. This slice caps all builds
# together, so they cannot take the memory that the terminal and the agent
# sessions need. CPUWeight 20 (default 100) keeps interactive work responsive
# while builds run. It was 50 until 2026-10-13, when builds at load 60 to 100
# still kept app.slice and claude.slice CPU pressure at 4 to 10%.
# MemoryHigh 32G protects the desktop from build memory pressure: the kernel
# reclaims build memory before the 42G hard cap. Added after the 2026-10-13
# freezes.
[Slice]
MemoryHigh=32G
MemoryMax=42G
MemorySwapMax=6G
CPUWeight=20

# oomd pressure kill is off since 2026-10-21: Oystein chose slowdown over killed builds. MemoryMax still caps the slice.
# History: kill at 60% (2026-10-16), raised to 75% (2026-10-17) after MemoryHigh throttling killed a kpp build.
ManagedOOMMemoryPressure=auto
ManagedOOMMemoryPressureLimit=75%
