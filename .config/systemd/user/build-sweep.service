[Unit]
Description=Report stale build output (build-sweep, report only)

[Service]
Type=oneshot
# Report only. Deletion needs --apply, and turning that on needs Oystein's yes.
# Phase 2 would be: ExecStart=%h/bin/build-sweep --apply --only cargo,mcbuild,dump
ExecStart=%h/bin/build-sweep
Nice=19
IOSchedulingClass=idle
# Its tree walk filled 11.5G of dentry/inode cache and pushed apps into swap (2026-10-17).
MemoryHigh=2G
TimeoutStartSec=2h
