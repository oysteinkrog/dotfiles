[Unit]
Description=MCP Agent Mail (am serve-http, localhost, no auth)
After=network.target
# Give up after 5 failed starts in 10 minutes. On 2026-10-04 a corrupt database
# made every start fail, and 6420 restarts left 234 GiB of failed rebuilds in
# doctor/reclaimable. `systemctl --user reset-failed agent-mail` clears the limit.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# The server reads STORAGE_ROOT; the am CLI reads AGENT_MAIL_STORAGE_ROOT. Keep them equal.
Environment=STORAGE_ROOT=%h/.mcp_agent_mail_git_mailbox_repo
Environment=AGENT_MAIL_STORAGE_ROOT=%h/.mcp_agent_mail_git_mailbox_repo
# ATC (Air Traffic Control liveness) kept one fsqlite-worker thread at about 97% CPU all
# day and flooded the journal with "pending effect queue at capacity" (upstream #264, #258).
# The maintainer's workaround is to turn it off. Measured 2026-10-08 on am 0.3.30.
Environment=AM_ATC_ENABLED=false
# Port 4809 matches ~/.claude.json and .claude/hooks/agent-mail-guard.sh.
ExecStart=%h/.local/bin/am serve-http --no-tui --no-auth --port 4809
Restart=on-failure
RestartSec=5
# The server peaked at 1.89 GiB in a 1-hour watch. At 512M it ran into its cap and fsqlite
# corrupted the database within seconds (2026-10-04).
MemoryMax=3G
# oomd: pick this unit last. Today this has no effect. oomd watches user-1000.slice,
# which root owns, for swap and memory pressure, and then ignores avoid on cgroups the
# user owns (man systemd.resource-control, systemd 262). It would count only for a
# ManagedOOMMemoryPressure=kill rule set on a slice inside the user manager.
ManagedOOMPreference=avoid

[Install]
WantedBy=default.target
