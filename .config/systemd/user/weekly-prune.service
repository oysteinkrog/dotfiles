[Unit]
Description=Weekly cache prune (uv, nuget http-cache, paru, claude-desktop-update, ~/.debug, trash, docker builder)

[Service]
Type=oneshot
# Live since 2026-11-19 (Oystein via manager-office). Remove --apply to go back to a dry run.
ExecStart=%h/bin/weekly-prune --apply
Nice=10
IOSchedulingClass=idle
MemoryHigh=2G
TimeoutStartSec=3h
