[Unit]
Description=Resume the Claude sessions that ran in herdr (claude-persist restore-herdr)
After=herdr.service
Requisite=herdr.service

[Service]
Type=oneshot
ExecStart=/bin/bash %h/.claude/hooks/claude-persist.sh restore-herdr
TimeoutStartSec=600

[Install]
# Runs each time herdr.service starts: at login and after a herdr restart.
WantedBy=herdr.service
