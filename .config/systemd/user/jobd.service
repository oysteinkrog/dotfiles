[Unit]
Description=jobd: build and test job queue (replaces heavy-build's own queue)
Documentation=file:///home/oystein/projects/job-system/README.md

[Service]
WorkingDirectory=%h/projects/job-system
ExecStart=/usr/bin/python3 -m jobd.daemon
# Send self-contained test runs to the home desktop (jobd/route.py, Oystein 2026-10-28).
Environment=JOBD_ROUTE=1
Environment=JOBD_ROUTE_KINDS=cargo-test,cargo-check,cargo-clippy,cargo-nextest
Slice=jobd.slice
# Each job runs as its own job-<attempt>.service, so a restart of jobd never
# stops a job; jobd adopts the running ones when it comes back.
KillMode=process
Restart=on-failure
RestartSec=5
MemoryMax=512M
# Keep jobd and its database pages out of swap (see jobd.slice.d/50-protect.conf).
MemoryLow=256M
# 2026-11-11: MemoryLow did not keep jobd's file pages under swap-in storms (passes of 7 to 14 s).
# Runtime test 15:37 to 16:41 with MemoryMin=300M: 0 slow passes in 64 min. Oystein approved.
MemoryMin=300M
MemorySwapMax=0

[Install]
WantedBy=default.target
