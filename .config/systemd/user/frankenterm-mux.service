[Unit]
Description=Frankenterm mux server (keeps terminal sessions alive without a window)
Documentation=https://github.com/oysteinkrog/frankenterm

[Service]
Type=simple
# read ~/.config/wezterm/wezterm.lua (Frankenterm only reads Lua config when this is set)
Environment=FRANKENTERM_LUA_CONFIG=1
Environment=CLAUDE_PERSIST_MAX=80
ExecStart=/usr/bin/frankenterm-mux-server
# save the tab order while the tabs still exist, for claude-persist.sh plan
ExecStop=/bin/bash %h/.claude/hooks/claude-persist.sh snapshot
Restart=on-failure
# Each pane holds about 9 file descriptors. The default soft limit (2048) ran
# out at about 220 panes on 2026-10-07: spawns failed with EMFILE and the
# server could barely accept client connections.
LimitNOFILE=65536
RestartSec=2
TimeoutStopSec=20
# oomd: pick this unit last. Today this has no effect. oomd watches user-1000.slice,
# which root owns, for swap and memory pressure, and then ignores avoid on cgroups the
# user owns (man systemd.resource-control, systemd 262). It would count only for a
# ManagedOOMMemoryPressure=kill rule set on a slice inside the user manager.
ManagedOOMPreference=avoid

[Install]
WantedBy=default.target
