[Unit]
Description=Frankenterm mux server (keeps terminal sessions alive without a window)
Documentation=https://github.com/oysteinkrog/frankenterm

[Service]
Type=simple
# read ~/.config/wezterm/wezterm.lua (Frankenterm only reads Lua config when this is set)
Environment=FRANKENTERM_LUA_CONFIG=1
ExecStart=%h/.local/bin/frankenterm-mux-server
Restart=on-failure
RestartSec=2
TimeoutStopSec=20

[Install]
WantedBy=default.target
