[Unit]
Description=Move memory of long-idle Claude Code sessions to swap (dry-run unless ~/.config/session-rest/mode says live)

[Service]
# background.slice, not app.slice: any reclaim stall charged to this process
# must not count toward heavy-build's app.slice memory pressure gate.
Slice=background.slice
Type=oneshot
ExecStart=/usr/bin/python3 %h/bin/session-rest
# Writes to memory.reclaim only. Never kills, stops or limits a session.
TimeoutStartSec=5min
Nice=19
MemoryHigh=200M
