[Unit]
Description=wherdr v3 phone and web UI for herdr-core (tailnet address only)
After=hc-core.service network-online.target
Wants=hc-core.service

[Service]
WorkingDirectory=%h/.local/share/wherdr
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HC_SOCKET=%t/herdr-core/default.sock
Environment=DATA_DIR=%h/.local/share/wherdr-data
Environment=PORT=7683
Environment=TZ=Europe/Oslo
# Listen on this machine's tailnet address only, never 0.0.0.0.
ExecStart=/bin/sh -c 'HOST=$(tailscale ip -4) exec node scripts/start.mjs'
Restart=on-failure
RestartSec=10
MemoryMax=1G

[Install]
WantedBy=default.target
