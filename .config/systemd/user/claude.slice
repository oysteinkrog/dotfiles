[Unit]
Description=Claude Code sessions started by aiolos-rc

# aiolos-rc starts each session as claude-<pid>.scope in this slice.
#
# No MemoryHigh here or on the scopes. vm.swappiness is 150 (the CachyOS zram default),
# so reclaim under MemoryHigh swaps anonymous memory before it drops page cache, and
# systemd-oomd kills on swap at 90%. On 2026-10-09 a per-session MemoryHigh=8G pushed
# 2.3 GiB of one session (VBCSCompiler) into swap in 10 minutes while 23 GiB RAM was free.
#
# MemorySwapMax caps how much of the oomd swap budget all sessions together can take.
# Above it nothing is killed: anonymous memory stays in RAM and reclaim drops page cache
# or swaps other cgroups instead. At 14:05 the sessions held 15.5 GiB of swap, so 20G
# leaves room.
#
# CPUWeight 80 sits between builds (50) and the desktop (100). Sessions used 3.8 cores
# in total at 13:40, median 0.01 per session, so this matters only under contention.
[Slice]
CPUWeight=80
MemorySwapMax=20G
