[Unit]
Description=Claude Code sessions started by aiolos-rc

# aiolos-rc starts each session as claude-<pid>.scope in this slice.
#
# No MemoryHigh here or on the scopes. vm.swappiness is 100,
# so reclaim under MemoryHigh swaps anonymous memory before it drops page cache, and
# systemd-oomd kills on swap at 90%. On 2026-10-09 a per-session MemoryHigh=8G pushed
# 2.3 GiB of one session (VBCSCompiler) into swap in 10 minutes while 23 GiB RAM was free.
#
# MemorySwapMax is infinity since 2026-10-22 (Oystein approved). A cap does not kill,
# but it stops a session's anonymous memory from going to swap, so the memory stays in
# RAM and a runaway can push the whole machine into OOM with disk swap still free. Idle
# sessions are sent to disk swap on purpose (session-rest). History: 20G,
# then 32G on 2026-10-20 after 45.6M refused swap attempts. pressure-coordinator watches
# swap use; it pauses builds when swap room runs low.
#
# CPUWeight 80 sits between builds (20) and the desktop (100). Sessions used 3.8 cores
# in total at 13:40, median 0.01 per session, so this matters only under contention.
[Slice]
CPUWeight=80
MemorySwapMax=infinity
