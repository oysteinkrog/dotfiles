[Unit]
Description=cass session index and cm reflect (capped, own cgroup)
Documentation=file:%h/.dotfiles/docs/cass-setup.md

[Service]
Type=oneshot
Slice=background.slice
# When the box is short of memory, cass-memcheck retries every 5 min for up to
# 2 h, then skips the run. The wait counts against TimeoutStartSec.
ExecCondition=%h/.local/bin/cass-memcheck
ExecStart=%h/.local/bin/cass-maintenance.sh
Environment=CASS_AUTO_REFRESH=0
Environment=MALLOC_ARENA_MAX=2
Environment=CASS_NON_WATCH_INGEST_CHUNK_SIZE=8
Environment=CASS_TANTIVY_REBUILD_WORKERS=4
Environment=CASS_TANTIVY_REBUILD_PAGE_PREP_WORKERS=2
Environment=CASS_TANTIVY_REBUILD_STAGED_SHARD_BUILDERS=1
Environment=CASS_TANTIVY_MAX_WRITER_THREADS=2
# Two Codex session files are over the default 100 MiB read budget; without this
# the Codex scan never completes and every run exits 9.
Environment=CASS_CODEX_MAX_SOURCE_BYTES=268435456
# Memory reduction, 2026-10-23.
# The 2026-10-23 run peaked at 16.1G plus a full 8G of swap. Most of it is giant
# Claude transcripts (up to 667 MB) parsed whole and mapped on every rayon
# thread, each thread with its own redact memo cache. cass never sizes the
# rayon pool, so it was 32 threads. 4 threads means fewer parallel copies and
# fewer memo caches. The redact memo override (65536 entries, up to 4 GiB per
# thread) is gone from cass-maintenance.sh, so the default 4096 applies.
# The ingest WAL is reset every 128 MiB instead of 512 MiB: the pager keeps
# about 3.5 to 4 times the WAL size in memory.
Environment=RAYON_NUM_THREADS=4
Environment=CASS_INDEX_INGEST_WAL_CHECKPOINT_BYTES=134217728
# cass reads only memory.max of its own cgroup, never memory.high. An OOM kill
# at MemoryMax kills only this unit, never the terminal mux, but a killed run
# that ingested anything forces a full lexical rebuild on the next run.
# History: 4G override, then 6G (2026-10-20), 10G with MemoryMax=30G and
# MemorySwapMax=8G (2026-10-21). With the changes above it is 6G again, 14G as
# the hard cap and 2G of swap, so the job cannot push other work into swap.
MemoryHigh=10G
MemoryMax=16G
MemorySwapMax=4G
OOMPolicy=kill
CPUWeight=20
IOWeight=20
Nice=10
IOSchedulingClass=idle
# 2 h memory wait + 4 h index cap + 10 min slack.
TimeoutStartSec=6h10min
# cass needs more than 10 s to act on SIGTERM during startup (measured
# 2026-10-04). A stop that ends in SIGKILL mid-scan forces a full lexical
# rebuild on the next run, so give a stop two minutes.
TimeoutStopSec=120
