[Unit]
Description=HeSuVi convolver (virtual surround and headphone EQ, see hesuvi)
After=pipewire.service pipewire-session-manager.service
BindsTo=pipewire.service

[Service]
Type=simple
# Writes ~/.config/pipewire/hesuvi-eq.conf, and the IRs if none exist yet.
ExecStartPre=%h/.local/bin/hesuvi render --if-missing
ExecStart=/usr/bin/pipewire -c hesuvi-eq.conf
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=pipewire.service
