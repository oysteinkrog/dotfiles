[Unit]
Description=meetrec: record Slack huddles and Google Meet calls
After=pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
# uv exits 143 when systemd stops it with SIGTERM; that is a clean stop.
SuccessExitStatus=143
ExecStart=%h/bin/meetrec watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
