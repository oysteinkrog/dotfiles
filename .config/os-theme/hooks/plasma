#!/usr/bin/env python3
"""os-theme hook: make the theme the Plasma colour scheme, so KDE and Qt apps and window title bars use it.

The scheme is built from Breeze Dark (Breeze Light for a light theme) with the theme's tokens on top, saved as
~/.local/share/color-schemes/OsTheme<Name>.colors and applied with plasma-apply-colorscheme. The scheme that was
in use before the first os-theme switch is kept in ~/.local/state/os-theme/plasma-scheme, and "plasma" puts it
back.

A Plasma style with its own colours (Sweet, for example) would keep them for the panel, so while a theme is set
the style is "default" (Breeze, which follows the colour scheme). The style in use before is kept in
~/.local/state/os-theme/plasma-style, and "plasma" puts it back.
"""

import configparser
import io
import json
import os
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state")) / "os-theme"
SCHEMES = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local" / "share")) / "color-schemes"
SAVED = STATE / "plasma-scheme"
SAVED_STYLE = STATE / "plasma-style"
THEMED_STYLE = "default"
PREFIX = "OsTheme"
MARKER = "; Generated by os-theme. Do not edit.\n"

# Groups and the token for each background. Foregrounds are the same in every group except Selection.
BACKGROUNDS = {
    "Window": ("window", "band"),
    "View": ("card", "band"),
    "Button": ("band", "card"),
    "Tooltip": ("card", "band"),
    "Header": ("window", "band"),
    "Header][Inactive": ("window", "band"),
    "Complementary": ("window", "band"),
}
FOREGROUNDS = {
    "ForegroundNormal": "text",
    "ForegroundInactive": "muted",
    "ForegroundActive": "accent",
    "ForegroundLink": "accent",
    "ForegroundVisited": "extra",
    "ForegroundPositive": "positive",
    "ForegroundNeutral": "warning",
    "ForegroundNegative": "negative",
    "DecorationFocus": "accent",
    "DecorationHover": "accent",
}


def rgb(value):
    return ",".join(str(int(value[i : i + 2], 16)) for i in (1, 3, 5))


def luminance(value):
    r, g, b = (int(value[i : i + 2], 16) for i in (1, 3, 5))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def kde(*args):
    return subprocess.run(args, capture_output=True, text=True).stdout.strip()


def current_scheme():
    return kde("kreadconfig6", "--file", "kdeglobals", "--group", "General", "--key", "ColorScheme")


def apply(name):
    return subprocess.run(["plasma-apply-colorscheme", name], capture_output=True, text=True)


def set_style(themed):
    before = kde("kreadconfig6", "--file", "plasmarc", "--group", "Theme", "--key", "name", "--default", "default")
    if before != THEMED_STYLE:
        STATE.mkdir(parents=True, exist_ok=True)
        SAVED_STYLE.write_text(before + "\n")
    target = THEMED_STYLE if themed else (SAVED_STYLE.read_text().strip() if SAVED_STYLE.exists() else before)
    if target != before:
        subprocess.run(["plasma-apply-desktoptheme", target], capture_output=True)
        print(f"Plasma style {target}")


def build(name, theme):
    tok = {k: v for k, v in theme.items() if isinstance(v, str) and v.startswith("#") and len(v) == 7}
    tok.setdefault("extra", tok.get("accent", ""))
    base = "BreezeLight" if luminance(tok["window"]) > 128 else "BreezeDark"

    scheme = configparser.ConfigParser(interpolation=None, strict=False)
    scheme.optionxform = str
    scheme.read(f"/usr/share/color-schemes/{base}.colors")

    def put(section, key, token):
        if tok.get(token):
            if not scheme.has_section(section):
                scheme.add_section(section)
            scheme[section][key] = rgb(tok[token])

    for group, (normal, alternate) in BACKGROUNDS.items():
        section = f"Colors:{group}"
        put(section, "BackgroundNormal", normal)
        put(section, "BackgroundAlternate", alternate)
        for key, token in FOREGROUNDS.items():
            put(section, key, token)
    put("Colors:Selection", "BackgroundNormal", "accent")
    put("Colors:Selection", "BackgroundAlternate", "accent")
    for key in ("ForegroundNormal", "ForegroundActive", "ForegroundInactive", "ForegroundLink", "ForegroundVisited"):
        put("Colors:Selection", key, "onAccent")
    put("Colors:Selection", "DecorationFocus", "accent")
    put("Colors:Selection", "DecorationHover", "accent")
    for state, fg in (("active", "text"), ("inactive", "muted")):
        put("WM", f"{state}Background", "window")
        put("WM", f"{state}Blend", "window")
        put("WM", f"{state}Foreground", fg)

    scheme_name = PREFIX + "".join(part.capitalize() for part in name.split("-"))
    scheme["General"]["ColorScheme"] = scheme_name
    scheme["General"]["Name"] = f"os-theme {theme.get('label', name)}"

    text = io.StringIO()
    scheme.write(text, space_around_delimiters=False)
    return scheme_name, MARKER + text.getvalue()


def main(name):
    themes = json.loads((CONFIG / "os-theme" / "themes.json").read_text())
    theme = themes.get(name, {})
    before = current_scheme()
    if not before.startswith(PREFIX):
        STATE.mkdir(parents=True, exist_ok=True)
        SAVED.write_text(before + "\n")
    saved = SAVED.read_text().strip() if SAVED.exists() else "BreezeDark"

    if name == "plasma" or not theme.get("window"):
        target = saved
    else:
        target, text = build(name, theme)
        SCHEMES.mkdir(parents=True, exist_ok=True)
        path = SCHEMES / f"{target}.colors"
        tmp = path.with_suffix(".tmp")
        tmp.write_text(text)
        os.replace(tmp, path)
        # Old generated schemes would only clutter the list in System Settings.
        for old in SCHEMES.glob(f"{PREFIX}*.colors"):
            if old != path and old.read_text().startswith(MARKER):
                old.unlink()
        # plasma-apply-colorscheme skips a scheme that is already set, so step off it to reload changes.
        if before == target:
            apply(saved)

    set_style(themed=target != saved)
    if before == target and name == "plasma":
        return 0
    result = apply(target)
    if result.returncode != 0:
        print(result.stdout.strip() or result.stderr.strip(), file=sys.stderr)
        return 1
    print(f"colour scheme {target}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else "plasma"))
