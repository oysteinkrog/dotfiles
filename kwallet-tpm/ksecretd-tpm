#!/usr/bin/python3 -I
"""Start ksecretd with the TPM-sealed wallet key, so the wallet opens with no prompt.

D-Bus activates this script instead of /usr/bin/ksecretd (see install.sh). It
unseals the wallet's PAM key hash with systemd-creds and hands it to ksecretd
the same way pam_kwallet5 does: ksecretd --pam-login <pipe-fd> <socket-fd>.

If anything fails, it starts plain ksecretd, which asks for the password as
before, and logs one line to the journal that says why. It never logs the key.

Settings (environment, for tests): KWALLET_TPM_CRED, KWALLET_TPM_NAME,
KWALLET_TPM_KSECRETD.
"""

import os
import socket
import subprocess
import sys
import syslog

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
CRED = os.environ.get("KWALLET_TPM_CRED") or os.path.join(CONFIG, "kwallet-tpm", "kdewallet.cred")
NAME = os.environ.get("KWALLET_TPM_NAME") or "kwallet-pam-hash"
KSECRETD = os.environ.get("KWALLET_TPM_KSECRETD") or "/usr/bin/ksecretd"
KEYSIZE = 56  # PBKDF2_SHA512_KEYSIZE in kwallet's kwalletbackend.h


def log(msg):
    syslog.openlog("ksecretd-tpm", 0, syslog.LOG_USER)
    syslog.syslog(syslog.LOG_NOTICE, msg)


def plain_start(reason):
    log(f"starting ksecretd without the sealed key: {reason}")
    os.execv(KSECRETD, [KSECRETD] + sys.argv[1:])


def unseal():
    if not os.path.isfile(CRED):
        plain_start(f"no sealed key at {CRED}")
    try:
        r = subprocess.run(
            ["systemd-creds", "decrypt", "--user", f"--name={NAME}", CRED, "-"],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=20,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        plain_start(f"systemd-creds did not run: {type(e).__name__}")
    if r.returncode != 0:
        err = r.stderr.decode(errors="replace").strip().splitlines()
        plain_start(f"systemd-creds decrypt failed (exit {r.returncode}): {err[-1] if err else 'no message'}")
    if len(r.stdout) != KEYSIZE:
        plain_start(f"unsealed key has {len(r.stdout)} bytes, expected {KEYSIZE}")
    return r.stdout


def main():
    key = unseal()

    # The key goes through a pipe, as pam_kwallet5 sends it. 56 bytes fit in the
    # pipe buffer, so the write never blocks.
    pipe_r, pipe_w = os.pipe()
    os.write(pipe_w, key)
    os.close(pipe_w)
    del key

    # ksecretd then accept()s one connection on the second fd and reads
    # environment lines until EOF (pam_kwallet_init normally sends them with
    # socat). Connect now and close at once: the connection waits in the listen
    # backlog, and ksecretd reads an empty environment. The socket is autobound
    # in the abstract namespace, so no file is left behind.
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind("")
    listener.listen(1)
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.connect(listener.getsockname())
    client.close()

    os.set_inheritable(pipe_r, True)
    os.set_inheritable(listener.fileno(), True)

    # ksecretd only looks at --pam-login when PAM_KWALLET5_LOGIN is set.
    env = dict(os.environ, PAM_KWALLET5_LOGIN="kwallet-tpm")
    log("starting ksecretd with the sealed key")
    os.execve(KSECRETD, [KSECRETD, "--pam-login", str(pipe_r), str(listener.fileno())], env)


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception as e:  # never leave the bus name without a ksecretd
        plain_start(f"wrapper error: {type(e).__name__}")
