+// The frozen spaces (the space-freeze mod), as app space ids ("home/sp…" for another machine).
+// The rows and the Freeze/Thaw menu both use this one function: the menu gets its answer in
+// its props. The source is the herdr.frozen label that freeze.sh sets on every terminal it
+// stops and clears when it starts it again. herdr-core syncs labels between machines and
+// terminals() is live in every window, so every window sees a change at once, with no polling.
+// The fallback is each machine's state files (shared "space-freeze.frozen", read by loadFrozen):
+// it counts only when a frozen terminal listed there is no longer live (closed, or its machine
+// is offline), so an old copy of it can never show a space as frozen while its terminals live.
+function frozenSpaces() {
+  const frozen = new Set(), live = new Set();
+  for (const term of terminals()) {
+    if (term.state !== "live") continue;
+    live.add(term.address);
+    const sp = term.labels?.["herdr.space"];
+    if (!sp || !term.labels?.["herdr.frozen"]) continue;
+    const slash = term.address.indexOf("/");
+    frozen.add(slash > 0 ? `${term.address.slice(0, slash)}/${sp}` : sp);
+  }
