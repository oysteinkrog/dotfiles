+  // Go to the agent that has waited longest for an answer, in any space on any machine. Pressing
+  // again from that agent goes to the next one in the queue (oldest first), then back to the start.
+  nextWaiting() {
+    const queue = readState().asks.filter((a) => a.state === "pending" && !a.notice && a.address)
+      .sort((a, b) => (a.detected_at ?? 0) - (b.detected_at ?? 0));
+    const seen = new Set(), list = queue.filter((a) => !seen.has(a.address) && seen.add(a.address));
+    if (!list.length) { notify({ title: "Nobody is waiting", timeout: 2500 }); return; }
+    const here = focused()?.terminal ?? focused()?.address ?? null;
+    const at = list.findIndex((a) => a.address === here);
+    const next = list[(at + 1) % list.length];
+    run("agent.focus", { terminal: next.address });
+  }
