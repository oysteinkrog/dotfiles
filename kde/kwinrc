# Window manager. The pin-to-monitor layout is per host: HOST_WINDOW_LAYOUT in host.sh.
[EdgeBarrier]
# The pointer crosses between monitors without sticking. Corners keep their barrier.
EdgeBarrier=0
CornerBarrier=true

[Effect-overview]
# No hot corner: top left is for the start menu. Overview is on Meta+W (kglobalshortcutsrc).
BorderActivate=9

[Effect-wobblywindows]
AdvancedMode=true
Drag=52
Stiffness=48

[Plugins]
mousemarkEnabled=true
sheetEnabled=true

[Windows]
ElectricBorderDelay=25

[Xwayland]
# X11 app scale, the office value. Home overrides it for its 125 % monitor.
Scale=1.1
XwaylandEisNoPromptApps=python3

[org.kde.kdecoration2]
library=org.kde.kwin.aurorae.v2

[Desktops]
Number=1
Rows=1
