#!/bin/bash
# Restart a USB audio device that PipeWire holds open but that passes no audio.
#
# Fault seen 2026-11-04 to 2026-11-09 on the StreamCam mic and once on the
# Audioengine D1: the ALSA stream says RUNNING, but its hw_ptr stands still, so
# every app gets silence. Suspending and resuming the PipeWire node fixes it.
# This loop watches hw_ptr once a second and does that restart by itself.
# It also holds the StreamCam's own mic gain in place.
#
# Each line: ALSA card id, PCM folder, pactl list type, pactl suspend command.
DEVICES="
StreamCam pcm0c sources suspend-source
D1 pcm0p sinks suspend-sink
"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/audio-stall-watchdog"
STALL_SECONDS=3      # unchanged hw_ptr for this long counts as a stall
COOLDOWN_SECONDS=15  # wait after a restart before judging the device again
mkdir -p "$STATE_DIR"

# Camera mic gain this loop holds in place. Checked every SETTINGS_SECONDS.
# The StreamCam's "Mic" control is a digital multiplier: 30 dB is the raw signal and
# each 6 dB more doubles every sample. At 54 dB it clipped inside the camera, and
# Chrome's automatic mic gain kept moving it during calls (2026-11-16). PipeWire now
# uses software volume for the camera (wireplumber 51-streamcam-soft-mixer.conf), so
# only this loop writes the camera gain. 53 (44.5 dB) sounded fine to Oystein.
MIC_CARD=StreamCam
MIC_GAIN=53          # ALSA "Mic" value, range 0 to 72 (18 to 54 dB)
SETTINGS_SECONDS=5

declare -A last_ptr still_count cooldown_until last_state

# Write the gain. With "force", write another value first: ALSA skips a write that
# equals its cached value, and the camera may have lost the gain in a stream restart.
hold_mic_gain() {
  local cur
  cur=$(amixer -c "$MIC_CARD" sget Mic 2>/dev/null | awk -F'[][ ]+' '/Capture [0-9]+ \[/{for(i=1;i<=NF;i++) if($i=="Capture"){print $(i+1); exit}}')
  [ -n "$cur" ] || return
  if [ "$1" = force ]; then
    amixer -q -c "$MIC_CARD" sset Mic $(( MIC_GAIN - 1 ))
    amixer -q -c "$MIC_CARD" sset Mic "$MIC_GAIN"
  elif [ "$cur" != "$MIC_GAIN" ]; then
    amixer -q -c "$MIC_CARD" sset Mic "$MIC_GAIN"
    echo "camera mic gain was $cur, set back to $MIC_GAIN"
  fi
}

restart_node() {
  local card=$1 kind=$2 cmd=$3 node
  node=$(pactl list short "$kind" | awk -v c="$card" '$2 ~ /^alsa_/ && $2 ~ c {print $2; exit}')
  if [ -z "$node" ]; then
    echo "stall on $card, but found no PipeWire node to restart"
    return
  fi
  pactl "$cmd" "$node" 1
  sleep 0.5
  pactl "$cmd" "$node" 0
  echo "restarted $node"
}

while sleep 1; do
  now=$(date +%s)
  if [ $(( now % SETTINGS_SECONDS )) -eq 0 ]; then hold_mic_gain; fi
  while read -r card pcm kind cmd; do
    [ -n "$card" ] || continue
    status="/proc/asound/$card/$pcm/sub0/status"
    state=""; ptr=""
    if [ -r "$status" ]; then
      state=$(awk '/^state:/{print $2}' "$status")
      ptr=$(awk '/^hw_ptr/{print $3}' "$status")
    fi
    if [ "$card" = "$MIC_CARD" ] && [ "$state" = "RUNNING" ] && [ "${last_state[$card]}" != "RUNNING" ]; then
      hold_mic_gain force
    fi
    last_state[$card]=$state
    if [ "$state" != "RUNNING" ] || [ "$now" -lt "${cooldown_until[$card]:-0}" ]; then
      last_ptr[$card]=""; still_count[$card]=0
      continue
    fi
    if [ "$ptr" = "${last_ptr[$card]}" ]; then
      still_count[$card]=$(( ${still_count[$card]:-0} + 1 ))
    else
      still_count[$card]=0
    fi
    last_ptr[$card]=$ptr
    if [ "${still_count[$card]}" -ge "$STALL_SECONDS" ]; then
      t=$(date +%Y%m%d-%H%M%S)
      echo "stall on $card: hw_ptr stuck at $ptr for ${STALL_SECONDS}s, saving $STATE_DIR/$t-$card.txt"
      {
        cat "$status"
        echo "--- kernel log, last 60 s"
        journalctl -k --since -60s --no-pager 2>/dev/null | tail -40
        echo "--- pipewire and wireplumber log, last 60 s"
        journalctl --user --since -60s --no-pager _COMM=pipewire _COMM=wireplumber 2>/dev/null | tail -40
      } >"$STATE_DIR/$t-$card.txt" 2>&1
      restart_node "$card" "$kind" "$cmd"
      last_state[$card]=""
      last_ptr[$card]=""; still_count[$card]=0
      cooldown_until[$card]=$(( $(date +%s) + COOLDOWN_SECONDS ))
    fi
  done <<<"$DEVICES"
done
