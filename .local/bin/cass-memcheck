#!/bin/sh
# ExecCondition for cass-maintenance.service. Exit 0 when there is room for a
# cass index run: MemAvailable >= 20 GiB and SwapFree >= 12 GiB. When there is
# not, retry every 5 minutes for up to 2 hours (24 retries), logging each wait to
# the journal via stderr. Exit 1 after that makes systemd skip the run without
# marking it failed. The wait counts against the unit's TimeoutStartSec.
INTERVAL=300
MAX_WAIT=7200

check() {
  awk '/^MemAvailable:/{a=$2} /^SwapFree:/{s=$2} END{printf "MemAvailable=%d MiB SwapFree=%d MiB\n", a/1024, s/1024; exit !(a>=20*1048576 && s>=12*1048576)}' /proc/meminfo
}

waited=0
while :; do
  state=$(check) && { echo "cass-memcheck: ok after ${waited}s wait ($state), running index" >&2; exit 0; }
  if [ "$waited" -ge "$MAX_WAIT" ]; then
    echo "cass-memcheck: skipping tonight's run, still short of memory after ${waited}s ($state; need MemAvailable>=20480 MiB and SwapFree>=12288 MiB)" >&2
    exit 1
  fi
  echo "cass-memcheck: short of memory ($state), waited ${waited}s of ${MAX_WAIT}s, retry in ${INTERVAL}s" >&2
  sleep "$INTERVAL"
  waited=$((waited + INTERVAL))
done
