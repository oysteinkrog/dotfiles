#!/usr/bin/env bash
# Check the StreamCam mic after login and after every wake from sleep.
#
# The camera's mic can come back from suspend recording only zeros. The camera
# does not reconnect on wake, so the udev rule that starts streamcam-mic.service
# never fires. logind sends PrepareForSleep(false) on every wake; start the
# service then. See docs/streamcam.md. Run by streamcam-mic-resume.service.
systemctl --user start streamcam-mic.service

gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 |
  while read -r line; do
    case "$line" in
      *PrepareForSleep*false*)
        sleep 3
        systemctl --user start streamcam-mic.service
        ;;
    esac
  done
