#!/bin/sh
# cass: stops read commands (search, pack, TUI) from starting background index runs
# inside the caller's cgroup. Indexing runs only from cass-maintenance.service.
# Set CASS_AUTO_REFRESH=1 in front of a command to allow one on purpose.
# See ~/.dotfiles/docs/cass-setup.md.
: "${CASS_AUTO_REFRESH:=0}"
export CASS_AUTO_REFRESH
exec /usr/bin/cass "$@"
