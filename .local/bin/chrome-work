#!/bin/sh
# Work Chrome profile (the default data folder), with its own Wayland app_id
# (chrome-work) so it gets a taskbar icon separate from chrome-personal.
exec /usr/bin/google-chrome-stable \
  --user-data-dir="$HOME/.config/google-chrome" \
  --profile-directory="Default" \
  --class=chrome-work \
  "$@"
