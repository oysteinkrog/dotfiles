#!/usr/bin/env python3
"""Set the Logitech StreamCam mic to stereo, recover it if it records only zeros,
then relink the mic filter.

Audio settings: selector 15 on the camera's peripheral extension unit is an
18-byte block. Bytes 2 and 3 are the mode (0 mono, 1 stereo, little-endian) and
bytes 4 to 17 are DSP parameters. Each run writes the factory block with the
mode set to stereo. Logi Options+ also runs this camera in stereo on Windows.
Writing the whole block also repairs bad DSP parameters: with those bytes zeroed
the mic sends loud white noise (tested 2026-10-23). This write does not reboot
the camera. The control cannot be read back: GET_CUR, GET_DEF, GET_MIN and
GET_MAX all return the same buffer, and it does not match what the camera does,
so the block is written every time.

Recovery: sometimes the StreamCam's mic sends only zero samples on Linux. It survives a
replug, a USB reset and a reboot. What fixes it is selector 17 on the camera's
peripheral extension unit (GUID ffe52d21-...): SET_CUR 1 restores the camera's
default settings and reboots it, so it drops off USB and reconnects about 2 s
later. Writing 0 does nothing, and GET_CUR always reads 0. Logi Options+ never
sends this control. See docs/streamcam.md in the dotfiles for the evidence.

Because the write reboots the camera every time, this only sends it when the mic
really records only zeros. Afterwards it checks that PipeWire has the camera's mic
source, and makes WirePlumber probe the sound card again if not (see
reprobe_audio).

Run by streamcam-mic.service, which a udev rule starts when the camera connects,
and by streamcam-mic-resume-watch after login and wake. Safe to run by hand.
  --mono        leave the camera in its default mono mode
  --force       send the reset even if the mic works, and ignore the backoff
  --reprobe     only rebind the sound card
  --no-relink   skip the PipeWire checks after the reset
"""
import ctypes
import errno
import fcntl
import glob
import os
import subprocess
import sys
import time
import uuid

VID, PID = "046d", "0893"
PERIPHERAL_GUID = uuid.UUID("ffe52d21-8030-4e2c-82d9-f587d00540bd")
AUDIO_SELECTOR = 15  # 18-byte audio settings block, bytes 2-3 = mode
# Read right after a factory reset (selector 17) on firmware 0.17, mode set to stereo.
STEREO_BLOCK = bytes.fromhex("00000100faff01000a00f7fff7fff0fff0ff")
RESET_SELECTOR = 17  # SET_CUR 1 = restore defaults and reboot
UVC_SET_CUR = 0x01
AUDIO_NODE = "alsa_input.usb-046d_Logitech_StreamCam"
# The reset reboots the camera, and the udev rule then runs this again on reconnect.
# When the write times out (ETIMEDOUT) instead of failing fast, that rerun lands
# after the reconnect and resets the camera again: 365 reconnects in 40 minutes on
# 2026-10-23. After a timeout, skip automatic runs for BACKOFF_SECONDS.
TIMEOUT_STAMP = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()), "streamcam-mic-timeout")
BACKOFF_SECONDS = 120


class XuQuery(ctypes.Structure):
    _fields_ = [
        ("unit", ctypes.c_uint8),
        ("selector", ctypes.c_uint8),
        ("query", ctypes.c_uint8),
        ("size", ctypes.c_uint16),
        ("data", ctypes.c_void_p),
    ]


# _IOWR('u', 0x21, struct uvc_xu_control_query)
UVCIOC_CTRL_QUERY = (3 << 30) | (ctypes.sizeof(XuQuery) << 16) | (ord("u") << 8) | 0x21


def find_camera():
    """Return (/dev/videoN, peripheral unit id) for the StreamCam capture node."""
    for node in sorted(glob.glob("/sys/class/video4linux/video*")):
        usb_if = os.path.realpath(os.path.join(node, "device"))
        usb_dev = os.path.dirname(usb_if)
        try:
            vid = open(os.path.join(usb_dev, "idVendor")).read().strip()
            pid = open(os.path.join(usb_dev, "idProduct")).read().strip()
            index = open(os.path.join(node, "index")).read().strip()
        except OSError:
            continue
        if (vid, pid, index) != (VID, PID, "0"):
            continue
        unit = peripheral_unit_id(open(os.path.join(usb_dev, "descriptors"), "rb").read())
        if unit is not None:
            return "/dev/" + os.path.basename(node), unit
    return None, None


def peripheral_unit_id(desc):
    """Find the bUnitID of the VideoControl extension unit with PERIPHERAL_GUID."""
    guid = PERIPHERAL_GUID.bytes_le
    i = 0
    while i + 2 <= len(desc):
        length, dtype = desc[i], desc[i + 1]
        if length == 0:
            break
        # CS_INTERFACE (0x24), VC_EXTENSION_UNIT (0x06): bUnitID at +3, GUID at +4.
        if dtype == 0x24 and length >= 20 and desc[i + 2] == 0x06 and desc[i + 4:i + 20] == guid:
            return desc[i + 3]
        i += length
    return None


def reset_camera(dev, unit):
    """Send SET_CUR 1 to the reset selector. The camera reboots, so the request fails
    with EPROTO (or ETIMEDOUT) even though it worked."""
    fd = os.open(dev, os.O_RDWR)
    try:
        buf = (ctypes.c_uint8 * 1)(1)
        query = XuQuery(unit, RESET_SELECTOR, UVC_SET_CUR, 1, ctypes.cast(buf, ctypes.c_void_p).value)
        try:
            fcntl.ioctl(fd, UVCIOC_CTRL_QUERY, query)
        except OSError as e:
            if e.errno != errno.EPROTO:
                raise
    finally:
        os.close(fd)


def xu_query(dev, unit, selector, request, data):
    """Run one UVC extension unit request and return the buffer afterwards."""
    buf = (ctypes.c_uint8 * len(data))(*data)
    fd = os.open(dev, os.O_RDWR)
    try:
        fcntl.ioctl(fd, UVCIOC_CTRL_QUERY, XuQuery(unit, selector, request, len(data), ctypes.cast(buf, ctypes.c_void_p).value))
    finally:
        os.close(fd)
    return bytes(buf)


def wait_for_camera(seconds):
    for _ in range(seconds * 2):
        dev, unit = find_camera()
        if dev:
            return dev, unit
        time.sleep(0.5)
    return None, None


def apply_audio_mode(dev, unit):
    """Write the factory audio block in stereo mode."""
    if "--mono" in sys.argv:
        return
    try:
        xu_query(dev, unit, AUDIO_SELECTOR, UVC_SET_CUR, STEREO_BLOCK)
        print(f"set audio block to stereo ({STEREO_BLOCK.hex()})")
    except OSError as e:
        print(f"could not set the audio mode on {dev}: {e}")


def audio_node_present():
    out = subprocess.run(["pw-cli", "ls", "Node"], capture_output=True, text=True).stdout
    return AUDIO_NODE in out, "effect_input.mic_streamcam" in out


def wait_for_audio_node(seconds):
    for _ in range(seconds * 2):
        if audio_node_present()[0]:
            return True
        time.sleep(0.5)
    return False


def mic_has_signal():
    """True if the camera's mic records sound, False if only zeros, None if unknown.

    The reset reboots the camera every time, so only send it when the mic is
    stuck, which shows as samples that are all exactly zero. A working mic always
    has some room noise.
    """
    names = subprocess.run(["pactl", "list", "short", "sources"], capture_output=True, text=True).stdout.split("\n")
    source = next((line.split("\t")[1] for line in names if AUDIO_NODE in line), None)
    if not source:
        return None
    try:
        raw = subprocess.run(["pw-record", "--target", source, "--rate", "16000", "--channels", "1",
                              "--format", "s16", "-"], capture_output=True, timeout=1.5).stdout
    except subprocess.TimeoutExpired as e:
        raw = e.stdout or b""
    if len(raw) < 3200:
        return None
    return any(raw[3200:])  # skip the first 0.1 s while the stream starts


def reprobe_audio():
    """Make WirePlumber probe the camera's sound card again.

    The reset makes the camera drop off USB and reconnect. If WirePlumber
    probes the sound card during that reconnect (seen at login on 2026-10-22), it
    keeps a card with only the "off" and "pro-audio" profiles and no mic source.
    Rebinding snd-usb-audio makes the kernel remove and re-add the card, so
    WirePlumber probes it again. That needs root: the machine profile installs a
    sudoers rule for exactly these two tee commands. Without it, restart WirePlumber
    instead, which reprobes every card and glitches audio for a moment.
    """
    driver = "/sys/bus/usb/drivers/snd-usb-audio"
    ifaces = [i for i in os.listdir(driver) if os.path.realpath(os.path.join(driver, i)).startswith(usb_device_path())]
    tee = ["sudo", "-n", "/usr/bin/tee"]
    allowed = subprocess.run(["sudo", "-n", "-l", "/usr/bin/tee", f"{driver}/unbind"], capture_output=True)
    if ifaces and allowed.returncode == 0:
        for i in ifaces:
            subprocess.run([*tee, f"{driver}/unbind"], input=i, text=True, capture_output=True)
        time.sleep(1)
        for i in ifaces:
            subprocess.run([*tee, f"{driver}/bind"], input=i, text=True, capture_output=True)
        print(f"rebound snd-usb-audio on {', '.join(ifaces)}")
    else:
        subprocess.run(["systemctl", "--user", "restart", "wireplumber.service"])
        print("restarted wireplumber")


def usb_device_path():
    """sysfs path of the StreamCam USB device, or a path that matches nothing."""
    for dev in glob.glob("/sys/bus/usb/devices/*"):
        try:
            if (open(f"{dev}/idVendor").read().strip(), open(f"{dev}/idProduct").read().strip()) == (VID, PID):
                return os.path.realpath(dev) + "/"
        except OSError:
            continue
    return "/nonexistent/"


def check_audio():
    """Make sure PipeWire has the camera's mic source and the mic filter.

    Reprobe the sound card if the source does not show up. Restart filter-chain only
    if the mic filter is gone: it relinks to a reconnected camera by itself, and a
    restart also cuts the EQ sink for a moment.
    """
    if not wait_for_audio_node(30):
        print("PipeWire has no StreamCam mic source after 30 s; reprobing the sound card")
        reprobe_audio()
        if not wait_for_audio_node(30):
            print("StreamCam mic source still missing after reprobe")
            return False
    if not audio_node_present()[1]:
        subprocess.run(["systemctl", "--user", "try-restart", "filter-chain.service"])
        print("mic filter was missing; restarted filter-chain")
    return True


def main():
    if "--reprobe" in sys.argv:
        reprobe_audio()
        sys.exit(0 if wait_for_audio_node(30) else "StreamCam mic source still missing after reprobe")
    dev, unit = wait_for_camera(10)
    if not dev:
        sys.exit("StreamCam not found")
    apply_audio_mode(dev, unit)
    if "--force" not in sys.argv:
        try:
            age = time.time() - os.path.getmtime(TIMEOUT_STAMP)
        except OSError:
            age = None
        if age is not None and age < BACKOFF_SECONDS:
            print(f"last reset timed out {age:.0f} s ago, not resetting (use --force)")
            return
        if wait_for_audio_node(10) and mic_has_signal():
            print("StreamCam mic records sound, no reset needed")
            check_audio()
            return
    timed_out = False
    for attempt in range(5):
        try:
            reset_camera(dev, unit)
            break
        except OSError as e:
            if e.errno == errno.ETIMEDOUT:
                open(TIMEOUT_STAMP, "w").close()
                timed_out = True
                break
            if attempt == 4:
                sys.exit(f"reset failed on {dev}: {e}")
            time.sleep(1)
    print(f"sent reset to {dev} (unit {unit}, selector {RESET_SELECTOR}); the camera reboots")
    # The reset restores the mono default. Set the mode again once the camera is back.
    # The udev rerun on reconnect may not happen (merged into this job) or may be held
    # back by the timeout backoff, so do not rely on it.
    time.sleep(3)
    dev, unit = wait_for_camera(15)
    if dev:
        apply_audio_mode(dev, unit)
    if timed_out:
        print(f"the reset timed out; automatic resets pause for {BACKOFF_SECONDS} s")
    if "--no-relink" not in sys.argv:
        check_audio()


if __name__ == "__main__":
    main()
