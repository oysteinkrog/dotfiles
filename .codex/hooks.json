{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\oystein\\.codex\\herdr-agent-state.ps1\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/oystein/.claude/hooks/cmd-timing.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/oystein/.claude/hooks/cmd-timing.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/oystein/.claude/hooks/slow-loop-detect.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
