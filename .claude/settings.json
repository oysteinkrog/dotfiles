  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\033]1337;SetUserVar=%s=%s\\007' claude_state Y29tcGxldGU= && echo -e '\\007' && echo -ne '\\033]9;4;1;100\\033\\\\'",
            "async": true
          },
          {
            "type": "command",
            "command": "cm outcome success 2>/dev/null || true",
            "async": true
          },
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\033]1337;SetUserVar=%s=%s\\007' claude_state aW5wdXQ=",
            "async": true
          },
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\033]1337;SetUserVar=%s=%s\\007' claude_state ZXJyb3I=",
            "async": true
          },
          {
            "type": "command",
            "command": "cm outcome failure 2>/dev/null || true",
            "async": true
          },
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\033]1337;SetUserVar=%s=%s\\007' claude_state d29ya2luZw==",
            "async": true
          },
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dcg"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/trauma_guard.py"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/rg-replace-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/grove-worktree-guard.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/c/users/oystein/.dotfiles/bin/aiolos-hook-forwarder",
            "async": true
          }
        ]
      }
    ]
