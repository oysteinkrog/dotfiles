name: soundness

# Generated by the rust-unsafe-code-exorcist harness-builder.
# Edits welcome — adjust matrix axes to match your project's shipped targets.

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    # Weekly nightly cron: Monday 06:00 UTC. Slow tools (fuzz, mutants) run here.
    - cron: '0 6 * * 1'

env:
  CARGO_TERM_COLOR: always
  RUST_BACKTRACE: 1

jobs:
  feature-matrix:
    name: test (${{ matrix.os }}, ${{ matrix.rust }}, ${{ matrix.feature }})
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-14]
        rust: [stable, nightly]
        feature: [all-features, safe-only]
        # Adjust per project's target-cpu choices:
        rustflags:
          - "-C target-cpu=x86-64-v2"
          - "-C target-cpu=x86-64-v3"
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - run: rustup toolchain install ${{ matrix.rust }}
      - run: rustup default ${{ matrix.rust }}
      - name: cargo test (${{ matrix.feature }})
        run: |
          if [ "${{ matrix.feature }}" = "safe-only" ]; then
            cargo test --workspace --no-default-features --features safe-only
          else
            cargo test --workspace --all-features
          fi
        env:
          RUSTFLAGS: ${{ matrix.rustflags }}

  miri:
    name: miri (nightly, default + strict-provenance)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: rustup toolchain install nightly
      - run: rustup +nightly component add miri rust-src
      - run: cargo +nightly miri setup
      - run: cargo +nightly miri test --workspace --all-features
      - run: MIRIFLAGS="-Zmiri-strict-provenance" cargo +nightly miri test --workspace --all-features

  careful:
    name: cargo-careful
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: rustup toolchain install nightly
      - run: cargo +nightly install --force cargo-careful
      - run: cargo +nightly careful test --workspace --all-features

  loom:
    name: loom (concurrency interleavings)
    runs-on: ubuntu-latest
    if: contains(fromJSON('["push","pull_request"]'), github.event_name)
    steps:
      - uses: actions/checkout@v4
      - run: rustup toolchain install stable
      - name: loom suite
        run: |
          if grep -q "loom_concurrency_tests" Cargo.toml */Cargo.toml 2>/dev/null; then
            RUSTFLAGS="--cfg loom" cargo test --features loom_concurrency_tests --release
          else
            echo "no loom suites configured — skipping"
          fi

  fuzz-smoke:
    name: fuzz (60s per target)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: rustup toolchain install nightly
      - run: cargo install --locked cargo-fuzz
      - name: run fuzz targets
        run: |
          if [ -d fuzz ]; then
            for target in $(cargo fuzz list); do
              cargo +nightly fuzz run "$target" -- -max_total_time=60
            done
          else
            echo "no fuzz/ directory — skipping"
          fi

  mutants:
    name: cargo-mutants (weekly)
    runs-on: ubuntu-latest
    if: github.event_name == 'schedule'
    steps:
      - uses: actions/checkout@v4
      - run: rustup toolchain install stable
      - run: cargo install --locked cargo-mutants
      - run: cargo mutants --in-place=false --jobs 4 --output mutants-out/
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: mutants-results
          path: mutants-out/

  geiger-delta:
    name: cargo-geiger delta vs main
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request'
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - run: rustup toolchain install nightly
      - run: cargo install --locked cargo-geiger
      - name: compute PR geiger
        run: cargo +nightly geiger --output-format Json > geiger-pr.json
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.repository.default_branch }}
          path: geiger-main-checkout
      - name: compute delta
        run: |
          (cd geiger-main-checkout && cargo +nightly geiger --output-format Json) > geiger-main.json
          PR_COUNT=$(jq '[.packages[]? | .package.metrics.counters | objects | .[] | numbers] | add // 0' geiger-pr.json)
          MAIN_COUNT=$(jq '[.packages[]? | .package.metrics.counters | objects | .[] | numbers] | add // 0' geiger-main.json)
          echo "main count: $MAIN_COUNT"
          echo "PR count:   $PR_COUNT"
          echo "delta:      $((PR_COUNT - MAIN_COUNT))"
          if [ "$PR_COUNT" -gt "$MAIN_COUNT" ]; then
            echo "::error::geiger count regression: PR has $((PR_COUNT - MAIN_COUNT)) more unsafe sites than main"
            exit 1
          fi
