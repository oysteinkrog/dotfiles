{
  "_comment": "Add these entries to the matching arrays in ~/.claude/settings.json. They run the plain-language gate on anything about to reach a person. Set PLAINLANG_MODE=warn to report without blocking, or PLAINLANG_OFF=1 to switch it off.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|Artifact",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/plain-language-guard.py" }
        ]
      },
      {
        "matcher": "mcp__.*(?:[Ss]lack|[Gg]mail|Atlassian).*",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/plain-language-guard.py" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/plain-language-guard.py" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/plain-language-guard.py" }
        ]
      }
    ]
  }
}
